+// A profile with no controller binding at all (an empty file, or one with only the keyboard's) gets
+// the controller's layout: controller 1 moves to a controller, which would otherwise do nothing.
+// Buttons a player cleared stay cleared (the controller's A and B can't be). Under the state lock.
+bool ControllerLayoutIfNone()
+{
+  for (const SkiesBindings::Input& input : SkiesBindings::Inputs())
+  {
+    if (std::string_view(input.section) == SkiesBindings::PAD_SECTION &&
+        !SkiesBindings::SlotControl(Expression(input), Slot::Controller).empty())
+      return false;
+  }
+  AddDefaults(Slot::Controller, false, nullptr);
+  NOTICE_LOG_FMT(CORE, "[skies] controller layout added (the profile had none)");
+  return true;
+}
