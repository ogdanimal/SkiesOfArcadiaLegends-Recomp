+    // A cheat file (Settings, Gameplay; the emulator-free game): a Dolphin GameSettings ini with the imported disc's
+    // codes, copied to the data folder's Cheats/<disc ID>.ini (the one there before kept as .ini.bak). Not into
+    // GameSettings/<disc ID>.ini: that's the game's settings for the Dolphin engine too (installDefaults).
+    private val pickCheats =
+        registerForActivityResult(ActivityResultContracts.OpenDocument()) { uri: Uri? ->
+            if (uri != null) afterInit { importCheats(uri) }
+        }
+
+    private fun importCheats(uri: Uri) {
+        val id = gameId
+        val message = if (id.isNullOrEmpty()) {
+            "Import a disc first: the cheat file is the disc's."
+        } else try {
+            val bytes = contentResolver.openInputStream(uri)?.use { input ->
+                val buffer = java.io.ByteArrayOutputStream()
+                val chunk = ByteArray(65536)
+                while (true) {
+                    val n = input.read(chunk)
+                    if (n < 0) break
+                    buffer.write(chunk, 0, n)
+                    if (buffer.size() > 1 shl 20) throw java.io.IOException("larger than 1 MB, not a cheat file")
+                }
+                buffer.toByteArray()
+            } ?: throw java.io.IOException("it couldn't be opened")
+            val text = String(bytes, Charsets.UTF_8)
+            if (!text.contains("[ActionReplay") && !text.contains("[Gecko")) {
+                "That file has no [ActionReplay] or [Gecko] section: not a Dolphin cheat file."
+            } else {
+                val dir = File(userDirectory, "Cheats").apply { mkdirs() }
+                val target = File(dir, "$id.ini")
+                if (target.exists()) target.copyTo(File(dir, "$id.ini.bak"), overwrite = true)
+                target.writeBytes(bytes)
+                var enabled = 0
+                var inEnabled = false
+                for (raw in text.lines()) {
+                    val line = raw.trim()
+                    if (line.startsWith("[")) inEnabled = line.endsWith("_Enabled]")
+                    else if (inEnabled && line.startsWith("$")) enabled++
+                }
+                "Cheat file imported for $id: $enabled code(s) enabled in it. Turn on Cheats to apply them."
+            }
+        } catch (e: Exception) {
+            "Could not import that file: ${e.message}"
+        }
+        android.widget.Toast.makeText(this, message, android.widget.Toast.LENGTH_LONG).show()
+    }
+
