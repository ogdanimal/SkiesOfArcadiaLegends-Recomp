+void OnScreenSize(int width, int height)
+{
+  if (width <= 0 || height <= 0)
+    return;  // minimised, or a surface going away
+  const u64 size = static_cast<u64>(width) << 32 | static_cast<u32>(height);
+  if (s_screen_size.exchange(size, std::memory_order_relaxed) == size)
+    return;
+  if (s_system && Config::Get(Config::SKIES_WIDESCREEN) == MATCH_SCREEN && Core::IsRunning(*s_system))
+  {
+    // Always a host job, even on the CPU thread (single core presents there): the presenter is
+    // mid-frame, and applying changes config.
+    Core::QueueHostJob([](Core::System& sys) { ApplyNow(sys); }, false);
+  }
+}
