+// The picture aspect for Match screen and Dolphin's custom ratio for it (the window's own size
+// when it's in range, so the picture fills it exactly).
+struct ScreenShape
+{
+  float aspect;
+  int width;
+  int height;
+};
+
+ScreenShape CurrentScreenShape()
+{
+  const u64 size = s_screen_size.load(std::memory_order_relaxed);
+  const int width = static_cast<int>(size >> 32);
+  const int height = static_cast<int>(size & 0xFFFFFFFF);
+  if (width <= 0 || height <= 0)
+    return {WIDE_ASPECT, 16, 9};  // no window yet: the first frames as 16:9
+  const float aspect = static_cast<float>(width) / static_cast<float>(height);
+  if (aspect < MIN_SCREEN_ASPECT)
+    return {MIN_SCREEN_ASPECT, 4, 3};
+  if (aspect > MAX_SCREEN_ASPECT)
+    return {MAX_SCREEN_ASPECT, 32, 9};
+  return {aspect, width, height};
+}
 
