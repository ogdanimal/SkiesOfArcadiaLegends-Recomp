+        bool waited = SDL_WaitProcess(process, true, &exit_code);
+        // A signal interrupts the wait (SDL's SIGINT / SIGTERM handler has no SA_RESTART): closing
+        // the game from Steam signals the launcher too, while the game is still shutting down. Wait
+        // again (issue #14); a quit request the game didn't get goes on to it, once.
+        bool forwarded = false;
+        while (!waited && std::string_view(SDL_GetError()).ends_with(std::strerror(EINTR)))
+        {
+          SDL_PumpEvents();
+          if (!forwarded && SDL_HasEvent(SDL_EVENT_QUIT))
+          {
+            SDL_KillProcess(process, false);
+            forwarded = true;
+          }
+          waited = SDL_WaitProcess(process, true, &exit_code);
+        }
+        const std::string wait_error = waited ? std::string() : std::string(SDL_GetError());
+        SDL_DestroyProcess(process);  // clears SDL's error, so it's read first
+        // The system or Steam asked the launcher to quit meanwhile: leave without a message
+        SDL_PumpEvents();
+        const bool quit_requested = SDL_HasEvent(SDL_EVENT_QUIT);
+        if (quit_requested)
+        {
+          result = waited && exit_code == 0 ? 0 : 1;
+        }
