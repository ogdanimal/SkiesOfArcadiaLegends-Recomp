diff --git a/Source/Core/VideoCommon/Present.cpp b/Source/Core/VideoCommon/Present.cpp
--- a/Source/Core/VideoCommon/Present.cpp
+++ b/Source/Core/VideoCommon/Present.cpp
@@ -1066,6 +1066,64 @@
 TimePoint Presenter::GetUpdatedPresentationTime(TimePoint intended_presentation_time)
 {
   const auto now = Clock::now();
+  // [Skies] A present that comes late holds the next ones back with it, and they return to their
+  // times gradually, at most 0.5 ms a present. A variable-refresh display (G-Sync, FreeSync) in
+  // fullscreen refreshes when a present arrives: one 7 ms late and the next on time made
+  // intervals of 24 and 9 ms, which swung it between about 40 and 110 Hz and made the panel
+  // flicker (issue #24); at 60 fps (frame interpolation) the game presents every refresh, so it
+  // happened every few seconds. Later than 1.5 refreshes (a load, a pause, a slow scene) isn't
+  // held: the next presents keep their times. Nor when presents are late all the time (the GPU
+  // thread can't keep up, or single core): holding them back takes time from the GPU thread,
+  // which the presents' sleep blocks, and they only came later.
+  {
+    constexpr DT MAX_HOLD = std::chrono::microseconds(25000);
+    constexpr DT STEP = std::chrono::microseconds(500);
+    const DT late = now - intended_presentation_time;
+    m_late_share += ((late > std::chrono::milliseconds(1) ? 1.0f : 0.0f) - m_late_share) / 60.0f;
+    if (late > MAX_HOLD || m_late_share > 0.25f)
+      m_late_offset = DT{};
+    else if (late > m_late_offset)
+      m_late_offset = late;
+    else
+      m_late_offset = std::max(m_late_offset - STEP, DT{});
+    static const bool stats = [] {
+      const char* env = std::getenv("RECOMP_PRESENT_STATS");
+      return env && env[0] == '1';
+    }();
+    if (stats)
+    {
+      ++m_pace_presents;
+      if (late > std::chrono::milliseconds(2))
+      {
+        ++m_pace_late, m_pace_worst = std::max(m_pace_worst, late);
+        ++m_pace_late_kind[FrameInterpolator::IsEnabled() ? FrameInterpolator::LastPictureKind() : 0];
+      }
+      if (m_late_offset > DT{})
+        ++m_pace_held;
+      if (m_pace_presents == 600)
+      {
+        std::fprintf(stderr,
+                     "[present] of 600: %u late by over 2 ms (worst %.1f ms; real %u, in-between %u, "
+                     "in-between finished then %u), %u held back\n",
+                     m_pace_late, DT_ms(m_pace_worst).count(), m_pace_late_kind[0],
+                     m_pace_late_kind[1], m_pace_late_kind[2], m_pace_held);
+        m_pace_late_kind = {};
+        m_pace_presents = m_pace_late = m_pace_held = 0;
+        m_pace_worst = DT{};
+      }
+    }
+    // RECOMP_PRESENT_PACING=0 presents as before (to compare).
+    static const bool pacing = [] {
+      const char* env = std::getenv("RECOMP_PRESENT_PACING");
+      return !env || env[0] != '0';
+    }();
+    if (pacing && !Config::Get(Config::MAIN_SMOOTH_EARLY_PRESENTATION) &&
+        !g_ActiveConfig.bImmediateXFB && !Config::Get(Config::MAIN_RUSH_FRAME_PRESENTATION))
+    {
+      m_presentation_time_offset = std::min(late, DT{});
+      return intended_presentation_time + m_late_offset;
+    }
+  }
   const auto arrival_offset = std::min(now - intended_presentation_time, DT{});
 
   if (!Config::Get(Config::MAIN_SMOOTH_EARLY_PRESENTATION))
