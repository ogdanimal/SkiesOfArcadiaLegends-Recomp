diff --git a/GXRuntime/graphics/aurora/lib/gfx/texture.hpp b/GXRuntime/graphics/aurora/lib/gfx/texture.hpp
index 4bde5e1b6e..945750b68f 100644
--- a/GXRuntime/graphics/aurora/lib/gfx/texture.hpp
+++ b/GXRuntime/graphics/aurora/lib/gfx/texture.hpp
@@ -92,8 +92,12 @@ struct GXTexObj_ {
   GXTexWrapMode wrap_s() const noexcept { return static_cast<GXTexWrapMode>(get_bits(mode0, 2, 0)); }
   GXTexWrapMode wrap_t() const noexcept { return static_cast<GXTexWrapMode>(get_bits(mode0, 2, 2)); }
   GXTexFilter min_filter() const noexcept {
+    // TX_SETMODE0 bits 5-6 = the mip mode (0 none, 1 point, 2 linear), bit 7 = linear within a level
+    // (Dolphin's TexMode0; the SDK's GX_LIN_MIP_NEAR writes 5, GX_NEAR_MIP_LIN 2). Mode 3 reads as
+    // point, as Dolphin's sampler does.
     constexpr GXTexFilter kHwToGxFilter[8] = {
-        GX_NEAR, GX_NEAR_MIP_NEAR, GX_LIN_MIP_NEAR, GX_NEAR, GX_LINEAR, GX_NEAR_MIP_LIN, GX_LIN_MIP_LIN, GX_NEAR,
+        GX_NEAR,   GX_NEAR_MIP_NEAR, GX_NEAR_MIP_LIN, GX_NEAR_MIP_NEAR,
+        GX_LINEAR, GX_LIN_MIP_NEAR,  GX_LIN_MIP_LIN,  GX_LIN_MIP_NEAR,
     };
     return kHwToGxFilter[get_bits(mode0, 3, 5)];
   }
