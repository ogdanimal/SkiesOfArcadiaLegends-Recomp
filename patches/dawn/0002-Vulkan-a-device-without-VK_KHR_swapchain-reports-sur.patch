From f4c463ba9a9dfbe5047c025924a8bd8c87e78e8b Mon Sep 17 00:00:00 2001
From: ogdanimal <306057786+ogdanimal@users.noreply.github.com>
Date: Mon, 26 Oct 2026 18:46:21 -0400
Subject: [PATCH] Vulkan: a device without VK_KHR_swapchain reports surfaces
 unsupported

GetSurfaceCapabilities used instance-level queries only, so a device that can't present (Windows
Sandbox's GPU-PV adapters, compute-only drivers) passed, and the swap chain then called the null
vkCreateSwapchainKHR (an access violation at address 0). Now the capability query fails, and an
application can pick another backend.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RjydsaTAV42JRd8fVw2QCA
---
 src/dawn/native/vulkan/PhysicalDeviceVk.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/dawn/native/vulkan/PhysicalDeviceVk.cpp b/src/dawn/native/vulkan/PhysicalDeviceVk.cpp
index 2265b6441..d83907402 100644
--- a/src/dawn/native/vulkan/PhysicalDeviceVk.cpp
+++ b/src/dawn/native/vulkan/PhysicalDeviceVk.cpp
@@ -1522,6 +1522,14 @@ std::optional<uint32_t> PhysicalDevice::GetDefaultComputeSubgroupSize() const {
 ResultOrError<PhysicalDeviceSurfaceCapabilities> PhysicalDevice::GetSurfaceCapabilities(
     InstanceBase* instance,
     const Surface* surface) const {
+    // A device without VK_KHR_swapchain can't present (Windows Sandbox's GPU-PV adapters, compute-only
+    // drivers): say the surface is unsupported, so the application can choose another backend, instead of
+    // a swap chain calling the null vkCreateSwapchainKHR. The surface queries below are instance-level and
+    // succeed regardless.
+    if (!mDeviceInfo.HasExt(DeviceExt::Swapchain)) {
+        return DAWN_VALIDATION_ERROR("%s can't present: no VK_KHR_swapchain.", this);
+    }
+
     // Gather the Vulkan surface capabilities.
     VulkanSurfaceInfo vkCaps;
     {
