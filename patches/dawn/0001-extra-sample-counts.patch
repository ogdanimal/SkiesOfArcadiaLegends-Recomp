+// IsValidSampleCount plus the counts beyond WebGPU's 1 and 4 (2 and 8) the adapter can render and
+// resolve on its colour and depth formats (PhysicalDeviceBase::SupportsExtraSampleCount): a native
+// extension for hosts that offer the same MSAA choices as a native renderer.
+bool IsSupportedSampleCount(const DeviceBase* device, uint32_t sampleCount);
 
 // Computes a swizzle which, when applied, is equivalent to applying `firstSwizzle`
 // then `secondSwizzle`, like the order of WGSL swizzles (`value.rgba.rgba`).
diff --git a/src/dawn/native/d3d12/PhysicalDeviceD3D12.cpp b/src/dawn/native/d3d12/PhysicalDeviceD3D12.cpp
index 42a9c88ad..b7df9fc1f 100644
--- a/src/dawn/native/d3d12/PhysicalDeviceD3D12.cpp
+++ b/src/dawn/native/d3d12/PhysicalDeviceD3D12.cpp
@@ -92,6 +92,22 @@ Backend* PhysicalDevice::GetBackend() const {
     return static_cast<Backend*>(Base::GetBackend());
 }
 
+bool PhysicalDevice::SupportsExtraSampleCount(uint32_t sampleCount) const {
+    // The 8-bit colour formats (render targets, surfaces) and the depth formats all take it
+    for (DXGI_FORMAT format : {DXGI_FORMAT_R8G8B8A8_UNORM, DXGI_FORMAT_B8G8R8A8_UNORM,
+                               DXGI_FORMAT_D32_FLOAT, DXGI_FORMAT_D24_UNORM_S8_UINT}) {
+        D3D12_FEATURE_DATA_MULTISAMPLE_QUALITY_LEVELS levels = {};
+        levels.Format = format;
+        levels.SampleCount = sampleCount;
+        if (FAILED(mD3d12Device->CheckFeatureSupport(D3D12_FEATURE_MULTISAMPLE_QUALITY_LEVELS,
+                                                      &levels, sizeof(levels))) ||
+            levels.NumQualityLevels == 0) {
+            return false;
+        }
+    }
+    return true;
+}
+
 ComPtr<ID3D12Device> PhysicalDevice::GetDevice() const {
     return mD3d12Device;
 }
