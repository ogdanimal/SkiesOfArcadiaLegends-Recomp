diff --git a/src/dawn/native/vulkan/PhysicalDeviceVk.cpp b/src/dawn/native/vulkan/PhysicalDeviceVk.cpp
index b3fa6a424..2265b6441 100644
--- a/src/dawn/native/vulkan/PhysicalDeviceVk.cpp
+++ b/src/dawn/native/vulkan/PhysicalDeviceVk.cpp
@@ -125,6 +125,20 @@ PhysicalDevice::PhysicalDevice(VulkanInstance* vulkanInstance, VkPhysicalDevice
 
 PhysicalDevice::~PhysicalDevice() = default;
 
+bool PhysicalDevice::SupportsExtraSampleCount(uint32_t sampleCount) const {
+    // As Dolphin's VulkanContext: the counts both the colour and the depth attachments take
+    const VkSampleCountFlags counts = mDeviceInfo.properties.limits.framebufferColorSampleCounts &
+                                      mDeviceInfo.properties.limits.framebufferDepthSampleCounts;
+    switch (sampleCount) {
+        case 2:
+            return (counts & VK_SAMPLE_COUNT_2_BIT) != 0;
+        case 8:
+            return (counts & VK_SAMPLE_COUNT_8_BIT) != 0;
+        default:
+            return false;
+    }
+}
+
 const VulkanDeviceInfo& PhysicalDevice::GetDeviceInfo() const {
     return mDeviceInfo;
 }
