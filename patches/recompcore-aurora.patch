@@ -0,0 +1,263 @@
+// Window backend for builds without SDL (AURORA_ENABLE_SDL=OFF): the host owns the native
+// window (ANativeWindow on Android, HWND on Windows), gives it to Aurora in
+// AuroraConfig::nativeWindow and swaps it with aurora_set_native_window(). There are no
+// events, no input and no pause/focus logic: the host runs the frame loop and decides.
+#include "window.hpp"
+
+#ifdef AURORA_ENABLE_GX
+#include "webgpu/gpu.hpp"
+#endif
+#include "internal.hpp"
+#include "dolphin/vi/vi_internal.hpp"
+
+#include <aurora/aurora.h>
+#include <aurora/event.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <mutex>
+#include <vector>
+
+namespace aurora::window {
+namespace {
+Module Log("aurora::window");
+
+// Guards the native window handle against the frame being presented on the render worker
+// (SurfaceLock, taken by gpu.cpp around surface creation, configuration and presentation).
+std::mutex g_surfaceMutex;
+void* g_native = nullptr;
+uint32_t g_nativeWidth = 0;
+uint32_t g_nativeHeight = 0;
+float g_nativeScale = 1.f;
+float g_frameBufferScale = 0.f;
+bool g_frameBufferAspectFit = false;
+AuroraWindowSize g_windowSize;
+std::vector<AuroraEvent> g_events;
+std::atomic_bool g_surfaceReady = true;
+std::atomic_bool g_pendingResize = false;
+std::atomic_bool g_pendingRefresh = false;
+
+bool operator==(const AuroraWindowSize& lhs, const AuroraWindowSize& rhs) {
+  return lhs.width == rhs.width && lhs.height == rhs.height && lhs.fb_width == rhs.fb_width &&
+         lhs.fb_height == rhs.fb_height && lhs.native_fb_height == rhs.native_fb_height &&
+         lhs.native_fb_width == rhs.native_fb_width && lhs.scale == rhs.scale;
+}
+
+Vec2<int> scale_frame_buffer_to_aspect(int w, int h, float scale, float aspect) {
+  if (w <= 0 || h <= 0 || scale <= 0.f || aspect <= 0.f) {
+    return {std::max(w, 1), std::max(h, 1)};
+  }
+  const int baseW = std::max(1, static_cast<int>(std::lround(static_cast<float>(w) * scale)));
+  const int baseH = std::max(1, static_cast<int>(std::lround(static_cast<float>(h) * scale)));
+  if (aspect >= static_cast<float>(w) / static_cast<float>(h)) {
+    return {std::max(1, static_cast<int>(std::lround(static_cast<float>(baseH) * aspect))), baseH};
+  }
+  return {baseW, std::max(1, static_cast<int>(std::lround(static_cast<float>(baseW) / aspect)))};
+}
+
+Vec2<int> fit_frame_buffer_to_aspect(int width, int height, float aspect) {
+  if (width <= 0 || height <= 0 || aspect <= 0.f) {
+    return {std::max(width, 1), std::max(height, 1)};
+  }
+  if (static_cast<float>(width) / static_cast<float>(height) > aspect) {
+    return {std::max(1, static_cast<int>(std::lround(static_cast<float>(height) * aspect))), height};
+  }
+  return {width, std::max(1, static_cast<int>(std::lround(static_cast<float>(width) / aspect)))};
+}
+
+void resize_swapchain() noexcept {
+  const auto size = get_window_size();
+  if (size == g_windowSize) {
+    return;
+  }
+  g_windowSize = size;
+#ifdef AURORA_ENABLE_GX
+  webgpu::resize_swapchain(size.fb_width, size.fb_height, size.native_fb_width, size.native_fb_height);
+#endif
+}
+} // namespace
+
+const AuroraEvent* poll_events() {
+  g_events.clear();
+  if (g_pendingResize.exchange(false)) {
+    resize_swapchain();
+    g_events.push_back(AuroraEvent{
+        .type = AURORA_WINDOW_RESIZED,
+        .windowSize = get_window_size(),
+    });
+  }
+  if (g_pendingRefresh.exchange(false)) {
+#ifdef AURORA_ENABLE_GX
+    webgpu::refresh_surface(false);
+#endif
+  }
+  g_events.push_back(AuroraEvent{
+      .type = AURORA_NONE,
+  });
+  return g_events.data();
+}
+
+bool create_window(AuroraBackend) {
+  if (g_native == nullptr) {
+    Log.error("No native window: set AuroraConfig::nativeWindow (AURORA_ENABLE_SDL=OFF build)");
+    return false;
+  }
+  return true;
+}
+
+// The SDL renderer only exists for the ImGui overlay on the Null WebGPU backend.
+bool create_renderer() { return false; }
+
+// The window is the host's; nothing to destroy.
+void destroy_window() {}
+
+void show_window() {}
+
+bool initialize() {
+  g_native = g_config.nativeWindow;
+  g_nativeWidth = g_config.nativeWindowWidth;
+  g_nativeHeight = g_config.nativeWindowHeight;
+  g_nativeScale = g_config.nativeWindowScale > 0.f ? g_config.nativeWindowScale : 1.f;
+  g_windowSize = {};
+  g_surfaceReady.store(true, std::memory_order_release);
+  g_pendingResize.store(false);
+  g_pendingRefresh.store(false);
+  Log.info("External native window {} ({}x{}, scale {})", g_native, g_nativeWidth, g_nativeHeight, g_nativeScale);
+  return true;
+}
+
+bool initialize_event_watch() { return true; }
+
+void shutdown() {
+  std::lock_guard lock(g_surfaceMutex);
+  g_native = nullptr;
+  g_nativeWidth = g_nativeHeight = 0;
+}
+
+AuroraWindowSize get_window_size() {
+  const int width = static_cast<int>(g_nativeWidth);
+  const int height = static_cast<int>(g_nativeHeight);
+  int fb_w = width;
+  int fb_h = height;
+  if (g_frameBufferScale > 0.f) {
+    const auto [baseW, baseH] = vi::configured_fb_size();
+    const auto [scaledW, scaledH] =
+        scale_frame_buffer_to_aspect(static_cast<int>(baseW), static_cast<int>(baseH), g_frameBufferScale,
+                                     static_cast<float>(fb_w) / static_cast<float>(std::max(fb_h, 1)));
+    fb_w = scaledW;
+    fb_h = scaledH;
+  }
+  if (g_frameBufferAspectFit) {
+    const auto [baseW, baseH] = vi::configured_fb_size();
+    if (baseW > 0 && baseH > 0) {
+      const auto [fitW, fitH] =
+          fit_frame_buffer_to_aspect(fb_w, fb_h, static_cast<float>(baseW) / static_cast<float>(baseH));
+      fb_w = fitW;
+      fb_h = fitH;
+    }
+  }
+  return {
+      .width = static_cast<uint32_t>(width),
+      .height = static_cast<uint32_t>(height),
+      .fb_width = static_cast<uint32_t>(std::max(fb_w, 0)),
+      .fb_height = static_cast<uint32_t>(std::max(fb_h, 0)),
+      .native_fb_width = static_cast<uint32_t>(width),
+      .native_fb_height = static_cast<uint32_t>(height),
+      .scale = g_nativeScale,
+  };
+}
+
+// gpu.cpp only tests this for null and hands it to SetupWindowAndGetSurfaceDescriptor, which in
+// this build reads it back as the native handle.
+SDL_Window* get_sdl_window() { return reinterpret_cast<SDL_Window*>(g_native); }
+
+SDL_Renderer* get_sdl_renderer() { return nullptr; }
+
+bool is_paused() noexcept { return false; }
+
+bool is_presentable() noexcept {
+  return g_native != nullptr && g_nativeWidth != 0 && g_nativeHeight != 0 &&
+         g_surfaceReady.load(std::memory_order_acquire);
+}
+
+void set_surface_ready(bool ready) noexcept { g_surfaceReady.store(ready, std::memory_order_release); }
+
+SurfaceLock::SurfaceLock() noexcept { g_surfaceMutex.lock(); }
+
+SurfaceLock::~SurfaceLock() { g_surfaceMutex.unlock(); }
+
+bool push_custom_event(CustomEvent eventType) {
+  switch (eventType) {
+  case CustomEvent::FutureResize:
+    g_pendingResize.store(true);
+    return true;
+  case CustomEvent::RefreshSurface:
+    g_pendingRefresh.store(true);
+    return true;
+  default:
+    return false;
+  }
+}
+
+void set_title(const char*) {}
+void set_fullscreen(bool) {}
+bool get_fullscreen() { return true; }
+void set_window_size(uint32_t, uint32_t) {}
+void set_window_position(uint32_t, uint32_t) {}
+void center_window() {}
+
+void request_frame_buffer_resize() {
+  if (g_native != nullptr) {
+    // Deferred to poll_events so the surface isn't reconfigured in the middle of a frame.
+    g_pendingResize.store(true);
+  }
+}
+
+void set_frame_buffer_scale(float scale) {
+  if (scale < 0.f) {
+    scale = 0.f;
+  }
+  if (g_frameBufferScale == scale) {
+    return;
+  }
+  g_frameBufferScale = scale;
+  request_frame_buffer_resize();
+}
+
+void set_frame_buffer_aspect_fit(bool fit) {
+  if (g_frameBufferAspectFit == fit) {
+    return;
+  }
+  g_frameBufferAspectFit = fit;
+  request_frame_buffer_resize();
+}
+
+void set_background_input(bool) {}
+
+void* get_native_window() { return g_native; }
+
+void set_native_window(void* window, uint32_t width, uint32_t height) {
+  if (window == g_native && width == g_nativeWidth && height == g_nativeHeight) {
+    return;
+  }
+#ifdef AURORA_ENABLE_GX
+  // Waits for the render worker, then drops the WebGPU surface built on the old window.
+  // Not under g_surfaceMutex: release_surface takes it itself.
+  webgpu::release_surface();
+#endif
+  {
+    std::lock_guard lock(g_surfaceMutex);
+    g_native = window;
+    g_nativeWidth = window != nullptr ? width : 0;
+    g_nativeHeight = window != nullptr ? height : 0;
+  }
+  // Forces resize_swapchain to reconfigure once the next begin_frame has recreated the surface.
+  g_windowSize = {};
+  Log.info("Native window {} ({}x{})", window, g_nativeWidth, g_nativeHeight);
+  if (window != nullptr) {
+    g_pendingResize.store(true);
+  }
+}
+
+} // namespace aurora::window
