+########################################
+# Aurora video backend: GXRuntime's Aurora renderer (graphics/aurora, Dawn) built in-tree.
+# It reuses this tree's SDL3, fmt, xxhash, zlib and zstd; Dolphin ships its own Dear ImGui,
+# so Aurora's overlay is stubbed out (AURORA_ENABLE_IMGUI=OFF).
+#
+if(ENABLE_AURORA_BACKEND)
+  set(GXRUNTIME_ENABLE_AURORA ON CACHE BOOL "" FORCE)
+  set(GXRUNTIME_ENABLE_AURORA_RECOMP OFF CACHE BOOL "" FORCE)
+  set(AURORA_ENABLE_IMGUI OFF CACHE BOOL "" FORCE)
+  set(AURORA_ENABLE_CARD OFF CACHE BOOL "" FORCE)
+  if(ANDROID)
+    # The Android app has no SDL and owns the Surface: Aurora draws into the ANativeWindow the
+    # app hands the video backend (fork option AURORA_ENABLE_SDL=OFF; no pad/audio/events).
+    set(AURORA_ENABLE_SDL OFF CACHE BOOL "" FORCE)
+  else()
+    set(AURORA_ENABLE_SDL ON CACHE BOOL "" FORCE)
+    set(AURORA_SDL3_PROVIDER "vendor" CACHE STRING "" FORCE)
+    set(AURORA_SDL3_LINKAGE "static" CACHE STRING "" FORCE)
+  endif()
+  if(NOT AURORA_DAWN_PROVIDER)
+    set(AURORA_DAWN_PROVIDER "package" CACHE STRING "" FORCE)
+  endif()
+  if(TARGET zstd::zstd AND NOT TARGET zstd::libzstd)
+    get_target_property(_aurora_zstd_real zstd::zstd ALIASED_TARGET)
+    if(NOT _aurora_zstd_real)
+      set(_aurora_zstd_real zstd::zstd)
+    endif()
+    add_library(zstd::libzstd ALIAS ${_aurora_zstd_real})
+  endif()
+  # Third-party code: Dolphin's /WX (add_compile_options above) must not apply to Aurora's tree.
+  get_directory_property(_aurora_saved_compile_options COMPILE_OPTIONS)
+  set(_aurora_compile_options ${_aurora_saved_compile_options})
+  list(REMOVE_ITEM _aurora_compile_options /WX)
+  set_directory_properties(PROPERTIES COMPILE_OPTIONS "${_aurora_compile_options}")
+  add_subdirectory(GXRuntime EXCLUDE_FROM_ALL)
+  set_directory_properties(PROPERTIES COMPILE_OPTIONS "${_aurora_saved_compile_options}")
+endif()
+
