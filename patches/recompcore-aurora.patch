+// The id EndFrame gives the frame whose XFB copy is being processed (the sink sees the copy first).
+u64 NextFrameId();
+// The frame the replay job draws.
+u64 JobFrame();
+// The vertex arrays recorded for the replay draw being decoded (after OnReplayPrimitive): `data` is
+// the copy of the bytes the draw reads, which start `lo` bytes past the array base.
+struct ReplayArray
+{
+  u8 attr;  // CPArray value: 0 position, 1 normal, 2-3 colours, 4-11 texture coordinates
+  const u8* data;
+  u32 lo;
+  u32 size;
+};
