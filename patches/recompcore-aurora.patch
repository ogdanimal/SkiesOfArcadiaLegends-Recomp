+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+#include <webgpu/webgpu_cpp.h>
+
+// A host's 2D overlay (Dear ImGui draw data: Dolphin's on-screen UI) drawn over the presented
+// picture, in surface pixels. The host sets the frame's lists before its present; end_frame takes
+// them, and the render worker draws them after the EFB blit.
+namespace aurora::gfx::overlay {
+struct Cmd {
+  float clip[4];  // x1, y1, x2, y2 in display pixels
+  uint32_t texture;
+  uint32_t indexOffset;
+  uint32_t indexCount;
+  uint32_t vertexOffset;
+};
+struct TextureUpload {
+  uint32_t id;
+  uint32_t width;
+  uint32_t height;
+  std::vector<uint8_t> rgba;
+};
+struct Data {
+  std::vector<uint8_t> vertices;  // 20 bytes each: pos f32x2, uv f32x2, col rgba8
+  std::vector<uint16_t> indices;
+  std::vector<Cmd> cmds;
+  std::vector<TextureUpload> textures;
+  float displayWidth = 0.f;
+  float displayHeight = 0.f;
+};
+
+void set(Data data) noexcept;
+void set_texture(uint32_t id, uint32_t width, uint32_t height, const uint8_t* rgba) noexcept;
+// The lists for this frame (the host's latest), with the texture uploads queued since the last take.
+Data take_for_frame() noexcept;
+// Render worker: draws `data` into the current present pass (the full surface as the viewport).
+void render(const wgpu::RenderPassEncoder& pass, const Data& data, uint32_t surfaceWidth,
+            uint32_t surfaceHeight) noexcept;
+void shutdown() noexcept;
+}  // namespace aurora::gfx::overlay
