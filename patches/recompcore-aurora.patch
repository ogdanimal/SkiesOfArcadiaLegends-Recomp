+}
+
+namespace Aurora
+{
+namespace
+{
+// stderr on the desktop; Android drops stdio, so logcat there too (tag "aurora-backend").
+template <typename... Args>
+void BackendLog(const char* format, Args... args)
+{
+  std::fprintf(stderr, format, args...);
+#ifdef ANDROID
+  __android_log_print(ANDROID_LOG_INFO, "aurora-backend", format, args...);
+#endif
+}
+// Every command the decoder sees (display lists arrive expanded) is appended to Aurora's raw
+// FIFO; Aurora parses it itself. The XFB copy (BP 0x52 with the "to XFB" bit) ends the frame:
+// Aurora stubs the display copy, so present there, exactly where Dolphin's FIFO recorder and
+// dff2dolt cut frames (that is the boundary the offline comparison was validated against).
+unsigned long long s_frames = 0;
+bool s_stop_requested = false;
+bool s_timing_log = false;
+// Per-frame CPU time on this (GPU) thread: feeding Aurora's FIFO, Aurora's present (parse, draw,
+// submit, present wait) and the whole frame interval; printed every 600 frames with _LOG=1.
+using Clock = std::chrono::steady_clock;
+
+Clock::duration s_feed_time{};
+Clock::duration s_present_time{};
+Clock::time_point s_interval_start{};
+Clock::duration s_interval_time{};
+unsigned s_interval_frames = 0;
+std::string s_png_dir;
+unsigned s_png_every = 0;
+void ReloadRegisterState();
+void PushBE32(std::vector<u8>& out, u32 value);
+unsigned EnvUnsigned(const char* name, unsigned fallback);
+
+// 60 fps: the Frame Interpolator's replay of a blended frame goes through the sink like the game's
+// commands, into a second Aurora context (its own GX state on a spare EFB) that the slice hooks
+// enter and leave, so slices can fall between the game's commands. Each replayed draw's vertex
+// arrays are the interpolator's copies (the RAM may have changed): they are handed to Aurora with
+// its host-pointer array command before the draw and the guest bases put back after it. The
+// game's real frame is copied aside at its XFB copy, the in-between one at the replay's, and the
+// retrace hook presents one of them (previous real, in-between, real: VideoCommon's order), so
+// presents follow the VI like Dolphin's own backends. MODERNGEKKO_AURORA_INTERP=0 keeps the old
+// behaviour (replays skipped, the game's own rate, present at the XFB copy).
+bool s_interp_aurora = true;
+bool s_retrace_driven = false;  // presents come from the retrace hook now
+int s_last_slot = -1;
+std::array<u64, 8> s_slot_frame{};  // the frame each kept slot holds (0: none)
+u32 s_overridden_arrays = 0;
+unsigned long long s_kept_real = 0, s_kept_interp = 0, s_shown_interp = 0, s_shown_real = 0;
+// Frame pacing (with the timing log): the interval between presents, percentiles every 600.
+std::array<double, 600> s_present_intervals{};
+unsigned s_present_interval_count = 0;
+Clock::time_point s_last_present{};
+// The replay draws' array copies stay put until the slice is drained (Aurora parses the FIFO
+// later): a bump arena of chunks, reset at each slice.
+std::vector<std::vector<u8>> s_arena;
+size_t s_arena_chunk = 0, s_arena_used = 0;
+constexpr size_t ArenaChunkBytes = 4u << 20;
+
+int RealSlot(u64 frame)
+{
+  return static_cast<int>(frame % 4) * 2;
+}
+int InterpSlot(u64 frame)
+{
+  return RealSlot(frame) + 1;
+}
+
+u8* ArenaAlloc(size_t bytes)
+{
+  if (s_arena.empty())
+    s_arena.emplace_back(ArenaChunkBytes);
+  if (s_arena_used + bytes > s_arena[s_arena_chunk].size())
+  {
+    ++s_arena_chunk;
+    s_arena_used = 0;
+    if (s_arena_chunk >= s_arena.size())
+      s_arena.emplace_back(std::max(ArenaChunkBytes, bytes));
+    else if (s_arena[s_arena_chunk].size() < bytes)
+      s_arena[s_arena_chunk].resize(bytes);
+  }
+  u8* p = s_arena[s_arena_chunk].data() + s_arena_used;
+  s_arena_used += bytes;
+  return p;
+}
+
+void PushBE16(std::vector<u8>& out, u16 value)
+{
+  out.push_back(static_cast<u8>(value >> 8));
+  out.push_back(static_cast<u8>(value));
+}
+void PushBE64(std::vector<u8>& out, u64 value)
+{
+  PushBE32(out, static_cast<u32>(value >> 32));
+  PushBE32(out, static_cast<u32>(value));
+}
+
+// Before a replayed draw: Aurora's GX_AURORA_LOAD_ARRAYBASE (0x50, sub-command 0x0010 + array:
+// u64 host address, u32 size, u8 little-endian flag) for each array the interpolator copied.
+// Aurora reads the array from its base, so the copy sits `lo` bytes into the buffer.
+void EmitReplayArrays()
+{
+  FrameInterpolator::ReplayArray arrays[16];
+  const u32 n = FrameInterpolator::ReplayArrays(arrays, 16);
+  static std::vector<u8> cmd;
+  for (u32 i = 0; i < n; ++i)
+  {
+    const auto& a = arrays[i];
+    if (a.attr >= 12 || a.data == nullptr)
+      continue;
+    const size_t bytes = static_cast<size_t>(a.lo) + a.size + 64;
+    u8* buf = ArenaAlloc(bytes);
+    std::memcpy(buf + a.lo, a.data, a.size);
+    cmd.clear();
+    cmd.push_back(0x50);
+    PushBE16(cmd, static_cast<u16>(0x0010 + a.attr));
+    PushBE64(cmd, static_cast<u64>(reinterpret_cast<uintptr_t>(buf)));
+    PushBE32(cmd, static_cast<u32>(bytes));
+    cmd.push_back(0);
+    aurora_backend_write_raw(cmd.data(), static_cast<u32>(cmd.size()));
+    s_overridden_arrays |= 1u << a.attr;
+  }
+}
+
+// After it: the guest bases of the recorded stream (CP register 0xA0 + array).
+void RestoreGuestArrays()
+{
+  if (s_overridden_arrays == 0)
+    return;
+  static std::vector<u8> cmd;
+  for (u32 attr = 0; attr < 12; ++attr)
+  {
+    if ((s_overridden_arrays & (1u << attr)) == 0)
+      continue;
+    cmd.clear();
+    cmd.push_back(0x08);
+    cmd.push_back(static_cast<u8>(0xA0 + attr));
+    PushBE32(cmd, g_main_cp_state.array_bases[static_cast<CPArray>(attr)]);
+    aurora_backend_write_raw(cmd.data(), static_cast<u32>(cmd.size()));
+  }
+  s_overridden_arrays = 0;
+}
+
+void OnSliceBegin(bool first, u64 frame)
+{
+  (void)frame;
+  s_arena_chunk = 0;
+  s_arena_used = 0;
+  s_overridden_arrays = 0;
+  aurora_backend_replay_context(1);
+  // VideoCommon holds the frame's start state now (every slice's state with _REFEED=1, a test)
+  static const bool refeed_always = EnvUnsigned("MODERNGEKKO_AURORA_INTERP_REFEED", 0) != 0;
+  if (first || refeed_always)
+    ReloadRegisterState();
+}
+
+void OnSliceEnd(bool finished, u64 frame)
+{
+  (void)finished;
+  (void)frame;
+  aurora_backend_replay_context(0);
+}
+
+void PresentPicture(int slot);
+
+void OnRetrace(u64 frame, int kind)
+{
+  int slot = kind == 2 ? RealSlot(frame - 1) : kind == 1 ? InterpSlot(frame) : RealSlot(frame);
+  const u64 want = kind == 2 ? frame - 1 : frame;
+  if (s_slot_frame[static_cast<size_t>(slot)] != want)
+  {
+    // Not kept (an in-between that never made it): the frame's real picture, else the last shown
+    slot = RealSlot(frame);
+    if (s_slot_frame[static_cast<size_t>(slot)] != frame)
+      slot = s_last_slot;
+  }
+  if (slot < 0)
+    return;
+  s_retrace_driven = true;
+  s_last_slot = slot;
+  if (slot % 2 == 1)
+    ++s_shown_interp;
+  else
+    ++s_shown_real;
+  PresentPicture(slot);
+}
+
+// Drain Aurora's FIFO whenever more than this many bytes are buffered (0: only at the frame end).
+// Mid-frame drains let Aurora's parse overlap the CPU thread in dual-core mode; the game waits for
+// draw-done at the frame end anyway, so a single burst there serializes with the next frame.
+u32 s_drain_bytes = 64 * 1024;
+unsigned s_drains = 0;
+// The host's native window Aurora draws into (Android: the app's ANativeWindow, which the
+// Surface callbacks replace while the game runs; null between surfaces).
+void* s_native_window = nullptr;
+
+void NativeWindowSize(void* window, unsigned* width, unsigned* height)
+{
+  *width = 0;
+  *height = 0;
+#ifdef ANDROID
+  if (window != nullptr)
+  {
+    auto* native = static_cast<ANativeWindow*>(window);
+    const int32_t w = ANativeWindow_getWidth(native);
+    const int32_t h = ANativeWindow_getHeight(native);
+    *width = w > 0 ? static_cast<unsigned>(w) : 0;
+    *height = h > 0 ? static_cast<unsigned>(h) : 0;
+  }
+#else
+  (void)window;
+#endif
+}
+
+void ApplyNativeWindow(void* window)
+{
+  unsigned width = 0;
+  unsigned height = 0;
+  NativeWindowSize(window, &width, &height);
+  s_native_window = window;
+  dol_aurora_set_native_window(window, width, height);
+  BackendLog("[aurora-backend] native window %p (%ux%u)\n", window, width, height);
+}
+
+// VideoCommon's presenter records surface changes (Android Surface callbacks) and leaves the
+// backend to pick them up on its own thread, as the Vulkan backend does each frame.
+void CheckForSurfaceChange()
+{
+  if (!g_presenter)
+    return;
+  if (g_presenter->SurfaceChangedTestAndClear())
+    ApplyNativeWindow(g_presenter->GetNewSurfaceHandle());
+  else if (g_presenter->SurfaceResizedTestAndClear() && s_native_window != nullptr)
+    ApplyNativeWindow(s_native_window);
+}
+
+void SaveFramePNG()
+{
+  const u8* rgba = nullptr;
+  u32 width = 0;
+  u32 height = 0;
+  bool got = false;
+  for (int attempt = 0; attempt < 20000; ++attempt)
+  {
+    if (aurora_take_framebuffer_readback(&rgba, &width, &height))
+    {
+      got = true;
+      break;
+    }
+    aurora_pump_framebuffer_readback();
+    std::this_thread::sleep_for(std::chrono::microseconds(250));
+  }
+  if (!got)
+  {
+    BackendLog("[aurora-backend] frame %llu: readback never completed\n", s_frames);
+    return;
+  }
+  const std::string path = fmt::format("{}/frame_{:06}.png", s_png_dir, s_frames);
+  if (!Common::SavePNG(path, rgba, Common::ImageByteFormat::RGBA, width, height, width * 4))
+    BackendLog("[aurora-backend] cannot write %s\n", path.c_str());
+}
+
+// Aurora draws at the window's size by default; Dolphin's internal resolution (iEFBScale: 1 =
+// native 640x480, N = N x, 0 = auto) applies through the VI's frame buffer scale, so both
+// backends draw the same pixels (the Vulkan comparison on the Retroid ran at 1x while Aurora
+// filled the 1280x960 surface: four times the pixels). MODERNGEKKO_AURORA_EFB_SCALE=N overrides.
+int s_applied_efb_scale = -1;
+void ApplyEfbScale()
+{
+  static const int env_scale = static_cast<int>(EnvUnsigned("MODERNGEKKO_AURORA_EFB_SCALE", 0));
+  const int scale = env_scale > 0 ? env_scale : g_ActiveConfig.iEFBScale;
+  if (scale == s_applied_efb_scale)
+    return;
+  s_applied_efb_scale = scale;
+  // The EFB stays 640x480 times the scale whatever the surface's shape (Dolphin's geometry; the
+  // picture is stretched at the present): a buffer widened to a 16:9 screen (853x480) put the
+  // EFB copies drawn back a third of a pixel off (the Pocket 5's red/cyan fringe).
+  static const bool no_fit = EnvUnsigned("MODERNGEKKO_AURORA_NO_ASPECT_FIT", 0) != 0;  // debug
+  aurora_backend_set_frame_buffer_aspect_fit(no_fit ? 0 : 1);
+  VISetFrameBufferScale(scale > 0 ? static_cast<float>(scale) : 0.f);
+  BackendLog("[aurora-backend] EFB scale %d (0 = window size)\n", scale);
+}
+
+// The picture's place on the surface: VideoCommon's presenter computes it from the aspect ratio
+// settings (the port's Picture option, Match screen included) once it knows the surface size,
+// which only Aurora does here (its own window on the desktop, the app's Surface on Android).
+unsigned s_surface_width = 0, s_surface_height = 0;
+
+void ApplyPresentRectangle()
+{
+  static const bool off = EnvUnsigned("MODERNGEKKO_AURORA_NO_PRESENT_RECT", 0) != 0;  // debug
+  unsigned width = 0, height = 0;
+  if (off || !g_presenter || !aurora_backend_surface_size(&width, &height))
+    return;
+  if (width != s_surface_width || height != s_surface_height)
+  {
+    s_surface_width = width;
+    s_surface_height = height;
+    g_presenter->SetBackbuffer(static_cast<int>(width), static_cast<int>(height));
+    BackendLog("[aurora-backend] surface %ux%u\n", width, height);
+  }
+  const MathUtil::Rectangle<int>& rect = g_presenter->GetTargetRectangle();
+  aurora_backend_set_present_rect(rect.left, rect.top, rect.GetWidth(), rect.GetHeight());
+}
+
+// Dolphin's on-screen UI (OSD messages, the port's in-game menu) is Dear ImGui drawn by the
+// presenter, which the Null gfx classes this backend runs on never show. With Null::g_presentable
+// the presenter builds the draw lists anyway, and OnScreenUI hands each frame's finished draw data
+// here (the ImGui lock held): it goes to Aurora's present pass as an overlay in display pixels
+// (the surface), the textures (the font atlas) uploaded when ImGui creates or updates them.
+std::unordered_map<ImTextureID, u32> s_overlay_texture_ids;
+
+void ImGuiDrawSink(ImDrawData* draw_data)
+{
+  if (draw_data == nullptr)
+    return;
+  if (draw_data->Textures != nullptr)
+  {
+    for (ImTextureData* tex : *draw_data->Textures)
+    {
+      if (tex->Status != ImTextureStatus_OK || tex->TexID == ImTextureID_Invalid || tex->Pixels == nullptr)
+        continue;
+      auto [it, inserted] = s_overlay_texture_ids.try_emplace(tex->TexID, static_cast<u32>(s_overlay_texture_ids.size() + 1));
+      // Updated this frame (the rects are cleared at the next NewFrame), or new here: the whole atlas
+      if (inserted || tex->Updates.Size > 0)
+        aurora_backend_set_overlay_texture(it->second, static_cast<u32>(tex->Width), static_cast<u32>(tex->Height),
+                                           static_cast<const uint8_t*>(tex->Pixels));
+    }
+  }
+  static std::vector<u8> vertices;
+  static std::vector<u16> indices;
+  static std::vector<AuroraOverlayCmd> cmds;
+  vertices.clear();
+  indices.clear();
+  cmds.clear();
+  static_assert(sizeof(ImDrawVert) == 20, "the overlay expects ImGui's default vertex layout");
+  static_assert(sizeof(ImDrawIdx) == 2, "the overlay expects 16-bit ImGui indices");
+  const ImVec2 pos = draw_data->DisplayPos;
+  for (int n = 0; n < draw_data->CmdListsCount; ++n)
+  {
+    const ImDrawList* list = draw_data->CmdLists[n];
+    const u32 base_vertex = static_cast<u32>(vertices.size() / sizeof(ImDrawVert));
+    const u32 base_index = static_cast<u32>(indices.size());
+    const auto* vb = reinterpret_cast<const u8*>(list->VtxBuffer.Data);
+    vertices.insert(vertices.end(), vb, vb + static_cast<size_t>(list->VtxBuffer.Size) * sizeof(ImDrawVert));
+    indices.insert(indices.end(), list->IdxBuffer.Data, list->IdxBuffer.Data + list->IdxBuffer.Size);
+    for (const ImDrawCmd& cmd : list->CmdBuffer)
+    {
+      if (cmd.UserCallback != nullptr || cmd.ElemCount == 0)
+        continue;
+      const auto tex_it = s_overlay_texture_ids.find(cmd.GetTexID());
+      if (tex_it == s_overlay_texture_ids.end())
+        continue;
+      cmds.push_back(AuroraOverlayCmd{
+          .clip = {cmd.ClipRect.x - pos.x, cmd.ClipRect.y - pos.y, cmd.ClipRect.z - pos.x, cmd.ClipRect.w - pos.y},
+          .texture = tex_it->second,
+          .index_offset = base_index + cmd.IdxOffset,
+          .index_count = cmd.ElemCount,
+          .vertex_offset = base_vertex + cmd.VtxOffset,
+      });
+    }
+  }
+  aurora_backend_set_overlay(vertices.data(), static_cast<u32>(vertices.size() / sizeof(ImDrawVert)), indices.data(),
+                             static_cast<u32>(indices.size()), cmds.data(), static_cast<u32>(cmds.size()),
+                             draw_data->DisplaySize.x, draw_data->DisplaySize.y);
+}
+
+// Presents kept slot `slot` (-1: the EFB) and opens the next frame.
+void PresentPicture(int slot)
+{
+  CheckForSurfaceChange();
+  ApplyEfbScale();
+  ApplyPresentRectangle();
+  // Clock reads only with the timing log.
+  const auto t0 = s_timing_log ? Clock::now() : Clock::time_point{};
+  const bool want_png = !s_png_dir.empty() && s_png_every != 0 && (s_frames % s_png_every) == 0;
+  if (want_png)
+    aurora_request_framebuffer_readback();
+  aurora_backend_present_kept(slot);
+  if (s_timing_log)
+  {
+    const auto now = Clock::now();
+    s_present_time += now - t0;
+    if (s_last_present.time_since_epoch().count() != 0)
+    {
+      s_present_intervals[s_present_interval_count++] =
+          std::chrono::duration<double, std::milli>(now - s_last_present).count();
+      if (s_present_interval_count == s_present_intervals.size())
+      {
+        std::array<double, 600> sorted = s_present_intervals;
+        std::sort(sorted.begin(), sorted.end());
+        unsigned over20 = 0, over25 = 0;
+        for (double v : sorted)
+        {
+          over20 += v > 20.0;
+          over25 += v > 25.0;
+        }
+        BackendLog("[aurora-backend] present interval ms over 600: p50 %.2f p90 %.2f p99 %.2f max %.2f; "
+                   ">20 ms %u, >25 ms %u\n",
+                   sorted[300], sorted[540], sorted[594], sorted[599], over20, over25);
+        s_present_interval_count = 0;
+      }
+    }
+    s_last_present = now;
+  }
+  if (want_png)
+    SaveFramePNG();
+  ++s_frames;
+  if (s_timing_log)
+  {
+    if (s_interval_frames != 0)
+      s_interval_time += Clock::now() - s_interval_start;
+    s_interval_start = Clock::now();
+    if (++s_interval_frames == 600)
+    {
+      const auto ms = [](Clock::duration d) {
+        return std::chrono::duration<double, std::milli>(d).count() / 600.0;
+      };
+      BackendLog("[aurora-backend] frame %llu: per frame %.2f ms (drains %.2f, present %.2f, "
+                 "feed+dolphin+cpu-wait %.2f), %.1f drains/frame; kept %llu real + %llu in-between, "
+                 "shown %llu real + %llu in-between\n",
+                 s_frames, ms(s_interval_time), ms(s_feed_time), ms(s_present_time),
+                 ms(s_interval_time - s_feed_time - s_present_time), s_drains / 600.0, s_kept_real,
+                 s_kept_interp, s_shown_real, s_shown_interp);
+      s_feed_time = s_present_time = s_interval_time = {};
+      s_drains = 0;
+      s_interval_frames = 0;
+    }
+  }
+  if (aurora_backend_should_quit() && !s_stop_requested)
+  {
+    s_stop_requested = true;
+    Host_Message(HostMessageID::WMUserStop);
+  }
+}
+
+// The game's XFB copy: with frame interpolation the real picture is kept for the retrace hook,
+// otherwise (and until the first retrace-driven present) the EFB is presented here.
+void OnFrameEnd()
+{
+  if (s_interp_aurora && FrameInterpolator::IsEnabled())
+  {
+    const u64 frame = FrameInterpolator::NextFrameId();
+    const int slot = RealSlot(frame);
+    if (aurora_backend_keep_picture(slot))
+    {
+      s_slot_frame[static_cast<size_t>(slot)] = frame;
+      ++s_kept_real;
+    }
+    if (!s_retrace_driven)
+      PresentPicture(-1);
+    return;
+  }
+  s_retrace_driven = false;
+  PresentPicture(-1);
+}
+
+void GPCommandSink(const u8* data, u32 size)
+{
+  // The Frame Interpolator's replay goes into Aurora's replay context (the slice hooks switch
+  // it); without MODERNGEKKO_AURORA_INTERP it is skipped as before.
+  const bool replaying = FrameInterpolator::IsReplaying();
+  if (replaying && !s_interp_aurora)
+    return;
+  const bool draw = data[0] >= 0x80;
+  if (replaying && draw)
+    EmitReplayArrays();
+  // 0x61 RR VV VV VV: BP register RR, 24-bit value; bit 14 of the value = copy to XFB. The
+  // picture is kept or presented before the command goes in: Aurora applies the copy's EFB clear.
+  const bool xfb_copy = size == 5 && data[0] == 0x61 && data[1] == 0x52 && (data[3] & 0x40) != 0;
+  if (s_timing_log && xfb_copy && !replaying && (s_frames % 600) == 0)
+    BackendLog("[aurora-backend] VideoCommon viewport at frame %llu: origin %g,%g size %gx%g, scissor "
+               "offset %u,%u\n",
+               s_frames, xfmem.viewport.xOrig, xfmem.viewport.yOrig, xfmem.viewport.wd,
+               xfmem.viewport.ht, bpmem.scissorOffset.x * 2, bpmem.scissorOffset.y * 2);
+  if (s_timing_log && size == 5 && data[0] == 0x61 && data[1] == 0x59)
+    BackendLog("[aurora-backend] game writes scissor offset %02x%02x%02x (replay %d)\n", data[2],
+               data[3], data[4], replaying ? 1 : 0);
+  if (xfb_copy)
+  {
+    if (replaying)
+    {
+      const u64 frame = FrameInterpolator::JobFrame();
+      const int slot = InterpSlot(frame);
+      if (aurora_backend_keep_picture(slot))
+      {
+        s_slot_frame[static_cast<size_t>(slot)] = frame;
+        ++s_kept_interp;
+      }
+    }
+    else
+    {
+      OnFrameEnd();
+    }
+  }
+  aurora_backend_write_raw(data, size);
+  if (s_drain_bytes != 0 && aurora_backend_fifo_over(s_drain_bytes))
+  {
+    // Only the drains are timed (the waits on the render worker): a clock read per GP command
+    // is a syscall on some Android kernels (the Pocket 5: 58% of the GPU thread, the game at
+    // 0.55x with the log on; the counter register is trapped there too).
+    const auto t0 = s_timing_log ? Clock::now() : Clock::time_point{};
+    aurora_backend_drain_if_over(s_drain_bytes);
+    ++s_drains;
+    if (s_timing_log)
+      s_feed_time += Clock::now() - t0;
+  }
+  if (replaying && draw)
+    RestoreGuestArrays();
+}
+
+bool ResolveGuestAddress(void*, u32 address, u32 size, DolGuestAddressSpace,
+                         DolGuestResourceKind, const void** data, u32* available)
+{
+  auto& memory = Core::System::GetInstance().GetMemory();
+  u8* ram = memory.GetRAM();
+  const u32 ram_size = memory.GetRamSizeReal();
+  const u32 physical = address & 0x1FFFFFFFu;
+  if (ram == nullptr || physical >= ram_size)
+  {
+    static int s_logged = 0;
+    if (s_logged < 8)
+    {
+      ++s_logged;
+      BackendLog("[aurora-backend] unresolved guest address %08x size %u (ram %p, %u bytes)\n",
+                   address, size, static_cast<void*>(ram), ram_size);
+    }
+    return false;
+  }
+  (void)size;
+  *data = ram + physical;
+  *available = ram_size - physical;
+  return true;
+}
+
+// FifoPlayer::ShouldLoadBP: registers whose replay would trigger side effects (draw-done /
+// token interrupts, EFB copy, TLUT DMA, TMEM preload, perf counters).
+bool ShouldLoadBP(u8 reg)
+{
+  switch (reg)
+  {
+  case 0x45:
+  case 0x47:
+  case 0x48:
+  case 0x52:
+  case 0x63:
+  case 0x65:
+  case 0x67:
+    return false;
+  default:
+    return true;
+  }
+}
+
+// FifoPlayer::ShouldLoadXF: skip the unknown/perf register ranges (relative to 0x1000).
+bool ShouldLoadXF(u8 reg)
+{
+  return !(reg == 0x07 || (reg >= 0x13 && reg <= 0x17) || (reg >= 0x27 && reg <= 0x3E) ||
+           (reg >= 0x48 && reg <= 0x4F));
+}
+
+void PushBE32(std::vector<u8>& out, u32 value)
+{
+  out.push_back(static_cast<u8>(value >> 24));
+  out.push_back(static_cast<u8>(value >> 16));
+  out.push_back(static_cast<u8>(value >> 8));
+  out.push_back(static_cast<u8>(value));
+}
+
+// Re-feed Dolphin's BP/CP/XF state to Aurora as the FIFO commands FifoPlayer::LoadRegisters
+// would issue (dff2dolt's preamble). Needed after a savestate load: VideoCommon restores its
+// registers from the state, but Aurora only ever sees the command stream.
+void ReloadRegisterState()
+{
+  std::vector<u8> fifo;
+  fifo.reserve(32 * 1024);
+
+  const u32* bp = reinterpret_cast<const u32*>(&bpmem);
+  for (u32 reg = 0; reg < FifoDataFile::BP_MEM_SIZE; ++reg)
+  {
+    if (!ShouldLoadBP(static_cast<u8>(reg)))
+      continue;
+    fifo.push_back(0x61);
+    PushBE32(fifo, (reg << 24) | (bp[reg] & 0x00FFFFFF));
+  }
+
+  u32 cp[FifoDataFile::CP_MEM_SIZE] = {};
+  g_main_cp_state.FillCPMemoryArray(cp);
+  auto load_cp = [&](u8 reg) {
+    fifo.push_back(0x08);
+    fifo.push_back(reg);
+    PushBE32(fifo, cp[reg]);
+  };
+  load_cp(0x30);
+  load_cp(0x40);
+  load_cp(0x50);
+  load_cp(0x60);
+  for (u8 i = 0; i < 8; ++i)
+  {
+    load_cp(0x70 + i);
+    load_cp(0x80 + i);
+    load_cp(0x90 + i);
+  }
+  for (u8 i = 0; i < 16; ++i)
+  {
+    load_cp(0xA0 + i);
+    load_cp(0xB0 + i);
+  }
+
+  const u32* xf_mem = reinterpret_cast<const u32*>(&xfmem);
+  const u32* xf_regs = xf_mem + FifoDataFile::XF_MEM_SIZE;
+  for (u32 addr = 0; addr < FifoDataFile::XF_MEM_SIZE; addr += 16)
+  {
+    fifo.push_back(0x10);
+    PushBE32(fifo, 0x000F0000u | addr);
+    for (u32 i = 0; i < 16; ++i)
+      PushBE32(fifo, xf_mem[addr + i]);
+  }
+  for (u32 reg = 0; reg < FifoDataFile::XF_REGS_SIZE; ++reg)
+  {
+    if (!ShouldLoadXF(static_cast<u8>(reg)))
+      continue;
+    fifo.push_back(0x10);
+    PushBE32(fifo, 0x1000u | reg);
+    PushBE32(fifo, xf_regs[reg]);
+  }
+
+  aurora_backend_call_display_list(fifo.data(), static_cast<u32>(fifo.size()));
+  BackendLog("[aurora-backend] register state reloaded (%zu bytes); scissor offset %06x, xf viewport "
+             "%08x %08x %08x %08x %08x %08x\n",
+             fifo.size(), bp[0x59] & 0xFFFFFF, xf_regs[0x1A], xf_regs[0x1B], xf_regs[0x1C],
+             xf_regs[0x1D], xf_regs[0x1E], xf_regs[0x1F]);
+}
+
+// aurora.env in the user folder: KEY=VALUE lines put into the environment before Aurora starts,
+// so the env-driven knobs (MODERNGEKKO_AURORA_*, the fork's AURORA_* debug toggles) work where
+// there is no shell to set them (Android). Lines starting with # are comments.
+void LoadEnvFile()
+{
+  const std::string path = File::GetUserPath(D_USER_IDX) + "aurora.env";
+  std::string text;
+  if (!File::ReadFileToString(path, text))
+    return;
+  size_t start = 0;
+  unsigned count = 0;
+  while (start < text.size())
+  {
+    size_t end = text.find('\n', start);
+    if (end == std::string::npos)
+      end = text.size();
+    std::string line = text.substr(start, end - start);
+    start = end + 1;
+    while (!line.empty() && (line.back() == '\r' || line.back() == ' '))
+      line.pop_back();
+    const size_t eq = line.find('=');
+    if (line.empty() || line[0] == '#' || eq == std::string::npos || eq == 0)
+      continue;
+#ifdef _WIN32
+    _putenv_s(line.substr(0, eq).c_str(), line.substr(eq + 1).c_str());
+#else
+    setenv(line.substr(0, eq).c_str(), line.substr(eq + 1).c_str(), 1);
+#endif
+    ++count;
+  }
+  BackendLog("[aurora-backend] %u variables from %s\n", count, path.c_str());
+  // AURORA_STDERR_FILE=<path>: the fork's stderr debug output (AURORA_DRAW_LOG) into a file,
+  // since Android has no stderr to read.
+  if (const char* file = std::getenv("AURORA_STDERR_FILE"))
+  {
+    if (std::freopen(file, "w", stderr) == nullptr)
+      BackendLog("[aurora-backend] cannot redirect stderr to %s\n", file);
+    else
+      std::setvbuf(stderr, nullptr, _IOLBF, 1 << 16);
+  }
+}
+
+unsigned EnvUnsigned(const char* name, unsigned fallback)
+{
+  const char* text = std::getenv(name);
+  if (text == nullptr || text[0] == '\0')
+    return fallback;
+  char* end = nullptr;
+  const unsigned long value = std::strtoul(text, &end, 10);
+  return end == text ? fallback : static_cast<unsigned>(value);
+}
