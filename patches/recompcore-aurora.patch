+// An overlay texture (RGBA8, the font atlas), replaced whole when it changes.
+void aurora_backend_set_overlay_texture(uint32_t id, uint32_t width, uint32_t height, const uint8_t* rgba) {
+    aurora::gfx::overlay::set_texture(id, width, height, rgba);
+}
+
+// Whether the next aurora_backend_drain_if_over(bytes) would drain (the host times only those).
+int aurora_backend_fifo_over(u32 bytes) {
+    return gx_aurora::g_initialized && gx_aurora::g_frame_open &&
+           aurora::gx::fifo::get_buffer_size() > bytes;
+}
+
+bool aurora_backend_drain_if_over(u32 bytes) {
+    if (!gx_aurora::g_initialized || !gx_aurora::g_frame_open)
+        return false;
+    if (aurora::gx::fifo::get_buffer_size() <= bytes)
+        return false;
+    aurora::gx::fifo::drain();
+    return true;
+}
