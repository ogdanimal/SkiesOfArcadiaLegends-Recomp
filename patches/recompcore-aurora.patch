diff --git a/GXRuntime/graphics/aurora/lib/gfx/overlay.cpp b/GXRuntime/graphics/aurora/lib/gfx/overlay.cpp
new file mode 100644
index 0000000000..304b677d7c
--- /dev/null
+++ b/GXRuntime/graphics/aurora/lib/gfx/overlay.cpp
@@ -0,0 +1,283 @@
+#include "overlay.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <mutex>
+#include <unordered_map>
+
+#include "../webgpu/gpu.hpp"
+
+namespace aurora::gfx::overlay {
+namespace {
+std::mutex g_mutex;
+Data g_pending;  // the host's latest lists
+std::vector<TextureUpload> g_pendingTextures;
+
+struct Texture {
+  wgpu::Texture texture;
+  wgpu::TextureView view;
+};
+std::unordered_map<uint32_t, Texture> g_textures;  // render worker only
+wgpu::RenderPipeline g_pipeline;
+wgpu::BindGroupLayout g_bindGroupLayout;
+wgpu::Sampler g_sampler;
+
+constexpr uint32_t VertexStride = 20;
+
+void ensure_pipeline() {
+  if (g_pipeline) {
+    return;
+  }
+  wgpu::ShaderSourceWGSL source{};
+  source.code = R"""(
+struct Transform {
+    scale: vec2<f32>,
+    offset: vec2<f32>,
+};
+@group(0) @binding(0) var overlay_sampler: sampler;
+@group(0) @binding(1) var overlay_texture: texture_2d<f32>;
+@group(0) @binding(2) var<uniform> transform: Transform;
+
+struct VertexOutput {
+    @builtin(position) pos: vec4<f32>,
+    @location(0) uv: vec2<f32>,
+    @location(1) color: vec4<f32>,
+};
+
+@vertex
+fn vs_main(@location(0) pos: vec2<f32>, @location(1) uv: vec2<f32>, @location(2) color: vec4<f32>) -> VertexOutput {
+    var out: VertexOutput;
+    out.pos = vec4<f32>(pos * transform.scale + transform.offset, 0.0, 1.0);
+    out.uv = uv;
+    out.color = color;
+    return out;
+}
+
+@fragment
+fn fs_main(in: VertexOutput) -> @location(0) vec4<f32> {
+    return in.color * textureSample(overlay_texture, overlay_sampler, in.uv);
+}
+)""";
+  const wgpu::ShaderModuleDescriptor moduleDescriptor{.nextInChain = &source, .label = "Overlay Module"};
+  auto module = webgpu::g_device.CreateShaderModule(&moduleDescriptor);
+  const std::array layoutEntries{
+      wgpu::BindGroupLayoutEntry{
+          .binding = 0,
+          .visibility = wgpu::ShaderStage::Fragment,
+          .sampler = wgpu::SamplerBindingLayout{.type = wgpu::SamplerBindingType::Filtering},
+      },
+      wgpu::BindGroupLayoutEntry{
+          .binding = 1,
+          .visibility = wgpu::ShaderStage::Fragment,
+          .texture =
+              wgpu::TextureBindingLayout{
+                  .sampleType = wgpu::TextureSampleType::Float,
+                  .viewDimension = wgpu::TextureViewDimension::e2D,
+              },
+      },
+      wgpu::BindGroupLayoutEntry{
+          .binding = 2,
+          .visibility = wgpu::ShaderStage::Vertex,
+          .buffer = wgpu::BufferBindingLayout{.type = wgpu::BufferBindingType::Uniform, .minBindingSize = 16},
+      },
+  };
+  const wgpu::BindGroupLayoutDescriptor layoutDescriptor{.entryCount = layoutEntries.size(),
+                                                         .entries = layoutEntries.data()};
+  g_bindGroupLayout = webgpu::g_device.CreateBindGroupLayout(&layoutDescriptor);
+  const wgpu::PipelineLayoutDescriptor pipelineLayoutDescriptor{.bindGroupLayoutCount = 1,
+                                                                .bindGroupLayouts = &g_bindGroupLayout};
+  auto pipelineLayout = webgpu::g_device.CreatePipelineLayout(&pipelineLayoutDescriptor);
+  const std::array attributes{
+      wgpu::VertexAttribute{.format = wgpu::VertexFormat::Float32x2, .offset = 0, .shaderLocation = 0},
+      wgpu::VertexAttribute{.format = wgpu::VertexFormat::Float32x2, .offset = 8, .shaderLocation = 1},
+      wgpu::VertexAttribute{.format = wgpu::VertexFormat::Unorm8x4, .offset = 16, .shaderLocation = 2},
+  };
+  const wgpu::VertexBufferLayout vertexLayout{
+      .stepMode = wgpu::VertexStepMode::Vertex,
+      .arrayStride = VertexStride,
+      .attributeCount = attributes.size(),
+      .attributes = attributes.data(),
+  };
+  const wgpu::BlendState blend{
+      .color = {.operation = wgpu::BlendOperation::Add,
+                .srcFactor = wgpu::BlendFactor::SrcAlpha,
+                .dstFactor = wgpu::BlendFactor::OneMinusSrcAlpha},
+      .alpha = {.operation = wgpu::BlendOperation::Add,
+                .srcFactor = wgpu::BlendFactor::One,
+                .dstFactor = wgpu::BlendFactor::OneMinusSrcAlpha},
+  };
+  const std::array colorTargets{wgpu::ColorTargetState{
+      .format = webgpu::g_graphicsConfig.surfaceConfiguration.format,
+      .blend = &blend,
+      .writeMask = wgpu::ColorWriteMask::All,
+  }};
+  const wgpu::FragmentState fragmentState{
+      .module = module,
+      .entryPoint = "fs_main",
+      .targetCount = colorTargets.size(),
+      .targets = colorTargets.data(),
+  };
+  const wgpu::RenderPipelineDescriptor pipelineDescriptor{
+      .label = "Overlay Pipeline",
+      .layout = pipelineLayout,
+      .vertex =
+          wgpu::VertexState{
+              .module = module,
+              .entryPoint = "vs_main",
+              .bufferCount = 1,
+              .buffers = &vertexLayout,
+          },
+      .primitive = wgpu::PrimitiveState{.topology = wgpu::PrimitiveTopology::TriangleList},
+      .multisample = wgpu::MultisampleState{.count = 1, .mask = UINT32_MAX},
+      .fragment = &fragmentState,
+  };
+  g_pipeline = webgpu::g_device.CreateRenderPipeline(&pipelineDescriptor);
+  const wgpu::SamplerDescriptor samplerDescriptor{
+      .label = "Overlay Sampler",
+      .addressModeU = wgpu::AddressMode::ClampToEdge,
+      .addressModeV = wgpu::AddressMode::ClampToEdge,
+      .magFilter = wgpu::FilterMode::Linear,
+      .minFilter = wgpu::FilterMode::Linear,
+  };
+  g_sampler = webgpu::g_device.CreateSampler(&samplerDescriptor);
+}
+
+void upload_texture(const TextureUpload& upload) {
+  auto& entry = g_textures[upload.id];
+  if (!entry.texture || entry.texture.GetWidth() != upload.width || entry.texture.GetHeight() != upload.height) {
+    const wgpu::TextureDescriptor descriptor{
+        .label = "Overlay Texture",
+        .usage = wgpu::TextureUsage::TextureBinding | wgpu::TextureUsage::CopyDst,
+        .dimension = wgpu::TextureDimension::e2D,
+        .size = {upload.width, upload.height, 1},
+        .format = wgpu::TextureFormat::RGBA8Unorm,
+        .mipLevelCount = 1,
+        .sampleCount = 1,
+    };
+    entry.texture = webgpu::g_device.CreateTexture(&descriptor);
+    entry.view = entry.texture.CreateView();
+  }
+  const wgpu::TexelCopyTextureInfo destination{.texture = entry.texture};
+  const wgpu::TexelCopyBufferLayout layout{.bytesPerRow = upload.width * 4, .rowsPerImage = upload.height};
+  const wgpu::Extent3D size{upload.width, upload.height, 1};
+  webgpu::g_queue.WriteTexture(&destination, upload.rgba.data(), upload.rgba.size(), &layout, &size);
+}
+}  // namespace
+
+void set(Data data) noexcept {
+  std::lock_guard lock{g_mutex};
+  g_pending = std::move(data);
+}
+
+void set_texture(uint32_t id, uint32_t width, uint32_t height, const uint8_t* rgba) noexcept {
+  std::lock_guard lock{g_mutex};
+  g_pendingTextures.push_back(TextureUpload{
+      .id = id,
+      .width = width,
+      .height = height,
+      .rgba = std::vector<uint8_t>(rgba, rgba + static_cast<size_t>(width) * height * 4),
+  });
+}
+
+Data take_for_frame() noexcept {
+  std::lock_guard lock{g_mutex};
+  Data data = g_pending;  // the lists stay until the host sets new ones (a frame without a set repeats)
+  data.textures = std::move(g_pendingTextures);
+  g_pendingTextures.clear();
+  return data;
+}
+
+void render(const wgpu::RenderPassEncoder& pass, const Data& data, uint32_t surfaceWidth,
+            uint32_t surfaceHeight) noexcept {
+  for (const auto& upload : data.textures) {
+    upload_texture(upload);
+  }
+  if (data.cmds.empty() || data.vertices.empty() || data.indices.empty() || data.displayWidth <= 0.f ||
+      data.displayHeight <= 0.f || surfaceWidth == 0 || surfaceHeight == 0) {
+    return;
+  }
+  ensure_pipeline();
+  if (!g_pipeline) {
+    return;
+  }
+  const wgpu::BufferDescriptor vertexDescriptor{
+      .label = "Overlay Vertices",
+      .usage = wgpu::BufferUsage::Vertex,
+      .size = (data.vertices.size() + 3) & ~size_t{3},
+      .mappedAtCreation = true,
+  };
+  auto vertexBuffer = webgpu::g_device.CreateBuffer(&vertexDescriptor);
+  std::memcpy(vertexBuffer.GetMappedRange(), data.vertices.data(), data.vertices.size());
+  vertexBuffer.Unmap();
+  const size_t indexBytes = data.indices.size() * sizeof(uint16_t);
+  const wgpu::BufferDescriptor indexDescriptor{
+      .label = "Overlay Indices",
+      .usage = wgpu::BufferUsage::Index,
+      .size = (indexBytes + 3) & ~size_t{3},
+      .mappedAtCreation = true,
+  };
+  auto indexBuffer = webgpu::g_device.CreateBuffer(&indexDescriptor);
+  std::memcpy(indexBuffer.GetMappedRange(), data.indices.data(), indexBytes);
+  indexBuffer.Unmap();
+  // Display pixels to clip space: the overlay's display is the surface.
+  const std::array<float, 4> transform{2.f / data.displayWidth, -2.f / data.displayHeight, -1.f, 1.f};
+  const wgpu::BufferDescriptor uniformDescriptor{
+      .label = "Overlay Transform",
+      .usage = wgpu::BufferUsage::Uniform,
+      .size = sizeof(transform),
+      .mappedAtCreation = true,
+  };
+  auto uniformBuffer = webgpu::g_device.CreateBuffer(&uniformDescriptor);
+  std::memcpy(uniformBuffer.GetMappedRange(), transform.data(), sizeof(transform));
+  uniformBuffer.Unmap();
+
+  pass.SetPipeline(g_pipeline);
+  pass.SetViewport(0.f, 0.f, static_cast<float>(surfaceWidth), static_cast<float>(surfaceHeight), 0.f, 1.f);
+  pass.SetVertexBuffer(0, vertexBuffer);
+  pass.SetIndexBuffer(indexBuffer, wgpu::IndexFormat::Uint16);
+  std::unordered_map<uint32_t, wgpu::BindGroup> bindGroups;
+  const float sx = static_cast<float>(surfaceWidth) / data.displayWidth;
+  const float sy = static_cast<float>(surfaceHeight) / data.displayHeight;
+  for (const auto& cmd : data.cmds) {
+    const auto texIt = g_textures.find(cmd.texture);
+    if (texIt == g_textures.end() || cmd.indexCount == 0) {
+      continue;
+    }
+    auto& bindGroup = bindGroups[cmd.texture];
+    if (!bindGroup) {
+      const std::array entries{
+          wgpu::BindGroupEntry{.binding = 0, .sampler = g_sampler},
+          wgpu::BindGroupEntry{.binding = 1, .textureView = texIt->second.view},
+          wgpu::BindGroupEntry{.binding = 2, .buffer = uniformBuffer, .size = sizeof(transform)},
+      };
+      const wgpu::BindGroupDescriptor descriptor{
+          .layout = g_bindGroupLayout, .entryCount = entries.size(), .entries = entries.data()};
+      bindGroup = webgpu::g_device.CreateBindGroup(&descriptor);
+    }
+    const auto clamp = [](float v, float lo, float hi) { return std::min(std::max(v, lo), hi); };
+    const float x1 = clamp(cmd.clip[0] * sx, 0.f, static_cast<float>(surfaceWidth));
+    const float y1 = clamp(cmd.clip[1] * sy, 0.f, static_cast<float>(surfaceHeight));
+    const float x2 = clamp(cmd.clip[2] * sx, 0.f, static_cast<float>(surfaceWidth));
+    const float y2 = clamp(cmd.clip[3] * sy, 0.f, static_cast<float>(surfaceHeight));
+    if (x2 <= x1 || y2 <= y1) {
+      continue;
+    }
+    pass.SetScissorRect(static_cast<uint32_t>(x1), static_cast<uint32_t>(y1),
+                        static_cast<uint32_t>(x2 - x1), static_cast<uint32_t>(y2 - y1));
+    pass.SetBindGroup(0, bindGroup, 0, nullptr);
+    pass.DrawIndexed(cmd.indexCount, 1, cmd.indexOffset, static_cast<int32_t>(cmd.vertexOffset), 0);
+  }
+  pass.SetScissorRect(0, 0, surfaceWidth, surfaceHeight);
+}
+
+void shutdown() noexcept {
+  std::lock_guard lock{g_mutex};
+  g_pending = {};
+  g_pendingTextures.clear();
+  g_textures.clear();
+  g_pipeline = {};
+  g_bindGroupLayout = {};
+  g_sampler = {};
+}
+}  // namespace aurora::gfx::overlay
