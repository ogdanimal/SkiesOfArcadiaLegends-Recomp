+struct BackendHooks
+{
+  // Before a slice is decoded: VideoCommon's registers hold the replay's state (the frame's start
+  // state for the first slice).
+  void (*slice_begin)(bool first, u64 frame) = nullptr;
+  // After a slice: the game's registers are back. `finished`: the frame's stream is complete (its
+  // XFB copy went through the sink).
+  void (*slice_end)(bool finished, u64 frame) = nullptr;
+  // A retrace shows: kind 0 the frame's real picture, 1 its in-between one, 2 the previous
+  // frame's real one.
+  void (*retrace)(u64 frame, int kind) = nullptr;
+};
