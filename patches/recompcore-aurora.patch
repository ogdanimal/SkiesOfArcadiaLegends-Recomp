+
+bool VideoBackend::Initialize(const WindowSystemInfo& wsi)
+{
+  // Runs on the thread that decodes the FIFO (the GPU thread in dual-core mode); Aurora's
+  // window is created, pumped and presented from that same thread.
+  LoadEnvFile();
+  // The on-screen UI (Dolphin's OSD, the port's in-game menu) through Aurora: the Null gfx reports
+  // itself presentable, the presenter then runs OnScreenUI, whose draw data ImGuiDrawSink forwards.
+  // The surface size is Aurora's; the presenter learns it through ApplyPresentRectangle later.
+  Null::g_presentable = EnvUnsigned("MODERNGEKKO_AURORA_OSD", 1) != 0;
+  Null::g_surface_info = SurfaceInfo{.width = 640, .height = 480, .scale = 1.0f,
+                                     .format = AbstractTextureFormat::RGBA8};
+  VideoCommon::g_imgui_draw_sink = Null::g_presentable ? ImGuiDrawSink : nullptr;
+  s_overlay_texture_ids.clear();
+  if (!InitializeShared(std::make_unique<Null::NullGfx>(), std::make_unique<Null::VertexManager>(),
+                        std::make_unique<Null::PerfQuery>(),
+                        std::make_unique<Null::NullBoundingBox>(),
+                        std::make_unique<Null::NullEFBInterface>(),
+                        std::make_unique<Null::TextureCache>()))
+  {
+    return false;
+  }
+
+  unsigned width = EnvUnsigned("MODERNGEKKO_AURORA_WIDTH", 1280);
+  unsigned height = EnvUnsigned("MODERNGEKKO_AURORA_HEIGHT", 960);
+  // Hosts without SDL (Android) pass their window; the fork's SDL build ignores it and opens
+  // its own.
+  void* native_window = nullptr;
+#ifdef ANDROID
+  native_window = wsi.render_surface;
+  NativeWindowSize(native_window, &width, &height);
+  if (native_window == nullptr || width == 0 || height == 0)
+  {
+    PanicAlertFmt("Aurora: no Android surface to draw into");
+    ShutdownShared();
+    return false;
+  }
+#endif
+  s_native_window = native_window;
+  // Aurora's shader and pipeline cache databases go with Dolphin's other caches
+  const std::string cache_dir = File::GetUserPath(D_CACHE_IDX) + "aurora/";
+  File::CreateFullPath(cache_dir);
+  const AuroraBackendConfig config = {
+      .app_name = "Skies of Arcadia (Aurora)",
+      .window_width = width,
+      .window_height = height,
+      .vsync = EnvUnsigned("MODERNGEKKO_AURORA_VSYNC", 0) != 0,
+      .allow_texture_dumps = false,
+      .info_logging = EnvUnsigned("MODERNGEKKO_AURORA_LOG", 0) != 0,
+      .graphics_logging = EnvUnsigned("MODERNGEKKO_AURORA_LOG", 0) != 0,
+      .force_untextured = false,
+      .native_window = native_window,
+      .native_window_width = width,
+      .native_window_height = height,
+      .native_window_scale = wsi.render_surface_scale,
+      .user_path = cache_dir.c_str(),
+      .cache_path = cache_dir.c_str(),
+  };
+  char arg0[] = "moderngekko-run";
+  char* argv[] = {arg0, nullptr};
+  if (!dol_aurora_initialize(1, argv, &config))
+  {
+    PanicAlertFmt("Aurora could not initialize its window or GPU device");
+    ShutdownShared();
+    return false;
+  }
+  aurora_backend_set_guest_address_resolver(ResolveGuestAddress, nullptr);
+  ApplyEfbScale();
+
+  // SDK baseline, as dolgx_replay does before feeding a trace: registers the game never
+  // touches must not stay zero (genMode with 0 TEV stages crashed shader generation).
+  static std::vector<u8> s_gx_fifo(64 * 1024);
+  GXInit(s_gx_fifo.data(), static_cast<u32>(s_gx_fifo.size()));
+  GXFlush();
+
+  s_frames = 0;
+  s_stop_requested = false;
+  if (const char* dir = std::getenv("MODERNGEKKO_AURORA_PNG_DIR"))
+    s_png_dir = dir;
+  s_png_every = EnvUnsigned("MODERNGEKKO_AURORA_PNG_EVERY", 60);
+  s_timing_log = EnvUnsigned("MODERNGEKKO_AURORA_LOG", 0) != 0;
+  s_drain_bytes = EnvUnsigned("MODERNGEKKO_AURORA_DRAIN_KB", 64) * 1024;
+  s_drains = 0;
+  s_feed_time = s_present_time = s_interval_time = {};
+  s_interval_frames = 0;
+
+  OpcodeDecoder::g_gp_state_sink = ReloadRegisterState;
+  OpcodeDecoder::g_gp_command_sink = GPCommandSink;
+  s_interp_aurora = EnvUnsigned("MODERNGEKKO_AURORA_INTERP", 1) != 0;
+  s_retrace_driven = false;
+  s_last_slot = -1;
+  s_slot_frame.fill(0);
+  s_overridden_arrays = 0;
+  if (s_interp_aurora)
+    FrameInterpolator::g_backend_hooks = {OnSliceBegin, OnSliceEnd, OnRetrace};
+  else
+    FrameInterpolator::g_backend_hooks = {};
+  // Aurora converts the vertices itself; VideoCommon's loaders only fed the Null vertex manager.
+  // MODERNGEKKO_AURORA_VERTEX_LOADERS=1 keeps them (A/B on the desktop).
+  OpcodeDecoder::g_skip_vertex_loading = EnvUnsigned("MODERNGEKKO_AURORA_VERTEX_LOADERS", 0) == 0;
+  BackendLog("[aurora-backend] window %ux%u, backend %d\n", width, height,
+               static_cast<int>(aurora_get_backend()));
+  return true;
+}
+
+void VideoBackend::Shutdown()
+{
+  VideoCommon::g_imgui_draw_sink = nullptr;
+  Null::g_presentable = false;
+  OpcodeDecoder::g_gp_command_sink = nullptr;
+  OpcodeDecoder::g_gp_state_sink = nullptr;
+  OpcodeDecoder::g_skip_vertex_loading = false;
+  FrameInterpolator::g_backend_hooks = {};
+  s_arena.clear();
+  dol_aurora_shutdown();
+  BackendLog("[aurora-backend] shutdown after %llu frames\n", s_frames);
+  ShutdownShared();
+}
+
+std::string VideoBackend::GetDisplayName() const
+{
+  return "Aurora";
+}
+
+void ApplyPendingSurfaceChange()
+{
+  if (OpcodeDecoder::g_gp_command_sink != GPCommandSink)
+    return;  // not this backend, or already shut down
+  CheckForSurfaceChange();
+}
