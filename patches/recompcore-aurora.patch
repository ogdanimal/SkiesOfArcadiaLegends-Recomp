+// Frame pacing, any backend: RECOMP_PRESENT_PACING=1 (or a file PresentPacing.on in the user
+// directory) logs the interval between presents as percentiles every 600 presents.
+static void LogPresentPacing()
+{
+  using Clock = std::chrono::steady_clock;
+  static const bool on = [] {
+    const char* env = std::getenv("RECOMP_PRESENT_PACING");
+    return (env && env[0] == '1') || File::Exists(File::GetUserPath(D_USER_IDX) + "PresentPacing.on");
+  }();
+  if (!on)
+    return;
+  static Clock::time_point last{};
+  static std::array<double, 600> intervals{};
+  static unsigned count = 0;
+  const auto now = Clock::now();
+  if (last.time_since_epoch().count() != 0)
+  {
+    intervals[count++] = std::chrono::duration<double, std::milli>(now - last).count();
+    if (count == intervals.size())
+    {
+      std::array<double, 600> sorted = intervals;
+      std::sort(sorted.begin(), sorted.end());
+      unsigned over20 = 0, over25 = 0;
+      for (double v : sorted)
+      {
+        over20 += v > 20.0;
+        over25 += v > 25.0;
+      }
+      const std::string line = fmt::format(
+          "[present-pacing] interval ms over 600: p50 {:.2f} p90 {:.2f} p99 {:.2f} max {:.2f}; >20 ms {}, >25 ms {}",
+          sorted[300], sorted[540], sorted[594], sorted[599], over20, over25);
+      std::fprintf(stderr, "%s\n", line.c_str());
+#ifdef ANDROID
+      __android_log_print(ANDROID_LOG_INFO, "present-pacing", "%s", line.c_str());
+#endif
+      count = 0;
+    }
+  }
+  last = now;
+}
+
