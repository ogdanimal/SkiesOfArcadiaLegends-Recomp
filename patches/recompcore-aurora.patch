+// Host video backend path (Dolphin's Aurora backend): raw command bytes, no SDK metadata, and an
+// optional mid-frame drain so Aurora's parsing overlaps the host's CPU thread instead of running
+// as one burst at the frame end.
+void aurora_backend_write_raw(const void* data, u32 size) {
+    if (!gx_aurora::g_initialized || data == nullptr || size == 0)
+        return;
+    aurora::gx::fifo::write_data(data, size);
+    gx_aurora::g_fifo_bytes += size;
+}
+
+// The context the host wants; applied at once with a frame open, else at the next begin_frame
+// (a switch dropped while no frame was open left the live frame drawing on the replay's EFB:
+// a black picture after a savestate reload, the shadow composite's red channel lost).
+static bool s_replay_wanted = false;
+
+static void apply_replay_context() {
+    if (!gx_aurora::g_initialized || !gx_aurora::g_frame_open)
+        return;
+    if (s_replay_wanted == aurora::gx::in_replay_context())
+        return;
+    aurora::gx::fifo::drain();
+    if (!aurora::webgpu::swap_spare_framebuffer())
+        return;
+    aurora::gx::swap_replay_context(s_replay_wanted);
+}
+
+void aurora_backend_replay_context(int enter) {
+    s_replay_wanted = enter != 0;
+    apply_replay_context();
+}
+
+static std::array<aurora::webgpu::TextureWithSampler, 8> s_kept_pictures;
+
+int aurora_backend_keep_picture(int slot) {
+    if (!gx_aurora::g_initialized || !gx_aurora::g_frame_open || slot < 0 ||
+        slot >= static_cast<int>(s_kept_pictures.size()))
+        return 0;
+    aurora::gx::fifo::drain();
+    const auto& src = aurora::webgpu::present_source();
+    if (!src.texture)
+        return 0;
+    auto& dst = s_kept_pictures[static_cast<size_t>(slot)];
+    if (!dst.texture || dst.size.width != src.size.width || dst.size.height != src.size.height ||
+        dst.format != src.format)
+        dst = aurora::webgpu::create_render_texture(src.size.width, src.size.height, false);
+    aurora::gfx::copy_present_source_to(dst);
+    return 1;
+}
+
+void aurora_backend_present_kept(int slot) {
+    if (!gx_aurora::g_initialized)
+        return;
+    if (slot >= 0 && slot < static_cast<int>(s_kept_pictures.size()) &&
+        s_kept_pictures[static_cast<size_t>(slot)].texture)
+        aurora::gfx::set_present_override(&s_kept_pictures[static_cast<size_t>(slot)]);
+    aurora_backend_present();
+    aurora::gfx::set_present_override(nullptr);
+}
+
+// The surface Aurora presents to, in pixels (0 when there is none yet).
+int aurora_backend_surface_size(unsigned* width, unsigned* height) {
+    *width = *height = 0;
+    if (!gx_aurora::g_initialized)
+        return 0;
+    *width = aurora::webgpu::g_graphicsConfig.surfaceConfiguration.width;
+    *height = aurora::webgpu::g_graphicsConfig.surfaceConfiguration.height;
+    return *width != 0 && *height != 0;
+}
+
+// Where the next presents put the picture, in surface pixels; width or height 0 goes back to
+// fitting the picture's own aspect (the host's letterbox: Dolphin's aspect ratio settings).
+void aurora_backend_set_present_rect(int left, int top, int width, int height) {
+    if (!gx_aurora::g_initialized || width <= 0 || height <= 0) {
+        aurora::gfx::set_present_rect(nullptr);
+        return;
+    }
+    const aurora::webgpu::Viewport rect{
+        .left = static_cast<float>(left),
+        .top = static_cast<float>(top),
+        .width = static_cast<float>(width),
+        .height = static_cast<float>(height),
+        .znear = 0.f,
+        .zfar = 1.f,
+    };
+    aurora::gfx::set_present_rect(&rect);
+}
+
+// The frame buffer keeps the GX base aspect (640x480 times the scale) whatever the window's
+// shape: an anamorphic game (Dolphin's widescreen) draws for 640 columns and its EFB copies drawn
+// back land on whole pixels only then (a 853x480 buffer on a 16:9 screen put the shadow composite
+// a third of a pixel off: a red/cyan fringe). Off (the default) widens the buffer to the window.
+void aurora_backend_set_frame_buffer_aspect_fit(int fit) {
+    aurora::window::set_frame_buffer_aspect_fit(fit != 0);
+}
+
+// The host's 2D overlay for the next presents (Dolphin's on-screen UI as Dear ImGui draw data),
+// in display pixels: vertices of 20 bytes (pos f32x2, uv f32x2, colour rgba8), 16-bit indices,
+// commands (clip x1 y1 x2 y2, texture id, index offset/count, vertex offset). An empty list clears it.
+void aurora_backend_set_overlay(const void* vertices, uint32_t vertex_count, const uint16_t* indices,
+                                uint32_t index_count, const AuroraOverlayCmd* cmds, uint32_t cmd_count,
+                                float display_width, float display_height) {
+    aurora::gfx::overlay::Data data;
+    const auto* bytes = static_cast<const uint8_t*>(vertices);
+    data.vertices.assign(bytes, bytes + static_cast<size_t>(vertex_count) * 20);
+    data.indices.assign(indices, indices + index_count);
+    data.cmds.reserve(cmd_count);
+    for (uint32_t i = 0; i < cmd_count; ++i) {
+        const AuroraOverlayCmd& c = cmds[i];
+        data.cmds.push_back(aurora::gfx::overlay::Cmd{
+            .clip = {c.clip[0], c.clip[1], c.clip[2], c.clip[3]},
+            .texture = c.texture,
+            .indexOffset = c.index_offset,
+            .indexCount = c.index_count,
+            .vertexOffset = c.vertex_offset,
+        });
+    }
+    data.displayWidth = display_width;
+    data.displayHeight = display_height;
+    aurora::gfx::overlay::set(std::move(data));
+}
+
+// ---- save states: the EFB copies ----------------------------------------------------------------
+namespace {
+// One copy in a snapshot, followed by its texels (width x height x bytes_per_texel, rows packed)
+struct SavedCopy {
+    uint32_t offset;  // from ram_base
+    uint32_t revision;
+    uint64_t ram_fingerprint;
+    uint32_t ram_bytes;
+    uint32_t logical_width;
+    uint32_t logical_height;
+    uint32_t copy_format;
+    uint32_t width;
+    uint32_t height;
+    uint32_t gx_format;  // the texture's (GX_TF_RGBA8 / GX_TF_RGB565 for a resolved copy)
+    uint32_t wgpu_format;
+    uint32_t bytes_per_texel;
+    uint32_t data_size;
+};
+constexpr uint32_t COPIES_MAGIC = 0x53504F43;  // "COPS"
+
+bool IsBgra(wgpu::TextureFormat f) {
+    return f == wgpu::TextureFormat::BGRA8Unorm || f == wgpu::TextureFormat::BGRA8UnormSrgb;
+}
+bool IsRgba(wgpu::TextureFormat f) {
+    return f == wgpu::TextureFormat::RGBA8Unorm || f == wgpu::TextureFormat::RGBA8UnormSrgb;
+}
+} // namespace
+
+uint32_t aurora_backend_copies_snapshot(const void* ram_base, uint32_t ram_size,
+                                        void (*write)(const void* data, uint32_t size, void* user),
+                                        void* user) {
+    using namespace aurora;
+    std::vector<uint8_t> blob(8, 0);
+    std::memcpy(blob.data(), &COPIES_MAGIC, 4);
+    uint32_t count = 0;
+    if (gx_aurora::g_initialized) {
+        // Everything handed to the worker is encoded and submitted; the reads below queue after it
+        gfx::render_worker::synchronize();
+        struct Pending {
+            SavedCopy header;
+            wgpu::Buffer buffer;
+            uint32_t bytes_per_row;
+            bool mapped = false;
+            bool failed = false;
+        };
+        std::vector<std::unique_ptr<Pending>> pending;
+        const auto* base = static_cast<const uint8_t*>(ram_base);
+        wgpu::CommandEncoder encoder = webgpu::g_device.CreateCommandEncoder();
+        for (const auto& [dest, ref] : gx::g_gxState.copyTextures) {
+            const auto* at = static_cast<const uint8_t*>(dest);
+            if (!ref.handle || at < base || at >= base + ram_size)
+                continue;
+            const gfx::TextureRef& tex = *ref.handle;
+            const auto info = gfx::format_info(tex.format);
+            if (info.compressed || info.blockWidth != 1 || info.blockHeight != 1 || tex.mipCount != 1)
+                continue;
+            auto p = std::make_unique<Pending>();
+            p->header = SavedCopy{
+                .offset = static_cast<uint32_t>(at - base),
+                .revision = ref.revision,
+                .ram_fingerprint = ref.ramFingerprint,
+                .ram_bytes = ref.ramBytes,
+                .logical_width = ref.logicalWidth,
+                .logical_height = ref.logicalHeight,
+                .copy_format = ref.copyFormat,
+                .width = tex.size.width,
+                .height = tex.size.height,
+                .gx_format = tex.gxFormat,
+                .wgpu_format = static_cast<uint32_t>(tex.format),
+                .bytes_per_texel = info.blockSize,
+                .data_size = tex.size.width * tex.size.height * info.blockSize,
+            };
+            p->bytes_per_row = (tex.size.width * info.blockSize + 255u) & ~255u;
+            const wgpu::BufferDescriptor desc{
+                .label = "EFB copy snapshot",
+                .usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst,
+                .size = static_cast<uint64_t>(p->bytes_per_row) * tex.size.height,
+            };
+            p->buffer = webgpu::g_device.CreateBuffer(&desc);
+            const wgpu::TexelCopyTextureInfo src{.texture = tex.texture};
+            const wgpu::TexelCopyBufferInfo dst{
+                .layout = {.offset = 0, .bytesPerRow = p->bytes_per_row, .rowsPerImage = tex.size.height},
+                .buffer = p->buffer,
+            };
+            const wgpu::Extent3D extent{.width = tex.size.width, .height = tex.size.height, .depthOrArrayLayers = 1};
+            encoder.CopyTextureToBuffer(&src, &dst, &extent);
+            pending.push_back(std::move(p));
+        }
+        if (!pending.empty()) {
+            const wgpu::CommandBuffer commands = encoder.Finish();
+            webgpu::g_queue.Submit(1, &commands);
+            for (auto& p : pending) {
+                Pending* raw = p.get();
+                raw->buffer.MapAsync(wgpu::MapMode::Read, 0, raw->buffer.GetSize(), wgpu::CallbackMode::AllowProcessEvents,
+                                     [raw](wgpu::MapAsyncStatus status, wgpu::StringView) {
+                                         raw->mapped = status == wgpu::MapAsyncStatus::Success;
+                                         raw->failed = !raw->mapped;
+                                     });
+            }
+            const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+            for (;;) {
+                webgpu::g_instance.ProcessEvents();
+                bool done = true;
+                for (const auto& p : pending)
+                    done = done && (p->mapped || p->failed);
+                if (done || std::chrono::steady_clock::now() > deadline)
+                    break;
+                std::this_thread::sleep_for(std::chrono::microseconds(200));
+            }
+            for (auto& p : pending) {
+                if (!p->mapped)
+                    continue;
+                const auto* mapped = static_cast<const uint8_t*>(p->buffer.GetConstMappedRange(0, p->buffer.GetSize()));
+                if (mapped != nullptr) {
+                    const size_t at = blob.size();
+                    blob.resize(at + sizeof(SavedCopy) + p->header.data_size);
+                    std::memcpy(blob.data() + at, &p->header, sizeof(SavedCopy));
+                    const uint32_t row = p->header.width * p->header.bytes_per_texel;
+                    for (uint32_t y = 0; y < p->header.height; ++y)
+                        std::memcpy(blob.data() + at + sizeof(SavedCopy) + static_cast<size_t>(y) * row,
+                                    mapped + static_cast<size_t>(y) * p->bytes_per_row, row);
+                    ++count;
+                }
+                p->buffer.Unmap();
+            }
+        }
+    }
+    std::memcpy(blob.data() + 4, &count, 4);
+    write(blob.data(), static_cast<uint32_t>(blob.size()), user);
+    return count;
+}
+
+int aurora_backend_copies_restore(const void* ram_base, uint32_t ram_size, const void* data, uint32_t size) {
+    using namespace aurora;
+    const auto* bytes = static_cast<const uint8_t*>(data);
+    uint32_t magic = 0, count = 0;
+    if (size < 8)
+        return -1;
+    std::memcpy(&magic, bytes, 4);
+    std::memcpy(&count, bytes + 4, 4);
+    if (magic != COPIES_MAGIC)
+        return -1;
+    if (!gx_aurora::g_initialized)
+        return 0;
+    if (gx_aurora::g_frame_open)
+        gx::fifo::drain();
+    gfx::render_worker::synchronize();
+    gx::clear_copy_texture_cache();
+    // A slot's bind is kept while its texture object is unchanged: one from before the restore
+    // could still hold a copy that is gone
+    for (auto& bind : gx::g_gxState.textures)
+        bind = gfx::TextureBind{};
+    const auto* base = static_cast<const uint8_t*>(ram_base);
+    const wgpu::TextureFormat surface = webgpu::g_graphicsConfig.surfaceConfiguration.format;
+    size_t at = 8;
+    int restored = 0;
+    for (uint32_t i = 0; i < count; ++i) {
+        SavedCopy h;
+        if (at + sizeof(SavedCopy) > size)
+            return -1;
+        std::memcpy(&h, bytes + at, sizeof(SavedCopy));
+        at += sizeof(SavedCopy);
+        if (h.data_size > size - at || h.data_size != h.width * h.height * h.bytes_per_texel)
+            return -1;
+        const uint8_t* texels = bytes + at;
+        at += h.data_size;
+        if (h.offset >= ram_size || h.width == 0 || h.height == 0)
+            continue;
+        // As copy_tex makes them: a converted copy in its format's own texture, a resolved one in
+        // the surface's format (BGRA or RGBA, which may differ from where the state was saved)
+        const bool conv = gfx::tex_copy_conv::needs_conversion(static_cast<GXTexFmt>(h.copy_format));
+        gfx::TextureHandle handle = conv ? gfx::new_conv_texture(h.width, h.height, h.gx_format, "Copy Conv Texture")
+                                         : gfx::new_render_texture(h.width, h.height, h.gx_format, "Resolved Texture");
+        const auto saved = static_cast<wgpu::TextureFormat>(h.wgpu_format);
+        std::vector<uint8_t> swapped;
+        if (handle->format != saved) {
+            if (h.bytes_per_texel == 4 && ((IsBgra(saved) && IsRgba(handle->format)) || (IsRgba(saved) && IsBgra(handle->format)))) {
+                swapped.assign(texels, texels + h.data_size);
+                for (size_t k = 0; k + 3 < swapped.size(); k += 4)
+                    std::swap(swapped[k], swapped[k + 2]);
+                texels = swapped.data();
+            } else {
+                continue;
+            }
+        }
+        const wgpu::TexelCopyTextureInfo dst{.texture = handle->texture};
+        const wgpu::TexelCopyBufferLayout layout{.bytesPerRow = h.width * h.bytes_per_texel, .rowsPerImage = h.height};
+        const wgpu::Extent3D extent{.width = h.width, .height = h.height, .depthOrArrayLayers = 1};
+        webgpu::g_queue.WriteTexture(&dst, texels, h.data_size, &layout, &extent);
+        const void* dest = base + h.offset;
+        const gx::GXState::CopyTextureRef ref{
+            .handle = handle,
+            .revision = h.revision,
+            .ramFingerprint = h.ram_fingerprint,
+            .ramBytes = h.ram_bytes,
+            .logicalWidth = h.logical_width,
+            .logicalHeight = h.logical_height,
+            .copyFormat = h.copy_format,
+        };
+        const gx::GXState::CopyTextureKey key{
+            .dest = dest,
+            .width = h.width,
+            .height = h.height,
+            .format = static_cast<GXTexFmt>(h.copy_format),
+        };
+        gx::g_gxState.copyTextureCache[key] = ref;
+        gx::g_gxState.copyTextures[dest] = ref;
+        ++restored;
+    }
+    return restored;
+}
