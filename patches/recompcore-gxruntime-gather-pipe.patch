     PPC_CACHE_DCBST,
@@ -169,6 +170,14 @@ struct CPUState {
     PPCSPRRead spr_read;
     PPCSPRWrite spr_write;
     PPCCacheControl cache_control;
+
+    /* Write-gather pipe (stores to effective page 0xCC008000, the GX FIFO). When the host sets
+       gather_pipe_ptr_ref, generated stores to that page append big-endian bytes at
+       *gather_pipe_ptr_ref and call gather_pipe_flush once 32 or more bytes are queued past
+       gather_pipe_base. NULL keeps them on external_write. */
+    u8** gather_pipe_ptr_ref;
+    u8* gather_pipe_base;
+    PPCGatherPipeFlush gather_pipe_flush;
 };
 
 #include <stdio.h>
@@ -206,6 +215,25 @@ static GXRUNTIME_ALWAYS_INLINE void clear_matching_reservation(CPUState* cpu, u3
         cpu->reserve_valid = false;
 }
 
+/* A store to the write-gather pipe page, queued in the host's buffer when it publishes one (see
+ * CPUState::gather_pipe_ptr_ref). Returns false to leave the store to external_write. */
+static GXRUNTIME_ALWAYS_INLINE bool gather_pipe_write(CPUState* cpu, u32 addr, u64 value, u32 size) {
+    if ((addr & 0xFFFFF000u) != 0xCC008000u || !cpu->gather_pipe_ptr_ref)
+        return false;
+    u8* cursor = *cpu->gather_pipe_ptr_ref;
+    switch (size) {
+    case 8: write_be64(cursor, value); break;
+    case 4: write_be32(cursor, (u32)value); break;
+    case 2: write_be16(cursor, (u16)value); break;
+    default: *cursor = (u8)value; break;
+    }
+    cursor += size;
+    *cpu->gather_pipe_ptr_ref = cursor;
+    if ((size_t)(cursor - cpu->gather_pipe_base) >= 32u)
+        cpu->gather_pipe_flush(cpu);
+    return true;
+}
