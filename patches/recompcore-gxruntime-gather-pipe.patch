     u32 offset;
     u8* ptr = get_ram_ptr(cpu, addr, 2, &offset);
     if (ptr == NULL) {
+        if (gather_pipe_write(cpu, addr, value, 2))
+            return;
         if (cpu->external_write) {
             cpu->external_write(cpu, addr, value, 2);
         }
@@ -292,6 +326,8 @@ static GXRUNTIME_ALWAYS_INLINE void mem_write8(CPUState* cpu, u32 addr, u8 value
     u32 offset;
     u8* ptr = get_ram_ptr(cpu, addr, 1, &offset);
     if (ptr == NULL) {
