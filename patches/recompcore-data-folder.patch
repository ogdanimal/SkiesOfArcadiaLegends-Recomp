index 0000000000..aafc9be731
--- /dev/null
+++ b/Source/Android/app/src/main/java/org/dolphinemu/dolphinemu/skies/SkiesDataFolder.kt
@@ -0,0 +1,134 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+package org.dolphinemu.dolphinemu.skies
+
+import android.app.Activity
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import android.os.Build
+import android.os.Environment
+import android.os.storage.StorageManager
+import android.provider.DocumentsContract
+import android.provider.Settings
+import java.io.File
+import kotlin.system.exitProcess
+
+/**
+ * Settings, Disc, Data folder: where the imported game, saves and settings are, as on desktop
+ * (ModernGekko tools/user_directory.hpp). They start in app storage (getExternalFilesDir), which
+ * uninstalling deletes; a move puts them in a folder of the player's choice and leaves
+ * data-folder.txt in app storage naming it (one UTF-8 line, the desktop format). Dolphin's own code
+ * needs real file paths there, so a folder outside app storage needs All files access, which
+ * Android 11 brought (Android 10's scoped storage allows no such paths to the branded app, which
+ * also drops the old storage permission: src/skies/AndroidManifest.xml).
+ */
+object SkiesDataFolder {
+    const val POINTER = "data-folder.txt"
+    const val FOLDER_NAME = "Skies of Arcadia Legends"
+
+    /** A place the data can go: its label in the list and the data folder there. */
+    class Place(val label: String, val folder: File)
+
+    /** The folder the data was moved to, or null while it is in app storage. */
+    fun moved(appStorage: File?): File? {
+        appStorage ?: return null
+        val line = try {
+            File(appStorage, POINTER).takeIf { it.isFile }?.bufferedReader()?.use { it.readLine() }
+        } catch (e: Exception) {
+            null
+        }?.removePrefix("﻿")?.trimEnd('\r')
+        return line?.takeIf { it.startsWith("/") }?.let { File(it) }
+    }
+
+    /** The moved folder when it can be used now (the access granted, the card in), else null. */
+    fun usable(appStorage: File?): File? =
+        moved(appStorage)?.takeIf { hasAccess() && it.isDirectory }
+
+    /**
+     * Dolphin's user directory at start: the moved folder, app storage when there's none, or, for
+     * one that can't be reached, a throwaway folder in the cache while the launcher asks.
+     */
+    fun userDirectory(context: Context, appStorage: File?): File? {
+        moved(appStorage) ?: return appStorage
+        return usable(appStorage) ?: File(context.cacheDir, "data-folder-unreachable").apply { mkdirs() }
+    }
+
+    /** Whether the data can leave app storage on this Android (11 and later). */
+    val supported get() = Build.VERSION.SDK_INT >= Build.VERSION_CODES.R
+
+    fun hasAccess(): Boolean = supported && Environment.isExternalStorageManager()
+
+    /** Opens Android's All files access screen for this app; the player comes back to onResume. */
+    fun requestAccess(activity: Activity) {
+        if (!supported) return
+        val app = Intent(Settings.ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION,
+            Uri.parse("package:" + activity.packageName))
+        try {
+            activity.startActivity(app)
+        } catch (e: Exception) {
+            // Some devices only have the list of all apps
+            activity.startActivity(Intent(Settings.ACTION_MANAGE_ALL_FILES_ACCESS_PERMISSION))
+        }
+    }
+
+    /** Internal storage and each SD card or USB drive, with a data folder at its top. */
+    fun places(context: Context): List<Place> {
+        val places = mutableListOf<Place>()
+        if (!supported) return places
+        val storage = context.getSystemService(StorageManager::class.java) ?: return places
+        for (volume in storage.storageVolumes) {
+            val root = volume.directory ?: continue
+            if (volume.state != Environment.MEDIA_MOUNTED) continue
+            val label = if (volume.isPrimary) "Internal storage" else volume.getDescription(context)
+            places.add(Place(label, File(root, FOLDER_NAME)))
+        }
+        return places
+    }
+
+    /**
+     * The folder a tree picked with ACTION_OPEN_DOCUMENT_TREE is (external storage documents only:
+     * "primary:Games" is internal storage's Games, "1234-ABCD:Games" that card's), or null.
+     */
+    fun treeFolder(uri: Uri): File? {
+        if (uri.authority != "com.android.externalstorage.documents") return null
+        val id = try {
+            DocumentsContract.getTreeDocumentId(uri)
+        } catch (e: Exception) {
+            return null
+        }
+        val volume = id.substringBefore(':')
+        val path = id.substringAfter(':', "")
+        val root = if (volume == "primary") Environment.getExternalStorageDirectory()
+        else File("/storage/$volume")
+        return if (path.isEmpty()) root else File(root, path)
+    }
+
+    /**
+     * Keeps the gallery out of a data folder in shared storage (screenshots, HD texture packs'
+     * PNGs): an empty .nomedia file. App storage isn't scanned; the file is harmless there too.
+     */
+    fun hideFromGallery(folder: File) {
+        try {
+            File(folder, ".nomedia").createNewFile()
+        } catch (e: Exception) {
+            // Only cosmetic
+        }
+    }
+
+    /** The data folder for one the player picked: [FOLDER_NAME] inside it, or itself if so named. */
+    fun inside(picked: File): File =
+        if (picked.name == FOLDER_NAME) picked else File(picked, FOLDER_NAME)
+
+    /**
+     * Starts the app again (a new process, so Dolphin takes the new user directory from the start),
+     * on the launcher.
+     */
+    fun restart(activity: Activity) {
+        val launcher = activity.packageManager.getLaunchIntentForPackage(activity.packageName)
+            ?.component
+        if (launcher != null) activity.startActivity(Intent.makeRestartActivityTask(launcher))
+        activity.finishAffinity()
+        exitProcess(0)
+    }
+}
