+
+// "" if the data in `from` can move to `to`, else why not
+JNIEXPORT jstring JNICALL Java_org_dolphinemu_dolphinemu_skies_SkiesNative_checkDataMove(
+    JNIEnv* env, jclass, jstring from, jstring to)
+{
+  return ToJString(env, moderngekko::frontend::CheckUserDirectoryMove(
+                            StringToPath(GetJString(env, from)), StringToPath(GetJString(env, to))));
+}
+
+JNIEXPORT jboolean JNICALL Java_org_dolphinemu_dolphinemu_skies_SkiesNative_holdsUserData(
+    JNIEnv* env, jclass, jstring directory)
+{
+  return moderngekko::frontend::HoldsUserData(StringToPath(GetJString(env, directory))) ? JNI_TRUE :
+                                                                                         JNI_FALSE;
+}
+
+// Uses `to` from the next start without moving anything. "" or what went wrong.
+JNIEXPORT jstring JNICALL Java_org_dolphinemu_dolphinemu_skies_SkiesNative_pointDataFolder(
+    JNIEnv* env, jclass, jstring to, jstring app_storage)
+{
+  std::string error;
+  moderngekko::frontend::PointUserDirectory(StringToPath(GetJString(env, to)),
+                                            StringToPath(GetJString(env, app_storage)), &error);
+  return ToJString(env, error);
+}
+
+// Blocks until it's done: {message, "ok"} on success (the message a warning or ""), {why, ""} if
+// nothing moved
+JNIEXPORT jobjectArray JNICALL Java_org_dolphinemu_dolphinemu_skies_SkiesNative_moveDataFolder(
+    JNIEnv* env, jclass, jstring from, jstring to, jstring app_storage)
+{
+  if (s_data_moving.exchange(true))
+  {
+    const std::string busy[] = {"The data folder is already being moved.", ""};
+    return SpanToJStringArray(env, std::span<const std::string>(busy));
+  }
+  s_data_move.cancel = false;
+  const moderngekko::frontend::UserDirectoryMoveResult result =
+      moderngekko::frontend::MoveUserDirectory(StringToPath(GetJString(env, from)),
+                                               StringToPath(GetJString(env, to)),
+                                               StringToPath(GetJString(env, app_storage)),
+                                               &s_data_move);
+  s_data_moving = false;
+  const std::string answer[] = {result.ok ? result.warning : result.error, result.ok ? "ok" : ""};
+  return SpanToJStringArray(env, std::span<const std::string>(answer));
+}
+
+// {bytes done, bytes in all} of the move running now (or the last one)
+JNIEXPORT jlongArray JNICALL Java_org_dolphinemu_dolphinemu_skies_SkiesNative_dataMoveProgress(
+    JNIEnv* env, jclass)
+{
+  const jlong values[2] = {static_cast<jlong>(s_data_move.done_bytes.load()),
+                           static_cast<jlong>(s_data_move.total_bytes.load())};
+  jlongArray array = env->NewLongArray(2);
+  env->SetLongArrayRegion(array, 0, 2, values);
+  return array;
+}
+
+JNIEXPORT void JNICALL Java_org_dolphinemu_dolphinemu_skies_SkiesNative_cancelDataMove(JNIEnv*,
+                                                                                       jclass)
+{
+  s_data_move.cancel = true;
+}
