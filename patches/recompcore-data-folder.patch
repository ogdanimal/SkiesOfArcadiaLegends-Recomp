+    private fun startDataMove(from: String, to: String, appStorage: String) {
+        if (dataMoveRunning) {
+            showMoving()
+            return
+        }
+        dataMoveRunning = true
+        dataMoveResult = null
+        // Only values go to the thread, never this Activity (as the imports)
+        Thread({
+            var result = arrayOf("The move stopped.", "")
+            try {
+                result = SkiesNative.moveDataFolder(from, to, appStorage)
+                if (result.getOrNull(1) == "ok") SkiesDataFolder.hideFromGallery(File(to))
+            } finally {
+                dataMoveResult = result
+                dataMoveRunning = false
+            }
+        }, "SkiesDataMove").start()
+        showMoving()
+    }
