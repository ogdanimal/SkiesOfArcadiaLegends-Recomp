+    // While the data moves: how far, with Cancel; then the app starts again, or says why not
+    private val movePoll = object : Runnable {
+        override fun run() {
+            if (dataMoveRunning) {
+                val (done, total) = SkiesNative.dataMoveProgress().let { it[0] to it[1] }
+                val mib = 1024L * 1024L
+                message.text = "Moving the data folder…" +
+                    if (total > 1) "\n${done / mib} / ${total / mib} MB" else ""
+                handler.postDelayed(this, 250)
+                return
+            }
+            val result = dataMoveResult ?: return
+            dataMoveResult = null
+            if (result.getOrNull(1) != "ok") {
+                refresh()
+                message.text = result[0]
+            } else if (result[0].isNotEmpty()) {
+                padDialog(android.app.AlertDialog.Builder(this@SkiesLauncherActivity)
+                    .setTitle("Data folder moved")
+                    .setMessage(result[0])
+                    .setCancelable(false)
+                    .setPositiveButton("OK") { _, _ -> SkiesDataFolder.restart(this@SkiesLauncherActivity) })
+            } else {
+                SkiesDataFolder.restart(this@SkiesLauncherActivity)
+            }
+        }
+    }
+
+    private fun showMoving() {
+        settings?.close()
+        buttons.removeAllViews()
+        if (dataMoveRunning) addButton("Cancel") { SkiesNative.cancelDataMove() }
+        message.text = "Moving the data folder…"
+        handler.removeCallbacks(movePoll)
+        handler.post(movePoll)
+    }
+
     private fun showImporting() {
