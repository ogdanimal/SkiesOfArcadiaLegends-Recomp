@@ -266,6 +266,26 @@ bool make_retail_key(const GXTexObj_& obj, const GXTlutObj_* tlut, RetailTexture
 
 // A replay's key from an earlier frame's hashes that missed the cache: hashed from RAM as it is now,
 // the texels the texture is about to be made from
+// Local (fork): Skies of Arcadia's turret drop shadows (td16b011, td16b024: 128x128 C4, an all-black
+// palette with an alpha ramp, drawn blended with Z update on) sit in their model's node order
+// before wall geometry; their soft edge then writes depth and hides the wall drawn later (a hole).
+// The Dreamcast original sorts translucent polygons after the opaque ones; these draws are
+// recorded at the end of their pass instead. Keyed by the texel data (not the palette, which the
+// host's hard-edge fix changes, nor an HD pack's replacement).
+bool is_sorted_decal(const GXTexObj_& obj, const RetailTextureKey& key) noexcept {
+  static const bool off = [] { const char* e = std::getenv("AURORA_DECAL_SORT"); return e != nullptr && e[0] == '0'; }();
+  static const bool log = std::getenv("AURORA_DECAL_LOG") != nullptr;
+  if (key.texHash == 0 || obj.width() != 128 || obj.height() != 128 || obj.format() != GX_TF_C4) {
+    return false;
+  }
+  if (log) {
+    std::fprintf(stderr, "[decal] C4 128x128 texHash=%016llx tlutHash=%016llx\n",
+                 static_cast<unsigned long long>(key.texHash), static_cast<unsigned long long>(key.tlutHash));
+  }
+  // td16b011 and td16b024 (the disc's bytes, the same on the USA, European and Japanese discs)
+  return !off && (key.texHash == 0x314df8f182fd5493ull || key.texHash == 0x4cbc6e18ddf8c0daull);
+}
