+
+#include "Core/SkiesInput.h"
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <string_view>
+#include <vector>
+
+#include <fmt/format.h>
+
+#include "Common/CommonPaths.h"
+#include "Common/FileUtil.h"
+#include "Common/IniFile.h"
+#include "Common/Logging/Log.h"
+#include "Core/Config/ConfigManager.h"
+#include "Core/HW/GCPad.h"
+#include "Core/HW/GCPadEmu.h"
+#include "InputCommon/ControlReference/ControlReference.h"
+#include "InputCommon/ControllerEmu/Control/Control.h"
+#include "InputCommon/ControllerEmu/ControlGroup/ControlGroup.h"
+#include "InputCommon/ControllerEmu/ControllerEmu.h"
+#include "InputCommon/ControllerEmu/Setting/NumericSetting.h"
+#include "InputCommon/ControllerInterface/ControllerInterface.h"
+#include "InputCommon/InputConfig.h"
+#include "VideoCommon/OnScreenDisplay.h"
+
+namespace SkiesInput
+{
+namespace
+{
+using Clock = std::chrono::steady_clock;
+using SkiesBindings::Slot;
+
+// How often the other controllers are looked at for a press, and how long controller 1's device
+// must have been idle before a press elsewhere takes over
+constexpr std::chrono::milliseconds SCAN_INTERVAL{50};
+constexpr std::chrono::milliseconds IDLE_BEFORE_SWITCH{750};
+constexpr double PRESS_THRESHOLD = 0.6;
+// A capture gives up after this long without a press
+constexpr std::chrono::milliseconds CAPTURE_TIMEOUT{6000};
+
+bool s_ready = false;
+std::atomic<bool> s_owns_keyboard{false};
+std::atomic<bool> s_devices_changed{true};
+std::optional<Common::EventHook> s_devices_hook;
+Clock::time_point s_next_scan{};
+Clock::time_point s_controller_active{};
+Clock::time_point s_keyboard_active{};
+
+struct Hotkey
+{
+  const char* key;
+  std::string expression;
+  InputReference reference;
+  bool previous = false;
+};
+// Under EmulatedController::GetStateLock(): the devices-changed callback resolves them again
+std::array<Hotkey, 2> s_hotkeys{Hotkey{"Menu"}, Hotkey{"Invincible"}};
+ciface::ExpressionParser::ControlEnvironment::VariableContainer s_variables;
+bool s_menu_pressed = false;
+bool s_invincible_held = false;
+
+ciface::Core::InputDetector s_detector;
+int s_capture_input = -1;
+Slot s_capture_slot = Slot::Controller;
+CaptureState s_capture_state = CaptureState::Idle;
+
+std::string ProfilePath()
+{
+  return File::GetUserPath(D_CONFIG_IDX) + "GCPadNew.ini";
+}
+
+GCPad* Controller()
+{
+  return static_cast<GCPad*>(Pad::GetConfig()->GetController(0));
+}
+
+ControlReference* FindControl(std::string_view key)
+{
+  for (const auto& group : Controller()->groups)
+  {
+    for (const auto& control : group->controls)
+    {
+      if (key == group->name + "/" + control->name)
+        return control->control_ref.get();
+    }
+  }
+  return nullptr;
+}
+
+Hotkey* FindHotkey(std::string_view key)
+{
+  for (Hotkey& hotkey : s_hotkeys)
+  {
+    if (key == hotkey.key)
+      return &hotkey;
+  }
+  return nullptr;
+}
+
+// An input's expression, in the profile or the hotkeys
+std::string Expression(const SkiesBindings::Input& input)
+{
+  if (std::string_view(input.section) == SkiesBindings::HOTKEY_SECTION)
+  {
+    const Hotkey* hotkey = FindHotkey(input.key);
+    return hotkey ? hotkey->expression : std::string();
+  }
+  const ControlReference* control = FindControl(input.key);
+  return control ? control->GetExpression() : std::string();
+}
+
+void SetExpression(std::string_view key, const std::string& expression)
+{
+  if (Hotkey* hotkey = FindHotkey(key))
+  {
+    hotkey->expression = expression;
+    return;
+  }
+  if (ControlReference* control = FindControl(key))
+    control->SetExpression(expression);
+}
+
+// A keyboard the bindings can name: on desktop the keyboard device (DirectInput, X11, macOS), on
+// Android a keyboard plugged in (an Android device with letter keys, not the virtual one)
+std::shared_ptr<ciface::Core::Device> FindKeyboard()
+{
+  std::shared_ptr<ciface::Core::Device> android;
+  for (const auto& device : g_controller_interface.GetAllDevices())
+  {
+    if (SkiesBindings::IsKeyboardSource(device->GetSource()) && device->FindInput("A"))
+      return device;
+    if (!android && device->GetSource() == "Android" && device->GetName() != "Virtual" &&
+        device->FindInput("W") && device->FindInput("Space") && !device->FindInput("Axis 0+"))
+    {
+      android = device;
+    }
+  }
+  return android;
+}
+
+// The controllers controller 1 can move to: SDL's gamepads (the controls every profile names)
+bool IsController(const ciface::Core::Device& device)
+{
+  return device.GetSource() == "SDL" && device.FindInput("Button S");
+}
+
+bool Pressed(const ciface::Core::Device& device)
+{
+  for (const ciface::Core::Device::Input* input : device.Inputs())
+  {
+    if (input->IsDetectable() && input->GetState() > PRESS_THRESHOLD)
+      return true;
+  }
+  return false;
+}
+
+// The hotkeys follow controller 1's device and the keyboard. Holds the state lock.
+void ResolveHotkeys()
+{
+  ciface::ExpressionParser::ControlEnvironment env(g_controller_interface,
+                                                   Controller()->GetDefaultDevice(), s_variables);
+  for (Hotkey& hotkey : s_hotkeys)
+  {
+    hotkey.reference.SetExpression(hotkey.expression);
+    hotkey.reference.UpdateReference(env);
+  }
+}
+
+// [SkiesHotkeys] Version: the keyboard layout has been added (once a keyboard was there)
+int s_version = 0;
+
+void SaveHotkeys()
+{
+  Common::IniFile ini;
+  ini.Load(ProfilePath());
+  Common::IniFile::Section* section = ini.GetOrCreateSection(SkiesBindings::HOTKEY_SECTION);
+  for (const Hotkey& hotkey : s_hotkeys)
+    section->Set(hotkey.key, hotkey.expression);
+  section->Set("Version", s_version);
+  ini.Save(ProfilePath());
+}
+
+// Under the state lock: the references follow the new expressions, and the profile (with the
+// hotkeys) is saved
+void Save()
+{
+  Controller()->UpdateReferences(g_controller_interface);
+  ResolveHotkeys();
+  Pad::GetConfig()->SaveConfig();
+  SaveHotkeys();
+}
+
+// The controls of a default ("Thumb L|Thumb R")
+std::vector<std::string> DefaultControls(std::string_view list)
+{
+  std::vector<std::string> controls;
+  while (!list.empty())
+  {
+    const std::size_t bar = list.find('|');
+    controls.emplace_back(list.substr(0, bar));
+    list = bar == std::string_view::npos ? std::string_view() : list.substr(bar + 1);
+  }
+  return controls;
+}
+
+// The default bindings of a slot, added where the slot is empty (reset: replaced). Under the state
+// lock.
+bool AddDefaults(Slot slot, bool replace, const ciface::Core::Device* keyboard)
+{
+  bool changed = false;
+  const std::string keyboard_device = keyboard ? keyboard->GetQualifiedName() : std::string();
+  const auto set = [&](const char* key, const std::string& expression) {
+    const SkiesBindings::Input lookup{SkiesBindings::FindInput(key) ?
+                                          SkiesBindings::FindInput(key)->section :
+                                          SkiesBindings::PAD_SECTION,
+                                      key, "", nullptr, "", "", nullptr};
+    if (Expression(lookup) != expression)
+    {
+      SetExpression(key, expression);
+      changed = true;
+    }
+  };
+  for (const SkiesBindings::Input& input : SkiesBindings::Inputs())
+  {
+    const std::string expression = Expression(input);
+    if (!replace && !SkiesBindings::SlotControl(expression, slot).empty())
+      continue;
+    std::string updated = SkiesBindings::SetSlot(expression, slot, "", "");
+    if (slot == Slot::Keyboard)
+    {
+      const SkiesBindings::KeyName* key = SkiesBindings::FindKey(input.keyboard);
+      const std::string name = key ? SkiesBindings::PlatformKeyName(*key) : std::string();
+      // Only a key this keyboard has (an Android keyboard may lack some)
+      if (keyboard && !name.empty() && keyboard->FindInput(name))
+        updated = SkiesBindings::SetSlot(updated, slot, keyboard_device, name);
+    }
+    else
+    {
+      // Several defaults (Invincible: either stick click) go in as separate terms
+      const std::vector<std::string> controls = DefaultControls(input.controller);
+      std::vector<SkiesBindings::Term> terms = SkiesBindings::SplitExpression(updated);
+      for (std::size_t i = 0; i < controls.size(); ++i)
+      {
+        SkiesBindings::Term term;
+        term.text = SkiesBindings::ControlTerm("", controls[i]);
+        term.simple = true;
+        term.control = controls[i];
+        terms.insert(terms.begin() + static_cast<std::ptrdiff_t>(i), std::move(term));
+      }
+      updated = SkiesBindings::JoinTerms(terms);
+      if (input.analog_key)
+      {
+        const SkiesBindings::Input analog{input.section, input.analog_key, "", nullptr, "", "", nullptr};
+        set(input.analog_key, SkiesBindings::SetSlot(Expression(analog), slot, "",
+                                                     input.controller_analog));
+      }
+    }
+    set(input.key, updated);
+  }
+  return changed;
+}
+
+// Keyboard bindings that name a keyboard not there (another X11 pointer's name, an Android keyboard
+// swapped for another) move to the one that is. Under the state lock.
+bool MoveKeyboardBindings(const std::string& keyboard_device)
+{
+  bool changed = false;
+  for (const SkiesBindings::Input& input : SkiesBindings::Inputs())
+  {
+    for (const char* key : {input.key, input.analog_key})
+    {
+      if (!key)
+        continue;
+      const SkiesBindings::Input lookup{input.section, key, "", nullptr, "", "", nullptr};
+      std::vector<SkiesBindings::Term> terms = SkiesBindings::SplitExpression(Expression(lookup));
+      bool moved = false;
+      for (SkiesBindings::Term& term : terms)
+      {
+        Slot slot;
+        if (!SkiesBindings::TermSlot(term, &slot) || slot != Slot::Keyboard ||
+            term.device == keyboard_device)
+        {
+          continue;
+        }
+        ciface::Core::DeviceQualifier qualifier;
+        qualifier.FromString(term.device);
+        if (g_controller_interface.FindDevice(qualifier))
+          continue;
+        term.device = keyboard_device;
+        term.text = SkiesBindings::ControlTerm(term.device, term.control);
+        moved = true;
+      }
+      if (moved)
+      {
+        SetExpression(key, SkiesBindings::JoinTerms(terms));
+        changed = true;
+      }
+    }
+  }
+  return changed;
+}
+
+// A profile from before the keyboard slot with the keyboard as its device (Dolphin's own keyboard
+// profile): its keys name the keyboard, so they stay keys when controller 1 moves to a controller,
+// and a controller gets the default layout. Under the state lock.
+void QualifyKeyboardProfile(const ciface::Core::Device& keyboard)
+{
+  const std::string device = Controller()->GetDefaultDevice().ToString();
+  ciface::Core::DeviceQualifier qualifier;
+  qualifier.FromString(device);
+  if (!SkiesBindings::IsKeyboardSource(qualifier.source))
+    return;
+  // The keys it has: the profile's keyboard, or the one there if that's another
+  const auto named = g_controller_interface.FindDevice(qualifier);
+  const ciface::Core::Device& keys = named ? *named : keyboard;
+  bool any = false;
+  for (const auto& group : Controller()->groups)
+  {
+    for (const auto& control : group->controls)
+    {
+      std::vector<SkiesBindings::Term> terms =
+          SkiesBindings::SplitExpression(control->control_ref->GetExpression());
+      bool qualified = false;
+      for (SkiesBindings::Term& term : terms)
+      {
+        if (!term.simple || !term.device.empty() || !keys.FindInput(term.control))
+          continue;
+        term.device = device;
+        term.text = SkiesBindings::ControlTerm(term.device, term.control);
+        qualified = true;
+      }
+      if (qualified)
+        control->control_ref->SetExpression(SkiesBindings::JoinTerms(terms));
+      any |= qualified;
+    }
+  }
+  AddDefaults(Slot::Controller, false, nullptr);
+  if (any)
+    NOTICE_LOG_FMT(CORE, "[skies] the keyboard profile's keys now name {}", device);
+}
+
+// The keyboard's layout goes in once (a player who unbinds a key keeps it unbound), when a
+// keyboard is there (on Android maybe only later); bindings naming another keyboard move to it.
+// Under the state lock; true if the profile changed.
+bool UpdateKeyboard()
+{
+  const auto keyboard = FindKeyboard();
+  if (!keyboard)
+    return false;
+  bool changed = false;
+  if (s_version < SkiesBindings::DEFAULTS_VERSION)
+  {
+    QualifyKeyboardProfile(*keyboard);
+    AddDefaults(Slot::Keyboard, false, keyboard.get());
+    s_version = SkiesBindings::DEFAULTS_VERSION;
+    changed = true;
+    NOTICE_LOG_FMT(CORE, "[skies] keyboard layout added for {}", keyboard->GetQualifiedName());
+  }
+  return MoveKeyboardBindings(keyboard->GetQualifiedName()) || changed;
+}
+
+// Controller 1 counts as connected without its device (Dolphin's "Always Connected"): otherwise the
+// game sees no controller at all, keyboard included, while the controller is unplugged or before
+// one has been. Under the state lock; true if it changed.
+bool AlwaysConnected()
+{
+  for (const auto& group : Controller()->groups)
+  {
+    if (group->name != "Options")
+      continue;
+    for (const auto& setting : group->numeric_settings)
+    {
+      if (std::string_view(setting->GetININame()) == "Always Connected" &&
+          setting->GetType() == ControllerEmu::SettingType::Bool)
+      {
+        auto* always = static_cast<ControllerEmu::NumericSetting<bool>*>(setting.get());
+        if (always->GetValue())
+          return false;
+        always->SetValue(true);
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+// First poll of a boot: the hotkeys from the profile (a profile from before them gets the
+// controller's defaults), the keyboard's layout
+void Setup()
+{
+  Common::IniFile ini;
+  ini.Load(ProfilePath());
+  const Common::IniFile::Section* section = ini.GetOrCreateSection(SkiesBindings::HOTKEY_SECTION);
+  section->Get("Version", &s_version, 0);
+  const auto lock = ControllerEmu::EmulatedController::GetStateLock();
+  bool changed = false;
+  for (Hotkey& hotkey : s_hotkeys)
+  {
+    if (section->Get(hotkey.key, &hotkey.expression))
+      continue;
+    const SkiesBindings::Input* input = SkiesBindings::FindInput(hotkey.key);
+    hotkey.expression.clear();
+    for (const std::string& control : DefaultControls(input ? input->controller : ""))
+      hotkey.expression += (hotkey.expression.empty() ? "" : " | ") + SkiesBindings::ControlTerm("", control);
+    changed = true;
+  }
+  changed |= UpdateKeyboard();
+  changed |= AlwaysConnected();
+  if (changed)
+    Save();
+  else
+    ResolveHotkeys();
+  const auto keyboard = FindKeyboard();
+  NOTICE_LOG_FMT(CORE, "[skies] controller 1: {}; keyboard: {}",
+                 Controller()->GetDefaultDevice().ToString(),
+                 keyboard ? keyboard->GetQualifiedName() : std::string("none"));
+}
+
+void SwitchTo(const std::shared_ptr<ciface::Core::Device>& device)
+{
+  const std::string name = device->GetQualifiedName();
+  {
+    const auto lock = ControllerEmu::EmulatedController::GetStateLock();
+    Controller()->SetDefaultDevice(name);
+    Save();
+  }
+  NOTICE_LOG_FMT(CORE, "[skies] controller 1 is now {}", name);
+  OSD::AddMessage(fmt::format("Controller: {}", device->GetName()), 2500);
+}
+
+// Controller 1 follows the controller in use, and a keyboard that turns up gets its bindings
+void Follow(Clock::time_point now)
+{
+  const bool devices_changed = s_devices_changed.exchange(false);
+  if (!devices_changed && now < s_next_scan)
+    return;
+  s_next_scan = now + SCAN_INTERVAL;
+
+  const auto current = g_controller_interface.FindDevice(Controller()->GetDefaultDevice());
+  std::shared_ptr<ciface::Core::Device> pressed, first;
+  for (const auto& device : g_controller_interface.GetAllDevices())
+  {
+    if (SkiesBindings::IsKeyboardSource(device->GetSource()))
+    {
+      if (Pressed(*device))
+        s_keyboard_active = now;
+      continue;
+    }
+    if (device == current)
+    {
+      if (Pressed(*device))
+        s_controller_active = now;
+      continue;
+    }
+    if (!IsController(*device))
+      continue;
+    if (!first)
+      first = device;
+    if (!pressed && Pressed(*device))
+      pressed = device;
+  }
+  // No controller on controller 1 (its device is gone, was never set, or is the keyboard): the
+  // first there is. Another controller pressed while controller 1's has been idle: that one.
+  const bool has_controller = current && !SkiesBindings::IsKeyboardSource(current->GetSource());
+  if (!has_controller && (pressed || first))
+  {
+    SwitchTo(pressed ? pressed : first);
+    s_controller_active = now;
+  }
+  else if (has_controller && pressed && now - s_controller_active > IDLE_BEFORE_SWITCH)
+  {
+    SwitchTo(pressed);
+    s_controller_active = now;
+  }
+  if (devices_changed)
+  {
+    const auto lock = ControllerEmu::EmulatedController::GetStateLock();
+    if (UpdateKeyboard())
+      Save();
+    else
+      ResolveHotkeys();
+  }
+}
+
+void PollHotkeys()
+{
+  const auto lock = ControllerEmu::EmulatedController::GetStateLock();
+  for (Hotkey& hotkey : s_hotkeys)
+  {
+    const bool down = !hotkey.expression.empty() && hotkey.reference.GetState<bool>();
+    if (std::string_view(hotkey.key) == "Menu" && down && !hotkey.previous)
+      s_menu_pressed = true;
+    if (std::string_view(hotkey.key) == "Invincible")
+      s_invincible_held = down;
+    hotkey.previous = down;
+  }
+}
+
+std::vector<std::string> CaptureDevices(Slot slot)
+{
+  std::vector<std::string> devices;
+  if (slot == Slot::Keyboard)
+  {
+    if (const auto keyboard = FindKeyboard())
+      devices.push_back(keyboard->GetQualifiedName());
+  }
+  else
+  {
+    devices.push_back(Controller()->GetDefaultDevice().ToString());
+  }
+  return devices;
+}
+}  // namespace
+
+void Poll()
+{
+  const std::string& game = SConfig::GetInstance().GetGameID();
+  if (game != "GEAE8P" && game != "GEAP8P")
+    return;
+  s_owns_keyboard = true;
+  if (!s_devices_hook)
+  {
+    s_devices_hook =
+        g_controller_interface.RegisterDevicesChangedCallback([] { s_devices_changed = true; });
+  }
+  if (!s_ready)
+  {
+    s_ready = true;
+    Setup();
+  }
+  if (s_capture_state != CaptureState::Waiting)
+    Follow(Clock::now());
+  PollHotkeys();
+}
+
+bool TakeMenuPress()
+{
+  const bool pressed = s_menu_pressed;
+  s_menu_pressed = false;
+  return pressed;
+}
+
+bool InvincibleHeld()
+{
+  return s_invincible_held;
+}
+
+bool KeyboardInUse()
+{
+  return s_keyboard_active > s_controller_active;
+}
+
+bool OwnsKeyboard()
+{
+  return s_owns_keyboard;
+}
+
+std::string BindingLabel(int input, Slot slot)
+{
+  const auto inputs = SkiesBindings::Inputs();
+  if (input < 0 || input >= static_cast<int>(inputs.size()))
+    return {};
+  if (s_capture_state == CaptureState::Waiting && s_capture_input == input && s_capture_slot == slot)
+    return slot == Slot::Keyboard ? "Press a key..." : "Press a button...";
+  const auto lock = ControllerEmu::EmulatedController::GetStateLock();
+  std::string label;
+  for (const SkiesBindings::Term& term : SkiesBindings::SplitExpression(Expression(inputs[input])))
+  {
+    Slot term_slot;
+    if (SkiesBindings::TermSlot(term, &term_slot) && term_slot == slot)
+      label += (label.empty() ? "" : " / ") + SkiesBindings::ControlLabel(term.control);
+  }
+  return label.empty() ? "-" : label;
+}
+
+void StartCapture(int input, Slot slot)
+{
+  const std::vector<std::string> devices = CaptureDevices(slot);
+  s_capture_input = input;
+  s_capture_slot = slot;
+  if (devices.empty() || devices.front().empty())
+  {
+    OSD::AddMessage(slot == Slot::Keyboard ? "No keyboard connected" : "No controller connected",
+                    2500);
+    s_capture_state = CaptureState::Idle;
+    return;
+  }
+  s_detector.Start(g_controller_interface, devices);
+  s_capture_state = CaptureState::Waiting;
+}
+
+CaptureState PollCapture()
+{
+  if (s_capture_state != CaptureState::Waiting)
+  {
+    const CaptureState state = s_capture_state;
+    s_capture_state = CaptureState::Idle;
+    return state;
+  }
+  s_detector.Update(CAPTURE_TIMEOUT, std::chrono::milliseconds(0), CAPTURE_TIMEOUT);
+  if (!s_detector.IsComplete())
+    return CaptureState::Waiting;
+  const auto results = s_detector.TakeResults();
+  s_capture_state = CaptureState::Idle;
+  if (results.empty() || !results.front().input)
+    return CaptureState::Done;  // timed out: nothing changes
+
+  const auto& detection = results.front();
+  const SkiesBindings::Input& input = SkiesBindings::Inputs()[s_capture_input];
+  const std::string control = detection.input->GetName();
+  const std::string device = s_capture_slot == Slot::Keyboard ? detection.device->GetQualifiedName() : "";
+  {
+    const auto lock = ControllerEmu::EmulatedController::GetStateLock();
+    SetExpression(input.key, SkiesBindings::SetSlot(Expression(input), s_capture_slot, device, control));
+    if (input.analog_key && s_capture_slot == Slot::Controller)
+    {
+      // A trigger: its analog half too when the control is an axis, else only the button
+      const SkiesBindings::Input analog{input.section, input.analog_key, "", nullptr, "", "", nullptr};
+      const bool axis = detection.IsAnalogPress() || control.find("Trigger") != std::string::npos ||
+                        control.find("Axis") != std::string::npos;
+      SetExpression(input.analog_key,
+                    SkiesBindings::SetSlot(Expression(analog), Slot::Controller, "", axis ? control : ""));
+    }
+    Save();
+  }
+  NOTICE_LOG_FMT(CORE, "[skies] {} ({}) bound to {}", input.key,
+                 s_capture_slot == Slot::Keyboard ? "keyboard" : "controller", control);
+  return CaptureState::Done;
+}
+
+void CancelCapture()
+{
+  s_capture_state = CaptureState::Idle;
+}
+
+void Clear(int input, Slot slot)
+{
+  const auto inputs = SkiesBindings::Inputs();
+  if (input < 0 || input >= static_cast<int>(inputs.size()))
+    return;
+  const auto lock = ControllerEmu::EmulatedController::GetStateLock();
+  SetExpression(inputs[input].key, SkiesBindings::SetSlot(Expression(inputs[input]), slot, "", ""));
+  if (inputs[input].analog_key && slot == Slot::Controller)
+  {
+    const SkiesBindings::Input analog{inputs[input].section, inputs[input].analog_key, "", nullptr,
+                                      "", "", nullptr};
+    SetExpression(analog.key, SkiesBindings::SetSlot(Expression(analog), slot, "", ""));
+  }
+  Save();
+}
+
+void ResetDefaults(Slot slot)
+{
+  const auto keyboard = FindKeyboard();
+  const auto lock = ControllerEmu::EmulatedController::GetStateLock();
+  AddDefaults(slot, true, keyboard.get());
+  Save();
+}
+}  // namespace SkiesInput
