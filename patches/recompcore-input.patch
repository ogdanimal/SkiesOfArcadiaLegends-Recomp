+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <string>
+
+#include "Core/SkiesBindings.h"
+
+// Controller 1 in the Skies of Arcadia Legends recomp (VideoCommon/SkiesMenu.cpp calls it from
+// every poll of controller 1):
+// - the keyboard plays alongside the controller: its default layout (Core/SkiesBindings.cpp) is
+//   added to the profile once, and its bindings follow the keyboard device the game finds;
+// - controller 1 is the controller in use: when its device isn't there, or another controller is
+//   pressed while it's idle, the profile moves to that one (the same bindings, since SDL names
+//   every gamepad's controls alike), so any controller works without the launcher, also under
+//   Steam Input, whose virtual gamepad has another name than the controller itself;
+// - the hotkeys of [SkiesHotkeys] (the settings menu, Invincible);
+// - remapping for the in-game menu's Controls page.
+namespace SkiesInput
+{
+// CPU thread, controller 1's poll
+void Poll();
+
+// A press of the settings menu hotkey since the last call
+bool TakeMenuPress();
+// The Invincible hotkey is held
+bool InvincibleHeld();
+// True when the keyboard was used more recently than a controller (the menu's hints)
+bool KeyboardInUse();
+// True when the game should have the keyboard to itself: the host window's own keys (fast-forward,
+// save states, quitting on Escape) stay out of the way (DolphinNoGUI's platforms)
+bool OwnsKeyboard();
+
+// Remapping (the in-game menu, CPU thread). Index into SkiesBindings::Inputs().
+std::string BindingLabel(int input, SkiesBindings::Slot slot);
+// Waits for the next press on the slot's devices: the controller in use or the keyboard
+void StartCapture(int input, SkiesBindings::Slot slot);
+enum class CaptureState
+{
+  Idle,
+  Waiting,
+  Done,
+};
+CaptureState PollCapture();
+void CancelCapture();
+void Clear(int input, SkiesBindings::Slot slot);
+void ResetDefaults(SkiesBindings::Slot slot);
+}  // namespace SkiesInput
