+
+#pragma once
+
+#include "InputCommon/GCPadStatus.h"
+
+// The in-game settings menu for Skies of Arcadia Legends (GEAE8P), on every platform: hold Z and
+// press Start on controller 1 to open it. While it's open the game sees a released controller and
+// keeps running; the menu takes L / R (tab), the D-pad / stick (select, change), A (change), B or
+// Start (close).
+// Changes are staged and applied when the menu closes, through the same config keys the launcher
+// and the runtime use (Core/SkiesSettings.cpp for the [Skies] ones), and saved.
+namespace SkiesMenu
+{
+// CPU thread, from Pad::GetStatus: returns what the game should see of controller pad_num.
+GCPadStatus FilterPad(int pad_num, const GCPadStatus& raw);
+
+// Video thread, inside the on-screen UI's ImGui frame: draws the menu while it's open.
+void Draw(float scale);
+
+// Video thread, when the on-screen UI sets up its fonts: adds the menu's own typefaces.
+void LoadFonts();
+
+bool IsOpen();
+}  // namespace SkiesMenu
