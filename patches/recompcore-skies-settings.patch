+    s_slot_time[slot] = WriteTime(SlotPath(slot));
+  const auto newest = State::Layout::LatestAutomatic(StateDirectory(), AUTO_PREFIX);
+  s_newest_auto = newest ? newest->string() : std::string();
+  s_slot_time[0] = newest ? WriteTime(*newest) : 0;
+}
