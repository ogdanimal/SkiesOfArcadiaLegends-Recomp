+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+// Applies the [Skies] settings (Core/Config/SkiesSettings.h) to the running game:
+//  - widescreen: the widescreen game patch keeps its config block at a fixed address
+//    (patches/game/widescreen.c, ws_config at 0x80002A00: magic 'WSCF', version, then the
+//    target display aspect as a float, 0 = the original 4:3) and applies it every frame, so the
+//    aspect is one memory write on the CPU thread; Dolphin's own aspect setting follows so the
+//    window letterboxes to match.
+//  - frame mode: frame interpolation (VideoCommon/FrameInterpolator) switched at the next frame
+//    boundary.
+// Applied when the core starts running, after a savestate load (a state restores RAM and so the
+// old aspect value), and whenever the settings change (the config-changed callback).
+namespace Core
+{
+class System;
+}
+
+namespace SkiesSettings
+{
+void Init(Core::System& system);
+void OnStateLoaded(Core::System& system);
+// True when the running DOL carries the widescreen patch (its config magic is in RAM).
+bool HasWidescreenPatch(Core::System& system);
+}  // namespace SkiesSettings
