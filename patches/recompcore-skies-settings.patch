+    GCPad* controller = Controller();
+    for (const PadGroup stick : {PadGroup::MainStick, PadGroup::CStick})
+    {
+      if (auto* setting = DeadZone(controller->GetGroup(stick)))
+        setting->SetValue(dead_zone);
+    }
+    if (auto* group = controller->GetGroup(PadGroup::Rumble); group && !group->controls.empty())
+      group->controls[0]->control_ref->range = rumble ? 1.0 : 0.0;
+  }
+  Pad::GetConfig()->SaveConfig();
