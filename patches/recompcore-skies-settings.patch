+  if (pending < 0 || pending == detail::s_enabled)
+    return;
+  if (pending == 0)
+  {
+    // Drop everything recorded and queued; the real pictures show from the next retrace on.
+    Shutdown();
+    detail::s_enabled = 0;
+    Log("[interp] frame interpolation off (setting)\n");
+  }
+  else
+  {
+    // Recording starts with the frame that begins at this boundary.
+    detail::s_enabled = 1;
+    Log("[interp] frame interpolation on (setting)\n");
+  }
