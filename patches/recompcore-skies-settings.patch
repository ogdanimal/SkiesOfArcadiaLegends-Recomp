+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include "Common/Config/Config.h"
+
+// Player settings for the Skies of Arcadia Legends recomp, section [Skies] in Dolphin.ini. They
+// are applied live by Core/SkiesSettings.cpp. -1 means "not set": the old switches decide
+// (the DOL's own default aspect; RECOMP_FRAME_INTERPOLATION / FrameInterpolation.on), and the
+// first boot writes the derived value so a settings screen shows a definite choice.
+namespace Config
+{
+// 1 = 16:9 (the widescreen patch's target aspect), 0 = the original 4:3 picture.
+extern const Info<int> SKIES_WIDESCREEN;
+// 0 = 30 fps (the game's own rate), 1 = 60 fps (frame interpolation), 2 = reserved (unlocked).
+extern const Info<int> SKIES_FRAME_MODE;
+// 1 = hold Z to tilt and zoom the camera with the C-stick and triggers (VideoCommon/SkiesMenu.cpp,
+// the game patch's camera.c), 0 = the game's own camera controls only.
+extern const Info<int> SKIES_CAMERA_CONTROL;
+// Quality-of-life options (the game patch's qol.c): percent of the game's random encounter chance
+// (0 = none), of the EXP, gold and magic EXP battles give, and the battle speed (1 = normal, 2..4;
+// a Z tap in battle cycles it).
+extern const Info<int> SKIES_ENCOUNTERS;
+extern const Info<int> SKIES_EXP;
+extern const Info<int> SKIES_GOLD;
+extern const Info<int> SKIES_MAGIC_EXP;
+extern const Info<int> SKIES_BATTLE_SPEED;
+// 1 = in battle the party's HP, MP and Spirit stay full and the party takes no damage; L3 or R3 (the
+// real controller's stick clicks) toggles it.
+extern const Info<int> SKIES_INVINCIBLE;
+// Minutes between auto-saves (save states in slots 6-8, the oldest overwritten; only on the field or
+// world map, VideoCommon/SkiesMenu.cpp), 0 = off.
+extern const Info<int> SKIES_AUTO_SAVE;
+}  // namespace Config
