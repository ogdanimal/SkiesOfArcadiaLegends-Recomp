+std::string SlotTime(int slot)
+{
+  if (s_slot_time[slot] == 0)
+    return "empty";
+  const auto local = Common::LocalTime(s_slot_time[slot]);
+  return local ? fmt::format("{:%b %d %H:%M}", *local) : "saved";
+}
