diff --git a/Source/Core/Core/SkiesSettings.cpp b/Source/Core/Core/SkiesSettings.cpp
new file mode 100644
index 0000000000..6580c269bd
--- /dev/null
+++ b/Source/Core/Core/SkiesSettings.cpp
@@ -0,0 +1,149 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "Core/SkiesSettings.h"
+
+#include <bit>
+#include <cstdlib>
+
+#include "Common/Config/Config.h"
+#include "Common/FileUtil.h"
+#include "Common/HookableEvent.h"
+#include "Common/Logging/Log.h"
+#include "Core/Config/GraphicsSettings.h"
+#include "Core/Config/SkiesSettings.h"
+#include "Core/Core.h"
+#include "Core/HW/Memmap.h"
+#include "Core/System.h"
+#include "VideoCommon/FrameInterpolator.h"
+#include "VideoCommon/VideoConfig.h"
+
+namespace SkiesSettings
+{
+namespace
+{
+constexpr u32 WS_CONFIG_ADDRESS = 0x80002A00;
+constexpr u32 WS_CONFIG_MAGIC = 0x57534346;  // 'WSCF'
+constexpr u32 WS_DISPLAY_ASPECT_OFFSET = 8;
+constexpr float WIDE_ASPECT = 16.0f / 9.0f;
+
+bool s_initialized = false;
+// This thread is applying, and writes settings itself (first-boot migration): its own config
+// callbacks are skipped. Per thread, so a change made elsewhere meanwhile still applies.
+thread_local bool s_applying = false;
+Common::EventHook s_state_hook;
+Config::ConfigChangedCallbackID s_config_callback;
+
+bool ReadMagic(Core::System& system)
+{
+  auto& memory = system.GetMemory();
+  if (!memory.IsInitialized())
+    return false;
+  return memory.Read_U32(WS_CONFIG_ADDRESS) == WS_CONFIG_MAGIC;
+}
+
+// What the old switches say: the frontend's RECOMP_FRAME_INTERPOLATION (from its config.ini) or
+// FrameInterpolation.on in the user directory.
+bool LegacyInterpolationSwitch()
+{
+  if (const char* env = std::getenv("RECOMP_FRAME_INTERPOLATION"))
+    return env[0] == '1' || env[0] == '2';
+  return File::Exists(File::GetUserPath(D_USER_IDX) + "FrameInterpolation.on");
+}
+
+// Runs on the host thread (a queued host job) or the CPU thread (a state load). The RAM write is
+// one aligned word the game reads once per frame.
+void ApplyNow(Core::System& system)
+{
+  s_applying = true;
+  bool save = false;
+
+  int widescreen = Config::Get(Config::SKIES_WIDESCREEN);
+  const bool patched = ReadMagic(system);
+  if (patched)
+  {
+    if (widescreen < 0)
+    {
+      // First boot with the patch: the patch's own default is 16:9.
+      widescreen = 1;
+      Config::SetBase(Config::SKIES_WIDESCREEN, widescreen);
+      save = true;
+    }
+    auto& memory = system.GetMemory();
+    const float aspect = widescreen ? WIDE_ASPECT : 0.0f;
+    const u32 address = WS_CONFIG_ADDRESS + WS_DISPLAY_ASPECT_OFFSET;
+    if (memory.Read_U32(address) != std::bit_cast<u32>(aspect))
+    {
+      memory.Write_U32(std::bit_cast<u32>(aspect), address);
+      NOTICE_LOG_FMT(CORE, "[skies] picture {}", widescreen ? "16:9" : "4:3");
+    }
+    // Letterbox to match: a custom 16:9 picture, or Dolphin's 4:3.
+    const AspectMode want = widescreen ? AspectMode::CustomStretch : AspectMode::ForceStandard;
+    if (Config::Get(Config::GFX_ASPECT_RATIO) != want)
+    {
+      Config::SetBaseOrCurrent(Config::GFX_ASPECT_RATIO, want);
+      save = true;
+    }
+    if (widescreen && (Config::Get(Config::GFX_CUSTOM_ASPECT_RATIO_WIDTH) != 16 ||
+                       Config::Get(Config::GFX_CUSTOM_ASPECT_RATIO_HEIGHT) != 9))
+    {
+      Config::SetBaseOrCurrent(Config::GFX_CUSTOM_ASPECT_RATIO_WIDTH, 16);
+      Config::SetBaseOrCurrent(Config::GFX_CUSTOM_ASPECT_RATIO_HEIGHT, 9);
+      save = true;
+    }
+  }
+
+  int mode = Config::Get(Config::SKIES_FRAME_MODE);
+  if (mode < 0)
+  {
+    mode = LegacyInterpolationSwitch() ? 1 : 0;
+    Config::SetBase(Config::SKIES_FRAME_MODE, mode);
+    save = true;
+  }
+  FrameInterpolator::RequestEnabled(mode >= 1);
+
+  if (save)
+    Config::Save();
+  s_applying = false;
+}
+
+void Apply(Core::System& system)
+{
+  // Non-blocking: queued for the host thread's next host-job point (the platform's main loop).
+  // From the CPU thread itself (single core, or a state load) it runs at once.
+  if (Core::IsCPUThread())
+  {
+    ApplyNow(system);
+    return;
+  }
+  Core::QueueHostJob([](Core::System& sys) { ApplyNow(sys); }, false);
+}
+}  // namespace
+
+bool HasWidescreenPatch(Core::System& system)
+{
+  return ReadMagic(system);
+}
+
+void Init(Core::System& system)
+{
+  if (s_initialized)
+    return;
+  s_initialized = true;
+  s_state_hook = Core::AddOnStateChangedCallback([&system](Core::State state) {
+    if (state == Core::State::Running)
+      Apply(system);
+  });
+  s_config_callback = Config::AddConfigChangedCallback([&system] {
+    if (!s_applying && Core::IsRunning(system))
+      Apply(system);
+  });
+}
+
+void OnStateLoaded(Core::System& system)
+{
+  // A load runs with the CPU thread held (on it, or paused under RunOnCPUThread from another
+  // thread), so apply now, before the next frame, instead of from a host job some frames later.
+  ApplyNow(system);
+}
+}  // namespace SkiesSettings
