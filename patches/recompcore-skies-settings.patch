+// CPU thread, menu just closed: the [Skies] values reach the game through SkiesSettings' config
+// callback (aspect at once, frame mode at the next frame end); Dolphin picks up the graphics ones
+// at its next frame.
+void Apply(const Values& values, const Values& before)
+{
+  bool changed = false;
+  if (values.widescreen != before.widescreen)
+  {
+    Config::SetBase(Config::SKIES_WIDESCREEN, values.widescreen);
+    changed = true;
+  }
+  if (values.frame_mode != before.frame_mode)
+  {
+    Config::SetBase(Config::SKIES_FRAME_MODE, values.frame_mode);
+    changed = true;
+  }
+  if (values.efb_scale != before.efb_scale)
+  {
+    Config::SetBase(Config::GFX_EFB_SCALE, values.efb_scale);
+    changed = true;
+  }
+  if (values.msaa != before.msaa)
+  {
+    Config::SetBase(Config::GFX_MSAA, static_cast<u32>(values.msaa));
+    changed = true;
+  }
+  if (values.camera != before.camera)
+  {
+    Config::SetBase(Config::SKIES_CAMERA_CONTROL, values.camera);
+    changed = true;
+  }
+  const auto set = [&](const Config::Info<int>& info, int value, int old) {
+    if (value != old)
+    {
+      Config::SetBase(info, value);
+      changed = true;
+    }
+  };
+  set(Config::SKIES_ENCOUNTERS, values.encounters, before.encounters);
+  set(Config::SKIES_EXP, values.exp, before.exp);
+  set(Config::SKIES_GOLD, values.gold, before.gold);
+  set(Config::SKIES_MAGIC_EXP, values.magic_exp, before.magic_exp);
+  set(Config::SKIES_BATTLE_SPEED, values.battle_speed, before.battle_speed);
+  set(Config::SKIES_INVINCIBLE, values.invincible, before.invincible);
+  set(Config::SKIES_AUTO_SAVE, values.auto_save, before.auto_save);
+  if (values.vsync != before.vsync)
+  {
+    Config::SetBase(Config::GFX_VSYNC, values.vsync);
+    changed = true;
+  }
+  if (values.show_fps != before.show_fps)
+  {
+    Config::SetBase(Config::GFX_SHOW_FPS, values.show_fps);
+    changed = true;
+  }
+  if (values.volume != before.volume)
+  {
+    Config::SetBase(Config::MAIN_AUDIO_VOLUME, values.volume);
+    AudioCommon::UpdateSoundStream(Core::System::GetInstance());
+    changed = true;
+  }
+  if (changed)
+    Config::Save();
+  if (values.dead_zone != before.dead_zone || values.rumble != before.rumble)
+    pad::Write(values.dead_zone, values.rumble != 0);
+}
