+ControllerEmu::NumericSetting<double>* DeadZone(ControllerEmu::ControlGroup* group)
+{
+  if (!group)
+    return nullptr;
+  for (const auto& setting : group->numeric_settings)
+  {
+    if (std::string_view(setting->GetININame()) == "Dead Zone" &&
+        setting->GetType() == ControllerEmu::SettingType::Double)
+    {
+      return static_cast<ControllerEmu::NumericSetting<double>*>(setting.get());
+    }
+  }
+  return nullptr;
+}
