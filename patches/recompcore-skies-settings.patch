+namespace
+{
+std::atomic<std::chrono::steady_clock::rep> s_last_access{0};
+
+void NoteAccess()
+{
+  s_last_access.store(std::chrono::steady_clock::now().time_since_epoch().count(),
+                      std::memory_order_relaxed);
+}
+}  // namespace
+
+double CEXIMemoryCard::SecondsSinceLastAccess()
+{
+  const auto last = s_last_access.load(std::memory_order_relaxed);
+  if (last == 0)
+    return 1e9;
+  const auto now = std::chrono::steady_clock::now().time_since_epoch().count();
+  return std::chrono::duration<double>(std::chrono::steady_clock::duration(now - last)).count();
+}
