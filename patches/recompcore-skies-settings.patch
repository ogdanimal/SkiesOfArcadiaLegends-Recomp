+}
+
+// A ship battle runs inside field mode 6, on a map from 500 to 599 (the game's own test, in
+// fn_8012A26C). The ship battle's data pointer (0x8034727C) isn't enough: the game frees the data
+// after the battle but leaves the pointer set, so a map's load would count as battle. The game
+// patch's qol_ship_live (patches/game/qol.c, .late_bss) is set from the data's allocation (or the
+// battle's first phase) until its results.
+bool InShipBattle(Memory::MemoryManager& memory)
+{
+  constexpr u32 GAME_MODE = 0x803475CC;
+  constexpr u32 MAP_ID = 0x80311AC4;
+  constexpr u32 QOL_SHIP_LIVE = 0x80002BA8;
+  const u32 map = memory.Read_U32(MAP_ID);
+  return memory.Read_U32(GAME_MODE) == 6 && map >= 500 && map <= 599 &&
+         memory.Read_U32(QOL_SHIP_LIVE) != 0;
+}
+
+// Camera control: hold Z, then the C-stick tilts the camera (and on the world map turns it around
+// the ship) and the L/R triggers zoom; the game patch (patches/game/camera.c) applies the offsets
+// it finds in cam_input. Only where the game's camera manager follows the field camera object:
+// towns, dungeons and the world map.
+namespace camera
+{
+constexpr u32 GAME_MODE = 0x803475CC;       // 6 = field / world map
+constexpr u32 MANAGER = 0x80311970;         // +0 mode (2 = follow), +8 eye source
+constexpr u32 FIELD_CAMERA_EYE = 0x80302F94;  // the field camera object's eye
+constexpr u32 FIELD_CAMERA_PITCH = 0x80302FA0;
+constexpr u32 MAP_ID = 0x80311AC4;          // 0x63 = the world map
+constexpr u32 WORLD_MAP = 0x63;
+constexpr u32 HOOK_SITE = 0x8022D910;       // bl fn_8022D1F8 in the unpatched game
+constexpr u32 HOOK_ORIGINAL = 0x4BFFF8E9;
+constexpr u32 INPUT = 0x80002EC0;           // camera.c's cam_input
+constexpr u32 INPUT_MAGIC = 0x43414D43;     // 'CAMC'
+
+constexpr float DEGREES = 65536.0f / 360.0f;  // Ninja angle units
+constexpr float PITCH_SPEED = 80.0f * DEGREES;  // per second, stick fully over
+constexpr float YAW_SPEED = 120.0f * DEGREES;
+constexpr float ZOOM_SPEED = 0.8f;              // distance factor per second, trigger fully in
+constexpr float YAW_RETURN = 3.0f;              // world map: the turn eases back at this rate
+constexpr int STICK_DEAD = 24;
+constexpr int TRIGGER_DEAD = 40;
+
+struct Offsets
+{
+  float pitch = 0.0f;
+  float yaw = 0.0f;
+  float zoom = 1.0f;
+};
+struct Limits
+{
+  float pitch_lo, pitch_hi;  // the tilted pitch, in Ninja units (negative: looking down)
+  float zoom_lo, zoom_hi;
+  float rise;  // > 0: the eye stays within this of the game's own eye height (camera.c)
+};
+// Field: the camera stays between the game's own camera and Vyse, since rooms have low ceilings and
+// walls close behind and the game has no camera collision: no higher than the game's eye (tilting
+// further down brings it closer instead), no further than the game's distance, never under Vyse's
+// head, down to -40 degrees.
+constexpr Limits FIELD_LIMITS{-40.0f * DEGREES, -1.0f * DEGREES, 0.5f, 1.0f, 0.5f};
+constexpr Limits WORLD_LIMITS{-35.0f * DEGREES, 25.0f * DEGREES, 0.6f, 2.0f, 0.0f};
+
+Offsets s_field;
+Offsets s_world;
+Clock::time_point s_last_poll;
+
+struct Context
+{
+  bool movable = false;  // the game is following the field camera object
+  bool world_map = false;
+  float game_pitch = 0.0f;
+};
+
+Context ReadContext(Memory::MemoryManager& memory)
+{
+  Context context;
+  if (memory.Read_U32(HOOK_SITE) == HOOK_ORIGINAL)  // a DOL without camera.c
+    return context;
+  context.movable = memory.Read_U32(GAME_MODE) == 6 && memory.Read_U32(MANAGER) == 2 &&
+                    memory.Read_U32(MANAGER + 8) == FIELD_CAMERA_EYE;
+  context.world_map = memory.Read_U32(MAP_ID) == WORLD_MAP;
+  context.game_pitch = static_cast<float>(static_cast<s16>(memory.Read_U32(FIELD_CAMERA_PITCH)));
+  return context;
+}
+
+float Axis(u8 value, u8 center)
+{
+  const int v = static_cast<int>(value) - center;
+  if (std::abs(v) < STICK_DEAD)
+    return 0.0f;
+  return std::clamp(static_cast<float>(v) / 100.0f, -1.0f, 1.0f);
+}
+
+float Trigger(u8 value)
+{
+  return value < TRIGGER_DEAD ? 0.0f : static_cast<float>(value - TRIGGER_DEAD) / (255 - TRIGGER_DEAD);
+}
+
+// Applies one poll of camera input (z: Z is held). Returns true if the player moved the camera.
+bool Update(const Context& context, const GCPadStatus& raw, bool z, float dt)
+{
+  Offsets& offsets = context.world_map ? s_world : s_field;
+  const Limits& limits = context.world_map ? WORLD_LIMITS : FIELD_LIMITS;
+  bool moved = false;
+  if (z)
+  {
+    const float stick_y = Axis(raw.substickY, GCPadStatus::C_STICK_CENTER_Y);
+    const float stick_x = Axis(raw.substickX, GCPadStatus::C_STICK_CENTER_X);
+    const float zoom = Trigger(raw.triggerRight) - Trigger(raw.triggerLeft);
+    // Up: the camera rises and looks down more.
+    offsets.pitch -= stick_y * PITCH_SPEED * dt;
+    offsets.zoom += zoom * ZOOM_SPEED * dt;
+    if (context.world_map)
+      offsets.yaw -= stick_x * YAW_SPEED * dt;
+    // In the field the game turns the camera with C-stick X itself; that counts too (a Z hold that
+    // turned the camera mustn't become a tap on release).
+    moved = stick_y != 0.0f || zoom != 0.0f || stick_x != 0.0f;
+  }
+  if (context.world_map && !(z && Axis(raw.substickX, GCPadStatus::C_STICK_CENTER_X) != 0.0f))
+    offsets.yaw -= offsets.yaw * std::min(1.0f, YAW_RETURN * dt);
+  // Keep the total pitch in range, so pushing past a limit doesn't wind up.
+  offsets.pitch = std::clamp(offsets.pitch, std::min(0.0f, limits.pitch_lo - context.game_pitch),
+                             std::max(0.0f, limits.pitch_hi - context.game_pitch));
+  offsets.zoom = std::clamp(offsets.zoom, limits.zoom_lo, limits.zoom_hi);
+  return moved;
+}
+
+void Write(Memory::MemoryManager& memory, const Context& context, bool enabled)
+{
+  if (memory.Read_U32(HOOK_SITE) == HOOK_ORIGINAL)
+    return;
+  const Offsets& offsets = context.world_map ? s_world : s_field;
+  const Limits& limits = context.world_map ? WORLD_LIMITS : FIELD_LIMITS;
+  memory.Write_U32(INPUT_MAGIC, INPUT);
+  memory.Write_U32(enabled ? 1 : 0, INPUT + 4);
+  memory.Write_U32(static_cast<u32>(static_cast<s32>(offsets.pitch)), INPUT + 8);
+  memory.Write_U32(static_cast<u32>(static_cast<s32>(offsets.yaw)), INPUT + 12);
+  memory.Write_U32(std::bit_cast<u32>(offsets.zoom), INPUT + 16);
+  memory.Write_U32(static_cast<u32>(static_cast<s32>(limits.pitch_lo)), INPUT + 20);
+  memory.Write_U32(static_cast<u32>(static_cast<s32>(limits.pitch_hi)), INPUT + 24);
+  memory.Write_U32(std::bit_cast<u32>(limits.rise), INPUT + 28);
+}
+}  // namespace camera
+
+// Quality-of-life options: the settings go to the game patch (patches/game/qol.c) through
+// qol_input every poll; a Z tap in battle cycles the battle speed; frame interpolation steps aside
+// while a battle runs fast (the game then draws a real picture for every retrace or more).
+namespace qol
+{
+constexpr u32 HOOK_SITE = 0x800C207C;      // bl fn_8025ECC4 (rand) in the unpatched game
+constexpr u32 HOOK_ORIGINAL = 0x4819CC49;
+constexpr u32 INPUT = 0x80002EA0;          // qol.c's qol_input
+constexpr u32 INPUT_MAGIC = 0x514F4C43;    // 'QOLC'
+constexpr u32 GAME_MODE = 0x803475CC;      // 7 = battle (ship battles: InShipBattle)
+
+bool s_interpolation_held = false;  // turned off for a fast battle
+int s_speed_pending = 0;            // a new battle speed to save (after the lock is let go)
+int s_invincible_pending = -1;      // a new Invincible setting to save (after the lock is let go)
+// A battle at 3x or 4x the host can't keep up with (the emulation drops under 95% for 1.5 s) steps
+// down, to 2x at the lowest, until the battle ends: the Retroid manages about 2.5x.
+int s_speed_cap = 4;
+Clock::time_point s_slow_since{};
+bool s_stick_click = false;         // L3 / R3 down at the last poll
+// A ship battle frame takes about a retrace of the emulated CPU's time, so skipping the waits takes
+// it to 2x and no further. At 3x and 4x the emulated CPU runs speed / 2 times faster while the
+// battle lasts (CurrentRun layer: the player's own overclock setting is left alone and comes back).
+float s_overclock = 1.0f;           // the factor asked for at the last poll
+float s_overclock_pending = 0.0f;   // a new factor to apply (after the lock is let go)
+
+bool Present(Memory::MemoryManager& memory)
+{
+  return memory.Read_U32(HOOK_SITE) != HOOK_ORIGINAL &&
+         memory.Read_U32(HOOK_SITE) >> 26 == 18;  // a bl, to qol.c
+}
+
+bool InBattle(Memory::MemoryManager& memory)
+{
+  return memory.Read_U32(GAME_MODE) == 7 || InShipBattle(memory);
+}
+
+int EffectiveSpeed(Memory::MemoryManager& memory, int speed)
+{
+  if (!InBattle(memory))
+  {
+    s_speed_cap = 4;
+    s_slow_since = {};
+    return speed;
+  }
+  const int effective = std::min(speed, s_speed_cap);
+  if (effective < 3)
+    return effective;
+  const Clock::time_point now = Clock::now();
+  if (Core::System::GetInstance().GetPerfMetrics().GetSpeed() >= 0.95)
+  {
+    s_slow_since = {};
+  }
+  else if (s_slow_since == Clock::time_point{})
+  {
+    s_slow_since = now;
+  }
+  else if (now - s_slow_since > std::chrono::milliseconds(1500))
+  {
+    s_speed_cap = effective - 1;
+    s_slow_since = {};
+    OSD::AddMessage(fmt::format("Battle speed: {}x (the most this device keeps up with)", s_speed_cap),
+                    2500);
+  }
+  return std::min(speed, s_speed_cap);
+}
+
+void Write(Memory::MemoryManager& memory)
+{
+  const int speed = EffectiveSpeed(
+      memory, s_speed_pending ? s_speed_pending : Config::Get(Config::SKIES_BATTLE_SPEED));
+  memory.Write_U32(INPUT_MAGIC, INPUT);
+  // Percentages, held to the menus' range: a hand-edited Dolphin.ini can say anything.
+  const auto percent = [](const Config::Info<int>& info, int most) {
+    return static_cast<u32>(std::clamp(Config::Get(info), 0, most));
+  };
+  memory.Write_U32(percent(Config::SKIES_ENCOUNTERS, ENCOUNTER_RATES.back()), INPUT + 4);
+  memory.Write_U32(percent(Config::SKIES_EXP, REWARD_RATES.back()), INPUT + 8);
+  memory.Write_U32(percent(Config::SKIES_GOLD, REWARD_RATES.back()), INPUT + 12);
+  memory.Write_U32(percent(Config::SKIES_MAGIC_EXP, REWARD_RATES.back()), INPUT + 16);
+  memory.Write_U32(static_cast<u32>(std::clamp(speed, 1, 4)), INPUT + 20);
+  const int invincible =
+      s_invincible_pending >= 0 ? s_invincible_pending : Config::Get(Config::SKIES_INVINCIBLE);
+  memory.Write_U32(invincible ? 1 : 0, INPUT + 24);
+
+  const bool hold = InBattle(memory) && speed >= 2;
+  if (hold != s_interpolation_held)
+  {
+    s_interpolation_held = hold;
+    FrameInterpolator::RequestEnabled(!hold && Config::Get(Config::SKIES_FRAME_MODE) >= 1);
+  }
+
+  const float overclock = InBattle(memory) && speed >= 3 ? std::clamp(speed, 1, 4) / 2.0f : 1.0f;
+  if (overclock != s_overclock)
+  {
+    s_overclock = overclock;
+    s_overclock_pending = overclock;
+  }
+}
+
+void ApplyOverclock(float factor)
+{
+  if (factor > 1.0f)
+  {
+    Config::SetCurrent(Config::MAIN_OVERCLOCK, factor);
+    Config::SetCurrent(Config::MAIN_OVERCLOCK_ENABLE, true);
+  }
+  else
+  {
+    Config::DeleteKey(Config::LayerType::CurrentRun, Config::MAIN_OVERCLOCK);
+    Config::DeleteKey(Config::LayerType::CurrentRun, Config::MAIN_OVERCLOCK_ENABLE);
+  }
+}
+
+// L3 / R3: the stick clicks of controller 1's real device. They aren't GameCube buttons, so they're
+// read from the device itself: "Thumb L" / "Thumb R" on desktop (SDL, XInput, WGInput), "Button
+// L3" / "Button R3" on Android. The device is looked up again every 2 s (it can be reconnected).
+bool StickClick()
+{
+  static std::weak_ptr<ciface::Core::Device> s_device;
+  static std::vector<ciface::Core::Device::Input*> s_inputs;
+  static Clock::time_point s_next_lookup;
+  const Clock::time_point now = Clock::now();
+  std::shared_ptr<ciface::Core::Device> device = s_device.lock();
+  if (!device || now >= s_next_lookup)
+  {
+    s_next_lookup = now + std::chrono::seconds(2);
+    device = g_controller_interface.FindDevice(Pad::GetConfig()->GetController(0)->GetDefaultDevice());
+    s_device = device;
+    s_inputs.clear();
+    if (device)
+    {
+      for (const char* name : {"Thumb L", "Thumb R", "Button L3", "Button R3"})
+      {
+        if (ciface::Core::Device::Input* input = device->FindInput(name))
+          s_inputs.push_back(input);
+      }
+    }
+  }
+  if (!device)
+    return false;
+  return std::ranges::any_of(s_inputs, [](auto* input) { return input->GetState() > 0.5; });
+}
+
+// A new stick click: toggle Invincible (saved and shown once the lock is let go).
+void PollStickClick()
+{
+  const bool down = StickClick();
+  if (down && !s_stick_click)
+  {
+    const int now_on =
+        s_invincible_pending >= 0 ? s_invincible_pending : Config::Get(Config::SKIES_INVINCIBLE);
+    s_invincible_pending = now_on ? 0 : 1;
+  }
+  s_stick_click = down;
+}
+
+// Z tapped in battle: next speed, saved and shown once the lock is let go.
+void CycleSpeed()
+{
+  const int speed = s_speed_pending ? s_speed_pending : Config::Get(Config::SKIES_BATTLE_SPEED);
+  s_speed_pending = speed >= 4 ? 1 : speed + 1;
+}
+}  // namespace qol
+
+// Auto-save: every [Skies] AutoSave minutes a save state goes to the oldest of slots 6-8, but only
+// at a quiet moment: on the field or world map (game mode 6, outside a ship battle, which runs in
+// mode 6 too) and with the memory card left alone for a while (a state doesn't hold a card transfer
+// in progress). Waits for such a moment once it's due.
+namespace autosave
+{
+constexpr u32 GAME_MODE = 0x803475CC;          // 6 = field / world map
+constexpr double CARD_QUIET_SECONDS = 10.0;
+
+Clock::time_point s_due{};
+int s_minutes = 0;
+bool s_pending = false;  // a save to start once the lock is let go
+
+void Poll(Memory::MemoryManager& memory)
+{
+  const int minutes = Config::Get(Config::SKIES_AUTO_SAVE);
+  const Clock::time_point now = Clock::now();
+  if (minutes <= 0)
+  {
+    s_due = {};
+    s_minutes = 0;
+    return;
+  }
+  if (s_due == Clock::time_point{} || minutes != s_minutes)
+  {
+    s_minutes = minutes;
+    s_due = now + std::chrono::minutes(minutes);
+    return;
+  }
+  if (now < s_due || memory.Read_U32(GAME_MODE) != 6 || InShipBattle(memory) ||
+      ExpansionInterface::CEXIMemoryCard::SecondsSinceLastAccess() < CARD_QUIET_SECONDS)
+  {
+    return;
+  }
+  s_due = now + std::chrono::minutes(minutes);
+  s_pending = true;
+}
+
+// Host thread: the oldest auto-saves go so that, with this one, the newest AUTO_KEEP remain.
+void Save(Core::System& system)
+{
+  const std::filesystem::path directory = StateDirectory();
+  std::error_code ec;
+  std::filesystem::create_directories(directory, ec);
+  State::Layout::PruneAutomatic(directory, AUTO_KEEP - 1, AUTO_PREFIX);
+  const std::string path =
+      (directory / State::Layout::TimestampedName(std::time(nullptr), AUTO_PREFIX)).string();
+  NOTICE_LOG_FMT(CORE, "[skies] auto-save to {}", path);
+  State::SaveAs(system, path);
+}
+}  // namespace autosave
+
+// Continue from a memory card save (the launchers' Continue, when the card save is the newest):
+// the game patch loads it at boot without the title or load screen (patches/game/autoload.c,
+// decomp ui.md *Loading a save without the load screen*). This hands it the request, at a fixed
+// address, on the first frame drawn, then reports what the game says. A DOL without the patch,
+// or a request that comes after the title has moved on, leaves the title as it is.
+namespace autoload
+{
+const Config::Info<int> AUTO_LOAD_CARD{{Config::System::Main, "Skies", "AutoLoadCard"}, 0};
+constexpr u32 REQUEST = 0x80002EF0;      // autoload.c's load_request: magic, file, status, error
+constexpr u32 REQUEST_MAGIC = 0x4C4F4144;  // 'LOAD'
+constexpr u32 HOOK_SITE = 0x801DC350;    // the title's call, redirected to dl_title by the patch
+constexpr u32 HOOK_ORIGINAL = 0x4804C6D1;  // bl fn_80228A20
+constexpr u32 GAME_MODE = 0x803475CC;
+constexpr u32 TITLE_STATE = 0x80311AE0;  // lbl_80311AD4[3]
+enum : u32
+{
+  PENDING = 0,
+  RUNNING = 1,
+  DONE = 2,
+  FAILED = 3,
+};
+
+int s_file = 0;  // 1..99: the file asked for (0 = nothing running)
+Clock::time_point s_deadline;
+
+void Stop(const char* message)
+{
+  s_file = 0;
+  if (message)
+    OSD::AddMessage(message, 6000);
+  NOTICE_LOG_FMT(CORE, "[skies] auto-load: {}", message ? message : "done");
+}
+
+bool Active()
+{
+  if (s_file > 0)
+    return true;
+  // One shot, set by the launcher for the boot it starts and consumed here at once (checked while
+  // no auto-load runs: Android keeps the process between boots)
+  const int file = Config::Get(AUTO_LOAD_CARD);
+  if (file == 0)
+    return false;
+  // Not before the DOL is in memory (its data section would overwrite the request)
+  auto& memory = Core::System::GetInstance().GetMemory();
+  if (!memory.GetRAM())
+    return false;
+  const u32 site = memory.Read_U32(HOOK_SITE);
+  if (site >> 26 != 18)  // not a bl yet
+    return false;
+  Config::SetBase(AUTO_LOAD_CARD, 0);
+  Config::Save();
+  if (file < 1 || file > 99)
+    return false;
+  if (site == HOOK_ORIGINAL)
+  {
+    Stop("This game patch can't load a save directly: load it on the title screen");
+    return false;
+  }
+  memory.Write_U32(0, REQUEST + 8);
+  memory.Write_U32(0, REQUEST + 12);
+  memory.Write_U32(static_cast<u32>(file), REQUEST + 4);
+  memory.Write_U32(REQUEST_MAGIC, REQUEST);
+  s_file = file;
+  s_deadline = Clock::now() + std::chrono::seconds(30);
+  OSD::AddMessage(fmt::format("Loading your memory card save (file {})...", file), 3000);
+  NOTICE_LOG_FMT(CORE, "[skies] auto-load: file {}", file);
+  return true;
+}
+
+GCPadStatus Drive(const GCPadStatus& raw)
+{
+  auto& memory = Core::System::GetInstance().GetMemory();
+  const u32 status = memory.Read_U32(REQUEST + 8);
+  if (status == DONE)
+  {
+    memory.Write_U32(0, REQUEST);
+    Stop(nullptr);
+  }
+  else if (status == FAILED)
+  {
+    const u32 error = memory.Read_U32(REQUEST + 12);
+    memory.Write_U32(0, REQUEST);
+    Stop(error == 1 ? "Your memory card save wasn't found on card A" :
+         error == 2 ? "The memory card couldn't be read" :
+                      "That memory card save is damaged");
+  }
+  else if (status == PENDING && ((memory.Read_U32(GAME_MODE) == 3 &&
+                                  memory.Read_U32(TITLE_STATE) > 1) ||
+                                 memory.Read_U32(GAME_MODE) == 6))
+  {
+    // The title went on (to the title proper, or the intro's field scenes) before the request
+    // arrived
+    memory.Write_U32(0, REQUEST);
+    Stop("Couldn't load your save directly: load it on the title screen");
+  }
+  else if (Clock::now() > s_deadline)
+  {
+    memory.Write_U32(0, REQUEST);
+    Stop("Loading your save took too long");
+  }
+  return raw;
+}
+}  // namespace autoload
+
+GCPadStatus FilterClosed(const GCPadStatus& raw)
+{
+  GCPadStatus out = raw;
+  const bool z = raw.button & PAD_TRIGGER_Z;
+  const bool start = raw.button & PAD_BUTTON_START;
+  const Clock::time_point now = Clock::now();
+  const float dt = std::clamp(std::chrono::duration<float>(now - camera::s_last_poll).count(), 0.0f, 0.1f);
+  camera::s_last_poll = now;
+
+  auto& memory = Core::System::GetInstance().GetMemory();
+  const bool qol_present = qol::Present(memory);
+  if (qol_present)
+  {
+    qol::PollStickClick();
+    qol::Write(memory);
+  }
+  autosave::Poll(memory);
+  const camera::Context context = camera::ReadContext(memory);
+  const bool camera_on = context.movable && Config::Get(Config::SKIES_CAMERA_CONTROL) != 0;
+
+  if (z && !s_z_held_back && !s_z_passed)
+  {
+    s_z_held_back = true;
+    s_z_camera_used = false;
+    s_z_down = now;
+  }
+  // Z+Start opens the menu however long Z was held first: also once Z has been passed on to the
+  // game (where it was held back only briefly).
+  if (z && start && (s_z_held_back || s_z_passed))
+  {
+    s_z_held_back = false;
+    Open();
+    return Released(raw);
+  }
+  if (camera_on)
+  {
+    if (camera::Update(context, raw, s_z_held_back && z, dt))
+      s_z_camera_used = true;
+    camera::Write(memory, context, true);
+    if (s_z_held_back && z)
+    {
+      // The camera has the C-stick's tilt (and on the world map its turn) and the triggers.
+      out.substickY = GCPadStatus::C_STICK_CENTER_Y;
+      if (context.world_map)
+        out.substickX = GCPadStatus::C_STICK_CENTER_X;
+      out.triggerLeft = 0;
+      out.triggerRight = 0;
+      out.button &= ~(PAD_TRIGGER_Z | PAD_TRIGGER_L | PAD_TRIGGER_R);
+      return out;
+    }
+  }
+  else if (context.movable)
+  {
+    camera::Write(memory, context, false);
+  }
+  if (s_z_held_back)
+  {
+    if (!z)
+    {
+      // Released before Start came (and without moving the camera): in battle that's the battle
+      // speed (the game doesn't use Z there), elsewhere the game gets its tap late.
+      s_z_held_back = false;
+      if (qol_present && qol::InBattle(memory))
+        qol::CycleSpeed();
+      else if (!s_z_camera_used)
+        s_z_replay_polls = 4;
+    }
+    else if (now - s_z_down < Z_HOLD_BACK || (qol_present && qol::InBattle(memory)))
+    {
+      // In battle the game has no use for Z: held back until it's released (a tap: the battle
+      // speed) or Start comes (the menu).
+      out.button &= ~PAD_TRIGGER_Z;
+      return out;
+    }
+    else
+    {
+      s_z_held_back = false;
+      s_z_passed = true;
+    }
+  }
+  if (!z)
+    s_z_passed = false;
+  if (s_z_replay_polls > 0)
+  {
+    --s_z_replay_polls;
+    out.button |= PAD_TRIGGER_Z;
+  }
+  return out;
+}
+
+GCPadStatus FilterOpen(const GCPadStatus& raw)
+{
+  const std::span<const Option> rows = TABS[s_tab].rows;
+  const bool on_tabs = s_selected == TAB_BAR;
+  const u16 pressed = Pressed(MenuButtons(raw), !on_tabs && rows[s_selected] == Option::Volume);
+  const int tab_count = static_cast<int>(TABS.size());
+  const auto switch_tab = [&](int direction) {
+    s_tab = (s_tab + direction + tab_count) % tab_count;
+    s_load_confirm = false;
+  };
+  if (pressed & (PAD_TRIGGER_L | PAD_TRIGGER_R))
+  {
+    switch_tab((pressed & PAD_TRIGGER_R) ? 1 : -1);
+    if (!on_tabs)
+      s_selected = 0;
+    return Released(raw);
+  }
+  const int count = static_cast<int>(rows.size());
+  if (on_tabs)
+  {
+    // The tab bar: Left / Right switch tabs, Down or A go into the tab's settings
+    if (pressed & PAD_BUTTON_LEFT)
+      switch_tab(-1);
+    if (pressed & PAD_BUTTON_RIGHT)
+      switch_tab(1);
+    if (pressed & (PAD_BUTTON_DOWN | PAD_BUTTON_A))
+      s_selected = 0;
+    else if (pressed & PAD_BUTTON_UP)
+      s_selected = static_cast<int>(TABS[s_tab].rows.size()) - 1;
+    else if (pressed & (PAD_BUTTON_B | PAD_BUTTON_START))
+      Close();
+    return Released(raw);
+  }
+  if (pressed & (PAD_BUTTON_UP | PAD_BUTTON_DOWN))
+    s_load_confirm = false;
+  // Up from the first setting and Down from the last reach the tab bar
+  if (pressed & PAD_BUTTON_UP)
+    s_selected = s_selected == 0 ? TAB_BAR : s_selected - 1;
+  else if (pressed & PAD_BUTTON_DOWN)
+    s_selected = s_selected == count - 1 ? TAB_BAR : s_selected + 1;
+  if (s_selected == TAB_BAR)
+    return Released(raw);
+  const Option option = rows[s_selected];
+  if (pressed & PAD_BUTTON_LEFT)
+    Change(option, -1, false);
+  if (pressed & PAD_BUTTON_RIGHT)
+    Change(option, 1, false);
+  if (pressed & PAD_BUTTON_A)
+  {
+    if (option == Option::SaveState)
+    {
+      s_state_action = StateAction::Save;
+      s_state_path = SlotPath(s_save_slot);
+      Close();
+    }
+    else if (option == Option::LoadState)
+    {
+      // Loading throws away the play since that state, so it takes a second A.
+      if (s_slot_time[s_load_slot] != 0)
+      {
+        if (s_load_confirm)
+        {
+          s_state_action = StateAction::Load;
+          s_state_path = s_load_slot == 0 ? s_newest_auto : SlotPath(s_load_slot);
+          Close();
+        }
+        s_load_confirm = true;
+      }
+    }
+    else
+    {
+      Change(option, 1, true);
+    }
+  }
+  else if (pressed & (PAD_BUTTON_B | PAD_BUTTON_START))
+  {
+    Close();
+  }
+  return Released(raw);
+}
+
+const char* OnOff(bool value)
+{
+  return value ? "On" : "Off";
+}
+}  // namespace
+
+// 60 fps a device can't keep up with: after 20 s in a row under 90% speed (not in a fast battle,
+// which turns the in-between frames off anyway, and not in the first minute, when shaders compile)
+// the menu opens once by itself on Frame rate and says why. The player decides: nothing switches
+// by itself, and it never opens like this again.
+namespace slowprompt
+{
+Clock::time_point s_started{};
+Clock::time_point s_slow_since{};
+
+// Under the lock, with the menu closed. True when it opened the menu.
+bool Poll()
+{
+  const Clock::time_point now = Clock::now();
+  if (s_started == Clock::time_point{})
+    s_started = now;
+  if (Config::Get(Config::SKIES_FRAME_MODE) < 1 || qol::s_interpolation_held ||
+      Config::Get(SLOW_NOTE_SHOWN) || now - s_started < std::chrono::seconds(60) ||
+      Core::System::GetInstance().GetPerfMetrics().GetSpeed() >= 0.90)
+  {
+    s_slow_since = {};
+    return false;
+  }
+  if (s_slow_since == Clock::time_point{})
+    s_slow_since = now;
+  if (now - s_slow_since < std::chrono::seconds(20))
+    return false;
+  s_slow_since = {};
+  Open();
+  for (int t = 0; t < static_cast<int>(TABS.size()); ++t)
+  {
+    const auto& rows = TABS[t].rows;
+    const auto found = std::find(rows.begin(), rows.end(), Option::FrameRate);
+    if (found != rows.end())
+    {
+      s_tab = t;
+      s_selected = static_cast<int>(found - rows.begin());
+    }
+  }
+  s_slow_note = true;
+  s_slow_note_save = true;
+  NOTICE_LOG_FMT(CORE, "[skies] 60 fps below full speed for 20 s: menu opened on Frame rate");
+  return true;
+}
+}  // namespace slowprompt
+
+GCPadStatus FilterPad(int pad_num, const GCPadStatus& raw)
+{
+  if (pad_num != 0 || !IsSkies())
+    return raw;
+  std::unique_lock lock(s_mutex);
+  GCPadStatus out = raw;
+  switch (s_mode)
+  {
+  case Mode::Closed:
+    out = autoload::Active() ? autoload::Drive(raw) : FilterClosed(raw);
+    if (s_mode == Mode::Closed && !autoload::Active() && slowprompt::Poll())
+      out = Released(raw);
+    break;
+  case Mode::Open:
+    out = FilterOpen(raw);
+    break;
+  case Mode::Closing:
+    if (MenuButtons(raw) != 0)
+    {
+      out = Released(raw);
+    }
+    else
+    {
+      s_mode = Mode::Closed;
+      s_z_held_back = false;
+      s_z_passed = false;
+    }
+    break;
+  }
+  if (qol::s_invincible_pending >= 0)
+  {
+    const int on = qol::s_invincible_pending;
+    qol::s_invincible_pending = -1;
+    lock.unlock();
+    Config::SetBase(Config::SKIES_INVINCIBLE, on);
+    Config::Save();
+    OSD::AddMessage(on ? "Invincible: on (HP, MP and Spirit full in battle)" : "Invincible: off",
+                    2000);
+    return out;
+  }
+  if (s_slow_note_save)
+  {
+    s_slow_note_save = false;
+    lock.unlock();
+    Config::SetBase(SLOW_NOTE_SHOWN, true);
+    Config::Save();
+    return out;
+  }
+  if (qol::s_overclock_pending > 0.0f)
+  {
+    const float factor = qol::s_overclock_pending;
+    qol::s_overclock_pending = 0.0f;
+    lock.unlock();
+    qol::ApplyOverclock(factor);
+    return out;
+  }
+  if (qol::s_speed_pending)
+  {
+    const int speed = qol::s_speed_pending;
+    qol::s_speed_pending = 0;
+    lock.unlock();
+    Config::SetBase(Config::SKIES_BATTLE_SPEED, speed);
+    Config::Save();
+    OSD::AddMessage(speed <= 1 ? "Battle speed: normal" : fmt::format("Battle speed: {}x", speed),
+                    1500);
+    return out;
+  }
+  // Save states run as host jobs: the host thread pauses the emulation at a safe point (a load from
+  // in here, the middle of the game's pad read, would pull the CPU state out from under it).
+  const StateAction state_action = s_state_action;
+  const std::string state_path = s_state_path;
+  const bool auto_save = autosave::s_pending;
+  s_state_action = StateAction::None;
+  autosave::s_pending = false;
+  if (s_apply_pending)
+  {
+    s_apply_pending = false;
+    const Values values = s_apply_values;
+    const Values before = s_apply_before;
+    lock.unlock();
+    Apply(values, before);
+  }
+  else
+  {
+    lock.unlock();
+  }
+  if (state_action == StateAction::Save)
+  {
+    NOTICE_LOG_FMT(CORE, "[skies] save state to {}", state_path);
+    Core::QueueHostJob([state_path](Core::System& system) {
+      std::error_code ec;
+      std::filesystem::create_directories(StateDirectory(), ec);
+      State::SaveAs(system, state_path);
+    });
+  }
+  else if (state_action == StateAction::Load)
+  {
+    NOTICE_LOG_FMT(CORE, "[skies] load state from {}", state_path);
+    Core::QueueHostJob([state_path](Core::System& system) { State::LoadAs(system, state_path); });
+  }
+  if (auto_save)
+    Core::QueueHostJob([](Core::System& system) { autosave::Save(system); });
+  return out;
+}
+
+bool IsOpen()
+{
+  std::lock_guard lock(s_mutex);
+  return s_mode == Mode::Open;
+}
+
+// Video thread only: the menu's typefaces (LoadFonts), null = ImGui's default (the OSD font).
+ImFont* s_ui_font = nullptr;
+ImFont* s_title_font = nullptr;
+
+void LoadFonts()
+{
+  // The launchers' faces: Segoe UI on Windows (as the desktop launcher), Roboto on Android,
+  // DejaVu Sans on Linux. The OSD's own font (monospace) stays the default for Dolphin's messages.
+  const auto add = [](std::initializer_list<std::string> candidates) -> ImFont* {
+    for (const std::string& path : candidates)
+    {
+      if (!path.empty() && File::Exists(path))
+        return ImGui::GetIO().Fonts->AddFontFromFileTTF(path.c_str());
+    }
+    return nullptr;
+  };
+  const char* windir = std::getenv("windir");
+  const std::string windows = windir ? std::string(windir) + "\\Fonts\\" : std::string();
+  s_ui_font = add({windows.empty() ? "" : windows + "segoeui.ttf", "/system/fonts/Roboto-Regular.ttf",
+                   "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"});
+  s_title_font = add({windows.empty() ? "" : windows + "segoeuib.ttf",
+                      "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"});
+  if (!s_title_font)
+    s_title_font = s_ui_font;
+}
+
+void Draw(float scale)
+{
+  Values v;
+  int tab, selected;
+  int save_slot, load_slot, text_percent;
+  bool load_confirm, slow_note;
+  std::string save_time, load_time;
+  {
+    std::lock_guard lock(s_mutex);
+    // The direct load's request goes in as early as the first frame (controller polls start later,
+    // after the title has passed the point where it loads)
+    if (IsSkies() && autoload::Active())
+      autoload::Drive(GCPadStatus{});
+    if (s_mode != Mode::Open)
+      return;
+    v = s_staged;
+    tab = s_tab;
+    selected = s_selected;
+    save_slot = s_save_slot;
+    load_slot = s_load_slot;
+    text_percent = s_text_percent;
+    load_confirm = s_load_confirm;
+    slow_note = s_slow_note;
+    save_time = SlotTime(s_save_slot);
+    load_time = SlotTime(s_load_slot);
+  }
+
+  struct Row
+  {
+    const char* label;
+    std::string value;
+    const char* description;
+  };
+  const auto row_of = [&](Option option) -> Row {
+    switch (option)
+    {
+    case Option::SaveState:
+      return {"Save state", fmt::format("Slot {}   {}", save_slot, save_time),
+              "Left / Right picks a slot, A saves to it."};
+    case Option::LoadState:
+      return {"Load state",
+              load_confirm   ? std::string("Press A again to load") :
+              load_slot == 0 ? fmt::format("Auto-save   {}", load_time) :
+                               fmt::format("Slot {}   {}", load_slot, load_time),
+              "Left / Right picks a slot or the newest auto-save, A twice loads it."};
+    case Option::AutoSave:
+      return {"Auto-save",
+              v.auto_save <= 0 ? std::string("Off") : fmt::format("Every {} min", v.auto_save),
+              "Saves your place at quiet moments. Continue picks up from the newest."};
+    case Option::Picture:
+      return {"Picture", v.widescreen ? "Widescreen 16:9" : "Original 4:3",
+              "Widescreen fills a 16:9 screen; Original keeps the GameCube's 4:3 picture."};
+    case Option::FrameRate:
+      return {"Frame rate", v.frame_mode ? "60 fps (interpolated)" : "30 fps (original)",
+              slow_note ? "This device runs the game below full speed at 60 fps. 30 fps keeps it "
+                          "at full speed; 60 fps stays if you keep it." :
+                          "60 fps adds in-between frames for smoother motion. 30 fps is the original."};
+    case Option::Resolution:
+      return {"Resolution", ResolutionText(v.efb_scale),
+              "Higher is sharper but needs a faster graphics chip."};
+    case Option::Antialiasing:
+      return {"Anti-aliasing", MsaaText(v.msaa),
+              "Smooths jagged edges. Higher settings need a faster graphics chip."};
+    case Option::VSync:
+      return {"V-Sync", OnOff(v.vsync), "Stops screen tearing. Can add a little input delay."};
+    case Option::ShowFps:
+      return {"Show FPS", OnOff(v.show_fps), "Show the frame rate in a corner of the screen."};
+    case Option::Camera:
+      return {"Camera", v.camera ? "Hold Z to move" : "Original",
+              "Hold Z, then tilt with the C-stick and zoom with L / R. Original keeps the game's "
+              "fixed camera."};
+    case Option::BattleSpeed:
+      return {"Battle speed", SpeedText(v.battle_speed),
+              "Plays battles faster. Tap Z during a battle to switch speeds."};
+    case Option::Encounters:
+      return {"Encounters", RateText(v.encounters),
+              "How often random battles happen. Off means none."};
+    case Option::Exp:
+      return {"EXP", RateText(v.exp), "Experience from battles, for levelling up."};
+    case Option::Gold:
+      return {"Gold", RateText(v.gold), "Gold won from battles."};
+    case Option::MagicExp:
+      return {"Magic EXP", RateText(v.magic_exp),
+              "Magic experience from battles, for learning new spells."};
+    case Option::Invincible:
+      return {"Invincible", v.invincible ? "On (L3 / R3)" : "Off (L3 / R3)",
+              "Keeps the party's HP and MP full. L3 or R3 switches it in game."};
+    case Option::Volume:
+      return {"Volume", v.volume == 0 ? std::string("0% (muted)") : std::to_string(v.volume) + "%",
+              "Music and sound effects."};
+    case Option::DeadZone:
+      return {"Stick dead zone",
+              v.dead_zone <= 0 ? std::string("Off") : fmt::format("{}%", v.dead_zone),
+              "Ignores small stick movements. Raise it if a stick drifts."};
+    case Option::Rumble:
+      return {"Rumble", OnOff(v.rumble != 0), "Controller vibration."};
+    }
+    return {"", "", ""};
+  };
+  const std::span<const Option> options = TABS[tab].rows;
+  const bool on_tabs = selected == TAB_BAR;
+  const Option current = on_tabs ? options[0] : options[selected];
+  const char* const hint =
+      on_tabs                      ? "Left / Right or L / R: tab    Down or A: settings    B: close" :
+      current == Option::SaveState ? "L / R: tab    Up / Down: choose    Left / Right: slot    A: save    B: close" :
+      current == Option::LoadState ? "L / R: tab    Up / Down: choose    Left / Right: slot    A: load    B: close" :
+                                     "L / R: tab    Up / Down: choose    Left / Right or A: change    B: close";
+
+  // The layout is in units of the picture (a 480-line picture = 1 unit per pixel), times the
+  // launchers' text size, shrunk to fit the screen. Every length comes from these constants, not
+  // from last frame's measurements, so the menu can't settle between two sizes.
+  constexpr float PAD = 22.0f, LABEL_W = 190.0f, VALUE_W = 340.0f, CONTENT_W = 690.0f;
+  constexpr float TITLE = 24.0f, TEXT = 15.0f, SMALL = 12.5f;
+  constexpr float TITLE_H = 34.0f, TAB_H = 28.0f, BOX_H = 28.0f, ROW_GAP = 9.0f, FOOTER_H = 30.0f;
+  ImFont* const ui = s_ui_font ? s_ui_font : ImGui::GetFont();
+  ImFont* const bold = s_title_font ? s_title_font : ui;
+  const float desc_w = CONTENT_W - LABEL_W;
+  // One row's height (units): its value box and its description, wrapped
+  const auto row_height = [&](const Row& row, float unit) {
+    const float px = std::max(1.0f, std::floor(SMALL * unit));
+    const float desc = ui->CalcTextSizeA(px, FLT_MAX, desc_w * unit, row.description).y / unit;
+    return BOX_H + 3.0f + desc + ROW_GAP;
+  };
+  const auto window_height = [&](float unit) {
+    float tallest = 0.0f;
+    for (const Tab& t : TABS)
+    {
+      float h = 0.0f;
+      for (Option option : t.rows)
+        h += row_height(row_of(option), unit);
+      tallest = std::max(tallest, h);
+    }
+    return PAD + TITLE_H + 6.0f + TAB_H + 12.0f + tallest + FOOTER_H + PAD * 0.6f;
+  };
+  const ImGuiViewport* viewport = ImGui::GetMainViewport();
+  const float base = std::max(scale, viewport->Size.y / 480.0f) * text_percent / 100.0f;
+  const float width_units = CONTENT_W + 2.0f * PAD;
+  float u = base;
+  // Fit: twice, since the wrapped descriptions' height depends on the size
+  for (int pass = 0; pass < 2; ++pass)
+  {
+    const float fit = std::min(viewport->Size.x * 0.94f / (width_units * u),
+                               viewport->Size.y * 0.94f / (window_height(u) * u));
+    if (fit >= 1.0f)
+      break;
+    u *= fit;
+  }
+  const auto px = [&](float size) { return std::max(1.0f, std::floor(size * u)); };
+
+  const ImVec2 size(width_units * u, window_height(u) * u);
+  const ImVec2 origin(viewport->Pos.x + (viewport->Size.x - size.x) * 0.5f,
+                      viewport->Pos.y + (viewport->Size.y - size.y) * 0.5f);
+  const auto at = [&](float x, float y) { return ImVec2(origin.x + x * u, origin.y + y * u); };
+  ImDrawList* draw = ImGui::GetForegroundDrawList();
+  const ImU32 white = IM_COL32(242, 242, 242, 255);
+  const ImU32 gold = IM_COL32(255, 201, 74, 255);
+  const ImU32 dim = IM_COL32(168, 184, 214, 255);
+  const ImU32 blue = IM_COL32(41, 87, 173, 255);
+
+  // The game dimmed behind, the window
+  draw->AddRectFilled(viewport->Pos,
+                      ImVec2(viewport->Pos.x + viewport->Size.x, viewport->Pos.y + viewport->Size.y),
+                      IM_COL32(0, 5, 15, 110));
+  draw->AddRectFilled(origin, ImVec2(origin.x + size.x, origin.y + size.y),
+                      IM_COL32(9, 14, 28, 242), 14.0f * u);
+  draw->AddRect(origin, ImVec2(origin.x + size.x, origin.y + size.y), IM_COL32(255, 255, 255, 56),
+                14.0f * u, 0, std::max(1.0f, 1.5f * u));
+
+  float y = PAD;
+  draw->AddText(bold, px(TITLE), at(PAD, y), white, "Settings");
+  y += TITLE_H + 6.0f;
+
+  // Tabs: the current one blue with a gold line on top
+  float x = PAD;
+  for (int i = 0; i < static_cast<int>(TABS.size()); ++i)
+  {
+    const float text_w = ui->CalcTextSizeA(px(TEXT), FLT_MAX, 0.0f, TABS[i].name).x / u;
+    const float w = text_w + 26.0f;
+    const ImVec2 a = at(x, y), b = at(x + w, y + TAB_H);
+    draw->AddRectFilled(a, b, i == tab ? blue : IM_COL32(26, 41, 77, 230), 6.0f * u,
+                        ImDrawFlags_RoundCornersTop);
+    if (i == tab)
+      draw->AddRectFilled(a, ImVec2(b.x, a.y + std::max(1.0f, 2.5f * u)), gold, 6.0f * u,
+                          ImDrawFlags_RoundCornersTop);
+    // The tab bar has the focus: the current tab gets the gold edge, like a selected value
+    if (i == tab && on_tabs)
+      draw->AddRect(a, b, gold, 6.0f * u, ImDrawFlags_RoundCornersTop, std::max(1.0f, 2.0f * u));
+    draw->AddText(ui, px(TEXT), at(x + 13.0f, y + (TAB_H - TEXT * 1.33f) * 0.5f),
+                  i == tab ? white : IM_COL32(242, 242, 242, 200), TABS[i].name);
+    x += w + 6.0f;
+  }
+  y += TAB_H;
+  draw->AddRectFilled(at(PAD, y), at(PAD + CONTENT_W, y + 1.5f), blue);
+  y += 12.0f;
+
+  // Rows: label, value box (the selected one gold-edged, with arrows), description
+  for (int i = 0; i < static_cast<int>(options.size()); ++i)
+  {
+    const Row row = row_of(options[i]);
+    const bool is_selected = !on_tabs && i == selected;
+    const float text_y = y + (BOX_H - TEXT * 1.33f) * 0.5f;
+    draw->AddText(ui, px(TEXT), at(PAD, text_y), is_selected ? gold : white, row.label);
+    const ImVec2 box_a = at(PAD + LABEL_W, y), box_b = at(PAD + LABEL_W + VALUE_W, y + BOX_H);
+    draw->AddRectFilled(box_a, box_b,
+                        is_selected ? IM_COL32(41, 66, 118, 255) : IM_COL32(26, 41, 77, 255),
+                        6.0f * u);
+    if (is_selected)
+    {
+      draw->AddRect(box_a, box_b, gold, 6.0f * u, 0, std::max(1.0f, 2.0f * u));
+      const float mid = y + BOX_H * 0.5f, s = 5.0f;
+      const float lx = PAD + LABEL_W + 10.0f, rx = PAD + LABEL_W + VALUE_W - 10.0f;
+      draw->AddTriangleFilled(at(lx, mid), at(lx + s, mid - s), at(lx + s, mid + s), gold);
+      draw->AddTriangleFilled(at(rx, mid), at(rx - s, mid - s), at(rx - s, mid + s), gold);
+    }
+    const bool confirm = options[i] == Option::LoadState && load_confirm;
+    draw->AddText(ui, px(TEXT), at(PAD + LABEL_W + 22.0f, text_y), confirm ? gold : white,
+                  row.value.c_str());
+    draw->AddText(ui, px(SMALL), at(PAD + LABEL_W, y + BOX_H + 3.0f),
+                  slow_note && options[i] == Option::FrameRate ? gold : dim, row.description,
+                  nullptr, desc_w * u);
+    y += row_height(row, u);
+  }
+
+  // Footer: the controls for the selected row
+  const float footer_y = size.y / u - PAD * 0.6f - FOOTER_H;
+  draw->AddRectFilled(at(PAD, footer_y), at(PAD + CONTENT_W, footer_y + 1.0f),
+                      IM_COL32(255, 255, 255, 40));
+  draw->AddText(ui, px(SMALL), at(PAD, footer_y + 9.0f), dim, hint);
+}
+}  // namespace SkiesMenu
