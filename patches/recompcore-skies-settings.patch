+// The MSAA sample counts the video backend offers (1 = off).
+std::vector<int> MsaaModes()
+{
+  std::vector<int> modes;
+  for (const u32 mode : g_backend_info.AAModes)
+    modes.push_back(static_cast<int>(mode));
+  if (modes.empty())
+    modes.push_back(1);
+  return modes;
+}
