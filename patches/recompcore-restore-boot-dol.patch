+std::vector<u8> DVDThread::ReadBootDOL()
+{
+  WaitUntilIdle();
+  if (!m_disc)
+    return {};
+  const DiscIO::Partition partition = m_disc->GetGamePartition();
+  const std::optional<u64> offset = DiscIO::GetBootDOLOffset(*m_disc, partition);
+  if (!offset)
+    return {};
+  const std::optional<u32> size = DiscIO::GetBootDOLSize(*m_disc, partition, *offset);
+  // The size is the disc's own sum of section ends: a damaged or modded disc can claim up to 4 GiB.
+  // No DOL is bigger than the console's 24 MiB of RAM.
+  if (!size || *size > (24u << 20))
+    return {};
+  std::vector<u8> dol(*size);
+  if (!m_disc->Read(*offset, *size, dol.data(), partition))
+    return {};
+  return dol;
+}
