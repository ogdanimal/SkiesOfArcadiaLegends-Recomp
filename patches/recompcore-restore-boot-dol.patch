+// A savestate carries the guest code of the DOL that was running when it was made. If the game's
+// DOL has been patched since (a game patch built into the DOL, and the module recompiled from it),
+// an older state brings the old code back: its chunks then fail verification and run interpreted,
+// without the patch. ClearCache runs on every state load, after RAM is restored, so put the boot
+// DOL's text sections back here when they differ, along with its sections below the usual DOL start
+// (0x80003100), where such patches keep their own code and data. Nothing changes when RAM already
+// matches, which is always the case for an unpatched game whose code isn't modified at runtime.
+void StaticRecompCore::RestoreBootDolCode()
+{
+  // The first ClearCache comes while the core is set up, before the disc is inserted, so keep
+  // trying until the DOL has been read.
+  if (m_boot_dol.size() < 0x100)
+    m_boot_dol = m_system.GetDVDThread().ReadBootDOL();
+  if (m_boot_dol.size() < 0x100)
+    return;
+
+  struct Section
+  {
+    u32 offset, address, size;
+  };
+  const auto be32 = [this](u32 at) {
+    return (u32{m_boot_dol[at]} << 24) | (u32{m_boot_dol[at + 1]} << 16) |
+           (u32{m_boot_dol[at + 2]} << 8) | m_boot_dol[at + 3];
+  };
+  auto& memory = m_system.GetMemory();
+  const u32 ram_size = memory.GetRamSizeReal();
+  const auto fits = [&](const Section& s) {
+    return s.size != 0 && s.address >= 0x80000000u && s.address - 0x80000000u <= ram_size &&
+           s.size <= ram_size - (s.address - 0x80000000u) &&
+           u64{s.offset} + s.size <= m_boot_dol.size();
+  };
+  std::vector<Section> text, low_data;
+  for (u32 i = 0; i < 7; ++i)
+    text.push_back({be32(i * 4), be32(0x48 + i * 4), be32(0x90 + i * 4)});
+  for (u32 i = 0; i < 11; ++i)
+  {
+    const Section s{be32(0x1C + i * 4), be32(0x64 + i * 4), be32(0xAC + i * 4)};
+    if (s.address < 0x80003100u)
+      low_data.push_back(s);
+  }
+
+  u8* ram = memory.GetRAM();
+  u32 restored = 0;
+  for (const Section& s : text)
+  {
+    if (!fits(s))
+      continue;
+    u8* dst = ram + (s.address - 0x80000000u);
+    if (std::memcmp(dst, m_boot_dol.data() + s.offset, s.size) != 0)
+    {
+      std::memcpy(dst, m_boot_dol.data() + s.offset, s.size);
+      ++restored;
+    }
+  }
+  if (restored == 0)
+    return;
+  for (const Section& s : low_data)
+  {
+    if (fits(s))
+      std::memcpy(ram + (s.address - 0x80000000u), m_boot_dol.data() + s.offset, s.size);
+  }
+  m_system.GetPPCState().iCache.Cache::Reset();
+  std::fprintf(stderr,
+               "[staticrecomp] state load: restored %u code section(s) of the boot DOL "
+               "(the state was made with different code)\n",
+               restored);
+}
