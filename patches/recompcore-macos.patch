+  static const bool readable = CGPreflightListenEventAccess();
+  return readable;
+}
+}  // namespace
+
+void KeyEvent(unsigned short keycode, bool down)
+{
+  if (keycode < s_event_keys.size())
+    s_event_keys[keycode] = down;
+}
+
+void ModifierEvent(unsigned short keycode, unsigned long modifier_flags)
+{
+  // Each side's device-dependent flag (IOLLEvent.h NX_DEVICE*KEYMASK)
+  static const std::map<unsigned short, unsigned long> side_flags = {
+      {kVK_Control, 0x1},     {kVK_Shift, 0x2},          {kVK_RightShift, 0x4},
+      {kVK_Command, 0x8},     {kVK_RightCommand, 0x10},  {kVK_Option, 0x20},
+      {kVK_RightOption, 0x40}, {kVK_RightControl, 0x2000},
+  };
+  if (const auto it = side_flags.find(keycode); it != side_flags.end())
+    KeyEvent(keycode, (modifier_flags & it->second) != 0);
+  else if (keycode == kVK_CapsLock)
+    KeyEvent(keycode, (modifier_flags & NSEventModifierFlagCapsLock) != 0);
+  else if (keycode == kVK_Function)
+    KeyEvent(keycode, (modifier_flags & NSEventModifierFlagFunction) != 0);
+}
+
+void ReleaseEventKeys()
+{
+  for (auto& key : s_event_keys)
+    key = false;
+}
+
 KeyboardAndMouse::Key::Key(CGKeyCode keycode) : m_keycode(keycode), m_name(KeycodeToName(keycode))
 {
 }
 
 ControlState KeyboardAndMouse::Key::GetState() const
 {
+  if (!HIDKeysReadable())
+    return s_event_keys[m_keycode].load();
   return CGEventSourceKeyState(kCGEventSourceStateHIDSystemState, m_keycode) != 0;
 }
 
