 JNIEXPORT jstring JNICALL Java_org_dolphinemu_dolphinemu_skies_SkiesNative_useStateFolder(
     JNIEnv* env, jclass, jstring game_root, jstring patch)
 {
-  const fs::path folder = moderngekko::frontend::StateDirectory(
