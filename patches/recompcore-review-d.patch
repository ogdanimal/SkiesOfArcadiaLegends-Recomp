+    private fun startTask(title: String, name: String, publish: (Array<String>) -> Unit,
+                          work: () -> Array<String>): Boolean {
+        if (importRunning) {
+            showImporting()
+            return false
+        }
+        importRunning = true
+        importTitle = title
+        Thread({
+            var result = arrayOf("It stopped.", "")
+            try {
+                result = work()
+            } catch (e: Exception) {
+                result = arrayOf("It stopped: ${e.message}", "")
+            } finally {
+                importStep = ""
+                importTitle = ""
+                publish(result)
+                importRunning = false
+            }
+        }, name).start()
+        showImporting()
+        return true
