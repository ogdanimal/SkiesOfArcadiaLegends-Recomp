+        /** Copies a save, refusing more than the largest file the import accepts (a save state). */
+        private fun copyCapped(input: java.io.InputStream, output: java.io.OutputStream) {
+            val buffer = ByteArray(1 shl 16)
+            var total = 0L
+            while (true) {
+                val n = input.read(buffer)
+                if (n < 0) break
+                total += n
+                if (total > MAX_IMPORT_BYTES) throw java.io.IOException("it is too big to be a save")
+                output.write(buffer, 0, n)
+            }
+        }
+
+        private fun isZip(file: File): Boolean {
+            val head = ByteArray(4)
+            val n = file.inputStream().use { it.read(head) }
+            return n == 4 && head.contentEquals(byteArrayOf(0x50, 0x4B, 0x03, 0x04))
+        }
+
+        /**
+         * Import a save, given a backup (Back up saves): each file in it imported as if picked on its own,
+         * oldest first, so the newest save state is still the one Continue picks. Stops if the game
+         * starts meanwhile (it would read the memory card while files are still written there).
+         */
+        private fun importBackup(file: File, cache: File, user: String): Array<String> {
+            java.util.zip.ZipFile(file).use { zip ->
+                val entries = zip.entries().toList().filter { !it.isDirectory }.sortedBy { it.time }
+                if (entries.isEmpty()) return arrayOf("That .zip has no saves in it.", "")
+                if (entries.size > MAX_BACKUP_ENTRIES) return arrayOf("That .zip holds too many files to be a backup of saves.", "")
+                var imported = 0
+                var failure = ""
+                for ((i, entry) in entries.withIndex()) {
+                    if (org.dolphinemu.dolphinemu.NativeLibrary.IsRunning()) {
+                        return arrayOf("The game started during the import, so it stopped: imported " +
+                            "$imported of ${entries.size} files from the backup.", "")
+                    }
+                    importStep = "File ${i + 1} of ${entries.size}"
+                    val part = File.createTempFile("save-import", null, cache)
+                    try {
+                        zip.getInputStream(entry).use { input -> part.outputStream().use { output -> copyCapped(input, output) } }
+                        val result = SkiesNative.importSave(part.absolutePath, user)
+                        if (result.getOrNull(1) == "ok") imported++
+                        else if (failure.isEmpty()) failure = "\n${entry.name.substringAfterLast('/')}: ${result[0]}"
+                    } finally {
+                        part.delete()
+                    }
+                }
+                return arrayOf("Imported $imported of ${entries.size} files from the backup.$failure",
+                    if (imported == entries.size) "ok" else "")
+            }
+        }
     }
 
