+      return false;
+    for (const char c : part)
+    {
+      if (static_cast<unsigned char>(c) < 0x20 || c == ':' || c == '\\')
+        return false;
+    }
+    if (end == std::string_view::npos)
+      return true;
+    start = end + 1;
+  }
+}
