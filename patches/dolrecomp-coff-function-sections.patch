diff --git a/src/backend/llvm/target.cpp b/src/backend/llvm/target.cpp
index 36dc8fa..d4280cc 100644
--- a/src/backend/llvm/target.cpp
+++ b/src/backend/llvm/target.cpp
@@ -128,6 +128,17 @@ static CodeGenOptLevel codegenLevel(int level) {
   return CodeGenOptLevel::Aggressive;
 }
 
+// COFF only puts PGO's hot / unlikely function prefixes in the section name (.text$hot,
+// .text$unlikely, which the linker groups across every chunk) with a section per function;
+// without one, a chunk's functions all go to its plain .text, hot and cold interleaved chunk by
+// chunk. ELF names the prefixes either way (.text.hot. / .text.unlikely.).
+// DOLRECOMP_FUNCTION_SECTIONS=0 keeps the old layout (A/B measurements).
+bool functionSections(const TargetProfile &profile) {
+  if (const char *set = std::getenv("DOLRECOMP_FUNCTION_SECTIONS"); set && set[0] == '0')
+    return false;
+  return Triple(profile.triple).isOSBinFormatCOFF();
+}
+
 std::unique_ptr<TargetMachine>
 createTargetMachine(const TargetProfile &profile, int optimization_level,
                     DolLLVMSemantics semantics,
@@ -140,6 +151,7 @@ createTargetMachine(const TargetProfile &profile, int optimization_level,
   options.AllowFPOpFusion = semantics == DOLLLVM_SEMANTICS_FAST
                                 ? FPOpFusion::Fast
                                 : FPOpFusion::Strict;
+  options.FunctionSections = functionSections(profile);
   return std::unique_ptr<TargetMachine>(target->createTargetMachine(
       profile.triple, profile.cpu, profile.features, options, Reloc::PIC_,
       std::nullopt, codegenLevel(optimization_level)));
