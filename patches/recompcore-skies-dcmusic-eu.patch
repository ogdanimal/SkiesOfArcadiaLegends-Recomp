+// The releases the app runs, each with its DOL patch among the APK's assets (the app copies them to
+// one folder) and its module, libg<ID>_recomp.so.
+struct Region
+{
+  const char* id;
+  const char* patch;
+  const char* name;
+};
+constexpr Region REGIONS[] = {{"GEAE8P", "skies-widescreen.dolpatch", "USA"},
+                              {"GEAP8P", "skies-widescreen-eu.dolpatch", "European"}};
+
+const Region* FindRegion(const std::string& id)
+{
+  for (const Region& region : REGIONS)
+  {
+    if (id == region.id)
+      return &region;
+  }
+  return nullptr;
+}
+
+// The game imported in the user directory (Games/<ID>; the USA one if there's none yet).
+const Region& InstalledRegion(const fs::path& user_directory)
+{
+  std::error_code ec;
+  for (const Region& region : REGIONS)
+  {
+    if (fs::is_regular_file(user_directory / "Games" / region.id / "sys" / "main.dol", ec))
+      return region;
+  }
+  return REGIONS[0];
+}
+
+// A DOL patch's "output-sha256" line: the build the region's module was made from (the APK's build
+// checks that it is).
+std::string PatchOutputSha256(const fs::path& patch)
+{
+  std::string text;
+  if (!File::ReadFileToString(patch.string(), text))
+    return "";
+  const std::size_t at = text.find("\noutput-sha256 ");
+  if (at == std::string::npos)
+    return "";
+  const std::size_t start = at + std::string_view("\noutput-sha256 ").size();
+  return text.substr(start, text.find('\n', start) - start);
+}
 
