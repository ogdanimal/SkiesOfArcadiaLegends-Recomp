+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "AudioCommon/DCMusic.h"
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <deque>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <vector>
+
+#include "Common/CommonPaths.h"
+#include "Common/FileUtil.h"
+#include "Common/Logging/Log.h"
