+# The Skies of Arcadia Legends recomp's Dreamcast music (DCMusic.cpp) runs the Dreamcast sound chip
+# with Highly Theoretical's AICA + ARM7 emulation (GPL-3; the repo's lib/HighlyTheoretical).
+set(SKIES_HT_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../../../../../../HighlyTheoretical" CACHE PATH
+    "Highly Theoretical source (its Core/ directory has dcsound.c)")
+if(EXISTS "${SKIES_HT_DIR}/Core/dcsound.c")
+  message(STATUS "Highly Theoretical found, enabling the Dreamcast music")
+  add_library(dcsound STATIC
+    "${SKIES_HT_DIR}/Core/dcsound.c"
+    "${SKIES_HT_DIR}/Core/arm.c"
+    "${SKIES_HT_DIR}/Core/yam.c"
+  )
+  target_compile_definitions(dcsound PRIVATE EMU_COMPILE EMU_LITTLE_ENDIAN HAVE_STDINT_H DISABLE_SSF)
+  # yam.c defines __fastcall as __attribute__((regparm(3))) on every non-Windows target, and only
+  # x86 compilers accept regparm (arm64 Android: "'regparm' is not valid on this platform"). An
+  # empty regparm(x) leaves an empty attribute list there (a compile option: CMake drops
+  # function-style macros from compile definitions).
+  if(NOT WIN32 AND NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(i.86|x86|x86_64|AMD64|amd64)$")
+    target_compile_options(dcsound PRIVATE "-Dregparm(x)=")
+  endif()
+  target_include_directories(dcsound PUBLIC "${SKIES_HT_DIR}/Core")
+  # Third-party code: none of Dolphin's warnings (MSVC builds them as errors)
+  if(MSVC)
+    target_compile_options(dcsound PRIVATE /W0 /WX-)
+  else()
+    target_compile_options(dcsound PRIVATE -w)
+  endif()
+  target_sources(audiocommon PRIVATE DCMusic.cpp DCMusic.h DCMusicImport.cpp DCMusicImport.h)
+  target_link_libraries(audiocommon PRIVATE dcsound)
+  target_compile_definitions(audiocommon PUBLIC HAVE_DCMUSIC=1)
+
+  # The music import reads CHD images with libchdr (BSD-3; the repo's lib/libchdr). Without it,
+  # only GDI images.
+  set(SKIES_LIBCHDR_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../../../../../../libchdr" CACHE PATH
+      "libchdr source")
+  if(EXISTS "${SKIES_LIBCHDR_DIR}/CMakeLists.txt")
+    message(STATUS "libchdr found, the Dreamcast music import reads CHD images")
+    set(CHDR_WANT_TESTS OFF CACHE BOOL "" FORCE)
+    set(INSTALL_STATIC_LIBS OFF CACHE BOOL "" FORCE)
+    # The C LZMA decoder: the assembly one gets Dolphin's compile options, which MASM rejects, and a
+    # one-off import doesn't need its speed
+    set(WITH_LZMA_ASM OFF CACHE BOOL "" FORCE)
+    add_subdirectory("${SKIES_LIBCHDR_DIR}" "${CMAKE_BINARY_DIR}/libchdr" EXCLUDE_FROM_ALL)
+    foreach(_skies_chdr_target IN ITEMS chdr-static chdr-lzma miniz zstd)
+      if(TARGET ${_skies_chdr_target})
+        if(MSVC)
+          target_compile_options(${_skies_chdr_target} PRIVATE /W0 /WX-)
+        else()
+          target_compile_options(${_skies_chdr_target} PRIVATE -w)
+        endif()
+      endif()
+    endforeach()
+    target_link_libraries(audiocommon PRIVATE chdr-static)
+    target_compile_definitions(audiocommon PRIVATE HAVE_LIBCHDR=1)
+  endif()
+endif()
+
 if(ENABLE_CUBEB)
