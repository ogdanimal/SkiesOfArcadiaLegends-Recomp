+// the background), while the runner and the preparer sit beside the launcher in Contents/MacOS.
+fs::path ProgramDirectory(const fs::path& release_directory)
+{
+#if defined(__APPLE__)
+  std::uint32_t size = 0;
+  _NSGetExecutablePath(nullptr, &size);
+  std::string executable(size, '\0');
+  if (_NSGetExecutablePath(executable.data(), &size) == 0)
+  {
+    std::error_code ec;
+    const fs::path resolved = fs::weakly_canonical(fs::path(executable.c_str()), ec);
+    if (!ec)
+      return resolved.parent_path();
+  }
+#endif
+  return release_directory;
+}
