+// Controller 1's settings in the pad profile (Config/GCPadNew.ini [GCPad1]: the sticks' dead zone and
+// the rumble motor's range, in percent), the keys the in-game menu and the desktop launcher write.
+// Dolphin reads the file at every boot (Core: Pad::LoadConfig). Only an existing profile is written:
+// keys alone in a new file would leave the pad unmapped.
+JNIEXPORT jint JNICALL Java_org_dolphinemu_dolphinemu_skies_SkiesNative_getPadOption(
+    JNIEnv* env, jclass, jstring key, jint fallback)
+{
+  Common::IniFile ini;
+  if (!ini.Load(File::GetUserPath(D_CONFIG_IDX) + "GCPadNew.ini"))
+    return fallback;
+  double value = fallback;
+  ini.GetOrCreateSection("GCPad1")->Get(GetJString(env, key), &value, fallback);
+  return static_cast<jint>(value + 0.5);
+}
+
+JNIEXPORT jboolean JNICALL Java_org_dolphinemu_dolphinemu_skies_SkiesNative_setPadOptions(
+    JNIEnv* env, jclass, jobjectArray keys, jint value)
+{
+  const std::string path = File::GetUserPath(D_CONFIG_IDX) + "GCPadNew.ini";
+  Common::IniFile ini;
+  if (!ini.Load(path) || !ini.Exists("GCPad1"))
+    return JNI_FALSE;
+  if (keys == nullptr)
+    return JNI_FALSE;
+  Common::IniFile::Section* section = ini.GetOrCreateSection("GCPad1");
+  const jsize count = env->GetArrayLength(keys);
+  for (jsize i = 0; i < count; ++i)
+  {
+    auto* key = static_cast<jstring>(env->GetObjectArrayElement(keys, i));
+    // A null element or a pending Java exception: write nothing rather than half the keys
+    if (env->ExceptionCheck() || key == nullptr)
+      return JNI_FALSE;
+    section->Set(GetJString(env, key), static_cast<int>(value));
+    env->DeleteLocalRef(key);
+  }
+  return ini.Save(path) ? JNI_TRUE : JNI_FALSE;
+}
+
+// Controller 1 on a handheld: Dolphin's built-in gamepad defaults name inputs the way SDL does
+// ("Left Y+", "Pad N", "Trigger L"), which Android's input backend doesn't have (its axes are
+// "Axis <MotionEvent axis id>"). Written as the profile on the first boot, they left only the face
+// buttons working: no stick, D-pad or triggers, in the game or the menu (Retroid, 2026-10-11).
+// When the main stick isn't on Android's names, this maps the stick, C-stick, triggers, D-pad and
+// rumble to the standard Android gamepad layout of the first gamepad with a left stick (AXIS_X / Y,
+// AXIS_Z / RZ, AXIS_HAT_X / Y, AXIS_GAS / BRAKE, L2 / R2); buttons keep their mapping (their names
+// match). Returns what it did, "" when nothing was needed.
+JNIEXPORT jstring JNICALL Java_org_dolphinemu_dolphinemu_skies_SkiesNative_ensurePadProfile(
+    JNIEnv* env, jclass)
+{
+  const std::string path = File::GetUserPath(D_CONFIG_IDX) + "GCPadNew.ini";
+  Common::IniFile ini;
+  ini.Load(path);
+  Common::IniFile::Section* section = ini.GetOrCreateSection("GCPad1");
+  std::string stick;
+  section->Get("Main Stick/Up", &stick, "");
+  if (stick.find("Axis ") != std::string::npos)
+    return ToJString(env, "");
+
+  std::string gamepad;
+  for (const std::string& name : g_controller_interface.GetAllDeviceStrings())
+  {
+    ciface::Core::DeviceQualifier qualifier;
+    qualifier.FromString(name);
+    const auto device = g_controller_interface.FindDevice(qualifier);
+    if (!device || device->GetSource() != "Android")
+      continue;
+    for (const ciface::Core::Device::Input* input : device->Inputs())
+    {
+      if (input->GetName() == "Axis 0+")
+      {
+        gamepad = name;
+        break;
+      }
+    }
+    if (!gamepad.empty())
+      break;
+  }
+  if (gamepad.empty())
+    return ToJString(env, "no gamepad with a stick connected");
+
+  section->Set("Device", gamepad);
+  const std::pair<const char*, const char*> mapping[] = {
+      {"Main Stick/Up", "`Axis 1-`"},    {"Main Stick/Down", "`Axis 1+`"},
+      {"Main Stick/Left", "`Axis 0-`"},  {"Main Stick/Right", "`Axis 0+`"},
+      {"C-Stick/Up", "`Axis 14-`"},      {"C-Stick/Down", "`Axis 14+`"},
+      {"C-Stick/Left", "`Axis 11-`"},    {"C-Stick/Right", "`Axis 11+`"},
+      {"Triggers/L", "`Button L2`"},     {"Triggers/R", "`Button R2`"},
+      {"Triggers/L-Analog", "`Axis 23+`"}, {"Triggers/R-Analog", "`Axis 22+`"},
+      {"D-Pad/Up", "`Axis 16-`"},        {"D-Pad/Down", "`Axis 16+`"},
+      {"D-Pad/Left", "`Axis 15-`"},      {"D-Pad/Right", "`Axis 15+`"},
+  };
+  for (const auto& [key, expression] : mapping)
+    section->Set(key, std::string(expression));
+  // The SDL defaults' single-value calibration and rumble motors don't apply here
+  section->Delete("Main Stick/Calibration");
+  section->Delete("C-Stick/Calibration");
+  ciface::Core::DeviceQualifier sensors;
+  sensors.FromString("Android/0/Device Sensors");
+  if (g_controller_interface.FindDevice(sensors))
+    section->Set("Rumble/Motor", std::string("`Android/0/Device Sensors:Motor 0`"));
+  else
+    section->Delete("Rumble/Motor");
+  if (!ini.Save(path))
+    return ToJString(env, "can't write " + path);
+  return ToJString(env, "mapped the stick, D-pad and triggers of " + gamepad);
+}
+
+// Settings, Saves: a save the player already has (tools/save_import.cpp, as on desktop). The app
+// copies the picked document to a file first and checks the game isn't running.
+// The game's card saves are always 3 blocks named SA_LEGENDS.000-.002 (the desktop launcher's SaveGame)
+constexpr moderngekko::frontend::SaveImportGame SKIES_SAVES{SKIES_GAME_ID, "Skies of Arcadia Legends",
+                                                            "state-skies-import-", 3, "SA_LEGENDS."};
+
+JNIEXPORT jobjectArray JNICALL Java_org_dolphinemu_dolphinemu_skies_SkiesNative_importSave(
+    JNIEnv* env, jclass, jstring file, jstring user_directory)
+{
+  const moderngekko::frontend::SaveImportResult result = moderngekko::frontend::ImportSave(
+      StringToPath(GetJString(env, file)), StringToPath(GetJString(env, user_directory)),
+      SKIES_SAVES);
+  const std::string answer[] = {result.message, result.ok ? "ok" : ""};
+  return SpanToJStringArray(env, std::span<const std::string>(answer));
+}
+
+JNIEXPORT jstring JNICALL Java_org_dolphinemu_dolphinemu_skies_SkiesNative_describeSaves(
+    JNIEnv* env, jclass, jstring user_directory)
+{
+  return ToJString(env, moderngekko::frontend::DescribeSaves(
+                            StringToPath(GetJString(env, user_directory)), SKIES_SAVES));
+}
+
+JNIEXPORT jstring JNICALL Java_org_dolphinemu_dolphinemu_skies_SkiesNative_importStatus(JNIEnv* env,
+                                                                                         jclass)
+{
+  std::lock_guard lock(s_status_lock);
+  return ToJString(env, s_status);
+}
