+                        val buffer = ByteArray(1 shl 16)
+                        var total = 0L
+                        while (true) {
+                            val n = input.read(buffer)
+                            if (n < 0) break
+                            total += n
+                            if (total > MAX_IMPORT_BYTES) throw java.io.IOException("it is too big to be a save")
+                            output.write(buffer, 0, n)
