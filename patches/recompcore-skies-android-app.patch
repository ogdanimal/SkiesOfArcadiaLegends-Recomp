+        val width = minOf(full.width, (full.height * aspect).toInt())
+        return if (width < full.width) Bitmap.createBitmap(full, full.width - width, 0, width, full.height)
+        else full
+    }
+
+    private val userDirectory get() = File(DirectoryInitialization.getUserDirectory())
+    private val gameRoot get() = File(userDirectory, "Games/GEAE8P")
+    private val mainDol get() = File(gameRoot, "sys/main.dol")
+
+    // main.dol's size and time when it was last hashed, and the answer: refresh() runs on the UI
+    // thread at every onResume, and the hash only changes when the file does
+    private var gameReadyFor: Pair<Long, Long>? = null
+    private var gameReadyResult = false
+
+    private fun gameReady(): Boolean {
+        val dol = mainDol
+        if (!dol.isFile) return false
+        val stamp = Pair(dol.length(), dol.lastModified())
+        if (stamp == gameReadyFor) return gameReadyResult
+        gameReadyResult = hashMatches(dol)
+        gameReadyFor = stamp
+        return gameReadyResult
+    }
+
+    private fun hashMatches(dol: File): Boolean {
+        val digest = MessageDigest.getInstance("SHA-256")
+        dol.inputStream().use { input ->
+            val buffer = ByteArray(1 shl 16)
+            while (true) {
+                val n = input.read(buffer)
+                if (n < 0) break
+                digest.update(buffer, 0, n)
+            }
+        }
+        val sha = digest.digest().joinToString("") { "%02x".format(it) }
+        return sha == getString(R.string.skies_dol_sha256)
+    }
+
+    /** The newest save state the in-game menu or auto-save made (Continue), or null. */
+    private fun newestState(): File? =
+        File(userDirectory, "StateSaves").listFiles { file ->
+            file.isFile && file.name.endsWith(".sav") &&
+                (file.name.startsWith("state-skies-") || file.name.startsWith("recovery-skies-"))
+        }?.maxByOrNull { it.lastModified() }
+
+    /**
+     * The game's newest memory card save (GCI folders GC/<region>/Card A|B), or null. Dolphin rewrites
+     * a .gci only when that save changed, so its time is when the game last saved.
+     */
+    private fun newestCardSave(): File? =
+        listOf("USA", "EUR", "JAP").flatMap { region ->
+            listOf("Card A", "Card B").flatMap { card ->
+                File(userDirectory, "GC/$region/$card").listFiles { file ->
+                    file.isFile && file.name.endsWith(".gci") && file.name.contains("GEAE")
+                }?.toList() ?: emptyList()
+            }
+        }.maxByOrNull { it.lastModified() }
+
+    /**
+     * The game's file number (1..99) of a card save on card A ("...SA_LEGENDS.000.gci" is file 1), or
+     * 0 when the in-game auto-load can't pick it (card B, another name).
+     */
+    private fun cardSaveFile(card: File): Int {
+        if (card.parentFile?.name != "Card A") return 0
+        val number = card.nameWithoutExtension.substringAfterLast('.', "").toIntOrNull() ?: return 0
+        return if (number in 0..98) number + 1 else 0
+    }
+
+    /** [Skies] AutoLoadCard: the card save file the game loads by itself on the next boot (0 = none). */
+    private fun setAutoLoadCard(file: Int) {
+        NativeConfig.setInt(NativeConfig.LAYER_BASE, Settings.FILE_DOLPHIN, "Skies", "AutoLoadCard", file)
+        NativeConfig.save(NativeConfig.LAYER_BASE)
+    }
+
+    /** A save state's name: the in-game menu's slots and auto-saves by their role. */
+    private fun stateText(state: File): String {
+        val stem = state.nameWithoutExtension
+        return when {
+            stem.startsWith("state-skies-slot") -> "Slot " + stem.removePrefix("state-skies-slot")
+            stem.startsWith("recovery-skies-") -> "Auto-save"
+            stem.startsWith("state-skies-import-") -> "Imported"
+            else -> stem
+        }
+    }
+
+    private fun timeText(millis: Long): String =
+        java.text.SimpleDateFormat("MMM d HH:mm", java.util.Locale.getDefault()).format(java.util.Date(millis))
+
+    private fun bundledPatch(): File {
+        val patch = File(cacheDir, "skies-widescreen.dolpatch")
+        assets.open("skies-widescreen.dolpatch").use { input ->
+            patch.outputStream().use { input.copyTo(it) }
+        }
+        return patch
+    }
+
+    private fun refresh() {
+        buttons.removeAllViews()
+        // Imported by an earlier version of the app: bring main.dol up to this version's build.
+        var repatchError = ""
+        if (mainDol.isFile && !gameReady()) {
+            repatchError = SkiesNative.repatch(
+                gameRoot.absolutePath, bundledPatch().absolutePath,
+                getString(R.string.skies_dol_sha256)
+            )
+        }
+        if (gameReady()) {
+            message.text = getString(R.string.skies_ready)
+            // Continue: the newer of the newest save state and the newest memory card save (as on
+            // desktop); a card save is loaded on the title screen, so for one it boots normally
+            val state = newestState()
+            val card = newestCardSave()
+            // A card save the in-game auto-load can't pick would only boot to the title, so then the
+            // newest state wins even if it's older
+            val cardFile = card?.let { cardSaveFile(it) } ?: 0
+            if (state != null &&
+                (card == null || state.lastModified() >= card.lastModified() || cardFile == 0)) {
+                addButton(getString(R.string.skies_continue),
+                    "Save state: ${stateText(state)}   ${timeText(state.lastModified())}") {
+                    setAutoLoadCard(0)
+                    launch(state)
+                }
+            } else if (card != null) {
+                // The game loads it by itself this boot (SkiesMenu.cpp autoload; one shot)
+                val file = cardFile
+                val detail = if (file > 0) "Memory card save: file $file   ${timeText(card.lastModified())}"
+                else "Memory card save   ${timeText(card.lastModified())}   (load it on the title screen)"
+                addButton(getString(R.string.skies_continue), detail) {
+                    setAutoLoadCard(file)
+                    launch(null)
+                }
+            }
+            addButton(getString(R.string.skies_play)) {
+                setAutoLoadCard(0)
+                launch(null)
+            }
+            addButton(getString(R.string.skies_change_disc)) { pickDisc.launch(arrayOf("*/*")) }
+            addButton(getString(R.string.skies_settings)) { openSettings(true) }
+        } else {
+            message.text = repatchError.ifEmpty { getString(R.string.skies_need_disc) }
+            addButton(getString(R.string.skies_choose_disc)) { pickDisc.launch(arrayOf("*/*")) }
+            addButton(getString(R.string.skies_settings)) { openSettings(false) }
+        }
+        buttons.getChildAt(0)?.requestFocus()
+    }
+
+    // A menu item like the desktop launcher's: plain text, gold with a bullet and a fading
+    // highlight when focused (pad) or pressed (touch).
+    /** The Settings window over the home screen; the home menu can't take focus while it's open. */
+    private fun openSettings(ready: Boolean, tab: String? = null, saveResult: Array<String>? = null) {
+        settings?.close()
+        column.descendantFocusability = ViewGroup.FOCUS_BLOCK_DESCENDANTS
+        val game = if (ready) getString(R.string.skies_title) + " [GEAE8P]" else null
+        settings = SkiesSettingsPanel(this, screen, game, { pickDisc.launch(arrayOf("*/*")) },
+            { pickDriver.launch(arrayOf("application/zip", "application/octet-stream", "*/*")) },
+            { confirmImportSave() }, { showLicences() }) {
+            column.descendantFocusability = ViewGroup.FOCUS_AFTER_DESCENDANTS
+            settings = null
+            buttons.getChildAt(buttons.childCount - 1)?.requestFocus()
+        }.also {
+            if (tab != null) it.tabName = tab
+            if (saveResult != null) {
+                it.importMessage = saveResult[0]
+                it.importOk = saveResult.getOrNull(1) == "ok"
+            }
+            it.show()
+        }
+    }
+
+    private fun addButton(label: String, onClick: () -> Unit) = addButton(label, null, onClick)
+
+    /** A menu item, with [detail] as a smaller second line (like the desktop menu's). */
+    private fun addButton(label: String, detail: String?, onClick: () -> Unit) {
+        val density = resources.displayMetrics.density
+        val lit = intArrayOf(android.R.attr.state_focused)
+        val pressed = intArrayOf(android.R.attr.state_pressed)
+        val glow = { GradientDrawable(GradientDrawable.Orientation.LEFT_RIGHT,
+            intArrayOf(Color.argb(90, 255, 201, 74), Color.argb(0, 255, 201, 74))) }
+        val bullet = GradientDrawable().apply {
+            shape = GradientDrawable.OVAL
+            setColor(ACCENT)
+            setSize((10 * density).toInt(), (10 * density).toInt())
+        }
+        buttons.addView(Button(this).apply {
+            text = if (detail == null) label else SpannableString("$label\n$detail").apply {
+                val start = label.length + 1
+                setSpan(RelativeSizeSpan(0.58f), start, length, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+                setSpan(ForegroundColorSpan(Color.argb(235, 220, 228, 242)), start, length,
+                    Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+            }
+            isAllCaps = false
+            textSize = 24f
+            gravity = Gravity.START or Gravity.CENTER_VERTICAL
+            stateListAnimator = null
+            background = StateListDrawable().apply {
+                addState(lit, glow())
+                addState(pressed, glow())
+                addState(intArrayOf(), ColorDrawable(Color.TRANSPARENT))
+            }
+            setTextColor(ColorStateList(arrayOf(lit, pressed, intArrayOf()),
+                intArrayOf(ACCENT, ACCENT, Color.rgb(242, 242, 242))))
+            setCompoundDrawablesRelativeWithIntrinsicBounds(bullet, null, null, null)
+            compoundDrawablePadding = (14 * density).toInt()
+            bullet.alpha = 0
+            setOnFocusChangeListener { _, focused -> bullet.alpha = if (focused) 255 else 0 }
+            setPadding((12 * density).toInt(), (6 * density).toInt(), (12 * density).toInt(),
+                (6 * density).toInt())
+            minWidth = (340 * density).toInt()
+            isFocusable = true
+            setOnClickListener { onClick() }
+        }, LinearLayout.LayoutParams(LinearLayout.LayoutParams.WRAP_CONTENT,
+            LinearLayout.LayoutParams.WRAP_CONTENT))
+    }
+
+    private fun launch(state: File?) {
+        // Only for a launch that goes ahead: a stale driver marker would later read as a crash
+        EmulationActivity.launch(this, mainDol.absolutePath, false) {
+            SkiesDriverGuard.onLaunch(this)
+            EmulationFragment.pendingStatePath = state?.absolutePath
+        }
+    }
+
+    // While an import runs: its progress, then (on whichever instance is showing) the result
+    private val importPoll = object : Runnable {
+        override fun run() {
+            if (!importRunning) {
+                showState()
+                return
+            }
+            val status = SkiesNative.importStatus()
+            message.text = getString(R.string.skies_importing) +
+                if (status.isNotEmpty()) "\n" + status else ""
+            handler.postDelayed(this, 250)
+        }
+    }
+
+    private fun showImporting() {
+        settings?.close()
+        buttons.removeAllViews()
+        message.text = getString(R.string.skies_importing)
+        handler.removeCallbacks(importPoll)
+        handler.post(importPoll)
+    }
+
+    private fun startImport(uri: Uri) {
+        if (importRunning) {
+            showImporting()
+            return
+        }
+        importRunning = true
+        importResult = null
+        val patch = bundledPatch()
+        val image = uri.toString()
+        val root = gameRoot.absolutePath
+        val sha = getString(R.string.skies_dol_sha256)
+        // Only values go to the thread, never this Activity (it can be gone when the import ends)
+        Thread({
+            try {
+                importResult = SkiesNative.importDisc(image, root, patch.absolutePath, sha)
+            } finally {
+                importRunning = false
+            }
+        }, "SkiesImport").start()
+        showImporting()
+    }
+
+    /**
+     * First run: the game's ini (dual core, the idle skip) into GameSettings, and the defaults the
+     * Retroid build was tuned with, each only if the player hasn't set it.
+     */
+    private fun installDefaults() {
+        val ini = File(userDirectory, "GameSettings/GEAE8P.ini")
+        if (!ini.exists()) {
+            ini.parentFile?.mkdirs()
+            assets.open("skies-GEAE8P.ini").use { input ->
+                ini.outputStream().use { input.copyTo(it) }
+            }
+        }
+        // Every start: a controller profile Android can read (no-op once it is)
+        SkiesNative.ensurePadProfile().let { if (it.isNotEmpty()) Log.i("SkiesLauncher", it) }
+        val dolphinIni = File(userDirectory, "Config/Dolphin.ini")
+        if (dolphinIni.exists() && dolphinIni.readText().contains("[Skies]")) return
+        val base = NativeConfig.LAYER_BASE
+        val dolphin = Settings.FILE_DOLPHIN
+        NativeConfig.setString(base, dolphin, "Core", "GFXBackend", "Vulkan")
+        NativeConfig.setBoolean(base, dolphin, "DSP", "DSPThread", true)
+        NativeConfig.setBoolean(base, dolphin, "Analytics", "Enabled", false)
+        NativeConfig.setBoolean(base, dolphin, "Analytics", "PermissionAsked", true)
+        // The touch controls only when no game controller is connected.
+        NativeConfig.setBoolean(base, dolphin, "Android", "ShowInputOverlay", !hasGamepad())
+        NativeConfig.save(base)
+    }
+
+    private fun hasGamepad(): Boolean = InputDevice.getDeviceIds().any { id ->
+        val sources = InputDevice.getDevice(id)?.sources ?: 0
+        sources and InputDevice.SOURCE_GAMEPAD == InputDevice.SOURCE_GAMEPAD ||
+            sources and InputDevice.SOURCE_JOYSTICK == InputDevice.SOURCE_JOYSTICK
+    }
+}
