+++ b/Source/Android/app/src/main/java/org/dolphinemu/dolphinemu/skies/SkiesSettingsPanel.kt
@@ -0,0 +1,517 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+package org.dolphinemu.dolphinemu.skies
+
+import android.content.res.ColorStateList
+import android.graphics.Color
+import android.graphics.Typeface
+import android.graphics.drawable.Drawable
+import android.graphics.drawable.GradientDrawable
+import android.graphics.drawable.StateListDrawable
+import android.view.Gravity
+import android.view.KeyEvent
+import android.view.View
+import android.widget.Button
+import android.widget.FrameLayout
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.TextView
+import androidx.fragment.app.FragmentActivity
+import org.dolphinemu.dolphinemu.features.settings.model.NativeConfig
+import org.dolphinemu.dolphinemu.features.settings.model.Settings
+
+/**
+ * The branded app's Settings window, the Android twin of the desktop launcher's (tools/
+ * moderngekko_launcher.cpp): a rounded window over the dimmed home screen with tabs, each setting a
+ * label, its value and a one-line description, A- / A+ for the text size, Close. The values are the
+ * in-game menu's (VideoCommon/SkiesMenu.cpp) on the same keys, so either side shows the other's
+ * changes. Dropdowns open in place instead of a popup window, so the pad's A and B work on them;
+ * left / right on a value steps through its choices.
+ */
+class SkiesSettingsPanel(
+    private val activity: FragmentActivity,
+    private val host: FrameLayout,
+    private val gameText: String?,
+    private val onChangeDisc: () -> Unit,
+    private val onPickDriver: () -> Unit,
+    private val onImportSave: () -> Unit,
+    private val onLicences: () -> Unit,
+    private val onClosed: () -> Unit
+) {
+    private class Choice(val value: Int, val text: String)
+
+    private companion object {
+        val ACCENT = Color.rgb(255, 201, 74)
+        val DESCRIPTION = Color.rgb(168, 184, 214)
+        val FIELD = Color.rgb(26, 41, 77)
+        val FIELD_FOCUS = Color.rgb(41, 66, 118)
+        val BUTTON = Color.rgb(36, 77, 158)
+        val BUTTON_FOCUS = Color.rgb(56, 107, 204)
+        const val TEXT_SIZE_KEY = "LauncherTextSize"
+        val TABS = listOf("Graphics", "Gameplay", "Sound", "Controls", "Saves", "Disc", "About")
+
+        fun choices(vararg pairs: Pair<Int, String>) = pairs.map { Choice(it.first, it.second) }
+        val ON_OFF = choices(1 to "On", 0 to "Off")
+        // Dolphin's [Core] GFXBackend values, by index
+        val BACKEND_KEYS = listOf("Vulkan", "OGL")
+        val BACKEND = choices(0 to "Vulkan", 1 to "OpenGL ES")
+        val PICTURE = choices(1 to "Widescreen 16:9", 0 to "Original 4:3")
+        val FRAME_RATE = choices(0 to "30 fps (original)", 1 to "60 fps (interpolated)")
+        val RESOLUTION = choices(1 to "Native (480p)", 2 to "2x (720p)", 3 to "3x (1080p)",
+            4 to "4x (1440p)", 6 to "6x (4K)")
+        val MSAA = choices(1 to "Off", 2 to "2x MSAA", 4 to "4x MSAA", 8 to "8x MSAA")
+        val CAMERA = choices(1 to "Hold Z to move", 0 to "Original")
+        val SPEED = choices(1 to "Normal (Z in battle)", 2 to "2x (Z in battle)",
+            3 to "3x (Z in battle)", 4 to "4x (Z in battle)")
+        val ENCOUNTERS = choices(0 to "Off", 25 to "1/4", 50 to "1/2", 100 to "Normal",
+            200 to "2x", 400 to "4x")
+        val REWARDS = choices(0 to "Off", 50 to "1/2", 100 to "Normal", 200 to "2x", 300 to "3x",
+            400 to "4x")
+        val INVINCIBLE = choices(1 to "On (L3 / R3)", 0 to "Off (L3 / R3)")
+        val VOLUME = (0..100 step 10).map { Choice(it, if (it == 0) "0% (muted)" else "$it%") }
+        val DEAD_ZONE = (0..30 step 5).map { Choice(it, if (it == 0) "Off" else "$it%") }
+        val AUTO_SAVE = choices(0 to "Off", 5 to "Every 5 min", 10 to "Every 10 min",
+            15 to "Every 15 min", 30 to "Every 30 min")
+    }
+
+    private val density = activity.resources.displayMetrics.density
+    private var textPercent = readInt(Settings.FILE_DOLPHIN, "Skies", TEXT_SIZE_KEY, 100)
+        .let { if (it in 80..160) it else 100 }
+    private var tab = 0
+    var tabName: String
+        get() = TABS[tab]
+        set(name) { tab = TABS.indexOf(name).coerceAtLeast(0) }
+    /** Saves: the last import's message and whether it worked, shown under the saves. */
+    var importMessage = ""
+    var importOk = false
+    private var overlay: FrameLayout? = null
+    private var openList: Pair<LinearLayout, View>? = null
+
+    private val scale get() = textPercent / 100f
+    private fun dp(value: Float) = (value * density * scale).toInt()
+
+    val isShowing get() = overlay != null
+
+    fun show() {
+        overlay?.let { host.removeView(it) }
+        openList = null
+        val metrics = activity.resources.displayMetrics
+        val root = FrameLayout(activity).apply {
+            setBackgroundColor(Color.argb(150, 0, 5, 15))
+            isClickable = true
+        }
+        val card = LinearLayout(activity).apply {
+            orientation = LinearLayout.VERTICAL
+            background = GradientDrawable().apply {
+                setColor(Color.argb(242, 9, 14, 28))
+                cornerRadius = 14 * density
+                setStroke((1.5f * density).toInt(), Color.argb(56, 255, 255, 255))
+            }
+            setPadding(dp(26f), dp(20f), dp(26f), dp(16f))
+        }
+        val width = minOf(metrics.widthPixels - (48 * density).toInt(), dp(900f))
+        root.addView(card, FrameLayout.LayoutParams(width, metrics.heightPixels - (40 * density).toInt(),
+            Gravity.CENTER))
+
+        // Header: title, text size, Close
+        val header = LinearLayout(activity).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+        }
+        header.addView(text("Settings", 26f, Color.WHITE, bold = true),
+            LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f))
+        val smaller = button("A-", BUTTON) { setTextPercent(textPercent - 10, true) }
+        smaller.isEnabled = textPercent > 80
+        header.addView(smaller)
+        header.addView(text("$textPercent%", 15f, Color.WHITE).apply {
+            setPadding(dp(10f), 0, dp(10f), 0)
+        })
+        val larger = button("A+", BUTTON) { setTextPercent(textPercent + 10, false) }
+        larger.isEnabled = textPercent < 160
+        header.addView(larger)
+        header.addView(View(activity), LinearLayout.LayoutParams(dp(18f), 1))
+        header.addView(button("Close", BUTTON) { close() }.apply { minWidth = dp(110f) })
+        card.addView(header)
+
+        // Tabs
+        val tabs = LinearLayout(activity).apply {
+            orientation = LinearLayout.HORIZONTAL
+            setPadding(0, dp(12f), 0, 0)
+        }
+        val tabButtons = TABS.mapIndexed { index, name ->
+            button(name, if (index == tab) Color.rgb(41, 87, 173) else FIELD, selected = index == tab) {
+                if (tab != index) {
+                    tab = index
+                    show()
+                }
+            }.also {
+                tabs.addView(it, LinearLayout.LayoutParams(LinearLayout.LayoutParams.WRAP_CONTENT,
+                    LinearLayout.LayoutParams.WRAP_CONTENT).apply { marginEnd = dp(6f) })
+            }
+        }
+        // Scrolls sideways when the tabs don't fit (narrow screens, large text)
+        card.addView(android.widget.HorizontalScrollView(activity).apply {
+            isHorizontalScrollBarEnabled = false
+            addView(tabs)
+        })
+        card.addView(View(activity).apply { setBackgroundColor(Color.rgb(41, 87, 173)) },
+            LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT,
+                maxOf(1, (1.5f * density).toInt())))
+
+        // The tab's rows
+        val rows = LinearLayout(activity).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(0, dp(8f), 0, dp(8f))
+        }
+        fillTab(rows)
+        card.addView(ScrollView(activity).apply { addView(rows) },
+            LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, 0, 1f))
+
+        host.addView(root, FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT)
+        overlay = root
+        tabButtons[tab].requestFocus()
+    }
+
+    /** B / Back: close an open choice list, else the window. */
+    fun back() {
+        val list = openList
+        if (list != null) {
+            list.first.visibility = View.GONE
+            list.second.requestFocus()
+            openList = null
+        } else {
+            close()
+        }
+    }
+
+    fun close() {
+        overlay?.let { host.removeView(it) }
+        overlay = null
+        openList = null
+        onClosed()
+    }
+
+    private fun setTextPercent(size: Int, smaller: Boolean) {
+        textPercent = size.coerceIn(80, 160)
+        writeInt(Settings.FILE_DOLPHIN, "Skies", TEXT_SIZE_KEY, textPercent)
+        show()
+        // Keep the pad on the button that was pressed
+        overlay?.let { root ->
+            root.findViewWithTag<View>(if (smaller) "A-" else "A+")?.requestFocus()
+        }
+    }
+
+    private fun fillTab(rows: LinearLayout) {
+        val dolphin = Settings.FILE_DOLPHIN
+        val gfx = Settings.FILE_GFX
+        when (TABS[tab]) {
+            "Graphics" -> {
+                configRow(rows, "Picture", PICTURE, dolphin, "Skies", "Widescreen", 1,
+                    "Widescreen fills a 16:9 screen; Original keeps the GameCube's 4:3 picture.")
+                configRow(rows, "Frame rate", FRAME_RATE, dolphin, "Skies", "FrameMode", 0,
+                    "60 fps adds in-between frames for smoother motion. 30 fps is the original.")
+                configRow(rows, "Resolution", RESOLUTION, gfx, "Settings", "InternalResolution", 1,
+                    "Higher is sharper but needs more power. 3x matches a 1080p screen.")
+                configRow(rows, "Anti-aliasing", MSAA, gfx, "Settings", "MSAA", 1,
+                    "Smooths jagged edges. Higher settings need more power.")
+                boolRow(rows, "V-Sync", gfx, "Hardware", "VSync",
+                    "Stops screen tearing. Can add a little input delay.")
+                boolRow(rows, "Show FPS", gfx, "Settings", "ShowFPS",
+                    "Show the frame rate in a corner of the game screen.")
+                backendRow(rows)
+                if (SkiesDriverGuard.supported()) driverRows(rows)
+            }
+            "Gameplay" -> {
+                configRow(rows, "Camera", CAMERA, dolphin, "Skies", "CameraControl", 1,
+                    "Hold Z, then tilt with the C-stick and zoom with L / R. Original keeps the " +
+                        "game's fixed camera.")
+                configRow(rows, "Battle speed", SPEED, dolphin, "Skies", "BattleSpeed", 1,
+                    "Plays battles faster. Tap Z during a battle to switch speeds.")
+                configRow(rows, "Encounters", ENCOUNTERS, dolphin, "Skies", "Encounters", 100,
+                    "How often random battles happen. Off means none.")
+                configRow(rows, "EXP", REWARDS, dolphin, "Skies", "Exp", 100,
+                    "Experience from battles, for levelling up.")
+                configRow(rows, "Gold", REWARDS, dolphin, "Skies", "Gold", 100,
+                    "Gold won from battles.")
+                configRow(rows, "Magic EXP", REWARDS, dolphin, "Skies", "MagicExp", 100,
+                    "Magic experience from battles, for learning new spells.")
+                configRow(rows, "Invincible", INVINCIBLE, dolphin, "Skies", "Invincible", 0,
+                    "Keeps the party's HP and MP full. Press L3 or R3 in game to switch it.")
+            }
+            "Sound" -> configRow(rows, "Volume", VOLUME, dolphin, "DSP", "Volume", 100,
+                "Music and sound effects.")
+            "Controls" -> {
+                padRow(rows, "Stick dead zone", DEAD_ZONE,
+                    arrayOf("Main Stick/Dead Zone", "C-Stick/Dead Zone"), 0, 1,
+                    "Ignores small stick movements. Raise it if a stick drifts.")
+                padRow(rows, "Rumble", ON_OFF, arrayOf("Rumble/Motor/Range"), 100, 100,
+                    "Controller vibration.")
+            }
+            "Saves" -> {
+                configRow(rows, "Auto-save", AUTO_SAVE, dolphin, "Skies", "AutoSave", 10,
+                    "Saves your place at quiet moments. Continue picks up from the newest.")
+                savesRows(rows)
+            }
+            "Disc" -> {
+                val line = rowLine(rows, "Game")
+                line.addView(text(gameText ?: "No disc imported yet", 16f, Color.WHITE))
+                val change = button(if (gameText != null) "Change Disc" else "Select Disc", BUTTON) {
+                    close()
+                    onChangeDisc()
+                }
+                rows.addView(change, LinearLayout.LayoutParams(LinearLayout.LayoutParams.WRAP_CONTENT,
+                    LinearLayout.LayoutParams.WRAP_CONTENT).apply {
+                    marginStart = dp(200f)
+                    topMargin = dp(10f)
+                })
+                describe(rows, "Your own copy of the game: RVZ, ISO, GCM, GCZ, WIA or CISO. It is " +
+                    "copied in once and patched; the file itself isn't changed.")
+            }
+            "About" -> {
+                val info = SkiesDriverGuard.deviceInfo(activity)
+                info.lines().forEach { line ->
+                    val (label, value) = line.split(": ", limit = 2).let { it[0] to it.getOrElse(1) { "" } }
+                    rowLine(rows, label).addView(text(value, 15f, Color.WHITE))
+                }
+                val actions = LinearLayout(activity).apply { orientation = LinearLayout.HORIZONTAL }
+                actions.addView(button("Copy device info", BUTTON) {
+                    val clipboard = activity.getSystemService(android.content.ClipboardManager::class.java)
+                    clipboard?.setPrimaryClip(android.content.ClipData.newPlainText("Device info", info))
+                    android.widget.Toast.makeText(activity, "Device info copied", android.widget.Toast.LENGTH_SHORT).show()
+                })
+                actions.addView(View(activity), LinearLayout.LayoutParams(dp(10f), 1))
+                actions.addView(button("Licences", BUTTON) { onLicences() })
+                rows.addView(actions, LinearLayout.LayoutParams(LinearLayout.LayoutParams.WRAP_CONTENT,
+                    LinearLayout.LayoutParams.WRAP_CONTENT).apply {
+                    marginStart = dp(200f)
+                    topMargin = dp(14f)
+                })
+                describe(rows, "Something wrong? Copy the device info into your bug report: it says " +
+                    "which phone, chip and graphics driver the game ran on.")
+            }
+        }
+    }
+
+    /** Saves: Import (like the N64 recomps': the activity asks first, then opens the picker) and what's there. */
+    private fun savesRows(rows: LinearLayout) {
+        rowLine(rows, "Import a save").addView(button("Choose a save file…", BUTTON) { onImportSave() })
+        describe(rows, "Brings in a save you already have: from Dolphin, a GameCube memory card, this " +
+            "port on another device, or a backup.")
+        val userDirectory = org.dolphinemu.dolphinemu.utils.DirectoryInitialization.getUserDirectory()
+        SkiesNative.describeSaves(userDirectory).lines().forEachIndexed { index, line ->
+            if (index == 0) {
+                rowLine(rows, "Your saves").addView(text(line, 15f, Color.WHITE))
+            } else {
+                rows.addView(text(line, 15f, Color.WHITE).apply { setPadding(dp(200f), dp(4f), 0, 0) })
+            }
+        }
+        if (importMessage.isNotEmpty()) {
+            rows.addView(text(importMessage, 15f, if (importOk) ACCENT else Color.rgb(255, 115, 102)).apply {
+                setPadding(dp(200f), dp(10f), 0, 0)
+            })
+        }
+    }
+
+    /** Graphics: Vulkan (default) or OpenGL ES, the way out of a Vulkan driver that misbehaves. */
+    private fun backendRow(rows: LinearLayout) {
+        val stored = NativeConfig.getString(NativeConfig.LAYER_BASE_OR_CURRENT, Settings.FILE_DOLPHIN,
+            "Core", "GFXBackend", "Vulkan")
+        val current = BACKEND_KEYS.indexOf(stored).coerceAtLeast(0)
+        choiceRow(rows, "Renderer", BACKEND, current,
+            "Vulkan is the default. If the game crashes or draws things wrong on this device, try " +
+                "OpenGL ES. Takes effect when the game starts.") { value ->
+            NativeConfig.setString(NativeConfig.LAYER_BASE, Settings.FILE_DOLPHIN, "Core", "GFXBackend",
+                BACKEND_KEYS[value])
+            NativeConfig.save(NativeConfig.LAYER_BASE)
+            true
+        }
+    }
+
+    /** Graphics: the GPU driver (Adreno devices that can load one; Dolphin's loader). */
+    private fun driverRows(rows: LinearLayout) {
+        val custom = SkiesDriverGuard.selected().isNotEmpty()
+        val current = if (custom) {
+            (SkiesDriverGuard.customName() ?: SkiesDriverGuard.selected()) +
+                if (SkiesDriverGuard.isKept(activity)) "" else "  (being tried)"
+        } else "The device's own"
+        rowLine(rows, "GPU driver").addView(text(current, 15f, Color.WHITE))
+        val actions = LinearLayout(activity).apply { orientation = LinearLayout.HORIZONTAL }
+        actions.addView(button("Choose driver…", BUTTON) { onPickDriver() })
+        if (custom) {
+            actions.addView(View(activity), LinearLayout.LayoutParams(dp(10f), 1))
+            actions.addView(button("Use the device's own", BUTTON) {
+                SkiesDriverGuard.useSystemDriver(activity)
+                show()
+            })
+        }
+        rows.addView(actions, LinearLayout.LayoutParams(LinearLayout.LayoutParams.WRAP_CONTENT,
+            LinearLayout.LayoutParams.WRAP_CONTENT).apply {
+            marginStart = dp(200f)
+            topMargin = dp(8f)
+        })
+        describe(rows, "For Adreno devices, with the Vulkan renderer: a driver package (.zip, e.g. Mesa Turnip) can fix crashes " +
+            "or glitches. Unsupported; if the game doesn't start with it, the app goes back to the " +
+            "device's own driver by itself.")
+    }
+
+    // Rows
+
+    private fun configRow(rows: LinearLayout, label: String, choices: List<Choice>, file: String,
+                          section: String, key: String, fallback: Int, description: String) {
+        val current = readInt(file, section, key, fallback).let { if (it < 0) fallback else it }
+        choiceRow(rows, label, choices, current, description) { value ->
+            writeInt(file, section, key, value)
+            true
+        }
+    }
+
+    private fun boolRow(rows: LinearLayout, label: String, file: String, section: String,
+                        key: String, description: String) {
+        val current = if (NativeConfig.getBoolean(NativeConfig.LAYER_BASE_OR_CURRENT, file, section,
+                key, false)) 1 else 0
+        choiceRow(rows, label, ON_OFF, current, description) { value ->
+            NativeConfig.setBoolean(NativeConfig.LAYER_BASE, file, section, key, value != 0)
+            NativeConfig.save(NativeConfig.LAYER_BASE)
+            true
+        }
+    }
+
+    private fun padRow(rows: LinearLayout, label: String, choices: List<Choice>, keys: Array<String>,
+                       fallback: Int, scaleToIni: Int, description: String) {
+        val stored = SkiesNative.getPadOption(keys[0], fallback)
+        val current = if (scaleToIni == 100) (if (stored > 0) 1 else 0) else stored
+        choiceRow(rows, label, choices, current, description) { value ->
+            SkiesNative.setPadOptions(keys, value * scaleToIni)
+        }
+    }
+
+    /** Label, value button (opens its choices in place; left / right steps) and description. */
+    private fun choiceRow(rows: LinearLayout, label: String, choices: List<Choice>, initial: Int,
+                          description: String, write: (Int) -> Boolean) {
+        var current = initial
+        val line = rowLine(rows, label)
+        val textOf = { value: Int -> choices.firstOrNull { it.value == value }?.text ?: choices[0].text }
+        val value = button("${textOf(current)}  ▾", FIELD, focusColor = FIELD_FOCUS) {}.apply {
+            gravity = Gravity.START or Gravity.CENTER_VERTICAL
+        }
+        line.addView(value, LinearLayout.LayoutParams(dp(420f), LinearLayout.LayoutParams.WRAP_CONTENT))
+        val list = LinearLayout(activity).apply {
+            orientation = LinearLayout.VERTICAL
+            visibility = View.GONE
+            setPadding(dp(200f), dp(4f), 0, dp(4f))
+        }
+        val pick = { choice: Choice ->
+            if (choice.value == current || write(choice.value)) {
+                current = choice.value
+                value.text = "${choice.text}  ▾"
+            } else {
+                value.text = "${textOf(current)}  ▾   (start the game once first)"
+            }
+        }
+        choices.forEach { choice ->
+            list.addView(button(choice.text, FIELD, focusColor = FIELD_FOCUS) {
+                pick(choice)
+                list.visibility = View.GONE
+                openList = null
+                value.requestFocus()
+            }.apply { gravity = Gravity.START or Gravity.CENTER_VERTICAL },
+                LinearLayout.LayoutParams(dp(420f), LinearLayout.LayoutParams.WRAP_CONTENT))
+        }
+        value.setOnClickListener {
+            if (list.visibility == View.VISIBLE) {
+                list.visibility = View.GONE
+                openList = null
+            } else {
+                openList?.first?.visibility = View.GONE
+                list.visibility = View.VISIBLE
+                openList = list to value
+                val index = choices.indexOfFirst { it.value == current }.coerceAtLeast(0)
+                list.getChildAt(index)?.requestFocus()
+            }
+        }
+        value.setOnKeyListener { _, keyCode, event ->
+            val step = when (keyCode) {
+                KeyEvent.KEYCODE_DPAD_LEFT -> -1
+                KeyEvent.KEYCODE_DPAD_RIGHT -> 1
+                else -> 0
+            }
+            if (step == 0 || list.visibility == View.VISIBLE) return@setOnKeyListener false
+            if (event.action == KeyEvent.ACTION_DOWN) {
+                val index = choices.indexOfFirst { it.value == current }.coerceAtLeast(0)
+                choices.getOrNull(index + step)?.let(pick)
+            }
+            true
+        }
+        rows.addView(list)
+        describe(rows, description)
+    }
+
+    private fun rowLine(rows: LinearLayout, label: String): LinearLayout {
+        val line = LinearLayout(activity).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            setPadding(0, dp(10f), 0, 0)
+        }
+        line.addView(text(label, 16f, Color.WHITE),
+            LinearLayout.LayoutParams(dp(200f), LinearLayout.LayoutParams.WRAP_CONTENT))
+        rows.addView(line)
+        return line
+    }
+
+    private fun describe(rows: LinearLayout, description: String) {
+        rows.addView(text(description, 13f, DESCRIPTION).apply {
+            setPadding(dp(200f), dp(3f), 0, 0)
+        })
+    }
+
+    // Widgets
+
+    private fun text(value: String, size: Float, color: Int, bold: Boolean = false) =
+        TextView(activity).apply {
+            text = value
+            textSize = size * scale
+            setTextColor(color)
+            if (bold) typeface = Typeface.DEFAULT_BOLD
+        }
+
+    private fun button(label: String, color: Int, focusColor: Int = BUTTON_FOCUS,
+                       selected: Boolean = false, onClick: () -> Unit) =
+        Button(activity).apply {
+            text = label
+            tag = label
+            isAllCaps = false
+            textSize = 15f * scale
+            stateListAnimator = null
+            minHeight = 0
+            minimumHeight = 0
+            minWidth = 0
+            minimumWidth = 0
+            setPadding(dp(14f), dp(8f), dp(14f), dp(8f))
+            background = StateListDrawable().apply {
+                addState(intArrayOf(android.R.attr.state_focused), box(focusColor, ACCENT))
+                addState(intArrayOf(android.R.attr.state_pressed), box(focusColor, ACCENT))
+                addState(intArrayOf(), box(color, if (selected) ACCENT else null))
+            }
+            setTextColor(ColorStateList(
+                arrayOf(intArrayOf(-android.R.attr.state_enabled), intArrayOf()),
+                intArrayOf(Color.argb(110, 255, 255, 255), Color.WHITE)))
+            isFocusable = true
+            setOnClickListener { onClick() }
+        }
+
+    private fun box(color: Int, stroke: Int?): Drawable = GradientDrawable().apply {
+        setColor(color)
+        cornerRadius = 6 * density
+        if (stroke != null) setStroke((2 * density).toInt(), stroke)
+    }
+
+    // Config (Dolphin's base layer, saved at once, like the in-game menu)
+
+    private fun readInt(file: String, section: String, key: String, fallback: Int) =
+        NativeConfig.getInt(NativeConfig.LAYER_BASE_OR_CURRENT, file, section, key, fallback)
+
+    private fun writeInt(file: String, section: String, key: String, value: Int) {
+        NativeConfig.setInt(NativeConfig.LAYER_BASE, file, section, key, value)
+        NativeConfig.save(NativeConfig.LAYER_BASE)
+    }
+}
