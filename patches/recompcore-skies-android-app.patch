--- /dev/null
+++ b/Source/Android/jni/SkiesImport.cpp
@@ -0,0 +1,332 @@
+// Skies Recomp (the branded Android app): first-run import of the player's own disc. The same steps
+// as the desktop launcher (ModernGekko tools/moderngekko_launcher.cpp, ExtractDisc): check that the
+// image is Skies of Arcadia Legends (USA, GEAE8P, revision 0), extract it into a game folder, turn its
+// main.dol into the game build the APK's module was made from with the bundled whole-file DOL patch
+// (which checks the input and output SHA-256 itself), and only then move the folder into place.
+
+#include <jni.h>
+
+#include <atomic>
+#include <cctype>
+#include <cstdint>
+#include <filesystem>
+#include <memory>
+#include <mutex>
+#include <span>
+#include <string>
+#include <system_error>
+
