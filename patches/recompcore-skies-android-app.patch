diff --git a/Source/Android/app/src/main/java/org/dolphinemu/dolphinemu/skies/SkiesDriverGuard.kt b/Source/Android/app/src/main/java/org/dolphinemu/dolphinemu/skies/SkiesDriverGuard.kt
