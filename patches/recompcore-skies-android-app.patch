+{
+constexpr const char* SKIES_GAME_ID = "GEAE8P";
+
+std::mutex s_status_lock;
+std::string s_status;
+
+void SetStatus(std::string status)
+{
+  std::lock_guard lock(s_status_lock);
+  s_status = std::move(status);
+}
+
+// Patches main.dol in place and checks the result. Returns "" or what went wrong.
+std::string PatchDol(const fs::path& dol, const fs::path& patch, const std::string& expected_sha256)
+{
+  bool changed = false;
+  std::string error;
+  if (!moderngekko::frontend::ApplyDolPatchManifest(dol, patch, &changed, &error))
+    return "Patching main.dol failed: " + error;
+  const std::optional<std::string> sha = moderngekko::Sha256File(dol);
+  if (!sha || *sha != expected_sha256)
+    return "The patched main.dol isn't the build this app was made for.";
+  return "";
+}
+
+// A game imported by an earlier version of the app: its main.dol is that version's build, so
+// patch the original kept beside it (main.dol.orig) into this version's. "" on success.
+std::string Repatch(const fs::path& game_root, const fs::path& patch,
+                    const std::string& expected_dol_sha256)
+{
+  const fs::path original = game_root / "sys" / "main.dol.orig";
+  const fs::path staged = game_root / "sys" / "main.dol.new";
+  std::error_code ec;
+  if (!fs::exists(original, ec))
+    return "This game was imported by an older version: choose the disc image again.";
+  fs::copy_file(original, staged, fs::copy_options::overwrite_existing, ec);
+  if (ec)
+    return "Can't copy main.dol: " + ec.message();
+  if (std::string error = PatchDol(staged, patch, expected_dol_sha256); !error.empty())
+  {
+    fs::remove(staged, ec);
+    return error;
+  }
+  fs::rename(staged, game_root / "sys" / "main.dol", ec);
+  return ec ? "Can't update main.dol: " + ec.message() : "";
+}
+
+// Returns "" on success, else what went wrong (shown to the player). The working install, if any,
+// is only replaced once the new one is complete and patched; a failure leaves it and removes the
+// staging folder.
+std::string ImportDiscStaged(const std::string& image, const fs::path& game_root,
+                             const fs::path& staging, const fs::path& patch,
+                             const std::string& expected_dol_sha256)
+{
+  SetStatus("Reading the disc image");
+  const std::unique_ptr<DiscIO::Volume> volume = DiscIO::CreateVolume(image);
+  if (!volume)
+    return "That file isn't a GameCube disc image this app can read.";
+  const std::string id = volume->GetGameID();
+  if (id != SKIES_GAME_ID)
+  {
+    return "That disc is " + (id.empty() ? std::string("unknown") : id) +
+           ". This port needs Skies of Arcadia Legends for the GameCube, USA version (GEAE8P).";
+  }
+  if (volume->GetRevision().value_or(0) != 0)
+    return "That's a later revision of the disc; this port needs the original USA release.";
+
+  const DiscIO::Partition partition = volume->GetGamePartition();
+  const DiscIO::FileSystem* filesystem = volume->GetFileSystem(partition);
+  if (!filesystem || !filesystem->IsValid())
+    return "The disc image's file system can't be read.";
+
+  // Every name on the disc is checked before anything is written (a crafted image could otherwise
+  // write outside the game folder), and the game has to fit beside the old import
+  std::uint64_t game_bytes = 0;
+  std::size_t game_files = 0;
+  if (std::string problem = moderngekko::frontend::CheckDiscFileNames(filesystem->GetRoot(),
+                                                                       &game_bytes, &game_files);
+      !problem.empty())
+  {
+    return "This disc image can't be used: " + problem + ".";
+  }
+  constexpr std::uint64_t SYSTEM_DATA_MARGIN = 64ull << 20;
+  if (std::string error; !moderngekko::frontend::HasFreeSpace(
+          game_root.parent_path(), game_bytes + SYSTEM_DATA_MARGIN, &error))
+  {
+    error[0] = static_cast<char>(std::toupper(static_cast<unsigned char>(error[0])));
+    return error + ".";
+  }
+
+  std::error_code ec;
+  fs::remove_all(staging, ec);
+  ec.clear();
+  fs::create_directories(staging / "files", ec);
+  if (ec)
+    return "Can't create " + staging.string() + ": " + ec.message();
+
+  SetStatus("Copying the disc's system data");
+  if (!DiscIO::ExportSystemData(*volume, partition, staging.string()))
+    return "Copying the disc's system data failed.";
+  SetStatus("Copying the game files");
+  if (std::string error; !moderngekko::frontend::ExportDiscFiles(
+          *volume, partition, filesystem->GetRoot(), (staging / "files").string(),
+          [](const std::string& path) { SetStatus("Copying " + path); }, &error))
+  {
+    return "Copying the game files failed: " + error + ".";
+  }
+
+  SetStatus("Patching the game");
+  // The original stays beside it, so a later version of the app can patch it again (Repatch).
+  const fs::path dol = staging / "sys" / "main.dol";
+  fs::copy_file(dol, staging / "sys" / "main.dol.orig", fs::copy_options::overwrite_existing, ec);
+  if (ec)
+    return "Can't keep a copy of main.dol: " + ec.message();
+  if (std::string error = PatchDol(dol, patch, expected_dol_sha256); !error.empty())
+    return error;
+
+  SetStatus("Finishing");
+  if (std::string error; !moderngekko::frontend::ReplaceDirectory(staging, game_root, &error))
+    return "Can't move the game into place: " + error;
+  return "";
+}
+
+// One import at a time, whatever the Activity does (it can be recreated, or a second one started,
+// while this runs on its thread).
+std::atomic<bool> s_importing{false};
+
+std::string ImportDisc(const std::string& image, const fs::path& game_root, const fs::path& patch,
+                       const std::string& expected_dol_sha256)
+{
+  if (s_importing.exchange(true))
+    return "A disc is already being imported.";
+  const fs::path staging = game_root.string() + ".importing";
+  std::string error = ImportDiscStaged(image, game_root, staging, patch, expected_dol_sha256);
+  if (!error.empty())
+  {
+    std::error_code ec;
+    fs::remove_all(staging, ec);
+  }
+  SetStatus("");
+  s_importing = false;
+  return error;
+}
