index 0000000000..e24d4e47aa
--- /dev/null
+++ b/Source/Android/app/src/main/java/org/dolphinemu/dolphinemu/skies/SkiesDriverGuard.kt
@@ -0,0 +1,136 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+package org.dolphinemu.dolphinemu.skies
+
+import android.content.Context
+import android.os.Build
+import org.dolphinemu.dolphinemu.features.settings.model.NativeConfig
+import org.dolphinemu.dolphinemu.features.settings.model.Settings
+import org.dolphinemu.dolphinemu.utils.GpuDriverHelper
+import java.io.File
+
+/**
+ * A GPU driver the player chose (Dolphin's custom-driver loading, libadrenotools, Adreno only),
+ * with the crash safeguard the Goemon / Hybrid Heaven ports use: a marker is written when the game
+ * starts with a custom driver and removed when it closes normally (or, for a driver the player has
+ * kept, after 30 s of play). A marker still there when the launcher comes back means the game
+ * crashed or was closed by force with that driver, so the app goes back to the device's own driver
+ * and says why. After the first normal session with a new driver the launcher asks whether to keep
+ * it (a black screen can't ask from inside the game).
+ */
+object SkiesDriverGuard {
+    private const val PENDING = "skies-driver-boot-pending"
+    private const val KEPT = "skies-driver-kept"
+    private const val SESSION_DONE = "skies-driver-session-done"
+
+    private fun file(context: Context, name: String) = File(context.filesDir, name)
+
+    /** The custom driver's library name, "" for the device's own driver. */
+    fun selected(): String = NativeConfig.getString(NativeConfig.LAYER_BASE_OR_CURRENT,
+        Settings.FILE_GFX, "Settings", "DriverLibName", "")
+
+    fun supported(): Boolean = try {
+        GpuDriverHelper.supportsCustomDriverLoading()
+    } catch (e: UnsatisfiedLinkError) {
+        false
+    }
+
+    /** "Name version" of the installed custom driver, or null. */
+    fun customName(): String? = GpuDriverHelper.getInstalledDriverMetadata()?.let {
+        listOf(it.name, it.driverVersion).filter { s -> !s.isNullOrBlank() }.joinToString(" ")
+    }
+
+    fun isKept(context: Context): Boolean =
+        file(context, KEPT).let { it.isFile && it.readText() == selected() }
+
+    /** After a driver was installed: selected, not kept yet. */
+    fun select(context: Context, libraryName: String) {
+        NativeConfig.setString(NativeConfig.LAYER_BASE, Settings.FILE_GFX, "Settings",
+            "DriverLibName", libraryName)
+        NativeConfig.save(NativeConfig.LAYER_BASE)
+        file(context, KEPT).delete()
+        file(context, SESSION_DONE).delete()
+    }
+
+    fun useSystemDriver(context: Context) {
+        GpuDriverHelper.uninstallDriver()
+        NativeConfig.setString(NativeConfig.LAYER_BASE, Settings.FILE_GFX, "Settings",
+            "DriverLibName", "")
+        NativeConfig.save(NativeConfig.LAYER_BASE)
+        listOf(PENDING, KEPT, SESSION_DONE).forEach { file(context, it).delete() }
+    }
+
+    fun keep(context: Context) {
+        file(context, KEPT).writeText(selected())
+        file(context, SESSION_DONE).delete()
+    }
+
+    /** The game is about to start. */
+    fun onLaunch(context: Context) {
+        if (selected().isEmpty()) return
+        file(context, PENDING).writeText(selected())
+        file(context, SESSION_DONE).delete()
+    }
+
+    /** The game has run for a while: a kept driver no longer needs the marker. */
+    fun onSurvived(context: Context) {
+        if (isKept(context)) file(context, PENDING).delete()
+    }
+
+    /** The game closed normally (EmulationActivity finishing). */
+    fun onCleanExit(context: Context) {
+        if (file(context, PENDING).delete() && !isKept(context))
+            file(context, SESSION_DONE).writeText(selected())
+    }
+
+    sealed class Check {
+        object None : Check()
+        class Reverted(val driver: String) : Check()
+        class AskKeep(val driver: String) : Check()
+    }
+
+    /** The launcher is showing: what to tell the player, if anything. */
+    fun check(context: Context): Check {
+        val pending = file(context, PENDING)
+        if (pending.isFile) {
+            val name = customName() ?: pending.readText().trim()
+            useSystemDriver(context)
+            return Check.Reverted(name)
+        }
+        if (file(context, SESSION_DONE).isFile && selected().isNotEmpty() && !isKept(context))
+            return Check.AskKeep(customName() ?: selected())
+        return Check.None
+    }
+
+    /** One block of text for a bug report: app, device, Android, GPU and driver. */
+    fun deviceInfo(context: Context): String {
+        val version = try {
+            context.packageManager.getPackageInfo(context.packageName, 0).let {
+                @Suppress("DEPRECATION")
+                "${it.versionName} (${if (Build.VERSION.SDK_INT >= 28) it.longVersionCode else it.versionCode})"
+            }
+        } catch (e: Exception) {
+            "?"
+        }
+        val chip = if (Build.VERSION.SDK_INT >= 31) "${Build.SOC_MANUFACTURER} ${Build.SOC_MODEL}"
+        else Build.HARDWARE
+        val system = try {
+            GpuDriverHelper.getSystemDriverMetadata(context)
+        } catch (e: UnsatisfiedLinkError) {
+            null
+        }
+        // Only the version: Dolphin's vendor field from the driver is a bare number on Adreno
+        val gpu = system?.driverVersion?.takeIf { it.isNotBlank() } ?: "unknown"
+        val driver = if (selected().isEmpty()) "device's own" else "custom: ${customName() ?: selected()}"
+        val metrics = context.resources.displayMetrics
+        return listOf(
+            "App: Skies of Arcadia Legends $version",
+            "Device: ${Build.MANUFACTURER} ${Build.MODEL}",
+            "Chip: $chip",
+            "Android: ${Build.VERSION.RELEASE} (API ${Build.VERSION.SDK_INT})",
+            "GPU driver (device): $gpu",
+            "GPU driver in use: $driver",
+            "Screen: ${metrics.widthPixels} x ${metrics.heightPixels}",
+        ).joinToString("\n")
+    }
+}
