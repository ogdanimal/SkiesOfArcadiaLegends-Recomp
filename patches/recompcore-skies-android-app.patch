@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+package org.dolphinemu.dolphinemu.skies
+
+import android.content.Context
+import org.dolphinemu.dolphinemu.R
+
+/** True in the branded app (-PskiesBrand), which hides Dolphin's own screens. */
+fun isSkiesBrand(context: Context): Boolean =
+    context.getString(R.string.skies_dol_sha256).isNotEmpty()
+
+/** Skies Recomp's first-run disc import (jni/SkiesImport.cpp). */
+object SkiesNative {
+    /**
+     * Checks [image] (a path or content URI) is Skies of Arcadia Legends (USA), extracts it to
+     * [gameRoot], patches its main.dol with the whole-file DOL patch at [patch] and checks the result
+     * against [dolSha256]. Returns "" on success, else a message for the player. Blocks: call it off
+     * the main thread.
+     */
+    @JvmStatic
+    external fun importDisc(image: String, gameRoot: String, patch: String, dolSha256: String): String
+
+    /**
+     * A game imported by an earlier version of the app: patches the original main.dol kept at import
+     * (sys/main.dol.orig) into this version's build. Returns "" on success, else a message.
+     */
+    @JvmStatic
+    external fun repatch(gameRoot: String, patch: String, dolSha256: String): String
+
+    /**
+     * Settings, Saves: imports a save the player already has (tools/save_import.cpp, the desktop
+     * launcher's code): a memory card save, a whole memory card image or a save state, told apart by
+     * contents. [file] is a copy of the picked document. Returns the message for the player and "ok"
+     * on success ("" otherwise). Call it only while the game isn't running.
+     */
+    @JvmStatic
+    external fun importSave(file: String, userDirectory: String): Array<String>
+
+    /** The saves there now, a line each: "Memory card: files 1 and 2", "Save states: 4". */
+    @JvmStatic
+    external fun describeSaves(userDirectory: String): String
+
+    /** What the import is doing now ("" when idle). */
+    @JvmStatic
+    external fun importStatus(): String
+
+    /** Controller 1's [key] in Config/GCPadNew.ini [GCPad1] (percent), or [fallback] if unset. */
+    @JvmStatic
+    external fun getPadOption(key: String, fallback: Int): Int
+
+    /**
+     * Writes [value] to each of [keys] in controller 1's existing profile. False when there is no
+     * profile yet (it appears once the game has run) or it can't be written.
+     */
+    @JvmStatic
+    external fun setPadOptions(keys: Array<String>, value: Int): Boolean
+
+    /**
+     * Gives controller 1 a stick, D-pad and triggers Android can read when its profile has Dolphin's
+     * SDL-style defaults (only the face buttons worked). What it did, or "" if nothing was needed.
+     */
+    @JvmStatic
+    external fun ensurePadProfile(): String
+}
diff --git a/Source/Android/app/src/main/java/org/dolphinemu/dolphinemu/skies/SkiesSettingsPanel.kt b/Source/Android/app/src/main/java/org/dolphinemu/dolphinemu/skies/SkiesSettingsPanel.kt
