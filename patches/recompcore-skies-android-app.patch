diff --git a/Source/Android/app/src/skies/AndroidManifest.xml b/Source/Android/app/src/skies/AndroidManifest.xml
new file mode 100644
index 0000000000..7626aaf47a
--- /dev/null
+++ b/Source/Android/app/src/skies/AndroidManifest.xml
@@ -0,0 +1,22 @@
+<!-- Skies Recomp, the branded app only (-PskiesBrand; merged over src/main's manifest for both build
+     types): no permissions it doesn't use. It has no netplay, online features or microphone, isn't
+     a TV channel app, and keeps its user folder in the app's own storage (without the legacy
+     storage permission Dolphin can't pick the shared dolphin-emu folder on Android 10 and older). -->
+<manifest xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:tools="http://schemas.android.com/tools">
+
+    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove"/>
+    <uses-permission android:name="android.permission.INTERNET" tools:node="remove"/>
+    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>
+    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
+    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" tools:node="remove"/>
+    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" tools:node="remove"/>
+    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
+
+    <application
+        android:requestLegacyExternalStorage="false"
+        android:preserveLegacyExternalStorage="false"
+        tools:replace="android:requestLegacyExternalStorage,android:preserveLegacyExternalStorage">
+        <profileable tools:node="remove"/>
+    </application>
+</manifest>
