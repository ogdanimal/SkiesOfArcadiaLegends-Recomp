+/* lwbrx / stwbrx swap all four bytes; lhbrx / sthbrx only the low two (a 32-bit swap would leave
+ * them in the high half: sthbrx of 0x6800 stored 0, lhbrx of 0x1234 loaded 0x34120000). */
+static DolIRValue byte_reverse(Builder* b, DolIRValue value, u8 width) {
+    value = unary(b, DOLIR_OP_BSWAP, DOLIR_TYPE_I32, value);
+    if (width == 2)
+        value = binary(b, DOLIR_OP_LSHR, DOLIR_TYPE_I32, value, c32(b, 16));
+    return value;
+}
