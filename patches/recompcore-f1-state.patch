+bool KeyBound(std::string_view control)
+{
+  const auto lock = ControllerEmu::EmulatedController::GetStateLock();
+  for (const SkiesBindings::Input& input : SkiesBindings::Inputs())
+  {
+    for (const SkiesBindings::Term& term : SkiesBindings::SplitExpression(Expression(input)))
+    {
+      Slot slot;
+      if (SkiesBindings::TermSlot(term, &slot) && slot == Slot::Keyboard && term.control == control)
+        return true;
+    }
+  }
+  return false;
+}
