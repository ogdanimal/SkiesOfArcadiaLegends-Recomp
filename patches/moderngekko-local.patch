+// The branded launcher's background picture, launcher-background.png beside the executable
+// (release/ in the recomp repo; Skies: art by I_LIKE_SONIC, credited in README.md / CREDITS.md). nullptr without one: the launcher keeps its plain look.
+SDL_Texture* LoadLauncherBackground(SDL_Renderer* renderer, const fs::path& path)
+{
+  std::ifstream file(path, std::ios::binary);
+  if (!file)
+    return nullptr;
+  const std::vector<u8> png{std::istreambuf_iterator<char>(file), std::istreambuf_iterator<char>()};
+  Common::UniqueBuffer<u8> pixels;
+  u32 width = 0;
+  u32 height = 0;
+  if (!Common::LoadPNG(png, &pixels, &width, &height))
+    return nullptr;
+  SDL_Texture* texture = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_RGBA32,
+                                           SDL_TEXTUREACCESS_STATIC, static_cast<int>(width),
+                                           static_cast<int>(height));
+  if (!texture)
+    return nullptr;
+  SDL_UpdateTexture(texture, nullptr, pixels.data(), static_cast<int>(width * 4));
+  SDL_SetTextureScaleMode(texture, SDL_SCALEMODE_LINEAR);
+  return texture;
+}
+
+// The newest memory card save of a game (GCI folders GC/<region>/Card A|B, Dolphin's default card
+// type for GameCube), by file write time: Dolphin rewrites a .gci only when that save changed, so
+// this is when the game last saved. Nothing for a game with no save.
+struct CardSave
+{
+  fs::path path;
+  fs::file_time_type written;
+};
+std::optional<CardSave> NewestCardSave(const fs::path& user_directory, std::string_view game_code)
+{
+  std::optional<CardSave> newest;
+  for (const char* region : {"USA", "EUR", "JAP"})
+  {
+    for (const char* card : {"Card A", "Card B"})
+    {
+      std::error_code ec;
+      for (const fs::directory_entry& entry :
+           fs::directory_iterator(user_directory / "GC" / region / card, ec))
+      {
+        const std::string name = entry.path().filename().string();
+        if (entry.path().extension() != ".gci" ||
+            (!game_code.empty() && name.find(game_code) == std::string::npos))
+        {
+          continue;
+        }
+        std::error_code time_ec;
+        const fs::file_time_type written = entry.last_write_time(time_ec);
+        if (!time_ec && (!newest || written > newest->written))
+          newest = CardSave{entry.path(), written};
+      }
+    }
+  }
+  return newest;
+}
+
+// The game's file number (1..99) of a card save on card A, from its name ("...SA_LEGENDS.000.gci"
+// is file 1); 0 when it isn't one the in-game auto-load can pick (card B, another name).
+int CardSaveFile(const fs::path& path)
+{
+  if (path.parent_path().filename() != "Card A")
+    return 0;
+  const std::string stem = path.stem().string();  // "8P-GEAE-SA_LEGENDS.000"
+  const std::size_t dot = stem.rfind('.');
+  if (dot == std::string::npos || stem.size() - dot != 4)
+    return 0;
+  int number = 0;
+  for (char c : stem.substr(dot + 1))
+  {
+    if (c < '0' || c > '9')
+      return 0;
+    number = number * 10 + (c - '0');
+  }
+  return number <= 98 ? number + 1 : 0;
+}
+
+// "Oct 11 21:07", local time
+std::string LocalTimeText(fs::file_time_type written)
+{
+  const auto system = std::chrono::time_point_cast<std::chrono::system_clock::duration>(
+      written - fs::file_time_type::clock::now() + std::chrono::system_clock::now());
+  const std::time_t when = std::chrono::system_clock::to_time_t(system);
+  char text[32] = {};
+  if (const std::tm* local = std::localtime(&when))
+    std::strftime(text, sizeof(text), "%b %d %H:%M", local);
+  return text;
+}
