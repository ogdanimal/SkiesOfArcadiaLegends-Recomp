diff --git a/tests/user_directory_test.cpp b/tests/user_directory_test.cpp
new file mode 100644
index 0000000..c8a05c4
--- /dev/null
+++ b/tests/user_directory_test.cpp
@@ -0,0 +1,185 @@
+#include "user_directory.hpp"
+
+#include <chrono>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <string>
+
+namespace fs = std::filesystem;
+using namespace moderngekko::frontend;
+
+namespace
+{
+int failures = 0;
+
+void Check(bool condition, const char* what)
+{
+  if (!condition)
+  {
+    std::cerr << "FAIL: " << what << '\n';
+    ++failures;
+  }
+}
+
+void Write(const fs::path& file, const std::string& text)
+{
+  fs::create_directories(file.parent_path());
+  std::ofstream(file, std::ios::binary) << text;
+}
+
+std::string Read(const fs::path& file)
+{
+  std::ifstream input(file, std::ios::binary);
+  return {std::istreambuf_iterator<char>(input), {}};
+}
+
+// A data folder as the launcher leaves it: a game, a card save with an old time, a config
+void MakeUserData(const fs::path& directory)
+{
+  Write(directory / "games" / "GEAE8P" / "sys" / "main.dol", std::string(4096, 'd'));
+  Write(directory / "GC" / "USA" / "Card A" / "01-8P-GEAE.gci", "save");
+  fs::last_write_time(directory / "GC" / "USA" / "Card A" / "01-8P-GEAE.gci",
+                      fs::file_time_type::clock::now() - std::chrono::hours(48));
+  Write(directory / "Config" / "Dolphin.ini", "[Skies]\nWidescreen = 1\n");
+  Write(directory / "default-game.txt", PathUtf8(directory / "games" / "GEAE8P") + "\n");
+}
+
+void CheckUserData(const fs::path& directory, const fs::file_time_type save_time, const char* what)
+{
+  const std::string label(what);
+  Check(Read(directory / "games" / "GEAE8P" / "sys" / "main.dol").size() == 4096,
+        (label + ": game moved").c_str());
+  Check(Read(directory / "Config" / "Dolphin.ini") == "[Skies]\nWidescreen = 1\n",
+        (label + ": config moved").c_str());
+  Check(fs::last_write_time(directory / "GC" / "USA" / "Card A" / "01-8P-GEAE.gci") == save_time,
+        (label + ": save time kept").c_str());
+  Check(Read(directory / "default-game.txt") ==
+            PathUtf8(directory / "games" / "GEAE8P") + "\n",
+        (label + ": default-game.txt points into the new folder").c_str());
+}
+}  // namespace
+
+int main()
+{
+  const fs::path root =
+      fs::temp_directory_path() /
+      ("moderngekko-user-directory-" +
+       std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+  const fs::path exe = root / "release";
+  const fs::path default_directory = root / "local" / "Skies of Arcadia Legends";
+  fs::create_directories(exe);
+
+  // Where Change... puts it
+  Check(UserDirectoryIn(root / "D", "Skies") == root / "D" / "Skies", "a folder inside the pick");
+  Check(UserDirectoryIn(root / "D" / "", "Skies") == root / "D" / "Skies", "trailing separator");
+  Check(UserDirectoryIn(root / "D" / "Skies", "Skies") == root / "D" / "Skies",
+        "the pick when it has the name");
+
+  // Nothing set: the default
+  MakeUserData(default_directory);
+  const fs::file_time_type save_time =
+      fs::last_write_time(default_directory / "GC" / "USA" / "Card A" / "01-8P-GEAE.gci");
+  UserDirectoryChoice choice = FindUserDirectory(exe, default_directory);
+  Check(choice.kind == UserDirectoryKind::Default && choice.path == default_directory, "default");
+
+  // Moves that can't happen
+  Check(!CheckUserDirectoryMove(default_directory, default_directory).empty(), "same folder");
+  Check(!CheckUserDirectoryMove(default_directory, default_directory / "inner").empty(),
+        "inside the data folder");
+  Check(!CheckUserDirectoryMove(default_directory, root / "local").empty(),
+        "the data folder inside it");
+  Write(root / "full" / "Skies" / "something.txt", "x");
+  Check(HoldsUserData(root / "full" / "Skies"), "a folder with data");
+  UserDirectoryMoveProgress refused;
+  Check(!MoveUserDirectory(default_directory, root / "full" / "Skies", default_directory, &refused).ok &&
+            fs::exists(default_directory / "Config"),
+        "no move into a folder with data");
+  Check(CheckUserDirectoryMove(default_directory, root / "empty" / "Skies").empty(),
+        "a new folder");
+
+  // Same drive: a rename
+  const fs::path moved = root / "D" / "Skies";
+  UserDirectoryMoveProgress progress;
+  UserDirectoryMoveResult result =
+      MoveUserDirectory(default_directory, moved, default_directory, &progress);
+  Check(result.ok && result.error.empty(), "rename move");
+  CheckUserData(moved, save_time, "rename");
+  Check(!HoldsUserData(default_directory), "default folder only has the pointer");
+  choice = FindUserDirectory(exe, default_directory);
+  Check(choice.kind == UserDirectoryKind::Moved && choice.path == moved && !choice.missing,
+        "pointer found");
+
+  // Copy (another drive), then a cancelled one
+  const fs::path copied = root / "E" / "Skies";
+  UserDirectoryMoveProgress copy_progress;
+  copy_progress.always_copy = true;
+  result = MoveUserDirectory(moved, copied, default_directory, &copy_progress);
+  Check(result.ok && result.warning.empty(), "copy move");
+  CheckUserData(copied, save_time, "copy");
+  Check(!fs::exists(moved), "old folder removed after the copy");
+  Check(!fs::exists(root / "E" / "Skies.moving"), "no staging folder left");
+  Check(copy_progress.done_bytes == copy_progress.total_bytes, "progress complete");
+  Check(FindUserDirectory(exe, default_directory).path == copied, "pointer updated");
+
+  UserDirectoryMoveProgress cancelled;
+  cancelled.always_copy = true;
+  cancelled.cancel = true;
+  result = MoveUserDirectory(copied, root / "F" / "Skies", default_directory, &cancelled);
+  Check(!result.ok && !fs::exists(root / "F" / "Skies") && !fs::exists(root / "F" / "Skies.moving"),
+        "cancel leaves nothing");
+  Check(FindUserDirectory(exe, default_directory).path == copied && fs::exists(copied / "Config"),
+        "cancel keeps the data and the pointer");
+
+  // Back to the default, by a copy: the pointer goes
+  UserDirectoryMoveProgress back_progress;
+  back_progress.always_copy = true;
+  result = MoveUserDirectory(copied, default_directory, default_directory, &back_progress);
+  Check(result.ok, "move back");
+  CheckUserData(default_directory, save_time, "back");
+  Check(!fs::exists(default_directory / USER_DIRECTORY_POINTER), "pointer removed");
+  Check(FindUserDirectory(exe, default_directory).kind == UserDirectoryKind::Default,
+        "default again");
+
+  // A pointer to a folder that's gone (a drive not connected)
+  std::string error;
+  Check(PointUserDirectory(root / "G" / "Skies", default_directory, &error), "point");
+  choice = FindUserDirectory(exe, default_directory);
+  Check(choice.kind == UserDirectoryKind::Moved && choice.missing, "missing folder");
+  Check(PointUserDirectory(default_directory, default_directory, &error) &&
+            FindUserDirectory(exe, default_directory).kind == UserDirectoryKind::Default,
+        "point back to the default");
+
+  // Portable wins over everything
+  Write(exe / PORTABLE_MARKER, "");
+  choice = FindUserDirectory(exe, default_directory);
+  Check(choice.kind == UserDirectoryKind::Portable && choice.path == exe / "User", "portable");
+
+  // default-game.txt from a data folder copied by hand
+  const fs::path hand_copy = root / "H" / "Skies";
+  fs::create_directories(hand_copy / "games" / "GEAE8P");
+  Check(ResolveDefaultGame(PathUtf8(root / "gone" / "games" / "GEAE8P"), exe, hand_copy) ==
+            hand_copy / "games" / "GEAE8P",
+        "absolute path that's gone");
+  Check(ResolveDefaultGame("Game", exe, hand_copy) == exe / "Game", "relative path");
+  Check(ResolveDefaultGame("", exe, hand_copy).empty(), "empty");
+
+  // Default folder from the environment
+#if !defined(_WIN32)
+  setenv("XDG_DATA_HOME", "relative", 1);
+  setenv("HOME", "/home/someone", 1);
+  Check(DefaultUserDirectory("Skies", false) == fs::path("/home/someone/.local/share/Skies"),
+        "relative XDG_DATA_HOME is unset");
+  setenv("XDG_DATA_HOME", "/data", 1);
+  Check(DefaultUserDirectory("Skies", false) == fs::path("/data/Skies"), "XDG_DATA_HOME");
+  Check(DefaultUserDirectory("Skies", true) == fs::path("/home/someone/Documents/Skies"),
+        "Documents");
+#endif
+
+  std::error_code ec;
+  fs::remove_all(root, ec);
+  if (failures == 0)
+    std::cout << "user_directory: all checks passed\n";
+  return failures == 0 ? 0 : 1;
+}
