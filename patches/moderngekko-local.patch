+// A save state's name for the menu: the in-game menu's slots and auto-saves by their role
+std::string StateText(const fs::path& path)
+{
+  const std::string stem = path.stem().string();
+  if (stem.starts_with("state-skies-slot"))
+    return "Slot " + stem.substr(std::string_view("state-skies-slot").size());
+  if (stem.starts_with("recovery-skies-"))
+    return "Auto-save";
+  if (stem.starts_with("state-skies-import-"))
+    return "Imported";
+  return stem;
+}
