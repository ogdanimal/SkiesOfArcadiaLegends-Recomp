diff --git a/tools/launcher_controls.cpp b/tools/launcher_controls.cpp
new file mode 100644
index 0000000..5562f1d
--- /dev/null
+++ b/tools/launcher_controls.cpp
@@ -0,0 +1,589 @@
+#include "launcher_controls.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cctype>
+
+#include <imgui.h>
+
+#include "Common/IniFile.h"
+
+namespace moderngekko::launcher_controls
+{
+namespace
+{
+using Clock = std::chrono::steady_clock;
+using SkiesBindings::Slot;
+
+constexpr std::chrono::seconds CAPTURE_TIME{6};
+constexpr Sint16 AXIS_PRESS = 20000;  // of 32767, as the game's press threshold (0.6)
+
+// InputCommon's SDL backend's names (SDL/SDLGamepad.h), so a binding made here is the one the game
+// would detect
+constexpr std::array<const char*, 21> BUTTON_NAMES{
+    "Button S",   "Button E",   "Button W", "Button N", "Back",     "Guide",    "Start",
+    "Thumb L",    "Thumb R",    "Shoulder L", "Shoulder R", "Pad N", "Pad S", "Pad W",
+    "Pad E",      "Misc 1",     "Paddle 1", "Paddle 2", "Paddle 3", "Paddle 4", "Touchpad"};
+
+fs::path ProfilePath(const fs::path& user_directory)
+{
+  return user_directory / "Config" / "GCPadNew.ini";
+}
+
+std::string Get(Common::IniFile& ini, const char* section, const char* key)
+{
+  std::string value;
+  ini.GetOrCreateSection(section)->Get(key, &value, "");
+  return value;
+}
+
+void Set(Common::IniFile& ini, const char* section, const char* key, const std::string& value)
+{
+  if (value.empty())
+    ini.GetOrCreateSection(section)->Delete(key);
+  else
+    ini.GetOrCreateSection(section)->Set(key, value);
+}
+
+// A key's name on this platform's keyboard ("SPACE" on Windows, "space" on X11)
+bool IsPlatformKey(std::string_view control)
+{
+  for (const SkiesBindings::KeyName& key : SkiesBindings::KeyNames())
+  {
+    if (SkiesBindings::PlatformKeyName(key) == control)
+      return true;
+  }
+  return false;
+}
+
+std::vector<std::string> Controls(std::string_view list)
+{
+  std::vector<std::string> controls;
+  while (!list.empty())
+  {
+    const std::size_t bar = list.find('|');
+    controls.emplace_back(list.substr(0, bar));
+    list = bar == std::string_view::npos ? std::string_view() : list.substr(bar + 1);
+  }
+  return controls;
+}
+
+// The default layout for a slot, written over what the slot had (as the runtime's ResetDefaults),
+// or only where it has nothing
+void WriteDefaults(Common::IniFile& ini, Slot slot, bool only_empty = false)
+{
+  const std::string keyboard = SkiesBindings::DefaultKeyboardDevice();
+  for (const SkiesBindings::Input& input : SkiesBindings::Inputs())
+  {
+    if (only_empty && !SkiesBindings::SlotControl(Get(ini, input.section, input.key), slot).empty())
+      continue;
+    std::string expression = SkiesBindings::SetSlot(Get(ini, input.section, input.key), slot, "", "");
+    if (slot == Slot::Keyboard)
+    {
+      const SkiesBindings::KeyName* key = SkiesBindings::FindKey(input.keyboard);
+      if (key && !keyboard.empty())
+        expression = SkiesBindings::SetSlot(expression, slot, keyboard, SkiesBindings::PlatformKeyName(*key));
+    }
+    else
+    {
+      std::vector<SkiesBindings::Term> terms = SkiesBindings::SplitExpression(expression);
+      const std::vector<std::string> controls = Controls(input.controller);
+      for (std::size_t i = 0; i < controls.size(); ++i)
+      {
+        SkiesBindings::Term term;
+        term.text = SkiesBindings::ControlTerm("", controls[i]);
+        term.simple = true;
+        term.control = controls[i];
+        terms.insert(terms.begin() + static_cast<std::ptrdiff_t>(i), std::move(term));
+      }
+      expression = SkiesBindings::JoinTerms(terms);
+      if (input.analog_key)
+        Set(ini, input.section, input.analog_key,
+            SkiesBindings::SetSlot(Get(ini, input.section, input.analog_key), slot, "",
+                                   input.controller_analog));
+    }
+    Set(ini, input.section, input.key, expression);
+  }
+  if (slot == Slot::Keyboard)
+    ini.GetOrCreateSection(SkiesBindings::HOTKEY_SECTION)->Set("Version", SkiesBindings::DEFAULTS_VERSION);
+}
+
+// A profile from before the keyboard (0.9.x) gets its layout and the hotkeys, as the game would
+// add them at its next start (Core/SkiesInput.cpp)
+bool Upgrade(Common::IniFile& ini)
+{
+  bool changed = false;
+  Common::IniFile::Section* hotkeys = ini.GetOrCreateSection(SkiesBindings::HOTKEY_SECTION);
+  for (const SkiesBindings::Input& input : SkiesBindings::Inputs())
+  {
+    if (std::string_view(input.section) != SkiesBindings::HOTKEY_SECTION || hotkeys->Exists(input.key))
+      continue;
+    std::string expression;
+    for (const std::string& control : Controls(input.controller))
+      expression += (expression.empty() ? "" : " | ") + SkiesBindings::ControlTerm("", control);
+    hotkeys->Set(input.key, expression);
+    changed = true;
+  }
+  int version = 0;
+  hotkeys->Get("Version", &version, 0);
+  if (version < SkiesBindings::DEFAULTS_VERSION)
+  {
+    const std::string keyboard = SkiesBindings::DefaultKeyboardDevice();
+    // Dolphin's own keyboard profile (the keyboard as the device): its keys name the keyboard, so
+    // they stay keys when controller 1 moves to a controller
+    std::string device;
+    ini.GetOrCreateSection(SkiesBindings::PAD_SECTION)->Get("Device", &device);
+    if (SkiesBindings::IsKeyboardSource(device.substr(0, device.find('/'))))
+    {
+      std::vector<std::string> keys;
+      for (const SkiesBindings::Input& input : SkiesBindings::Inputs())
+      {
+        if (std::string_view(input.section) != SkiesBindings::PAD_SECTION)
+          continue;
+        keys.emplace_back(input.key);
+        if (input.analog_key)
+          keys.emplace_back(input.analog_key);
+      }
+      keys.emplace_back("Main Stick/Modifier");
+      keys.emplace_back("C-Stick/Modifier");
+      for (const std::string& key : keys)
+      {
+        std::vector<SkiesBindings::Term> terms =
+            SkiesBindings::SplitExpression(Get(ini, SkiesBindings::PAD_SECTION, key.c_str()));
+        bool qualified = false;
+        for (SkiesBindings::Term& term : terms)
+        {
+          if (!term.simple || !term.device.empty() || !IsPlatformKey(term.control))
+            continue;
+          term.device = device;
+          term.text = SkiesBindings::ControlTerm(device, term.control);
+          qualified = true;
+        }
+        if (qualified)
+          Set(ini, SkiesBindings::PAD_SECTION, key.c_str(), SkiesBindings::JoinTerms(terms));
+      }
+      // and a controller gets the default layout
+      WriteDefaults(ini, Slot::Controller, true);
+    }
+    // Only into empty keyboard slots
+    for (const SkiesBindings::Input& input : SkiesBindings::Inputs())
+    {
+      const std::string expression = Get(ini, input.section, input.key);
+      const SkiesBindings::KeyName* key = SkiesBindings::FindKey(input.keyboard);
+      if (key && !keyboard.empty() && SkiesBindings::SlotControl(expression, Slot::Keyboard).empty())
+        Set(ini, input.section, input.key,
+            SkiesBindings::SetSlot(expression, Slot::Keyboard, keyboard,
+                                   SkiesBindings::PlatformKeyName(*key)));
+    }
+    hotkeys->Set("Version", SkiesBindings::DEFAULTS_VERSION);
+    changed = true;
+  }
+  // No controller binding at all (only the keyboard's): the controller's layout, as the game adds it
+  // (Core/SkiesInput.cpp ControllerLayoutIfNone)
+  const bool controller_bound =
+      std::ranges::any_of(SkiesBindings::Inputs(), [&](const SkiesBindings::Input& input) {
+        return std::string_view(input.section) == SkiesBindings::PAD_SECTION &&
+               !SkiesBindings::SlotControl(Get(ini, input.section, input.key), Slot::Controller)
+                    .empty();
+      });
+  if (!controller_bound)
+  {
+    WriteDefaults(ini, Slot::Controller, true);
+    changed = true;
+  }
+  return changed;
+}
+
+bool Save(Common::IniFile& ini, const fs::path& user_directory, std::string* message)
+{
+  std::error_code ec;
+  fs::create_directories(ProfilePath(user_directory).parent_path(), ec);
+  if (!ini.Save(ProfilePath(user_directory).string()))
+  {
+    if (message)
+      *message = "can't write " + ProfilePath(user_directory).string();
+    return false;
+  }
+  return true;
+}
+
+bool UseControllerImpl(const fs::path& user_directory, const std::string& device, std::string* message);
+
+void Load(State& state, const fs::path& user_directory)
+{
+  Common::IniFile ini;
+  // No profile yet (no controller has been connected), or one without bindings (an empty file):
+  // the default layout, keeping its device
+  if (!ini.Load(ProfilePath(user_directory).string()) ||
+      !ini.GetOrCreateSection(SkiesBindings::PAD_SECTION)->Exists("Buttons/A"))
+  {
+    std::string device;
+    ini.GetOrCreateSection(SkiesBindings::PAD_SECTION)->Get("Device", &device);
+    UseControllerImpl(user_directory, device, nullptr);
+  }
+  if (ini.Load(ProfilePath(user_directory).string()) && Upgrade(ini))
+    Save(ini, user_directory, nullptr);
+  state.controller_labels.clear();
+  state.keyboard_labels.clear();
+  for (const SkiesBindings::Input& input : SkiesBindings::Inputs())
+  {
+    const std::string expression = Get(ini, input.section, input.key);
+    for (const Slot slot : {Slot::Controller, Slot::Keyboard})
+    {
+      std::string label;
+      for (const SkiesBindings::Term& term : SkiesBindings::SplitExpression(expression))
+      {
+        Slot term_slot;
+        if (SkiesBindings::TermSlot(term, &term_slot) && term_slot == slot)
+          label += (label.empty() ? "" : " / ") + SkiesBindings::ControlLabel(term.control);
+      }
+      (slot == Slot::Controller ? state.controller_labels : state.keyboard_labels)
+          .push_back(label.empty() ? "-" : label);
+    }
+  }
+  state.loaded = true;
+}
+
+bool Bind(State& state, const fs::path& user_directory, const std::string& control, bool analog)
+{
+  const SkiesBindings::Input& input = SkiesBindings::Inputs()[state.capture_input];
+  const Slot slot = state.capture_slot;
+  Common::IniFile ini;
+  ini.Load(ProfilePath(user_directory).string());
+  const std::string device = slot == Slot::Keyboard ? SkiesBindings::DefaultKeyboardDevice() : "";
+  Set(ini, input.section, input.key,
+      SkiesBindings::SetSlot(Get(ini, input.section, input.key), slot, device, control));
+  // A trigger's analog half follows a controller axis (a button only presses it all the way)
+  if (input.analog_key && slot == Slot::Controller)
+    Set(ini, input.section, input.analog_key,
+        SkiesBindings::SetSlot(Get(ini, input.section, input.analog_key), slot, "",
+                               analog ? control : ""));
+  state.capture_input = -1;
+  const bool saved = Save(ini, user_directory, &state.status);
+  if (saved)
+    state.status = std::string(input.label) + ": " + SkiesBindings::ControlLabel(control);
+  state.loaded = false;
+  return saved;
+}
+
+void StopCapture(State& state)
+{
+  state.capture_input = -1;
+  for (SDL_Gamepad* gamepad : state.gamepads)
+    SDL_CloseGamepad(gamepad);
+  state.gamepads.clear();
+  state.held.clear();
+}
+
+// Every gamepad's buttons and axes, in one list (the order of AxisOrButton below)
+std::vector<bool> ReadHeld(const State& state)
+{
+  std::vector<bool> held;
+  for (SDL_Gamepad* gamepad : state.gamepads)
+  {
+    for (int button = 0; button < static_cast<int>(BUTTON_NAMES.size()); ++button)
+      held.push_back(SDL_GetGamepadButton(gamepad, static_cast<SDL_GamepadButton>(button)));
+    for (int axis = 0; axis < SDL_GAMEPAD_AXIS_COUNT; ++axis)
+    {
+      const Sint16 value = SDL_GetGamepadAxis(gamepad, static_cast<SDL_GamepadAxis>(axis));
+      held.push_back(value > AXIS_PRESS);
+      held.push_back(value < -AXIS_PRESS);
+    }
+  }
+  return held;
+}
+
+// The name of entry `index` of ReadHeld's list, and whether it's an axis
+std::string HeldName(std::size_t index, bool* analog)
+{
+  const std::size_t per_pad = BUTTON_NAMES.size() + 2 * SDL_GAMEPAD_AXIS_COUNT;
+  const std::size_t i = index % per_pad;
+  *analog = i >= BUTTON_NAMES.size();
+  if (!*analog)
+    return BUTTON_NAMES[i];
+  const int axis = static_cast<int>((i - BUTTON_NAMES.size()) / 2);
+  const bool positive = (i - BUTTON_NAMES.size()) % 2 == 0;
+  switch (axis)
+  {
+  case SDL_GAMEPAD_AXIS_LEFTX:
+    return positive ? "Left X+" : "Left X-";
+  case SDL_GAMEPAD_AXIS_LEFTY:  // SDL's down is positive; Dolphin's names follow XInput (up = +)
+    return positive ? "Left Y-" : "Left Y+";
+  case SDL_GAMEPAD_AXIS_RIGHTX:
+    return positive ? "Right X+" : "Right X-";
+  case SDL_GAMEPAD_AXIS_RIGHTY:
+    return positive ? "Right Y-" : "Right Y+";
+  case SDL_GAMEPAD_AXIS_LEFT_TRIGGER:
+    return positive ? "Trigger L" : "";
+  case SDL_GAMEPAD_AXIS_RIGHT_TRIGGER:
+    return positive ? "Trigger R" : "";
+  default:
+    return "";
+  }
+}
+
+void StartCapture(State& state, int input, Slot slot)
+{
+  StopCapture(state);
+  state.capture_input = input;
+  state.capture_slot = slot;
+  state.capture_deadline = Clock::now() + CAPTURE_TIME;
+  state.status.clear();
+  if (slot == Slot::Controller)
+  {
+    int count = 0;
+    SDL_JoystickID* ids = SDL_GetGamepads(&count);
+    for (int i = 0; i < count; ++i)
+    {
+      if (SDL_Gamepad* gamepad = SDL_OpenGamepad(ids[i]))
+        state.gamepads.push_back(gamepad);
+    }
+    SDL_free(ids);
+    if (state.gamepads.empty())
+    {
+      state.capture_input = -1;
+      state.status = "Connect a controller to change its buttons";
+      return;
+    }
+    state.held = ReadHeld(state);
+  }
+  // Pad navigation would act on the press too
+  ImGui::GetIO().ConfigFlags &= ~ImGuiConfigFlags_NavEnableGamepad;
+  state.nav_suspended = true;
+}
+
+// The keyboard's name for a key: the layout's letter (X11 names letters by the layout, as SDL's
+// keycodes), else the key's position (KeyNames)
+std::string KeyboardName(SDL_Scancode scancode)
+{
+#if !defined(_WIN32)
+  const SDL_Keycode keycode = SDL_GetKeyFromScancode(scancode, SDL_KMOD_NONE, false);
+  if (keycode >= 'a' && keycode <= 'z')
+    return std::string(1, static_cast<char>(std::toupper(static_cast<int>(keycode))));
+#endif
+  const SkiesBindings::KeyName* key = SkiesBindings::FindKey(SDL_GetScancodeName(scancode));
+  return key ? SkiesBindings::PlatformKeyName(*key) : std::string();
+}
+
+void PollCapture(State& state, const fs::path& user_directory)
+{
+  if (state.capture_input < 0)
+  {
+    // Pad navigation comes back once the press that bound a button is let go
+    if (state.nav_suspended)
+    {
+      bool any = false;
+      int count = 0;
+      SDL_JoystickID* ids = SDL_GetGamepads(&count);
+      for (int i = 0; i < count; ++i)
+      {
+        if (SDL_Gamepad* gamepad = SDL_GetGamepadFromID(ids[i]))
+        {
+          for (int button = 0; button < SDL_GAMEPAD_BUTTON_COUNT; ++button)
+            any |= SDL_GetGamepadButton(gamepad, static_cast<SDL_GamepadButton>(button));
+        }
+      }
+      SDL_free(ids);
+      if (!any)
+      {
+        ImGui::GetIO().ConfigFlags |= ImGuiConfigFlags_NavEnableGamepad;
+        state.nav_suspended = false;
+      }
+    }
+    return;
+  }
+  if (Clock::now() > state.capture_deadline)
+  {
+    StopCapture(state);
+    state.status = "Nothing pressed: unchanged";
+    return;
+  }
+  if (state.capture_slot != Slot::Controller)
+    return;
+  const std::vector<bool> held = ReadHeld(state);
+  for (std::size_t i = 0; i < held.size() && i < state.held.size(); ++i)
+  {
+    if (held[i] && !state.held[i])
+    {
+      bool analog = false;
+      const std::string name = HeldName(i, &analog);
+      if (name.empty())
+        continue;
+      Bind(state, user_directory, name, analog);
+      StopCapture(state);
+      return;
+    }
+    if (!held[i])
+      state.held[i] = false;
+  }
+}
+}  // namespace
+
+bool UseController(const fs::path& user_directory, const std::string& device, std::string* message)
+{
+  return UseControllerImpl(user_directory, device, message);
+}
+
+bool PrepareProfile(const fs::path& user_directory, std::string* message)
+{
+  Common::IniFile ini;
+  std::string device;
+  if (ini.Load(ProfilePath(user_directory).string()))
+    ini.GetOrCreateSection(SkiesBindings::PAD_SECTION)->Get("Device", &device);
+  return UseControllerImpl(user_directory, device, message);
+}
+
+namespace
+{
+bool UseControllerImpl(const fs::path& user_directory, const std::string& device, std::string* message)
+{
+  Common::IniFile ini;
+  const bool exists = ini.Load(ProfilePath(user_directory).string()) &&
+                      ini.GetOrCreateSection(SkiesBindings::PAD_SECTION)->Exists("Buttons/A");
+  if (!exists)
+  {
+    // A new profile: the default layout for both, the sticks' calibration and rumble as the
+    // generated GameCube profile had them (frontend_config.cpp)
+    WriteDefaults(ini, Slot::Controller);
+    WriteDefaults(ini, Slot::Keyboard);
+    Common::IniFile::Section* pad = ini.GetOrCreateSection(SkiesBindings::PAD_SECTION);
+    pad->Set("Main Stick/Calibration", std::string("100.00"));
+    pad->Set("C-Stick/Calibration", std::string("100.00"));
+    pad->Set("Rumble/Motor", std::string("`Motor L` | `Motor R`"));
+  }
+  // The game sees controller 1 without its device too (the keyboard plays while it's unplugged)
+  ini.GetOrCreateSection(SkiesBindings::PAD_SECTION)->Set("Options/Always Connected", std::string("True"));
+  Upgrade(ini);
+  Set(ini, SkiesBindings::PAD_SECTION, "Device", device);
+  if (!Save(ini, user_directory, message))
+    return false;
+  if (message)
+    *message = device.empty() ? "Keyboard (a controller works as soon as it's connected)" :
+                                "Controller set up";
+  return true;
+}
+}  // namespace
+
+bool ResetDefaults(const fs::path& user_directory, bool controller, bool keyboard,
+                   std::string* message)
+{
+  Common::IniFile ini;
+  ini.Load(ProfilePath(user_directory).string());
+  if (controller)
+    WriteDefaults(ini, Slot::Controller);
+  if (keyboard)
+    WriteDefaults(ini, Slot::Keyboard);
+  return Save(ini, user_directory, message);
+}
+
+bool HandleEvent(State& state, const SDL_Event& event, const fs::path& user_directory)
+{
+  if (state.capture_input < 0 || state.capture_slot != Slot::Keyboard)
+    return false;
+  if (event.type != SDL_EVENT_KEY_DOWN)
+    return false;
+  if (!event.key.repeat)
+  {
+    const std::string name = KeyboardName(event.key.scancode);
+    if (name.empty())
+      state.status = std::string("That key can't be used: ") + SDL_GetScancodeName(event.key.scancode);
+    else
+      Bind(state, user_directory, name, false);
+    StopCapture(state);
+  }
+  return true;
+}
+
+void DrawMapping(State& state, const fs::path& user_directory, float scale)
+{
+  PollCapture(state, user_directory);
+  if (!state.loaded)
+    Load(state, user_directory);
+  const auto inputs = SkiesBindings::Inputs();
+  const ImGuiTableFlags flags = ImGuiTableFlags_SizingStretchProp | ImGuiTableFlags_RowBg |
+                                ImGuiTableFlags_PadOuterX;
+  if (ImGui::BeginTable("##mapping", 3, flags))
+  {
+    ImGui::TableSetupColumn("GameCube", ImGuiTableColumnFlags_WidthStretch, 1.0f);
+    ImGui::TableSetupColumn("Controller", ImGuiTableColumnFlags_WidthStretch, 1.3f);
+    ImGui::TableSetupColumn("Keyboard", ImGuiTableColumnFlags_WidthStretch, 1.3f);
+    ImGui::TableHeadersRow();
+    for (int i = 0; i < static_cast<int>(inputs.size()); ++i)
+    {
+      ImGui::TableNextRow();
+      ImGui::TableNextColumn();
+      ImGui::AlignTextToFramePadding();
+      ImGui::TextUnformatted(inputs[i].label);
+      for (const Slot slot : {Slot::Controller, Slot::Keyboard})
+      {
+        ImGui::TableNextColumn();
+        const bool capturing = state.capture_input == i && state.capture_slot == slot;
+        const std::string& label =
+            (slot == Slot::Controller ? state.controller_labels : state.keyboard_labels)[i];
+        const std::string text = (capturing ? (slot == Slot::Keyboard ? std::string("Press a key...") :
+                                                                        std::string("Press a button...")) :
+                                              label) +
+                                 "##" + std::to_string(i) + (slot == Slot::Keyboard ? "k" : "c");
+        if (capturing)
+          ImGui::PushStyleColor(ImGuiCol_Button, ImGui::GetStyleColorVec4(ImGuiCol_ButtonActive));
+        if (ImGui::Button(text.c_str(), ImVec2(-FLT_MIN, 0)))
+        {
+          if (capturing)
+            StopCapture(state);
+          else
+            StartCapture(state, i, slot);
+        }
+        if (capturing)
+          ImGui::PopStyleColor();
+        // Clear: right click, Delete / Backspace or the pad's X on the focused binding
+        const bool clear = ImGui::IsItemClicked(ImGuiMouseButton_Right) ||
+                           (ImGui::IsItemFocused() && !capturing &&
+                            (ImGui::IsKeyPressed(ImGuiKey_Delete, false) ||
+                             ImGui::IsKeyPressed(ImGuiKey_Backspace, false) ||
+                             ImGui::IsKeyPressed(ImGuiKey_GamepadFaceLeft, false)));
+        // The controller's A and B stay bound: the in-game menu needs them (as SkiesMenu.cpp)
+        const std::string_view key = inputs[i].key;
+        const bool keep = slot == Slot::Controller && (key == "Buttons/A" || key == "Buttons/B");
+        if (clear && state.capture_input < 0 && keep)
+        {
+          state.status = std::string(inputs[i].label) + " stays bound on the controller (the in-game "
+                                                         "menu needs it): change it instead";
+        }
+        else if (clear && state.capture_input < 0)
+        {
+          state.capture_input = i;
+          state.capture_slot = slot;
+          Bind(state, user_directory, "", false);
+          state.status = std::string(inputs[i].label) + ": unbound";
+        }
+        if (ImGui::IsItemHovered() && !capturing)
+        {
+          ImGui::SetTooltip(keep ? "Click, then press the new %s." :
+                                   "Click, then press the new %s. Right-click or Delete unbinds it.",
+                            slot == Slot::Keyboard ? "key" : "button");
+        }
+      }
+    }
+    ImGui::EndTable();
+  }
+  if (ImGui::Button("Reset controller buttons"))
+  {
+    ResetDefaults(user_directory, true, false, &state.status);
+    state.status = "Controller buttons reset";
+    state.loaded = false;
+  }
+  ImGui::SameLine();
+  if (ImGui::Button("Reset keyboard keys"))
+  {
+    ResetDefaults(user_directory, false, true, &state.status);
+    state.status = "Keyboard keys reset";
+    state.loaded = false;
+  }
+  if (!state.status.empty())
+  {
+    ImGui::SameLine(0.0f, 16.0f * scale);
+    ImGui::AlignTextToFramePadding();
+    ImGui::TextDisabled("%s", state.status.c_str());
+  }
+}
+}  // namespace moderngekko::launcher_controls
