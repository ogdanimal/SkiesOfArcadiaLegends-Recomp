+bool ReplaceDirectory(const std::filesystem::path& staging,
+                      const std::filesystem::path& destination, std::string* error);
+
+// The folder ReplaceDirectory parks the old destination in.
+std::filesystem::path ReplacedDirectory(const std::filesystem::path& destination);
+
+// Before reading `destination`: if a swap was killed between its two renames (no destination, the
+// old one parked), the old one is put back.
+void RecoverReplacedDirectory(const std::filesystem::path& destination);
+}  // namespace moderngekko::frontend
