diff --git a/tools/disc_extract.cpp b/tools/disc_extract.cpp
new file mode 100644
index 0000000..37e96bd
--- /dev/null
+++ b/tools/disc_extract.cpp
@@ -0,0 +1,221 @@
+#include "disc_extract.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <set>
+#include <string_view>
+#include <system_error>
+
+#include "Common/FileUtil.h"
+#include "DiscIO/DiscExtractor.h"
+#include "DiscIO/Filesystem.h"
+#include "DiscIO/Volume.h"
+
+namespace fs = std::filesystem;
+
+namespace moderngekko::frontend
+{
+namespace
+{
+// A real disc's tree is a few levels deep and a few thousand entries; a crafted one is cut off long
+// before the recursion or the duplicate sets get large.
+constexpr int MAX_DEPTH = 32;
+constexpr std::size_t MAX_ENTRIES = 1u << 20;
+
+std::string Lower(std::string_view text)
+{
+  std::string lower(text);
+  std::ranges::transform(lower, lower.begin(),
+                         [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+  return lower;
+}
+
+// "" if `name` can only ever mean a file or folder inside its parent, on every platform.
+std::string NameProblem(std::string_view name)
+{
+  if (name.empty() || name == "." || name == "..")
+    return "an empty or relative name";
+  for (const char c : name)
+  {
+    if (c == '/' || c == '\\' || c == ':' || static_cast<unsigned char>(c) < 0x20 || c == 0x7f)
+      return "a path separator or control character";
+  }
+  if (name.back() == '.' || name.back() == ' ')
+    return "a name ending in a dot or space";
+  // Windows opens these as devices, with or without an extension
+  const std::string stem = Lower(name.substr(0, name.find('.')));
+  static constexpr std::array<std::string_view, 4> DEVICES{"con", "prn", "aux", "nul"};
+  if (std::ranges::find(DEVICES, stem) != DEVICES.end() ||
+      (stem.size() == 4 && (stem.starts_with("com") || stem.starts_with("lpt")) &&
+       stem[3] >= '1' && stem[3] <= '9'))
+  {
+    return "a device name";
+  }
+  return "";
+}
+
+std::string CheckDirectory(const DiscIO::FileInfo& directory, const std::string& path, int depth,
+                           std::size_t* entries, std::uint64_t* total_bytes,
+                           std::size_t* file_count)
+{
+  if (depth > MAX_DEPTH)
+    return "the disc's folders nest too deep (" + path + ")";
+  std::set<std::string> seen;
+  for (const DiscIO::FileInfo& entry : directory)
+  {
+    if (++*entries > MAX_ENTRIES)
+      return "the disc lists too many files";
+    const std::string name = entry.GetName();
+    if (const std::string problem = NameProblem(name); !problem.empty())
+      return "the disc has a file with " + problem + " in " + (path.empty() ? "/" : path);
+    if (!seen.insert(Lower(name)).second)
+      return "the disc lists " + path + name + " twice";
+    if (entry.IsDirectory())
+    {
+      if (std::string error =
+              CheckDirectory(entry, path + name + "/", depth + 1, entries, total_bytes, file_count);
+          !error.empty())
+      {
+        return error;
+      }
+    }
+    else
+    {
+      *total_bytes += entry.GetSize();
+      ++*file_count;
+    }
+  }
+  return "";
+}
+
+bool ExportDirectory(const DiscIO::Volume& volume, const DiscIO::Partition& partition,
+                     const DiscIO::FileInfo& directory, const std::string& disc_path,
+                     const std::string& folder,
+                     const std::function<void(const std::string& path)>& progress,
+                     std::string* error)
+{
+  if (!File::IsDirectory(folder) && !File::CreateDir(folder))
+  {
+    *error = "can't create " + folder;
+    return false;
+  }
+  for (const DiscIO::FileInfo& entry : directory)
+  {
+    const std::string name = entry.GetName();
+    const std::string output = folder + '/' + name;
+    if (entry.IsDirectory())
+    {
+      if (!ExportDirectory(volume, partition, entry, disc_path + name + "/", output, progress,
+                           error))
+      {
+        return false;
+      }
+      continue;
+    }
+    if (progress)
+      progress(disc_path + name);
+    // The folder started empty and names are unique, so anything already there is a collision
+    if (File::Exists(output))
+    {
+      *error = output + " already exists";
+      return false;
+    }
+    if (!DiscIO::ExportFile(volume, partition, &entry, output) ||
+        File::GetSize(output) != entry.GetSize())
+    {
+      *error = "can't copy " + disc_path + name + " from the disc (damaged image, or the drive is full)";
+      return false;
+    }
+  }
+  return true;
+}
+}  // namespace
+
+std::string CheckDiscFileNames(const DiscIO::FileInfo& root, std::uint64_t* total_bytes,
+                               std::size_t* file_count)
+{
+  *total_bytes = 0;
+  *file_count = 0;
+  std::size_t entries = 0;
+  return CheckDirectory(root, "/", 0, &entries, total_bytes, file_count);
+}
+
+bool ExportDiscFiles(const DiscIO::Volume& volume, const DiscIO::Partition& partition,
+                     const DiscIO::FileInfo& root, const std::string& export_folder,
+                     const std::function<void(const std::string& path)>& progress,
+                     std::string* error)
+{
+  // Names are checked here too, so a caller that skipped CheckDiscFileNames still can't escape
+  std::uint64_t total_bytes = 0;
+  std::size_t file_count = 0;
+  if (std::string problem = CheckDiscFileNames(root, &total_bytes, &file_count); !problem.empty())
+  {
+    *error = std::move(problem);
+    return false;
+  }
+  return ExportDirectory(volume, partition, root, "", export_folder, progress, error);
+}
+
+bool HasFreeSpace(const fs::path& directory, std::uint64_t bytes, std::string* error)
+{
+  std::error_code ec;
+  fs::path existing = directory;
+  while (!existing.empty() && !fs::exists(existing, ec))
+    existing = existing.parent_path();
+  const fs::space_info space = fs::space(existing.empty() ? fs::path(".") : existing, ec);
+  if (ec)
+    return true;  // can't tell: let the copy itself report a full drive
+  if (space.available >= bytes)
+    return true;
+  constexpr std::uint64_t MIB = 1024 * 1024;
+  *error = "not enough free space: the game needs " + std::to_string(bytes / MIB) + " MB, " +
+           std::to_string(space.available / MIB) + " MB are free";
+  return false;
+}
+
+fs::path ReplacedDirectory(const fs::path& destination)
+{
+  fs::path old = destination;
+  old += ".old";
+  return old;
+}
+
+void RecoverReplacedDirectory(const fs::path& destination)
+{
+  std::error_code ec;
+  const fs::path old = ReplacedDirectory(destination);
+  if (!fs::exists(destination, ec) && fs::is_directory(old, ec))
+    fs::rename(old, destination, ec);
+}
+
+bool ReplaceDirectory(const fs::path& staging, const fs::path& destination, std::string* error)
+{
+  std::error_code ec;
+  RecoverReplacedDirectory(destination);
+  const fs::path old = ReplacedDirectory(destination);
+  fs::remove_all(old, ec);
+  ec.clear();
+  const bool had_destination = fs::exists(destination, ec);
+  if (had_destination)
+  {
+    fs::rename(destination, old, ec);
+    if (ec)
+    {
+      *error = "can't move the old game folder aside: " + ec.message();
+      return false;
+    }
+  }
+  fs::rename(staging, destination, ec);
+  if (ec)
+  {
+    *error = "can't move the new game folder into place: " + ec.message();
+    std::error_code restore_ec;
+    if (had_destination)
+      fs::rename(old, destination, restore_ec);
+    return false;
+  }
+  fs::remove_all(old, ec);
+  return true;
+}
+}  // namespace moderngekko::frontend
diff --git a/tools/disc_extract.hpp b/tools/disc_extract.hpp
new file mode 100644
index 0000000..1dae3db
--- /dev/null
+++ b/tools/disc_extract.hpp
@@ -0,0 +1,55 @@
+#pragma once
+
+// Extracting the player's disc into a game folder, shared by the desktop launcher (ExtractDisc) and
+// the Android app (jni/SkiesImport.cpp). Dolphin's DiscIO::ExportDirectory builds each output path
+// from the disc's own file-system (FST) names and only logs a file it couldn't write, so a crafted
+// image could write outside the folder ("..", "/") and a damaged one gave a "successful" import with
+// files missing. These check every name first, fail on any file that isn't written whole, and swap
+// a finished folder in without losing the old one if the swap fails.
+
+#include <cstddef>
+#include <cstdint>
+#include <filesystem>
+#include <functional>
+#include <string>
+
+namespace DiscIO
+{
+class FileInfo;
+class Volume;
+struct Partition;
+}  // namespace DiscIO
+
+namespace moderngekko::frontend
+{
+// Checks the whole FST under `root` before anything is written: every name must be a plain file
+// or folder name (not empty, ".", "..", no '/', '\\', ':' or control characters, no Windows
+// device name, no trailing dot or space) and unique in its folder ignoring case. Adds up the
+// file sizes in *total_bytes and counts them in *file_count. "" if it is fine, else what is wrong.
+std::string CheckDiscFileNames(const DiscIO::FileInfo& root, std::uint64_t* total_bytes,
+                               std::size_t* file_count);
+
+// Exports every file under `root` into `export_folder` (UTF-8, as Dolphin's File:: functions
+// take it), which must be new and empty. Call CheckDiscFileNames first. Fails on the first file that
+// can't be written or doesn't end up its FST size. `progress` gets each file's disc path.
+bool ExportDiscFiles(const DiscIO::Volume& volume, const DiscIO::Partition& partition,
+                     const DiscIO::FileInfo& root, const std::string& export_folder,
+                     const std::function<void(const std::string& path)>& progress,
+                     std::string* error);
+
+// Whether the drive holding `directory` (or its nearest existing parent) has `bytes` free.
+bool HasFreeSpace(const std::filesystem::path& directory, std::uint64_t bytes, std::string* error);
+
+// Puts the finished `staging` folder at `destination`: an existing destination is renamed aside
