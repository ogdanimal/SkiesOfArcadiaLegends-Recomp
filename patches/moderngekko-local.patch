+// What Import a save accepts for `game_id` (the string must outlive the result). Skies' card saves
+// are always 3 blocks named SA_LEGENDS.000-.002, so anything else is refused, not left unloadable.
+moderngekko::frontend::SaveImportGame SaveGame(std::string_view game_id)
+{
+  moderngekko::frontend::SaveImportGame game{game_id, MODERNGEKKO_FRONTEND_NAME,
+                                             "state-skies-import-"};
+  if (IsSkies(game_id))
+  {
+    game.save_blocks = 3;
+    game.save_name_prefix = "SA_LEGENDS.";
+  }
+  return game;
+}
