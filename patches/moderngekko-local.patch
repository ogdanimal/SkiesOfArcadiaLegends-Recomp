+
+// A whole-file patch for a DOL that a game patch extends with new sections (word patches can't add
+// them):
+//   moderngekko-dol-file-patch 1
+//   input-sha256 <hex>     the original DOL it applies to
+//   output-sha256 <hex>    the patched DOL (what the recomp module was built from)
+//   output-size <decimal>
+//   <hex file offset> <hex bytes>   one run per line, ascending
+// It only applies to that exact input and checks its output, so the result is byte for byte the DOL
+// the module expects; a DOL that already is the output is left alone.
+constexpr std::string_view FILE_PATCH_HEADER = "moderngekko-dol-file-patch 1";
+
+bool ParseHexBytes(std::string_view text, std::vector<std::uint8_t> *bytes) {
+  if (text.empty() || text.size() % 2 != 0)
+    return false;
+  bytes->clear();
+  for (std::size_t i = 0; i < text.size(); i += 2) {
+    std::uint8_t value = 0;
+    const auto parsed =
+        std::from_chars(text.data() + i, text.data() + i + 2, value, 16);
+    if (parsed.ec != std::errc{} || parsed.ptr != text.data() + i + 2)
+      return false;
+    bytes->push_back(value);
+  }
+  return true;
+}
+
+bool ApplyFilePatch(const fs::path &dol_path, std::ifstream &input,
+                    bool *changed, std::string *error) {
+  std::string input_sha, output_sha;
+  std::uint64_t output_size = 0;
+  struct Run {
+    std::uint64_t offset;
+    std::vector<std::uint8_t> bytes;
+  };
+  std::vector<Run> runs;
+  std::string line;
+  unsigned line_number = 1;
+  while (std::getline(input, line)) {
+    ++line_number;
+    if (!line.empty() && line.back() == '\r')
+      line.pop_back();
+    if (line.empty())
+      continue;
+    const std::size_t space = line.find(' ');
+    if (space == std::string::npos) {
+      *error = "invalid DOL file patch line " + std::to_string(line_number);
+      return false;
+    }
+    const std::string_view key = std::string_view(line).substr(0, space);
+    const std::string_view value = std::string_view(line).substr(space + 1);
+    if (key == "input-sha256") {
+      input_sha = value;
+    } else if (key == "output-sha256") {
+      output_sha = value;
+    } else if (key == "output-size") {
+      const auto parsed =
+          std::from_chars(value.data(), value.data() + value.size(), output_size);
+      if (parsed.ec != std::errc{} || parsed.ptr != value.data() + value.size()) {
+        *error = "invalid DOL file patch size";
+        return false;
+      }
+    } else {
+      Run run{};
+      const auto parsed =
+          std::from_chars(key.data(), key.data() + key.size(), run.offset, 16);
+      if (parsed.ec != std::errc{} || parsed.ptr != key.data() + key.size() ||
+          !ParseHexBytes(value, &run.bytes)) {
+        *error = "invalid DOL file patch line " + std::to_string(line_number);
+        return false;
+      }
+      runs.push_back(std::move(run));
+    }
+  }
+  if (input_sha.size() != 64 || output_sha.size() != 64 || output_size == 0 ||
+      output_size > (64u << 20) || runs.empty()) {
+    *error = "incomplete DOL file patch";
+    return false;
+  }
+  // Every run in order and inside the output, compared without adding to an untrusted offset.
+  std::uint64_t previous_end = 0;
+  for (const Run &run : runs) {
+    if (run.offset < previous_end || run.offset > output_size ||
+        run.bytes.size() > output_size - run.offset) {
+      *error = "invalid DOL file patch run at " + std::to_string(run.offset);
+      return false;
+    }
+    previous_end = run.offset + run.bytes.size();
+  }
+
+  std::vector<std::uint8_t> bytes;
+  if (!ReadFile(dol_path, &bytes, error))
+    return false;
+  const std::string actual = moderngekko::Sha256(bytes);
+  if (actual == output_sha)
+    return true;
+  if (actual != input_sha) {
+    *error = "main.dol isn't the one this release patches (SHA-256 " + actual +
+             ", expected " + input_sha + ")";
+    return false;
+  }
+  bytes.resize(static_cast<std::size_t>(output_size), 0);
+  for (const Run &run : runs)
+    std::copy(run.bytes.begin(), run.bytes.end(),
+              bytes.begin() + static_cast<std::ptrdiff_t>(run.offset));
+  if (moderngekko::Sha256(bytes) != output_sha) {
+    *error = "patched main.dol doesn't match the release (patch file damaged?)";
+    return false;
+  }
+  *changed = true;
+  return ReplaceFile(dol_path, bytes, error);
+}
 } // namespace
 
 bool ApplyDolPatchManifest(const fs::path &dol_path,
                            const fs::path &manifest_path, bool *changed,
                            std::string *error) {
   *changed = false;
+  {
+    std::ifstream input(manifest_path);
+    std::string header;
+    if (input && std::getline(input, header)) {
+      if (!header.empty() && header.back() == '\r')
+        header.pop_back();
+      if (header == FILE_PATCH_HEADER)
+        return ApplyFilePatch(dol_path, input, changed, error);
+    }
+  }
   std::vector<Patch> patches;
   if (!LoadManifest(manifest_path, &patches, error))
     return false;
