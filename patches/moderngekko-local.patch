+
+// A Dolphin setting in the user directory's Config/<file>, [<section>] <key>.
+struct DolphinOption
+{
+  const char* file;
+  const char* section;
+  const char* key;
+};
+
+// -1 when not set. Booleans (Dolphin writes True / False) read as 1 / 0.
+int ReadDolphinOption(const fs::path& user_directory, const DolphinOption& option)
+{
+  Common::IniFile ini;
+  ini.Load((user_directory / "Config" / option.file).string());
+  std::string text;
+  if (!ini.GetOrCreateSection(option.section)->Get(option.key, &text) || text.empty())
+    return -1;
+  std::ranges::transform(text, text.begin(), [](unsigned char c) { return std::tolower(c); });
+  if (text == "true")
+    return 1;
+  if (text == "false")
+    return 0;
+  try
+  {
+    // Out of int's range (1e99) or nan would make the cast undefined: unset instead
+    const double value = std::stod(text);
+    if (!(value >= -1e9 && value <= 1e9))
+      return -1;
+    return static_cast<int>(value);
+  }
+  catch (const std::exception&)
+  {
+    return -1;
+  }
+}
+
+bool WriteDolphinOption(const fs::path& user_directory, const DolphinOption& option, int value,
+                        std::string* error)
+{
+  const fs::path path = user_directory / "Config" / option.file;
+  std::error_code ec;
+  fs::create_directories(path.parent_path(), ec);
+  Common::IniFile ini;
+  // A file that is there but can't be read (another program holding it) would otherwise be
+  // rewritten with this one key, losing every other setting in it.
+  if (!ini.Load(path.string()) && fs::exists(path, ec))
+  {
+    *error = "can't read " + path.string() + "; try again";
+    return false;
+  }
+  ini.GetOrCreateSection(option.section)->Set(option.key, value);
+  if (!ini.Save(path.string()))
+  {
+    *error = "can't write " + path.string();
+    return false;
+  }
+  return true;
+}
+
+// Controller 1's settings in the pad profile (GCPadNew.ini [GCPad1], what Dolphin's controller
+// settings and the in-game menu write): the sticks' dead zone and the rumble motor's range, percent.
+constexpr const char* PAD_PROFILE = "GCPadNew.ini";
+constexpr const char* PAD_SECTION = "GCPad1";
+
+int ReadPadOption(const fs::path& user_directory, const char* key, int fallback)
+{
+  const int value = ReadDolphinOption(user_directory, {PAD_PROFILE, PAD_SECTION, key});
+  return value < 0 ? fallback : value;
+}
+
+bool WritePadOptions(const fs::path& user_directory, std::initializer_list<const char*> keys,
+                     int value, std::string* error)
+{
+  const fs::path path = user_directory / "Config" / PAD_PROFILE;
+  Common::IniFile ini;
+  if (!ini.Load(path.string()))
+  {
+    *error = "set up a controller first (Controls)";
+    return false;
+  }
+  for (const char* key : keys)
+    ini.GetOrCreateSection(PAD_SECTION)->Set(key, value);
+  if (!ini.Save(path.string()))
+  {
+    *error = "can't write " + path.string();
+    return false;
+  }
+  return true;
+}
