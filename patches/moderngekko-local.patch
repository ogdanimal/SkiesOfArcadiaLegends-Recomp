+#include "Core/SkiesBindings.h"
+
+// Settings, Controls in the GameCube launcher: controller 1's profile (GCPadNew.ini) with the
+// keyboard beside the controller, and a table to change any button or key (Core/SkiesBindings.h,
+// the same bindings the in-game menu's Button mapping shows).
+namespace moderngekko::launcher_controls
+{
+namespace fs = std::filesystem;
+
+struct State
+{
+  // A binding waiting for its new button or key
+  int capture_input = -1;
+  SkiesBindings::Slot capture_slot = SkiesBindings::Slot::Controller;
+  std::chrono::steady_clock::time_point capture_deadline{};
+  // Gamepad buttons and axes held when the capture started: they count once released
+  std::vector<SDL_Gamepad*> gamepads;
+  std::vector<bool> held;
+  // Pad navigation is off while capturing, until every button is let go again
+  bool nav_suspended = false;
+  // What the table shows, read from the profile when it changes
+  bool loaded = false;
+  std::vector<std::string> controller_labels;
+  std::vector<std::string> keyboard_labels;
+  std::string status;
+};
+
+// Controller 1 uses this device (an SDL gamepad, "" = none yet: the keyboard plays and the game
+// takes the first controller it sees). Keeps the bindings; makes the default profile if there is
+// none.
+bool UseController(const fs::path& user_directory, const std::string& device, std::string* message);
+// Before a launch: the profile as UseController leaves it, its device kept (an empty file, or one
+// with only the keyboard's bindings, gets the default layout where it has none)
+bool PrepareProfile(const fs::path& user_directory, std::string* message);
+// The default layout back, for the controller, the keyboard or both (dead zone, rumble and the
+// device stay)
+bool ResetDefaults(const fs::path& user_directory, bool controller, bool keyboard,
+                   std::string* message);
+
+// Before ImGui sees an event: a capture takes key presses. True if it took the event.
+bool HandleEvent(State& state, const SDL_Event& event, const fs::path& user_directory);
+// The mapping table (inside the Controls tab). scale: the launcher's layout scale.
+void DrawMapping(State& state, const fs::path& user_directory, float scale);
+}  // namespace moderngekko::launcher_controls
