@@ -0,0 +1,101 @@
+#pragma once
+
+// Where the launcher and the runner keep the imported game, saves, settings and logs (the user
+// directory, Dolphin's User folder). Both use these, so they always agree:
+//  1. Portable: a file named portable.txt beside the programs puts it in a User folder there.
+//  2. Moved: Settings, Disc, Data folder moves it anywhere and leaves data-folder.txt in the
+//     default folder, one UTF-8 line naming the new place.
+//  3. The default: %LOCALAPPDATA%\<name> on Windows, $XDG_DATA_HOME/<name> or
+//     ~/.local/share/<name> elsewhere (Documents/<name> in a build that asks for it).
+// Standard library only (the unit test builds it alone).
+
+#include <atomic>
+#include <cstdint>
+#include <filesystem>
+#include <string>
+#include <string_view>
+
+namespace moderngekko::frontend
+{
+enum class UserDirectoryKind
+{
+  Default,
+  Moved,
+  Portable,
+};
+
+struct UserDirectoryChoice
+{
+  std::filesystem::path path;
+  UserDirectoryKind kind = UserDirectoryKind::Default;
+  // Moved, but the folder data-folder.txt names isn't there (a drive not connected, a folder
+  // deleted): the caller asks before using it, as it would start empty
+  bool missing = false;
+};
+
+// The pointer file a move leaves in the default folder
+inline constexpr std::string_view USER_DIRECTORY_POINTER = "data-folder.txt";
+// Beside the programs: keep the data in a User folder there
+inline constexpr std::string_view PORTABLE_MARKER = "portable.txt";
+
+// The default folder named `name`, from the environment. `in_documents`: Documents/<name>.
+std::filesystem::path DefaultUserDirectory(std::string_view name, bool in_documents);
+
+// Which folder to use (portable, moved or the default, as above).
+UserDirectoryChoice FindUserDirectory(const std::filesystem::path& executable_directory,
+                                      const std::filesystem::path& default_directory);
+
+// UTF-8 text of a path and back (std::filesystem's narrow strings are the ANSI code page on
+// Windows)
+std::string PathUtf8(const std::filesystem::path& path);
+std::filesystem::path Utf8Path(std::string_view text);
+
+// The folder Change... uses for one the player picked: a folder named `name` inside it, or the
+// picked folder itself when it already has that name (picking the data folder's old place).
+std::filesystem::path UserDirectoryIn(const std::filesystem::path& picked, std::string_view name);
+
+// Whether `directory` holds anything but the pointer file (data that a move would mix into).
+bool HoldsUserData(const std::filesystem::path& directory);
+
+// "" if the data in `from` can move to `to`, else why not, in a sentence for the player: the same
+// folder, or one inside the other. A `to` that holds data (HoldsUserData) can't take it either,
+// but can be used as it is (PointUserDirectory).
+std::string CheckUserDirectoryMove(const std::filesystem::path& from,
+                                   const std::filesystem::path& to);
+
+// Makes `to` the folder used from the next start, without moving anything: writes the pointer in
+// `default_directory`, or removes it when `to` is the default.
+bool PointUserDirectory(const std::filesystem::path& to,
+                        const std::filesystem::path& default_directory, std::string* error);
+
+struct UserDirectoryMoveProgress
+{
+  std::atomic<std::uint64_t> done_bytes{0};
+  std::atomic<std::uint64_t> total_bytes{1};
+  std::atomic<bool> cancel{false};
+  bool always_copy = false;  // tests: copy even where a rename would do
+};
+
+struct UserDirectoryMoveResult
+{
+  bool ok = false;
+  std::string error;    // why it didn't move; the data is still where it was
+  std::string warning;  // moved, but some old files couldn't be removed
+};
+
+// Moves the data in `from` to `to` (refused as CheckUserDirectoryMove says, or if `to` holds
+// data) and points the next start there. On the same drive a rename; otherwise a copy into
+// `to`.moving (file times kept: Continue picks the newest save by them), renamed into place, then
+// the pointer, then the old files are removed. A failed or cancelled copy removes its folder and
+// leaves everything as it was. default-game.txt paths into `from` are rewritten into `to`.
+UserDirectoryMoveResult MoveUserDirectory(const std::filesystem::path& from,
+                                          const std::filesystem::path& to,
+                                          const std::filesystem::path& default_directory,
+                                          UserDirectoryMoveProgress* progress);
+
+// The game a default-game.txt line names: relative lines are in `base`; an absolute one that is
+// gone but whose folder name is in `user_directory`/games is that (a data folder copied by hand
+// to another drive or folder).
+std::filesystem::path ResolveDefaultGame(std::string_view line, const std::filesystem::path& base,
+                                         const std::filesystem::path& user_directory);
+}  // namespace moderngekko::frontend
