diff --git a/tools/release_games.hpp b/tools/release_games.hpp
new file mode 100644
index 0000000..b779d53
--- /dev/null
+++ b/tools/release_games.hpp
@@ -0,0 +1,76 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <filesystem>
+#include <fstream>
+#include <span>
+#include <string>
+#include <string_view>
+
+// The games a branded release runs, one per region (CMake: MODERNGEKKO_REQUIRED_DISC_ID, with
+// MODERNGEKKO_REQUIRED_DOL_SHA256 and MODERNGEKKO_DOL_PATCH_MANIFEST in the same order): per disc
+// ID, the patched DOL the release pins ("" = any) and the DOL patch that makes it ("" = none),
+// relative to the executables. A build without the list runs any game and checks nothing.
+namespace moderngekko::frontend
+{
+struct ReleaseGame
+{
+  std::string_view disc_id;
+  std::string_view dol_sha256;
+  std::string_view dol_patch;
+};
+
+#ifdef MODERNGEKKO_RELEASE_GAMES
+inline constexpr ReleaseGame RELEASE_GAMES[] = {
+#include "release_games.inc"
+};
+#endif
+
+inline std::span<const ReleaseGame> ReleaseGames()
+{
+#ifdef MODERNGEKKO_RELEASE_GAMES
+  return RELEASE_GAMES;
+#else
+  return {};
+#endif
+}
+
+inline bool IsReleaseBuild()
+{
+  return !ReleaseGames().empty();
+}
+
+inline const ReleaseGame* FindReleaseGame(std::string_view disc_id)
+{
+  for (const ReleaseGame& game : ReleaseGames())
+  {
+    if (game.disc_id == disc_id)
+      return &game;
+  }
+  return nullptr;
+}
+
+// "GEAE8P" or "GEAE8P or GEAP8P", for messages.
+inline std::string ReleaseDiscIds()
+{
+  std::string ids;
+  for (const ReleaseGame& game : ReleaseGames())
+  {
+    if (!ids.empty())
+      ids += " or ";
+    ids += game.disc_id;
+  }
+  return ids;
+}
+
+// An extracted game's disc ID (sys/boot.bin's first six bytes), "" if it can't be read.
+inline std::string ReadDiscId(const std::filesystem::path& game_root)
+{
+  std::ifstream file(game_root / "sys" / "boot.bin", std::ios::binary);
+  std::array<char, 6> id{};
+  if (!file.read(id.data(), id.size()))
+    return {};
+  return std::string(id.data(), id.size());
+}
+}  // namespace moderngekko::frontend
diff --git a/tools/save_import.cpp b/tools/save_import.cpp
new file mode 100644
index 0000000..67380d9
--- /dev/null
+++ b/tools/save_import.cpp
@@ -0,0 +1,578 @@
+#include "save_import.hpp"
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <cstring>
+#include <ctime>
+#include <fstream>
+#include <optional>
+#include <system_error>
+#include <variant>
+#include <vector>
+
+#include "Common/StringUtil.h"
+#include "Core/HW/GCMemcard/GCMemcard.h"
+#include "Core/HW/GCMemcard/GCMemcardUtils.h"
+#include "Core/SavestateLayout.h"
+#include "Core/StateFile.h"
+
+namespace moderngekko::frontend
+{
+namespace fs = std::filesystem;
+
+namespace
+{
+constexpr std::string_view BACKUP_SUFFIX = ".pre-import.bak";
+constexpr std::string_view STAGING_SUFFIX = ".importtemp";
+
+// The most blocks a save can have: a 2043-block card's whole free space. Dolphin's GCI folder loader
+// skips a larger file without a word (GCMemcardDirectory.cpp), so it would import and never load.
+constexpr std::uint16_t MAX_SAVE_BLOCKS = 2043;
+// The largest single-save file that can hold that many: the biggest header (GCS) plus the blocks.
+// Checked before Dolphin reads it: its GCS reader takes the block count from the file size.
+constexpr std::uintmax_t MAX_SAVE_FILE_SIZE = 0x150 + std::uintmax_t{MAX_SAVE_BLOCKS} * 0x2000;
+// A Skies state is about 100 MB unpacked; this allows any resolution's with room to spare. Dolphin
+// allocates the size the header claims before reading anything, so a bigger claim is refused here.
+constexpr std::uint64_t MAX_STATE_BYTES = 1ull << 30;
+// LZ4 can't unpack a chunk to more than 255 times its packed size.
+constexpr std::uint64_t LZ4_MAX_RATIO = 255;
+
+std::uint32_t ReadLE32(const std::uint8_t* bytes)
+{
+  return bytes[0] | (bytes[1] << 8) | (bytes[2] << 16) | (static_cast<std::uint32_t>(bytes[3]) << 24);
+}
+
+std::string EntryGameId(const Memcard::DEntry& entry)
+{
+  return std::string(reinterpret_cast<const char*>(entry.m_gamecode.data()), entry.m_gamecode.size()) +
+         std::string(reinterpret_cast<const char*>(entry.m_makercode.data()),
+                     entry.m_makercode.size());
+}
+
+// The game's file number of a card save: "SA_LEGENDS.000" is file 1 (the game's load screen counts
+// from 1). 0 for a name without a numbered ending.
+int FileNumber(const Memcard::DEntry& entry)
+{
+  const std::size_t length =
+      std::find(entry.m_filename.begin(), entry.m_filename.end(), 0) - entry.m_filename.begin();
+  const std::string_view name(reinterpret_cast<const char*>(entry.m_filename.data()), length);
+  const std::size_t dot = name.rfind('.');
+  if (dot == std::string_view::npos || dot + 1 == name.size())
+    return 0;
+  int number = 0;
+  for (char c : name.substr(dot + 1))
+  {
+    if (c < '0' || c > '9' || number > 99999)  // a numbered ending, not a long digit string
+      return 0;
+    number = number * 10 + (c - '0');
+  }
+  return number + 1;
+}
+
+std::string_view EntryFileName(const Memcard::DEntry& entry)
+{
+  const std::size_t length =
+      std::find(entry.m_filename.begin(), entry.m_filename.end(), 0) - entry.m_filename.begin();
+  return {reinterpret_cast<const char*>(entry.m_filename.data()), length};
+}
+
+// "" when the game could load `save` from the card, else why not (for the player).
+std::string CardSaveProblem(const Memcard::Savefile& save, const SaveImportGame& game)
+{
+  const std::uint16_t blocks = save.dir_entry.m_block_count;
+  if (blocks == 0 || blocks > MAX_SAVE_BLOCKS || save.blocks.size() != blocks)
+    return "That save is damaged: its size doesn't match what it says it is.";
+  if (game.save_blocks != 0 && blocks != game.save_blocks)
+  {
+    return "That isn't a " + std::string(game.name) + " save: the game's saves are " +
+           std::to_string(game.save_blocks) + " blocks, this one is " + std::to_string(blocks) + ".";
+  }
+  if (!game.save_name_prefix.empty() && !EntryFileName(save.dir_entry).starts_with(game.save_name_prefix))
+    return "That isn't a " + std::string(game.name) + " save file.";
+  return "";
+}
+
+std::string FileText(const Memcard::DEntry& entry)
+{
+  const int number = FileNumber(entry);
+  if (number > 0)
+    return "file " + std::to_string(number);
+  return Memcard::GenerateFilename(entry);
+}
+
+// "files 1, 2 and 3"
+std::string JoinFiles(std::vector<std::string> files)
+{
+  if (files.empty())
+    return {};
+  std::string text = files.size() == 1 ? files[0] : "";
+  for (std::size_t i = 0; files.size() > 1 && i < files.size(); ++i)
+  {
+    std::string item = files[i];
+    if (item.starts_with("file "))
+      item = item.substr(5);
+    text += i == 0 ? item : (i + 1 == files.size() ? " and " : ", ") + item;
+  }
+  return files.size() == 1 ? text : "files " + text;
+}
+
+// The region folder Dolphin keeps a game's card in, from the disc ID's region letter.
+std::string_view RegionFolder(std::string_view game_id)
+{
+  switch (game_id.size() > 3 ? game_id[3] : 'E')
+  {
+  case 'J':
+    return "JAP";
+  case 'P':
+  case 'D':
+  case 'F':
+  case 'S':
+  case 'I':
+  case 'U':
+    return "EUR";
+  default:
+    return "USA";
+  }
+}
+
+std::string_view RegionName(char letter)
+{
+  switch (letter)
+  {
+  case 'E':
+    return "USA";
+  case 'J':
+    return "Japanese";
+  case 'P':
+  case 'D':
+  case 'F':
+  case 'S':
+  case 'I':
+  case 'U':
+    return "European";
+  default:
+    return "another";
+  }
+}
+
+std::optional<Memcard::DEntry> ReadGciHeader(const fs::path& path)
+{
+  std::ifstream in(path, std::ios::binary);
+  Memcard::DEntry entry;
+  if (!in.read(reinterpret_cast<char*>(&entry), Memcard::DENTRY_SIZE))
+    return std::nullopt;
+  return entry;
+}
+
+// Copies `from` to `to` through a staged file beside it, so `to` is never half written.
+// "" on success, else the reason.
+std::string StagedCopy(const fs::path& from, const fs::path& to)
+{
+  fs::path staged = to;
+  staged += STAGING_SUFFIX;
+  std::error_code ec;
+  fs::copy_file(from, staged, fs::copy_options::overwrite_existing, ec);
+  if (!ec)
+    fs::rename(staged, to, ec);
+  if (ec)
+  {
+    std::error_code cleanup;
+    fs::remove(staged, cleanup);
+    return ec.message();
+  }
+  return {};
+}
+
+// A folder something will be written into. "" when it is there (or was made), else the reason.
+std::string EnsureFolder(const fs::path& folder)
+{
+  std::error_code ec;
+  // A plain file where the folder should be (what copying a save in by hand can leave): nothing can
+  // be made inside it, so every save after it would fail.
+  if (fs::exists(folder, ec) && !fs::is_directory(folder, ec))
+  {
+    return "A file is in the way of the save folder \"" + PathToString(folder) +
+           "\". Delete that file and try again.";
+  }
+  fs::create_directories(folder, ec);
+  return ec ? "Could not create the save folder: " + ec.message() : "";
+}
+
+// Dolphin loads a GCI folder by the saves' identities (game code, maker, file name), not by file
+// names, and refuses a second file with the same identity -- so the one being replaced is found by
+// identity, wherever it is in the folder.
+std::vector<fs::path> SameIdentityFiles(const fs::path& folder, const Memcard::DEntry& entry)
+{
+  std::vector<fs::path> found;
+  std::error_code ec;
+  for (const fs::directory_entry& file : fs::directory_iterator(folder, ec))
+  {
+    if (file.path().extension() != ".gci")
+      continue;
+    const std::optional<Memcard::DEntry> header = ReadGciHeader(file.path());
+    if (header && Memcard::HasSameIdentity(*header, entry))
+      found.push_back(file.path());
+  }
+  return found;
+}
+
+struct WrittenSave
+{
+  std::string file;  // "file 2"
+  int number = 0;     // 2 (0 when not numbered), for listing in order
+  std::vector<std::string> backups;
+};
+
+// `<name>.pre-import.bak`, or `<name>.pre-import.2.bak` and up when an earlier import's copy is
+// there: a second import over the same save keeps the original's copy too.
+fs::path FreeBackupPath(const fs::path& old)
+{
+  std::error_code ec;
+  for (int n = 1;; ++n)
+  {
+    fs::path backup = old;
+    backup += n == 1 ? std::string(BACKUP_SUFFIX) :
+                       ".pre-import." + std::to_string(n) + ".bak";
+    if (!fs::exists(fs::symlink_status(backup, ec)) || n == 999)
+      return backup;
+  }
+}
+
+// Writes one card save into the GCI folder as Dolphin names it, dated `when`. "" on success.
+std::string WriteCardSave(const Memcard::Savefile& save, const fs::path& folder,
+                          fs::file_time_type when, WrittenSave* written)
+{
+  const fs::path destination =
+      folder / StringToPath(Memcard::GenerateFilename(save.dir_entry) + ".gci");
+  const std::vector<fs::path> replaced = SameIdentityFiles(folder, save.dir_entry);
+
+  // Everything being replaced is kept first; if that fails nothing has changed yet.
+  for (const fs::path& old : replaced)
+  {
+    const fs::path backup = FreeBackupPath(old);
+    if (const std::string failure = StagedCopy(old, backup); !failure.empty())
+      return "Could not keep a copy of the save that is already there, so nothing was changed: " +
+             failure;
+    written->backups.push_back(PathToString(backup.filename()));
+  }
+
+  fs::path staged = destination;
+  staged += STAGING_SUFFIX;
+  std::error_code ec;
+  if (!Memcard::WriteSavefile(PathToString(staged), save, Memcard::SavefileFormat::GCI))
+  {
+    fs::remove(staged, ec);
+    return "Could not write the save into the save folder.";
+  }
+  fs::rename(staged, destination, ec);
+  if (ec)
+  {
+    std::error_code cleanup;
+    fs::remove(staged, cleanup);
+    return "Could not put the save into place: " + ec.message();
+  }
+  fs::last_write_time(destination, when, ec);
+  // The same save under another file name would stop Dolphin loading the new one (kept above).
+  for (const fs::path& old : replaced)
+  {
+    if (!fs::equivalent(old, destination, ec))
+      fs::remove(old, ec);
+  }
+  written->file = FileText(save.dir_entry);
+  written->number = FileNumber(save.dir_entry);
+  return {};
+}
+
+std::string BackupText(const std::vector<WrittenSave>& written)
+{
+  std::vector<std::string> backups;
+  for (const WrittenSave& save : written)
+    backups.insert(backups.end(), save.backups.begin(), save.backups.end());
+  if (backups.empty())
+    return {};
+  std::string text = backups.size() == 1 ? " The save that was there is kept as " :
+                                           " The saves that were there are kept as ";
+  for (std::size_t i = 0; i < backups.size(); ++i)
+    text += (i == 0 ? "" : (i + 1 == backups.size() ? " and " : ", ")) + backups[i];
+  return text + ".";
+}
+
+std::string WrongGameText(const std::string& id, const SaveImportGame& game, bool state)
+{
+  const std::string kind = state ? "save state" : "save";
+  // Same game, other region: the saves aren't interchangeable (the game checks the game code)
+  if (id.size() >= 4 && game.game_id.size() >= 4 && id.compare(0, 3, game.game_id.substr(0, 3)) == 0)
+  {
+    return "That " + kind + " is from the " + std::string(RegionName(id[3])) +
+           " version of the game. This port plays the " +
+           std::string(RegionName(game.game_id[3])) + " version, which can't read it.";
+  }
+  std::string shown;
+  for (char c : id)
+    shown += (c >= 0x20 && c < 0x7F) ? c : '?';
+  return "That " + kind + " is for another game (" + shown + "), not " + std::string(game.name) +
+         ".";
+}
+
+SaveImportResult ImportCardSaves(std::vector<Memcard::Savefile> saves,
+                                 const fs::path& user_directory, const SaveImportGame& game)
+{
+  const fs::path folder = CardSaveFolder(user_directory, game.game_id);
+  if (std::string failure = EnsureFolder(folder); !failure.empty())
+    return {false, failure};
+
+  // The card's own last-written times order them, so the one saved last is the newest file and
+  // Continue loads it. All are dated now (a second apart), so they're newer than any state.
+  std::ranges::stable_sort(saves, {}, [](const Memcard::Savefile& save) {
+    return static_cast<std::uint32_t>(save.dir_entry.m_modification_time);
+  });
+  const fs::file_time_type now = fs::file_time_type::clock::now();
+  std::vector<WrittenSave> written;
+  for (std::size_t i = 0; i < saves.size(); ++i)
+  {
+    const fs::file_time_type when = now - std::chrono::seconds(saves.size() - 1 - i);
+    WrittenSave result;
+    if (std::string failure = WriteCardSave(saves[i], folder, when, &result); !failure.empty())
+    {
+      if (written.empty())
+        return {false, failure};
+      // Earlier ones went in; say so rather than claim nothing happened
+      std::vector<std::string> files;
+      for (const WrittenSave& save : written)
+        files.push_back(save.file);
+      return {false, "Imported " + JoinFiles(files) + ", then stopped: " + failure +
+                         BackupText(written)};
+    }
+    written.push_back(std::move(result));
+  }
+
+  // Listed by number ("file 2" before "file 10"); written oldest first, so the last one written
+  // is the one saved last
+  std::vector<const WrittenSave*> ordered;
+  for (const WrittenSave& save : written)
+    ordered.push_back(&save);
+  std::ranges::stable_sort(ordered, {}, [](const WrittenSave* save) { return save->number; });
+  std::vector<std::string> files;
+  for (const WrittenSave* save : ordered)
+    files.push_back(save->file);
+  const std::string last = written.back().file;
+  std::string text = "Imported " + JoinFiles(files) + ".";
+  if (written.size() > 1)
+    text += " Continue loads " + last + ", the one saved last.";
+  else
+    text += " Continue loads it.";
+  return {true, text + BackupText(written)};
+}
+
+SaveImportResult ImportCardSave(const fs::path& source, const fs::path& user_directory,
+                                const SaveImportGame& game)
+{
+  const auto read = Memcard::ReadSavefile(PathToString(source));
+  if (std::holds_alternative<Memcard::ReadSavefileErrorCode>(read))
+  {
+    return {false, "That file looks like a memory card save but can't be read: it may be damaged "
+                   "or cut short."};
+  }
+  const Memcard::Savefile& save = std::get<Memcard::Savefile>(read);
+  const std::string id = EntryGameId(save.dir_entry);
+  if (id != game.game_id)
+    return {false, WrongGameText(id, game, false)};
+  if (std::string problem = CardSaveProblem(save, game); !problem.empty())
+    return {false, problem};
+  return ImportCardSaves({save}, user_directory, game);
+}
+
+SaveImportResult ImportCardImage(const fs::path& source, const fs::path& user_directory,
+                                 const SaveImportGame& game)
+{
+  auto [error, card] = Memcard::GCMemcard::Open(PathToString(source));
+  if (error.HasCriticalErrors() || !card || !card->IsValid())
+  {
+    return {false, "That file looks like a whole memory card, but this app can't read it: "
+                   "it may be damaged or another format."};
+  }
+  std::vector<Memcard::Savefile> saves;
+  std::vector<std::string> other_regions;
+  for (std::uint8_t i = 0; i < Memcard::DIRLEN; ++i)
+  {
+    std::optional<Memcard::Savefile> save = card->ExportFile(i);
+    if (!save)
+      continue;
+    const std::string id = EntryGameId(save->dir_entry);
+    if (id == game.game_id)
+    {
+      // Anything of the game's the game itself couldn't load stops the whole import: a card from
+      // a real console never has one, so the card is damaged or not what it seems
+      if (std::string problem = CardSaveProblem(*save, game); !problem.empty())
+        return {false, "On that memory card: " + problem};
+      saves.push_back(std::move(*save));
+    }
+    else if (id.compare(0, 3, game.game_id.substr(0, 3)) == 0)
+      other_regions.push_back(id);
+  }
+  if (saves.empty())
+  {
+    if (!other_regions.empty())
+    {
+      return {false, "That memory card only has saves from the " +
+                         std::string(RegionName(other_regions[0][3])) +
+                         " version of the game. This port plays the " +
+                         std::string(RegionName(game.game_id[3])) + " version, which can't read them."};
+    }
+    return {false, "That memory card has no " + std::string(game.name) + " saves on it."};
+  }
+  return ImportCardSaves(std::move(saves), user_directory, game);
+}
+
+SaveImportResult ImportState(const fs::path& source, std::uintmax_t size,
+                             const std::array<std::uint8_t, 32>& head,
+                             const fs::path& user_directory, const SaveImportGame& game)
+{
+  // Checked as Dolphin's loader checks a state (StateFile.cpp ValidateHeaders and LoadFileStateData,
+  // State.cpp's game ID check): this game, this exact state version, a known extended header.
+  const std::string id(reinterpret_cast<const char*>(head.data()), 6);
+  if (id != game.game_id)
+    return {false, WrongGameText(id, game, true)};
+  if (ReadLE32(&head[24]) - State::COOKIE_BASE != State::STATE_VERSION)
+  {
+    return {false, "That save state was made by a different version of this port and can't be "
+                   "loaded by this one. Memory card saves work across versions."};
+  }
+  const std::uint32_t version_length = ReadLE32(&head[28]);
+  std::array<std::uint8_t, sizeof(State::StateExtendedBaseHeader)> extended{};
+  std::ifstream in(source, std::ios::binary);
+  const std::uint64_t data_start = 32 + std::uint64_t{version_length} + extended.size();
+  in.seekg(32 + static_cast<std::streamoff>(version_length));
+  if (data_start > size || !in.read(reinterpret_cast<char*>(extended.data()), extended.size()))
+    return {false, "That save state is cut short and can't be loaded."};
+  State::StateExtendedBaseHeader base;
+  std::memcpy(&base, extended.data(), sizeof(base));
+  const std::string damaged = "That save state is damaged and can't be loaded.";
+  if (base.header_version != State::EXTENDED_HEADER_VERSION ||
+      base.compression_type > State::CompressionType::LZ4)
+  {
+    return {false, damaged};
+  }
+  // What Dolphin's loader trusts without looking (StateFile.cpp LoadFileStateData): the unpacked size
+  // it allocates up front, and the chain of LZ4 chunks it reads until that size is reached. A bad
+  // value there threw out of the load, so every Continue crashed until the file was deleted.
+  if (base.uncompressed_size == 0 || base.uncompressed_size > MAX_STATE_BYTES)
+    return {false, damaged};
+  if (base.compression_type == State::CompressionType::LZ4)
+  {
+    // Each chunk: a positive 32-bit packed length, then that many bytes; the last ends the file
+    std::uint64_t position = data_start;
+    std::uint64_t packed = 0;
+    while (position < size)
+    {
+      std::array<std::uint8_t, 4> length_bytes{};
+      in.seekg(static_cast<std::streamoff>(position));
+      if (position + 4 > size || !in.read(reinterpret_cast<char*>(length_bytes.data()), 4))
+        return {false, damaged};
+      const auto length = static_cast<std::int32_t>(ReadLE32(length_bytes.data()));
+      if (length <= 0 || position + 4 + static_cast<std::uint64_t>(length) > size)
+        return {false, damaged};
+      packed += static_cast<std::uint64_t>(length);
+      position += 4 + static_cast<std::uint64_t>(length);
+    }
+    if (packed == 0 || base.uncompressed_size > packed * LZ4_MAX_RATIO)
+      return {false, damaged};
+  }
+  else if (data_start + base.payload_offset >= size)
+  {
+    return {false, damaged};
+  }
+  in.close();
+
+  const fs::path folder = user_directory / "StateSaves";
+  if (std::string failure = EnsureFolder(folder); !failure.empty())
+    return {false, failure};
+  // A new name every time, so nothing is replaced
+  const std::time_t now = std::time(nullptr);
+  fs::path destination;
+  std::error_code ec;
+  for (std::size_t sequence = 0;; ++sequence)
+  {
+    destination = folder / State::Layout::TimestampedName(now, sequence, game.state_prefix);
+    if (!fs::exists(destination, ec))
+      break;
+  }
+  if (const std::string failure = StagedCopy(source, destination); !failure.empty())
+    return {false, "Could not copy the save state into place: " + failure};
+  // Dated now (a copy can keep the original's date), so Continue starts from it
+  fs::last_write_time(destination, fs::file_time_type::clock::now(), ec);
+  return {true, "Imported the save state as " + PathToString(destination.filename()) +
+                    ". Continue starts from it."};
+}
+}  // namespace
+
+fs::path CardSaveFolder(const fs::path& user_directory, std::string_view game_id)
+{
+  return user_directory / "GC" / RegionFolder(game_id) / "Card A";
+}
+
+SaveImportResult ImportSave(const fs::path& source, const fs::path& user_directory,
+                            const SaveImportGame& game)
+{
+  std::error_code ec;
+  if (!fs::is_regular_file(source, ec))
+    return {false, "That is not a file this app can read."};
+  const std::uintmax_t size = fs::file_size(source, ec);
+  if (ec)
+    return {false, "Could not read that file: " + ec.message()};
+
+  std::array<std::uint8_t, 32> head{};
+  {
+    std::ifstream in(source, std::ios::binary);
+    if (!in.good())
+      return {false, "Could not open that file."};
+    in.read(reinterpret_cast<char*>(head.data()), head.size());
+  }
+
+  // A Dolphin save state: the version cookie at 24. Checked first, since a state can happen to
+  // have any size; the cookie can't occur there in a card save (that is inside the file name).
+  const std::uint32_t cookie_version = ReadLE32(&head[24]) - State::COOKIE_BASE;
+  if (size >= head.size() && ReadLE32(&head[8]) == 0 && cookie_version < 0x10000)
+    return ImportState(source, size, head, user_directory, game);
+
+  // One card save: GCI, GCS and SAV have different header sizes and whole 8 KiB blocks after
+  // them (Dolphin's ReadSavefile tells them apart the same way).
+  const std::uintmax_t header = size % Memcard::BLOCK_SIZE;
+  if (size > Memcard::BLOCK_SIZE && (header == 0x40 || header == 0x150 || header == 0xC0))
+  {
+    if (size > MAX_SAVE_FILE_SIZE)
+      return {false, "That save is bigger than a memory card can hold, so it can't be one."};
+    return ImportCardSave(source, user_directory, game);
+  }
+  // A whole card: Dolphin's .raw, a .gcp, a real card's dump
+  if (size >= 0x80000 && header == 0)
+    return ImportCardImage(source, user_directory, game);
+
+  return {false, "That isn't a save this app can import. It takes a memory card save (.gci, .gcs, "
+                 ".sav), a whole memory card (.raw, .gcp) or a save state from this port."};
+}
+
+std::string DescribeSaves(const fs::path& user_directory, const SaveImportGame& game)
+{
+  std::vector<std::pair<int, std::string>> files;
+  std::error_code ec;
+  for (const fs::directory_entry& file :
+       fs::directory_iterator(CardSaveFolder(user_directory, game.game_id), ec))
+  {
+    if (file.path().extension() != ".gci")
+      continue;
+    const std::optional<Memcard::DEntry> header = ReadGciHeader(file.path());
+    if (header && EntryGameId(*header) == game.game_id)
+      files.emplace_back(FileNumber(*header), FileText(*header));
+  }
+  std::ranges::sort(files);
+  std::vector<std::string> names;
+  for (const auto& file : files)
+    names.push_back(file.second);
+  const std::size_t states = State::Layout::List(user_directory / "StateSaves").size();
+  return "Memory card: " + (names.empty() ? std::string("no saves yet") : JoinFiles(names)) +
+         "\nSave states: " + (states == 0 ? std::string("none yet") : std::to_string(states));
+}
+}  // namespace moderngekko::frontend
diff --git a/tools/save_import.hpp b/tools/save_import.hpp
new file mode 100644
index 0000000..29c292c
--- /dev/null
+++ b/tools/save_import.hpp
@@ -0,0 +1,56 @@
+#pragma once
+
+// Importing a save the player already has -- from Dolphin, a real GameCube (via a card tool), this
+// port on another device, or a backup -- into the places the game reads saves from. Shared by the
+// desktop launcher and the Android app (jni/SkiesImport.cpp), so both accept and refuse the same
+// files with the same words.
+//
+// Same rules as the N64 recomps' Import (Goemon 64, Hybrid Heaven, src/ui/ui_saves.cpp):
+//   - only while the game isn't running (the callers check: a running game holds the card in
+//     memory and writes it back, so a file swapped underneath it would be lost);
+//   - the file is checked as strictly as the code that will load it, no more and no less;
+//   - whatever is replaced is copied aside first (<name>.pre-import.bak), and the new file is
+//     staged and renamed into place, so a save is never left half written.
+//
+// The kind of file is told from its contents, not its name: ".sav" is both a MaxDrive card save
+// and a Dolphin save state, and an Android content URI has no name at all.
+
+#include <cstdint>
+#include <filesystem>
+#include <string>
+#include <string_view>
+
+namespace moderngekko::frontend
+{
+struct SaveImportGame
+{
+  std::string_view game_id;       // "GEAE8P": card saves and states must be this game's
+  std::string_view name;          // "Skies of Arcadia Legends", for messages
+  std::string_view state_prefix;  // imported states are named <prefix><date-time>.sav
+  // The game's own card saves, when known: their size in blocks and the start of their file name
+  // ("SA_LEGENDS."); 0 / "" accept any save of the game that a card can hold.
+  std::uint16_t save_blocks = 0;
+  std::string_view save_name_prefix = {};
+};
+
+struct SaveImportResult
+{
+  bool ok = false;
+  std::string message;  // for the player, success or not
+};
+
+// Imports `source`: one memory card save (.gci, .gcs, .sav), a whole memory card image (.raw,
+// .gcp; the game's saves are taken from it), or a Dolphin save state. Card saves go into card A's
+// GCI folder, states into StateSaves, both dated now so Continue picks them up.
+SaveImportResult ImportSave(const std::filesystem::path& source,
+                            const std::filesystem::path& user_directory,
+                            const SaveImportGame& game);
+
+// Card A's GCI folder for the game's region (Dolphin's default: GC/<region>/Card A).
+std::filesystem::path CardSaveFolder(const std::filesystem::path& user_directory,
+                                     std::string_view game_id);
+
+// What is there now, one line each: "Memory card: files 1 and 2" and "Save states: 4".
+std::string DescribeSaves(const std::filesystem::path& user_directory,
+                          const SaveImportGame& game);
+}  // namespace moderngekko::frontend
diff --git a/tools/user_directory.cpp b/tools/user_directory.cpp
new file mode 100644
index 0000000..e08f290
--- /dev/null
+++ b/tools/user_directory.cpp
@@ -0,0 +1,499 @@
+#include "user_directory.hpp"
+
+#include <algorithm>
+#include <cstdlib>
+#include <fstream>
+#include <system_error>
+#include <vector>
+
+#if !defined(_WIN32)
+#include <cerrno>
+#include <fcntl.h>
+#include <unistd.h>
+#endif
+
+namespace fs = std::filesystem;
+
+namespace moderngekko::frontend
+{
+namespace
+{
+// An environment variable as a path ("" when unset). Windows: the wide one, so a user name such as
+// "José" survives whatever the code page is.
+fs::path EnvironmentPath(const char* name)
+{
+#if defined(_WIN32)
+  const std::wstring wide(name, name + std::char_traits<char>::length(name));
+  const wchar_t* value = _wgetenv(wide.c_str());
+  return value ? fs::path(value) : fs::path();
+#else
+  const char* value = std::getenv(name);
+  return value ? fs::path(value) : fs::path();
+#endif
+}
+
+std::string ReadLine(const fs::path& file)
+{
+  std::ifstream input(file, std::ios::binary);
+  std::string line;
+  std::getline(input, line);
+  if (!line.empty() && line.back() == '\r')
+    line.pop_back();
+  if (line.starts_with("\xEF\xBB\xBF"))  // a byte order mark, from Notepad
+    line.erase(0, 3);
+  return line;
+}
+
+// Written beside it and renamed over it, so a kill mid-write leaves the old one whole
+bool WriteLine(const fs::path& file, std::string_view line, std::string* error)
+{
+  std::error_code ec;
+  fs::create_directories(file.parent_path(), ec);
+  fs::path staged = file;
+  staged += ".tmp";
+  {
+    std::ofstream output(staged, std::ios::binary | std::ios::trunc);
+    output << line << '\n';
+    if (!output.flush())
+    {
+      *error = "can't write " + PathUtf8(staged);
+      return false;
+    }
+  }
+  fs::rename(staged, file, ec);
+  if (ec)
+  {
+    *error = "can't write " + PathUtf8(file) + ": " + ec.message();
+    fs::remove(staged, ec);
+    return false;
+  }
+  return true;
+}
+
+// The same folder, also when one name has a link or a different case on Windows
+bool SameFolder(const fs::path& a, const fs::path& b)
+{
+  std::error_code ec;
+  if (fs::exists(a, ec) && fs::exists(b, ec))
+    return fs::equivalent(a, b, ec);
+  return fs::weakly_canonical(a, ec) == fs::weakly_canonical(b, ec);
+}
+
+// Whether `inner` is `outer` or inside it
+bool IsWithin(const fs::path& inner, const fs::path& outer)
+{
+  std::error_code ec;
+  const fs::path relative =
+      fs::weakly_canonical(inner, ec).lexically_relative(fs::weakly_canonical(outer, ec));
+  return !relative.empty() && *relative.begin() != "..";
+}
+
+std::uint64_t FolderBytes(const fs::path& directory)
+{
+  std::uint64_t bytes = 0;
+  std::error_code ec;
+  for (fs::recursive_directory_iterator it(directory, ec), end; !ec && it != end;
+       it.increment(ec))
+  {
+    std::error_code size_ec;
+    if (it->is_regular_file(size_ec))
+      bytes += it->file_size(size_ec);
+  }
+  return bytes;
+}
+
+#if !defined(_WIN32)
+// One file in 4 MiB pieces, counted as they go. std::filesystem::copy_file managed ~4.5 MB/s from
+// Android's app storage to shared storage (both behind its FUSE layer) and counted only whole files.
+// (Windows: copy_file is CopyFileW.)
+bool CopyFileData(const fs::path& from, const fs::path& to, std::vector<char>& buffer,
+                  UserDirectoryMoveProgress* progress, std::error_code& ec)
+{
+  const int in = ::open(from.c_str(), O_RDONLY | O_CLOEXEC);
+  if (in < 0)
+  {
+    ec.assign(errno, std::generic_category());
+    return false;
+  }
+  const int out = ::open(to.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0666);
+  if (out < 0)
+  {
+    ec.assign(errno, std::generic_category());
+    ::close(in);
+    return false;
+  }
+  bool ok = true;
+  while (ok)
+  {
+    if (progress->cancel)
+    {
+      ec = std::make_error_code(std::errc::operation_canceled);
+      ok = false;
+      break;
+    }
+    const ssize_t got = ::read(in, buffer.data(), buffer.size());
+    if (got == 0)
+      break;
+    if (got < 0)
+    {
+      if (errno == EINTR)
+        continue;
+      ec.assign(errno, std::generic_category());
+      ok = false;
+      break;
+    }
+    for (ssize_t written = 0; written < got;)
+    {
+      const ssize_t put = ::write(out, buffer.data() + written, got - written);
+      if (put < 0 && errno == EINTR)
+        continue;
+      if (put <= 0)
+      {
+        ec.assign(put < 0 ? errno : EIO, std::generic_category());
+        ok = false;
+        break;
+      }
+      written += put;
+    }
+    if (ok)
+      progress->done_bytes += static_cast<std::uint64_t>(got);
+  }
+  ::close(in);
+  if (::close(out) != 0 && ok)
+  {
+    ec.assign(errno, std::generic_category());
+    ok = false;
+  }
+  return ok;
+}
+#endif
+
+// Copies every folder and file in `from` into the new folder `to`, file times kept
+bool CopyFolder(const fs::path& from, const fs::path& to, UserDirectoryMoveProgress* progress,
+                std::string* error)
+{
+  std::error_code ec;
+  fs::create_directories(to, ec);
+  if (ec)
+  {
+    *error = "can't create " + PathUtf8(to) + ": " + ec.message();
+    return false;
+  }
+#if !defined(_WIN32)
+  std::vector<char> buffer(4 << 20);
+#endif
+  fs::recursive_directory_iterator it(from, ec);
+  for (const fs::recursive_directory_iterator end; !ec && it != end; it.increment(ec))
+  {
+    if (progress->cancel)
+    {
+      *error = "cancelled";
+      return false;
+    }
+    const fs::path target = to / it->path().lexically_relative(from);
+    std::error_code entry_ec;
+    if (it->is_directory(entry_ec))
+    {
+      fs::create_directories(target, entry_ec);
+    }
+    else if (it->is_regular_file(entry_ec))
+    {
+#if defined(_WIN32)
+      fs::copy_file(it->path(), target, fs::copy_options::overwrite_existing, entry_ec);
+      if (!entry_ec)
+        progress->done_bytes += it->file_size(entry_ec);
+#else
+      CopyFileData(it->path(), target, buffer, progress, entry_ec);
+#endif
+      if (!entry_ec)
+        fs::last_write_time(target, it->last_write_time(entry_ec), entry_ec);
+    }
+    if (entry_ec == std::errc::operation_canceled)
+    {
+      *error = "cancelled";
+      return false;
+    }
+    if (entry_ec)
+    {
+      *error = "can't copy " + PathUtf8(it->path()) + ": " + entry_ec.message();
+      return false;
+    }
+  }
+  if (ec)
+  {
+    *error = "can't read " + PathUtf8(from) + ": " + ec.message();
+    return false;
+  }
+  return true;
+}
+
+// Removes everything in `directory` but the pointer file; the folder itself too when that leaves
+// it empty. False if something stayed.
+bool RemoveUserData(const fs::path& directory)
+{
+  std::error_code ec;
+  bool all = true;
+  std::vector<fs::path> entries;
+  for (fs::directory_iterator it(directory, ec), end; !ec && it != end; it.increment(ec))
+    entries.push_back(it->path());
+  for (const fs::path& entry : entries)
+  {
+    if (entry.filename() == USER_DIRECTORY_POINTER)
+      continue;
+    std::error_code remove_ec;
+    fs::remove_all(entry, remove_ec);
+    all = all && !remove_ec;
+  }
+  if (!HoldsUserData(directory) && !fs::exists(directory / USER_DIRECTORY_POINTER, ec))
+    fs::remove(directory, ec);
+  return all;
+}
+
+// default-game.txt: a path into `from` now points into `to`
+void RebaseDefaultGame(const fs::path& from, const fs::path& to)
+{
+  const fs::path file = to / "default-game.txt";
+  const std::string line = ReadLine(file);
+  if (line.empty())
+    return;
+  const fs::path game = Utf8Path(line);
+  if (!game.is_absolute() || !IsWithin(game, from))
+    return;
+  std::error_code ec;
+  const fs::path moved = to / fs::weakly_canonical(game, ec).lexically_relative(
+                                  fs::weakly_canonical(from, ec));
+  std::string error;
+  WriteLine(file, PathUtf8(moved), &error);
+}
+}  // namespace
+
+std::string PathUtf8(const fs::path& path)
+{
+  const std::u8string text = path.u8string();
+  return {text.begin(), text.end()};
+}
+
+fs::path Utf8Path(std::string_view text)
+{
+  return fs::path(std::u8string(text.begin(), text.end()));
+}
+
+fs::path DefaultUserDirectory(std::string_view name, bool in_documents)
+{
+  const fs::path folder = Utf8Path(name);
+  if (in_documents)
+  {
+#if defined(_WIN32)
+    if (const fs::path profile = EnvironmentPath("USERPROFILE"); !profile.empty())
+      return profile / "Documents" / folder;
+#endif
+    if (const fs::path home = EnvironmentPath("HOME"); !home.empty())
+      return home / "Documents" / folder;
+  }
+#if defined(_WIN32)
+  if (const fs::path local_app_data = EnvironmentPath("LOCALAPPDATA"); !local_app_data.empty())
+    return local_app_data / folder;
+#endif
+  // XDG: an empty or relative XDG_DATA_HOME counts as unset
+  if (const fs::path xdg = EnvironmentPath("XDG_DATA_HOME"); xdg.is_absolute())
+    return xdg / folder;
+  if (const fs::path home = EnvironmentPath("HOME"); !home.empty())
+    return home / ".local" / "share" / folder;
+  fs::path fallback = folder;
+  fallback += "-user";
+  return fallback;
+}
+
+UserDirectoryChoice FindUserDirectory(const fs::path& executable_directory,
+                                      const fs::path& default_directory)
+{
+  std::error_code ec;
+  // Native separators throughout: shown in Settings, and a pointer written by hand may mix them
+  if (fs::exists(executable_directory / PORTABLE_MARKER, ec))
+    return {(executable_directory / "User").make_preferred(), UserDirectoryKind::Portable, false};
+  const std::string line = ReadLine(default_directory / USER_DIRECTORY_POINTER);
+  if (!line.empty())
+  {
+    const fs::path moved = Utf8Path(line).make_preferred();
+    // Only an absolute one: a relative path would depend on the working directory
+    if (moved.is_absolute())
+      return {moved, UserDirectoryKind::Moved, !fs::is_directory(moved, ec)};
+  }
+  return {fs::path(default_directory).make_preferred(), UserDirectoryKind::Default, false};
+}
+
+fs::path UserDirectoryIn(const fs::path& picked, std::string_view name)
+{
+  const fs::path folder = Utf8Path(name);
+  fs::path clean = picked.lexically_normal();
+  if (!clean.has_filename() && clean.has_parent_path() && clean != clean.root_path())
+    clean = clean.parent_path();
+  return (clean.filename() == folder ? clean : clean / folder).make_preferred();
+}
+
+bool HoldsUserData(const fs::path& directory)
+{
+  std::error_code ec;
+  for (fs::directory_iterator it(directory, ec), end; !ec && it != end; it.increment(ec))
+  {
+    // The pointer, and its copy from a write that was killed
+    const fs::path name = it->path().filename();
+    fs::path staged_pointer = USER_DIRECTORY_POINTER;
+    staged_pointer += ".tmp";
+    if (name != USER_DIRECTORY_POINTER && name != staged_pointer)
+      return true;
+  }
+  return false;
+}
+
+std::string CheckUserDirectoryMove(const fs::path& from, const fs::path& to)
+{
+  if (SameFolder(from, to))
+    return "That is already the data folder.";
+  if (IsWithin(to, from))
+    return "That folder is inside the data folder. Pick one outside it.";
+  if (IsWithin(from, to))
+    return "The data folder is inside that folder. Pick another one.";
+  return "";
+}
+
+bool PointUserDirectory(const fs::path& to, const fs::path& default_directory, std::string* error)
+{
+  const fs::path pointer = default_directory / USER_DIRECTORY_POINTER;
+  std::error_code ec;
+  if (SameFolder(to, default_directory))
+  {
+    fs::remove(pointer, ec);
+    if (ec)
+    {
+      *error = "can't remove " + PathUtf8(pointer) + ": " + ec.message();
+      return false;
+    }
+    return true;
+  }
+  return WriteLine(pointer, PathUtf8(fs::absolute(to, ec)), error);
+}
+
+UserDirectoryMoveResult MoveUserDirectory(const fs::path& from, const fs::path& to,
+                                          const fs::path& default_directory,
+                                          UserDirectoryMoveProgress* progress)
+{
+  UserDirectoryMoveResult result;
+  if (std::string problem = CheckUserDirectoryMove(from, to); !problem.empty())
+  {
+    result.error = std::move(problem);
+    return result;
+  }
+  if (HoldsUserData(to))
+  {
+    result.error = "That folder already holds data.";
+    return result;
+  }
+  std::error_code ec;
+  fs::path staging = to;
+  staging += ".moving";
+  fs::remove_all(staging, ec);  // a copy an earlier try didn't finish
+  ec.clear();
+  fs::create_directories(staging.parent_path(), ec);
+  if (ec)
+  {
+    result.error = "can't create " + PathUtf8(staging.parent_path()) + ": " + ec.message();
+    return result;
+  }
+  progress->total_bytes = std::max<std::uint64_t>(1, FolderBytes(from));
+  progress->done_bytes = 0;
+
+  // The same drive: one rename, nothing copied. It fails across drives (and on Windows while a
+  // file in it is open): then a copy.
+  bool copied = false;
+  if (progress->always_copy)
+    ec = std::make_error_code(std::errc::cross_device_link);
+  else
+    fs::rename(from, staging, ec);
+  if (ec)
+  {
+    ec.clear();
+    const fs::space_info space = fs::space(staging.parent_path(), ec);
+    if (!ec && space.available < progress->total_bytes)
+    {
+      constexpr std::uint64_t MIB = 1024 * 1024;
+      result.error = "Not enough free space there: the data needs " +
+                     std::to_string(progress->total_bytes / MIB) + " MB, " +
+                     std::to_string(space.available / MIB) + " MB are free.";
+      return result;
+    }
+    std::string copy_error;
+    if (!CopyFolder(from, staging, progress, &copy_error))
+    {
+      fs::remove_all(staging, ec);
+      result.error = copy_error == "cancelled" ? "Cancelled; nothing was moved." :
+                                                 "Nothing was moved: " + copy_error;
+      return result;
+    }
+    copied = true;
+  }
+  progress->done_bytes = progress->total_bytes.load();
+
+  // `to` may be there, empty, or the default folder with only the pointer in it (a move back)
+  bool removed_pointer = false;
+  if (fs::exists(to, ec))
+  {
+    removed_pointer = fs::remove(to / USER_DIRECTORY_POINTER, ec);
+    fs::remove(to, ec);
+  }
+  fs::rename(staging, to, ec);
+  if (ec)
+  {
+    const std::string reason = ec.message();
+    if (copied)
+      fs::remove_all(staging, ec);
+    else
+      fs::rename(staging, from, ec);  // put it back
+    std::string ignored;
+    if (removed_pointer)
+      PointUserDirectory(from, default_directory, &ignored);
+    result.error = "Nothing was moved: can't create " + PathUtf8(to) + ": " + reason;
+    return result;
+  }
+  RebaseDefaultGame(from, to);
+  std::string point_error;
+  if (!PointUserDirectory(to, default_directory, &point_error))
+  {
+    // The data is in the new place but the next start wouldn't find it: put it back
+    if (!copied)
+    {
+      fs::rename(to, from, ec);
+      RebaseDefaultGame(to, from);
+    }
+    else
+    {
+      fs::remove_all(to, ec);
+    }
+    result.error = "Nothing was moved: " + point_error;
+    return result;
+  }
+  result.ok = true;
+  if (copied && !RemoveUserData(from))
+    result.warning = "Some of the old files couldn't be removed from " + PathUtf8(from) +
+                     ". The data is in the new folder; you can delete them by hand.";
+  return result;
+}
+
+fs::path ResolveDefaultGame(std::string_view line, const fs::path& base,
+                            const fs::path& user_directory)
+{
+  if (line.empty())
+    return {};
+  fs::path game = Utf8Path(line);
+  if (game.is_relative())
+    return base / game;
+  std::error_code ec;
+  if (!fs::exists(game, ec) && game.has_filename())
+  {
+    const fs::path copied = user_directory / "games" / game.filename();
+    if (fs::is_directory(copied, ec))
+      return copied;
+  }
+  return game;
+}
+}  // namespace moderngekko::frontend
