+// Asks what to do about a moved data folder that isn't there before anything reads it. False:
+// quit. The answer can also be the default folder (the pointer removed).
+bool ResolveMissingDataFolder(moderngekko::frontend::UserDirectoryChoice* choice,
+                              const fs::path& release_directory, const fs::path& default_directory)
+{
+  while (choice->missing)
+  {
+    // Short lines: Windows' box doesn't wrap them
+    const std::string message =
+        "The data folder isn't there:\n" + moderngekko::frontend::PathUtf8(choice->path) +
+        "\n\nIf it is on a drive that isn't connected, connect it and choose Try Again.\n\n"
+        "Use Default starts with the default folder instead:\n" +
+        moderngekko::frontend::PathUtf8(default_directory) +
+        "\nThe moved folder isn't deleted: Settings, Disc, Data folder can pick it again.";
+    enum
+    {
+      QUIT,
+      RETRY,
+      USE_DEFAULT,
+    };
+    const SDL_MessageBoxButtonData buttons[] = {
+        {SDL_MESSAGEBOX_BUTTON_RETURNKEY_DEFAULT, RETRY, "Try Again"},
+        {0, USE_DEFAULT, "Use Default"},
+        {SDL_MESSAGEBOX_BUTTON_ESCAPEKEY_DEFAULT, QUIT, "Quit"},
+    };
+    const SDL_MessageBoxData box = {SDL_MESSAGEBOX_WARNING, nullptr, "Data folder not found",
+                                    message.c_str(), static_cast<int>(std::size(buttons)),
+                                    buttons, nullptr};
+    int answer = QUIT;
+    if (!SDL_ShowMessageBox(&box, &answer) || answer == QUIT)
+      return false;
+    if (answer == USE_DEFAULT)
+    {
+      std::string error;
+      if (!moderngekko::frontend::PointUserDirectory(default_directory, default_directory, &error))
+      {
+        SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, "Data folder", error.c_str(), nullptr);
+        return false;
+      }
+    }
+    *choice = moderngekko::frontend::FindUserDirectory(release_directory, default_directory);
+  }
+  return true;
+}
