+// Static recomp: if the APK carries a module for this disc (libg<GameID>_recomp.so in the
+// native library directory, beside libmain.so), boot it on the StaticRecomp core with the
+// settings moderngekko-run uses. Only the current-run layer is touched, and BootManager clears
+// it at shutdown, so other games and the user's settings are unaffected.
+static void ConfigureStaticRecomp(const BootParameters& boot)
+{
+  StaticRecompModuleSource source;
+  const auto* disc = std::get_if<BootParameters::Disc>(&boot.parameters);
+  Dl_info info{};
+  if (disc && disc->volume &&
+      dladdr(reinterpret_cast<void*>(&ConfigureStaticRecomp), &info) && info.dli_fname)
+  {
+    std::string path = info.dli_fname;
+    path.resize(path.rfind('/') + 1);
+    path += "libg" + disc->volume->GetGameID() + "_recomp.so";
+    if (File::Exists(path))
+    {
+      __android_log_print(ANDROID_LOG_INFO, DOLPHIN_TAG, "StaticRecomp module: %s", path.c_str());
+      source = StaticRecompModuleSource::Dynamic(path);
+      // A PGO-instrumented module (DolRecomp --profile-generate) writes its counters when it is
+      // unloaded; point them at app storage (the default is relative to "/", not writable).
+      const std::string profile = File::GetUserPath(D_USER_IDX) + "PGO/%m-%p.profraw";
+      setenv("LLVM_PROFILE_FILE", profile.c_str(), 0);
+      Config::SetCurrent(Config::MAIN_CPU_CORE, PowerPC::CPUCore::StaticRecomp);
+      Config::SetCurrent(Config::GFX_SHADER_CACHE, true);
+      Config::SetCurrent(Config::GFX_SHADER_COMPILATION_MODE,
+                         ShaderCompilationMode::AsynchronousUberShaders);
+      Config::SetCurrent(Config::GFX_WAIT_FOR_SHADERS_BEFORE_STARTING, true);
+    }
+  }
+  Core::System::GetInstance().GetJitInterface().SetStaticRecompModuleSource(std::move(source));
+}
+
 static void Run(JNIEnv* env, std::unique_ptr<BootParameters>&& boot, bool riivolution)
 {
+  if (boot)
+    ConfigureStaticRecomp(*boot);
+
   if (riivolution && std::holds_alternative<BootParameters::Disc>(boot->parameters))
   {
     const std::string& riivolution_dir = File::GetUserPath(D_RIIVOLUTION_IDX);
@@ -577,12 +621,21 @@ static void Run(JNIEnv* env, std::unique_ptr<BootParameters>&& boot, bool riivol
   s_need_nonblocking_alert_msg = false;
   surface_guard.unlock();
 
+#ifdef DOLPHIN_ANDROID_AUTOMATION
+  if (Core::IsRunning(Core::System::GetInstance()))
+    Automation::Start();
+#endif
+
   while (Core::IsRunning(Core::System::GetInstance()))
   {
     s_update_main_frame_event.Wait();
     Core::HostDispatchJobs(Core::System::GetInstance());
   }
 
+#ifdef DOLPHIN_ANDROID_AUTOMATION
+  Automation::Stop();
+#endif
+
   s_game_metadata_is_valid = false;
   Core::Shutdown(Core::System::GetInstance());
 
