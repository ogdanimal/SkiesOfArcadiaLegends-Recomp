+// Local (fork): the game's copy textures (handle, revision) as each of its last frames left them, by
+// texture frame. A copy the game made frames ago and still draws (Skies' screen shatter: one capture of the
+// screen, drawn on the shards for the next 40 frames) is not made again by the replay of a frame that only
+// reads it, so the replay held the capture of its own first in-between (a blend, a frame older at T=0)
+// and drew every later in-between with that, not the game's capture. A replay reads the game's copy of a
+// texture it doesn't copy itself when the game hasn't copied it since the end of the frame before.
+struct LiveCopyRevisions {
+  u32 frame = 0;
+  absl::flat_hash_map<const void*, std::pair<const void*, u32>> copies;  // dest -> handle, revision
+};
+static std::array<LiveCopyRevisions, 4> s_liveCopyRevisions;
+static const bool s_liveCopyDisabled = std::getenv("AURORA_REPLAY_LIVE_COPIES") != nullptr &&
+                                       std::getenv("AURORA_REPLAY_LIVE_COPIES")[0] == '0';
+
+u32 replay_serial() noexcept { return s_replaySerial; }
+
+// The game's copy of `dest` when a replay of the frame with texture frame s_replayTextureFrame may read it
+static const GXState::CopyTextureRef* live_copy_for_replay(const void* dest) noexcept {
+  if (s_liveCopyDisabled || !s_replayContext || s_replayTextureFrame <= 1 || !s_replayInit) {
+    return nullptr;
+  }
+  // (the game's state is the swapped-out one while the replay's is current)
+  const auto live = s_replayState.copyTextures.find(dest);
+  if (live == s_replayState.copyTextures.end() || !live->second.handle) {
+    return nullptr;
+  }
+  const auto& before = s_liveCopyRevisions[(s_replayTextureFrame - 1) % s_liveCopyRevisions.size()];
+  if (before.frame != s_replayTextureFrame - 1) {
+    return nullptr;
+  }
+  const auto at = before.copies.find(dest);
+  if (at == before.copies.end() || at->second.first != live->second.handle.get() ||
+      at->second.second != live->second.revision) {
+    return nullptr;  // copied again since: the replay's own copy of it stands
+  }
+  if (live->second.ramBytes != 0 && copy_ram_fingerprint(dest, live->second.ramBytes) != live->second.ramFingerprint) {
+    return nullptr;
+  }
+  return &live->second;
+}
+
+void texture_frame_tick() noexcept {
+  if (!s_replayContext) {
+    auto& slot = s_liveCopyRevisions[s_textureFrame % s_liveCopyRevisions.size()];
+    slot.frame = s_textureFrame;
+    slot.copies.clear();
+    for (const auto& [dest, ref] : g_gxState.copyTextures) {
+      slot.copies[dest] = {ref.handle.get(), ref.revision};
+    }
+  }
