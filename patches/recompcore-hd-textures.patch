+# The Skies of Arcadia Legends recomp's HD texture pack import (TexturePackImport.cpp) reads .zip
+# packs with minizip-ng and .7z packs with the LZMA SDK's 7z decoder (public domain; the repo's
+# lib/lzma-sdk). Without it, .zip packs and unpacked folders only.
+target_link_libraries(videocommon PRIVATE MINIZIP::minizip-ng)
+set(SKIES_LZMA_SDK_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../../../../../../lzma-sdk" CACHE PATH
+    "LZMA SDK source (its C/ directory has 7zArcIn.c)")
+if(EXISTS "${SKIES_LZMA_SDK_DIR}/C/7zArcIn.c")
+  message(STATUS "LZMA SDK found, the texture pack import reads .7z files")
+  set(_skies_7z_sources)
+  foreach(_skies_7z_file IN ITEMS 7zAlloc 7zArcIn 7zBuf 7zBuf2 7zCrc 7zCrcOpt 7zDec 7zStream Bcj2
+                                  Bra Bra86 BraIA64 CpuArch Delta Lzma2Dec LzmaDec Ppmd7 Ppmd7Dec)
+    list(APPEND _skies_7z_sources "${SKIES_LZMA_SDK_DIR}/C/${_skies_7z_file}.c")
+  endforeach()
+  add_library(skies7z STATIC ${_skies_7z_sources})
+  target_compile_definitions(skies7z PRIVATE Z7_PPMD_SUPPORT Z7_EXTRACT_ONLY)
+  target_include_directories(skies7z PUBLIC "${SKIES_LZMA_SDK_DIR}/C")
+  # Third-party code: none of Dolphin's warnings (MSVC builds them as errors). Its own symbol
+  # names: mGBA links another copy of the SDK (Skies7zPrefix.h).
+  set(_skies_7z_prefix "${CMAKE_CURRENT_SOURCE_DIR}/Skies7zPrefix.h")
+  if(MSVC)
+    target_compile_options(skies7z PRIVATE /W0 /WX- "/FI${_skies_7z_prefix}")
+  else()
+    target_compile_options(skies7z PRIVATE -w "SHELL:-include \"${_skies_7z_prefix}\"")
+  endif()
+  target_link_libraries(videocommon PRIVATE skies7z)
+  target_compile_definitions(videocommon PRIVATE HAVE_LZMA_SDK=1)
+endif()
+
 if(_M_X86_64)
   target_sources(videocommon PRIVATE
     TextureDecoder_x64.cpp
