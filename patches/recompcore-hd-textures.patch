+// Settings, Graphics: an HD texture pack the player downloaded (a .7z or .zip; the picker hands
+// over a document, so no folders here) into Load/Textures/GEA, where Dolphin loads custom textures
+// for both games (VideoCommon/TexturePackImport.h). "" or what went wrong; the progress goes to
+// importStatus.
+JNIEXPORT jstring JNICALL Java_org_dolphinemu_dolphinemu_skies_SkiesNative_importTexturePack(
+    JNIEnv* env, jclass, jstring pack)
+{
+  if (s_importing.exchange(true))
+    return ToJString(env, "Something is already being imported.");
+  std::string summary;
+  const std::string path = GetJString(env, pack);
+  // A media URI ends in a number, not the file's name
+  const std::string file_name =
+      path.starts_with("content://") ? GetAndroidContentDisplayName(path) : "";
+  const std::string error = TexturePackImport::Import(
+      path, File::GetUserPath(D_HIRESTEXTURES_IDX), &summary,
+      [](const std::string& status) { SetStatus(status); }, file_name);
+  SetStatus("");
+  s_importing = false;
+  return ToJString(env, error);
+}
+
+// What's imported, e.g. "SoA_HD_v0.06_PNG: 745 textures"; "" if nothing.
+JNIEXPORT jstring JNICALL Java_org_dolphinemu_dolphinemu_skies_SkiesNative_describeTexturePack(
+    JNIEnv* env, jclass)
+{
+  return ToJString(env, TexturePackImport::Describe(File::GetUserPath(D_HIRESTEXTURES_IDX)));
+}
+
+JNIEXPORT jint JNICALL Java_org_dolphinemu_dolphinemu_skies_SkiesNative_texturePackBc7(JNIEnv*,
+                                                                                        jclass)
+{
+  return TexturePackImport::Bc7Count(File::GetUserPath(D_HIRESTEXTURES_IDX));
+}
+
+JNIEXPORT jboolean JNICALL Java_org_dolphinemu_dolphinemu_skies_SkiesNative_removeTexturePack(
+    JNIEnv*, jclass)
+{
+  return TexturePackImport::Remove(File::GetUserPath(D_HIRESTEXTURES_IDX)) ? JNI_TRUE : JNI_FALSE;
+}
