+// The game's save state folder (StateSaves, or a romhack's own: tools/dol_patch.hpp RomhackTag),
+// made Dolphin's for this process, so the in-game menu and auto-save use it; returns it.
+JNIEXPORT jstring JNICALL Java_org_dolphinemu_dolphinemu_skies_SkiesNative_useStateFolder(
+    JNIEnv* env, jclass, jstring game_root, jstring patch)
+{
+  const fs::path folder = moderngekko::frontend::StateDirectory(
+      StringToPath(File::GetUserPath(D_USER_IDX)),
+      moderngekko::frontend::RomhackTag(StringToPath(GetJString(env, game_root)),
+                                        StringToPath(GetJString(env, patch))));
+  std::error_code ec;
+  fs::create_directories(folder, ec);
+  File::SetUserPath(D_STATESAVES_IDX, PathToString(folder));
+  return ToJString(env, PathToString(folder));
+}
+
+// The launcher's check at every resume: main.dol is this app's build (or a romhack's data on it)
+JNIEXPORT jboolean JNICALL Java_org_dolphinemu_dolphinemu_skies_SkiesNative_dolMatches(
+    JNIEnv* env, jclass, jstring dol, jstring patch, jstring dol_sha256)
+{
+  return moderngekko::frontend::DolMatchesPin(GetJString(env, dol), GetJString(env, patch),
+                                              GetJString(env, dol_sha256)) ?
+             JNI_TRUE :
+             JNI_FALSE;
+}
