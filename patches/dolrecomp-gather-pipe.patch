diff --git a/src/cpu/cpu.h b/src/cpu/cpu.h
index 29510f8..e941c1a 100644
--- a/src/cpu/cpu.h
+++ b/src/cpu/cpu.h
@@ -55,6 +55,7 @@ typedef bool (*PPCHostCall)(CPUState* cpu, u32 address);
 typedef u32 (*PPCSPRRead)(CPUState* cpu, u16 spr, u32 cia);
 typedef void (*PPCSPRWrite)(CPUState* cpu, u16 spr, u32 value, u32 cia);
 typedef void (*PPCCacheControl)(CPUState* cpu, u8 operation, u32 ea, u32 cia);
+typedef void (*PPCGatherPipeFlush)(CPUState* cpu);
 
 enum {
     PPC_CACHE_DCBST,
@@ -122,6 +123,14 @@ struct CPUState {
     PPCSPRRead spr_read;
     PPCSPRWrite spr_write;
     PPCCacheControl cache_control;
+
+    /* Write-gather pipe (stores to effective page 0xCC008000, the GX FIFO). When the host sets
+       gather_pipe_ptr_ref, generated stores to that page append big-endian bytes at
+       *gather_pipe_ptr_ref and call gather_pipe_flush once 32 or more bytes are queued past
+       gather_pipe_base. NULL keeps them on external_write. */
+    u8** gather_pipe_ptr_ref;
+    u8* gather_pipe_base;
+    PPCGatherPipeFlush gather_pipe_flush;
 };
 
 typedef void (*PPCMemWriteJournal)(u32 offset, u32 size, void* user);
