diff --git a/src/backend/llvm/gather_pipe.cpp b/src/backend/llvm/gather_pipe.cpp
new file mode 100644
index 0000000..17e3447
--- /dev/null
+++ b/src/backend/llvm/gather_pipe.cpp
@@ -0,0 +1,63 @@
+#include "backend/llvm/emitter.h"
+#include "cpu/cpu.h"
+
+#include <llvm/IR/BasicBlock.h>
+#include <llvm/IR/Function.h>
+#include <llvm/IR/MDBuilder.h>
+
+namespace dolllvm {
+
+using namespace llvm;
+
+// Stores to the write-gather pipe page (effective 0xCC008000, the GX FIFO) append to the host's
+// gather buffer when it publishes one (gather_pipe_ptr_ref), calling out only once a 32-byte burst
+// is queued. Immediate-mode vertex data makes these the most frequent non-RAM stores; through
+// external_write each one was an indirect call that also took the guest state out of host
+// registers. The flush only moves queued bytes to the GPU FIFO: it leaves the guest state alone and
+// raises nothing synchronously (CP interrupts are delivered between dispatches), so it needs no PC,
+// exception check or state reload.
+void FunctionEmitter::gatherPipeWrite(Value *address, Value *value,
+                                      u32 width) {
+  Type *ptr = PointerType::getUnqual(context_);
+  Type *i8 = Type::getInt8Ty(context_);
+  BasicBlock *checkHost =
+      BasicBlock::Create(context_, "store_gp_check", function_);
+  BasicBlock *gather = BasicBlock::Create(context_, "store_gp", function_);
+  BasicBlock *flush = BasicBlock::Create(context_, "store_gp_flush", function_);
+  BasicBlock *external =
+      BasicBlock::Create(context_, "store_external", function_);
+  BasicBlock *done = BasicBlock::Create(context_, "store_gp_done", function_);
+  Value *page = builder_.CreateAnd(address, builder_.getInt32(0xFFFFF000u));
+  builder_.CreateCondBr(
+      builder_.CreateICmpEQ(page, builder_.getInt32(0xCC008000u)), checkHost,
+      external);
+
+  builder_.SetInsertPoint(checkHost);
+  Value *ref = loadOffset(ptr, offsetof(CPUState, gather_pipe_ptr_ref));
+  builder_.CreateCondBr(builder_.CreateIsNotNull(ref), gather, external,
+                        MDBuilder(context_).createBranchWeights(2000, 1));
+
+  builder_.SetInsertPoint(gather);
+  Value *cursor = builder_.CreateLoad(ptr, ref, "gp.cursor");
+  endianStore(cursor, value, width);
+  Value *next = builder_.CreateInBoundsGEP(i8, cursor, builder_.getInt64(width));
+  builder_.CreateStore(next, ref);
+  Value *base = loadOffset(ptr, offsetof(CPUState, gather_pipe_base));
+  Value *queued = builder_.CreatePtrDiff(i8, next, base);
+  builder_.CreateCondBr(
+      builder_.CreateICmpUGE(queued, builder_.getInt64(32)), flush, done,
+      MDBuilder(context_).createBranchWeights(1, 7));
+
+  builder_.SetInsertPoint(flush);
+  Value *fn = loadOffset(ptr, offsetof(CPUState, gather_pipe_flush));
+  builder_.CreateCall(FunctionType::get(Type::getVoidTy(context_), {ptr}, false),
+                      fn, {ctx_});
+  builder_.CreateBr(done);
+
+  builder_.SetInsertPoint(external);
+  externalWrite(address, value, width);
+  builder_.CreateBr(done);
+  builder_.SetInsertPoint(done);
+}
+
+} // namespace dolllvm
