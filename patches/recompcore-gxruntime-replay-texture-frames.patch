+// A replay's key from an earlier frame's hashes that missed the cache: hashed from RAM as it is now,
+// the texels the texture is about to be made from
+void rehash_retail_key(const GXTexObj_& obj, const GXTlutObj_* tlut, RetailTextureKey& key) noexcept {
+  if (!s_keyFromHistory) {
+    return;
+  }
+  s_keyFromHistory = false;
+  key.texHash = hash_bytes(obj.data, recomp::texture_byte_size(obj));
+  key.tlutHash = tlut != nullptr && tlut->data != nullptr
+                     ? hash_bytes(tlut->data, static_cast<size_t>(tlut->numEntries) * 2u)
+                     : 0;
+}
