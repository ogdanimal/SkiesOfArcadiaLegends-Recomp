+void GPFifoManager::UpdateGatherPipeBatched()
+{
+  size_t pipe_count = GetGatherPipeCount();
+  if (pipe_count < GATHER_PIPE_SIZE)
+    return;
+  auto& system = m_system;
+  auto& command_processor = system.GetCommandProcessor();
+  if (!command_processor.IsGatherPipeLinked())
+  {
+    UpdateGatherPipe();
+    return;
+  }
+  auto& memory = system.GetMemory();
+  auto& processor_interface = system.GetProcessorInterface();
+  const u32 bursts = static_cast<u32>(pipe_count / GATHER_PIPE_SIZE);
+  // Room for the whole batch before any of it is copied (WaitForFifoSpace's guarantee, for N)
+  system.GetFifo().WaitForFifoSpace(bursts * GATHER_PIPE_SIZE);
+  size_t processed = 0;
+  for (u32 i = 0; i < bursts; ++i, processed += GATHER_PIPE_SIZE)
+  {
+    memory.CopyToEmu(processor_interface.m_fifo_cpu_write_pointer, m_gather_pipe + processed,
+                     GATHER_PIPE_SIZE);
+    if (processor_interface.m_fifo_cpu_write_pointer == processor_interface.m_fifo_cpu_end)
+      processor_interface.m_fifo_cpu_write_pointer = processor_interface.m_fifo_cpu_base;
+    else
+      processor_interface.m_fifo_cpu_write_pointer += GATHER_PIPE_SIZE;
+  }
+  command_processor.GatherPipeBurstedN(bursts);
+  pipe_count -= processed;
+  memmove(m_gather_pipe, m_gather_pipe + processed, pipe_count);
+  SetGatherPipeCount(pipe_count);
+}
