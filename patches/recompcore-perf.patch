+u32 StaticRecompCore::ReadGuestWord(u32 address) const
+{
+  if (address < 0x80000000u || address - 0x80000000u + 4u > m_guest.ram_size)
+    return 0;
+  const u8* code = m_guest.ram + (address - 0x80000000u);
+  return static_cast<u32>(code[0]) << 24 | static_cast<u32>(code[1]) << 16 |
+         static_cast<u32>(code[2]) << 8 | code[3];
+}
+
+namespace
+{
+enum ExitKind
+{
+  EXIT_EXCEPTION,
+  EXIT_SLICE_END,
+  EXIT_AFTER_MTMSR,
+  EXIT_RETURN_AFTER_BL,
+  EXIT_RETURN_AFTER_INDIRECT,
+  EXIT_INDIRECT_CALL,
+  EXIT_DIRECT_CALL,
+  EXIT_SAME_START,
+  EXIT_INDIRECT_JUMP,
+  EXIT_RETURN_BLR,
+  EXIT_OTHER,
+};
+constexpr const char* EXIT_NAMES[] = {
+    "exception", "slice end (downcount <= 0)", "after mtmsr", "return to a lost bl frame",
+    "return after bctrl/blrl", "indirect call (bctrl/blrl)", "direct call (bl target)",
+    "same start (loop)", "indirect jump (pc == ctr)", "return (pc == lr)", "other"};
+constexpr const char* BURST_END_NAMES[] = {"slice end",         "sync exception",
+                                           "external interrupt", "not dispatchable",
+                                           "host call",          "state"};
+
+bool IsBl(u32 inst)
+{
+  return (inst >> 26) == 18 && (inst & 1) != 0;
+}
+bool IsIndirectCall(u32 inst)
+{
+  const u32 xo = (inst >> 1) & 0x3FF;
+  return (inst >> 26) == 19 && (inst & 1) != 0 && (xo == 16 || xo == 528);
+}
+bool IsMtmsr(u32 inst)
+{
+  return (inst & 0xFC0007FEu) == 0x7C000124u;
+}
+u32 BlTarget(u32 inst, u32 at)
+{
+  s32 li = static_cast<s32>(inst & 0x03FFFFFCu);
+  if (li & 0x02000000)
+    li -= 0x04000000;
+  return (inst & 2) ? static_cast<u32>(li) : at + static_cast<u32>(li);
+}
+}  // namespace
+
+void StaticRecompCore::CountDispatchExit(u32 start_pc, bool exception)
+{
+  const u32 pc = m_guest.pc;
+  const u32 before = ReadGuestWord(pc - 4);
+  const u32 lr = m_guest.lr;
+  const u32 call = ReadGuestWord(lr - 4);
+  ExitKind kind;
+  if (exception)
+    kind = EXIT_EXCEPTION;
+  else if (m_system.GetPPCState().downcount <= 0)
+    kind = EXIT_SLICE_END;
+  else if (IsMtmsr(before))
+    kind = EXIT_AFTER_MTMSR;
+  else if (IsBl(before))
+    kind = EXIT_RETURN_AFTER_BL;
+  else if (IsIndirectCall(before))
+    kind = EXIT_RETURN_AFTER_INDIRECT;
+  else if (pc != lr && IsIndirectCall(call))
+    kind = EXIT_INDIRECT_CALL;
+  else if (pc != lr && IsBl(call) && BlTarget(call, lr - 4) == pc)
+    kind = EXIT_DIRECT_CALL;
+  else if (pc == start_pc)
+    kind = EXIT_SAME_START;
+  else if (pc == m_guest.ctr)
+    kind = EXIT_INDIRECT_JUMP;
+  else if (pc == lr)
+    kind = EXIT_RETURN_BLR;
+  else
+    kind = EXIT_OTHER;
+  ++m_exit_counts[kind];
+}
+
+void StaticRecompCore::CountBurstEnd(bool sync_exception, bool dispatchable, bool host_call,
+                                     bool running)
+{
+  auto& ppc = m_system.GetPPCState();
+  std::size_t kind;
+  if (sync_exception)
+    kind = 1;
+  else if (!running)
+    kind = 5;
+  else if (!dispatchable)
+    kind = 3;
+  else if (host_call)
+    kind = 4;
+  else if (ppc.downcount <= 0)
+    kind = 0;
+  else
+    kind = 2;
+  ++m_burst_end_counts[kind];
+}
+
+bool StaticRecompCore::IsWaitingAt(u32 address) const
+{
+  if (address != m_wait_pc || m_wait_pc == 0)
+    return false;
+  auto& memory = m_system.GetMemory();
+  return memory.Read_U32(m_wait_counter) == memory.Read_U32(m_wait_last) &&
+         memory.Read_U32(m_wait_empty) == 0;
+}
