 void ObjectCache::Shutdown()
 {
+  JoinPipelineCacheSave();
   if (g_ActiveConfig.bShaderCache && m_pipeline_cache != VK_NULL_HANDLE)
     SavePipelineCache();
 }
 
+void ObjectCache::JoinPipelineCacheSave()
+{
+  if (m_pipeline_cache_save_thread.joinable())
+    m_pipeline_cache_save_thread.join();
+}
+
+void ObjectCache::SavePipelineCacheIfChanged()
+{
+  using namespace std::chrono_literals;
+  if (!g_ActiveConfig.bShaderCache || m_pipeline_cache == VK_NULL_HANDLE)
+    return;
+  const auto now = std::chrono::steady_clock::now();
+  if (now - m_last_pipeline_cache_save < 30s ||
+      m_pipelines_since_save.load(std::memory_order_relaxed) == 0 ||
+      m_pipeline_cache_saving.load(std::memory_order_acquire))
+  {
+    return;
+  }
+  JoinPipelineCacheSave();
+  m_last_pipeline_cache_save = now;
+  m_pipelines_since_save.store(0, std::memory_order_relaxed);
+  m_pipeline_cache_saving.store(true, std::memory_order_release);
+  // Pipeline caches are internally synchronized (created without the externally-synchronized
+  // flag), so pipelines may keep being created meanwhile.
+  m_pipeline_cache_save_thread = std::thread([this] {
+    SavePipelineCache();
+    m_pipeline_cache_saving.store(false, std::memory_order_release);
+  });
+}
