+    /**
+     * Runs [action] once no game runs: a session left running without its screen (see refresh) is
+     * stopped first, as Exit Game would, and its emulation thread has ended.
+     */
+    private fun afterGameClosed(action: () -> Unit) {
+        val native = org.dolphinemu.dolphinemu.NativeLibrary
+        if (!native.IsRunning()) {
+            action()
+            return
+        }
+        message.text = "Closing the game…"
+        buttons.removeAllViews()
+        native.StopEmulation()
+        val deadline = android.os.SystemClock.uptimeMillis() + CLOSE_TIMEOUT_MS
+        handler.removeCallbacks(closePoll)
+        closePoll = object : Runnable {
+            override fun run() {
+                val closed = native.IsUninitialized() && !EmulationActivity.isIgnoringLaunchRequests
+                if (!closed && android.os.SystemClock.uptimeMillis() < deadline) {
+                    handler.postDelayed(this, 100)
+                    return
+                }
+                if (!closed) Log.w("SkiesLauncher", "The game didn't close in time")
+                refresh()
+                action()
+            }
+        }
+        handler.post(closePoll)
+    }
+
+    private var closePoll = Runnable {}
