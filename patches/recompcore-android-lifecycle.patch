+        val day = java.text.SimpleDateFormat("yyyy-MM-dd", java.util.Locale.US).format(java.util.Date())
+        pickBackup.launch("skies-of-arcadia-saves-$day.zip")
+    }
+
+    /**
+     * The memory card saves (every region's Card A) and the save states (not Dolphin's lastState.sav,
+     * its undo) into one .zip at the picked place, each dated as its file is.
+     */
+    private fun exportSaves(uri: Uri) {
+        val user = userDirectory
+        Thread {
+            val cards = File(user, "GC").listFiles { f -> f.isDirectory }.orEmpty().flatMap { region ->
+                File(region, "Card A").listFiles { f -> f.isFile && f.name.endsWith(".gci") }.orEmpty()
+                    .map { "GC/${region.name}/Card A/${it.name}" to it }
+            }
+            val states = File(user, "StateSaves")
+                .listFiles { f -> f.isFile && f.name.endsWith(".sav") && f.name != "lastState.sav" }.orEmpty()
+                .map { "StateSaves/${it.name}" to it }
+            val result = try {
+                if (cards.isEmpty() && states.isEmpty()) throw java.io.IOException("there are no saves yet")
+                (contentResolver.openOutputStream(uri) ?: throw java.io.IOException("that place can't be written"))
+                    .use { out ->
+                        java.util.zip.ZipOutputStream(out.buffered()).use { zip ->
+                            zip.setLevel(1)  // states are compressed already
+                            for ((name, f) in cards + states) {
+                                zip.putNextEntry(java.util.zip.ZipEntry(name).apply { time = f.lastModified() })
+                                f.inputStream().use { it.copyTo(zip) }
+                                zip.closeEntry()
+                            }
+                        }
+                    }
+                arrayOf("Saved a backup with ${cards.size} memory card ${if (cards.size == 1) "save" else "saves"} " +
+                    "and ${states.size} save ${if (states.size == 1) "state" else "states"}.", "ok")
+            } catch (e: Exception) {
+                // Not a half-written backup someone could take for a whole one
+                try {
+                    android.provider.DocumentsContract.deleteDocument(contentResolver, uri)
+                } catch (ignored: Exception) {
+                }
+                arrayOf("Could not save the backup: ${e.message}", "")
+            }
+            handler.post { openSettings(mainDol.isFile, "Saves", result) }
+        }.start()
+    }
