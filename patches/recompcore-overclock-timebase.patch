diff --git a/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompCore.h b/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompCore.h
index 341258012d..02758ebb08 100644
--- a/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompCore.h
+++ b/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompCore.h
@@ -150,6 +150,20 @@ private:
   void SyncIn();   // Dolphin PowerPCState -> m_guest
   void SyncOut();  // m_guest -> Dolphin PowerPCState
   void AdvanceGuestTimebase(u64 cpu_cycles);
+  // Charges are CPU cycles, which run faster than the emulated clock when the CPU is overclocked:
+  // the timebase advances by charge * (1 / overclock) bus cycles, as Dolphin's GetTicks() counts
+  // them. Without it the guest's mftb ran ahead inside a native burst and jumped back at the next
+  // SyncIn (a MusyX stream stalled and its battle waited for good at an overclock of 1.5 or more).
+  u64 GuestTimebaseCycles(u64 cpu_cycles)
+  {
+    if (m_timebase_oc_inverted == 1.0f)
+      return cpu_cycles;
+    const double cycles = static_cast<double>(cpu_cycles) * m_timebase_oc_inverted +
+                          m_timebase_cycle_fraction;
+    const u64 whole = static_cast<u64>(cycles);
+    m_timebase_cycle_fraction = cycles - static_cast<double>(whole);
+    return whole;
+  }
 
   // CPUState hooks (module -> chassis environment). `cpu->external_user_data`
   // is the StaticRecompCore*.
@@ -189,6 +203,8 @@ private:
   u64 m_native_exceptions = 0;
   u64 m_hook_fallback_instructions = 0;
   u64 m_timebase_cycle_remainder = 0;
+  float m_timebase_oc_inverted = 1.0f;     // CoreTiming's 1 / overclock, read at SyncIn
+  double m_timebase_cycle_fraction = 0.0;  // the part of a bus cycle not yet counted
   std::unordered_map<u32, u64> m_dispatch_samples;
   std::unordered_map<u32, u64> m_fallback_samples;  // STATICRECOMP_FALLBACK_SAMPLES
   bool m_collect_fallback_samples = false;
