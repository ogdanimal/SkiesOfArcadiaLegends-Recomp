index 0000000000..d2339d8844
--- /dev/null
+++ b/Source/Android/app/src/main/java/org/dolphinemu/dolphinemu/skies/SkiesGame.kt
@@ -0,0 +1,81 @@
+package org.dolphinemu.dolphinemu.skies
+
+import android.app.Activity
+import android.app.ActivityManager
+import android.content.Context
+import android.content.Intent
+import android.os.Process
+import android.util.Log
+import org.dolphinemu.dolphinemu.DolphinApplication
+import org.dolphinemu.dolphinemu.NativeLibrary
+import java.io.File
+
+/**
+ * Which runtime plays the game: the emulator-free host (SkiesGameActivity, libskies.so in the ":game" process) when
+ * the APK has it (-PskiesStandaloneJava, tools/android-ws-build.sh STANDALONE=1), else Dolphin's emulation in this
+ * process as before. The launcher asks here instead of NativeLibrary, so both kinds of build keep working.
+ */
+object SkiesGame {
+    private const val ACTIVITY = "org.dolphinemu.dolphinemu.skies.SkiesGameActivity"
+    const val EXTRA_ARGS = "org.dolphinemu.dolphinemu.skies.GAME_ARGS"
+    const val ACTION_CLOSE = "org.dolphinemu.dolphinemu.skies.CLOSE_GAME"
+    /** SkiesGameActivity.RESULT_RESTART: the Language restart. */
+    const val RESULT_RESTART = Activity.RESULT_FIRST_USER + 1
+    private const val PROCESS_SUFFIX = ":game"
+
+    /** The emulator-free host is in this APK (built for Android 9 and later). */
+    val standalone: Boolean by lazy {
+        if (android.os.Build.VERSION.SDK_INT < 28) return@lazy false
+        try {
+            Class.forName(ACTIVITY, false, SkiesGame::class.java.classLoader)
+            true
+        } catch (e: ClassNotFoundException) {
+            false
+        }
+    }
+
+    private fun context(): Context = DolphinApplication.getAppContext()
+
+    /** The game process's pid, 0 when it isn't running. */
+    private fun gamePid(): Int {
+        val context = context()
+        val manager = context.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager
+        val name = context.packageName + PROCESS_SUFFIX
+        return manager.runningAppProcesses?.firstOrNull { it.processName == name }?.pid ?: 0
+    }
+
+    /** A game runs (or is still shutting down): imports and a new disc wait for it to end. */
+    fun isRunning(): Boolean = if (standalone) gamePid() != 0 else NativeLibrary.IsRunning()
+
+    /** Asks the game to quit (its memory card is flushed on the way out); isRunning turns false once it has. */
+    fun requestClose() {
+        if (!standalone) {
+            NativeLibrary.StopEmulation()
+            return
+        }
+        val context = context()
+        context.sendBroadcast(Intent(ACTION_CLOSE).setPackage(context.packageName))
+    }
+
+    /** The last resort after requestClose didn't end it in time. */
+    fun forceClose() {
+        val pid = gamePid()
+        if (standalone && pid != 0 && pid != Process.myPid()) {
+            Log.w("SkiesGame", "ending the game process")
+            Process.killProcess(pid)
+        }
+    }
+
+    /**
+     * The intent that starts the game: the host's command line (main.cpp) with the launcher's choices, [state] to
+     * load (Continue from a save state) or none. A memory card Continue goes through [Skies] AutoLoadCard as before.
+     */
+    fun intent(context: Context, user: File, game: File, stateDirectory: File?, state: File?): Intent {
+        val sys = File(context.filesDir, "Sys")
+        val args = arrayListOf("--game", game.absolutePath, "--user", user.absolutePath, "--sys", sys.absolutePath,
+            "--dsp-coef", File(sys, "GC/dsp_coef.bin").absolutePath)
+        if (stateDirectory != null) args += listOf("--state-dir", stateDirectory.absolutePath)
+        if (state != null) args += listOf("--load-state", state.absolutePath)
+        return Intent().setClassName(context, ACTIVITY).putExtra(EXTRA_ARGS, args.toTypedArray())
+    }
+}
