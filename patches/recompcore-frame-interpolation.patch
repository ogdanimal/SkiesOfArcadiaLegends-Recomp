+
+bool ReadEnabled()
+{
+  const char* env = std::getenv("RECOMP_FRAME_INTERPOLATION");
+  // Without the variable (Android has no frontend to set it), a file named
+  // FrameInterpolation.on in the user directory turns it on.
+  const bool enabled = env ? (env[0] == '1' || env[0] == '2') :
+                             File::Exists(File::GetUserPath(D_USER_IDX) + "FrameInterpolation.on");
+  s_verbose = (env && env[0] == '2') ||
+              File::Exists(File::GetUserPath(D_USER_IDX) + "FrameInterpolation.stats");
+  s_test_norecord = File::Exists(File::GetUserPath(D_USER_IDX) + "FrameInterpolation.norecord");
+  s_test_noreplay =
+      s_test_norecord || File::Exists(File::GetUserPath(D_USER_IDX) + "FrameInterpolation.noreplay");
+  if (enabled)
+    Log( "[interp] frame interpolation on\n");
+  s_enabled = enabled ? 1 : 0;
+  return enabled;
+}
