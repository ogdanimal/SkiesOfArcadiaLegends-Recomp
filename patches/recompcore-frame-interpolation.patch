+void FifoManager::WaitForGpuToDrain(int reason)
+{
+  if (!m_system.IsDualCoreMode() || m_use_deterministic_gpu_thread)
+    return;
+  const auto wait_start = std::chrono::steady_clock::now();
+  Common::ScopeGuard count_wait{[&] {
+    if (FrameInterpolator::IsEnabled())
+      FrameInterpolator::CountCpuWait(reason, std::chrono::steady_clock::now() - wait_start);
+  }};
+  auto& command_processor = m_system.GetCommandProcessor();
+  auto& fifo = command_processor.GetFifo();
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(250);
+  // Wake the GPU thread once; waking it on every spin takes its lock each time and slows it down.
+  m_gpu_mainloop.Wakeup();
+  // Spin: the CPU thread has nothing else to do, and short sleeps overshoot (by a millisecond or
+  // more on Windows), which would cost more than the wait itself.
+  while (fifo.CPReadWriteDistance.load(std::memory_order_acquire) != 0 &&
+         fifo.bFF_GPReadEnable.load(std::memory_order_relaxed) &&
+         !command_processor.IsInterruptWaiting() && !AtBreakpoint(m_system) &&
+         m_emu_running_state.IsSet())
+  {
+    if (std::chrono::steady_clock::now() > deadline)
+      break;
+    std::this_thread::yield();
+  }
+}
+
+// A game stops writing at the high watermark through the CP overflow interrupt, which suspends the
+// writing thread (GXOverflowHandler). Recompiled code takes interrupts only between dispatches
+// (one can run a whole function with its callees), so it can write past the watermark's margin
+// while the GPU thread lags, and then overwrites commands the GPU thread hasn't read ("FIFO is
+// overflowed by GatherPipe"). Waiting here instead keeps emulated time still, as if the GPU had
+// kept up.
+void FifoManager::WaitForFifoSpace()
+{
+  if (!m_system.IsDualCoreMode() || m_use_deterministic_gpu_thread)
+    return;
+  auto& command_processor = m_system.GetCommandProcessor();
+  auto& fifo = command_processor.GetFifo();
+  // The largest distance the overflow check allows.
+  const u32 capacity = fifo.CPEnd.load(std::memory_order_relaxed) -
+                       fifo.CPBase.load(std::memory_order_relaxed);
+  if (fifo.CPReadWriteDistance.load(std::memory_order_acquire) + GPFifo::GATHER_PIPE_SIZE <=
+      capacity)
+  {
+    return;
+  }
+  u32 target = fifo.CPHiWatermark;
+  if (target == 0 || target >= capacity)
+    target = capacity / 2;
+
+  static std::atomic<u32> s_waits{0};
+  if (s_waits.fetch_add(1, std::memory_order_relaxed) < 8)
+    WARN_LOG_FMT(COMMANDPROCESSOR, "FIFO full ({} bytes): CPU thread waits for the GPU thread",
+                 capacity);
+
+  // Longer than WaitForGpuToDrain's limit: giving up here means the overflow.
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+  m_gpu_mainloop.Wakeup();
+  while (fifo.CPReadWriteDistance.load(std::memory_order_acquire) > target &&
+         fifo.bFF_GPReadEnable.load(std::memory_order_relaxed) &&
+         !command_processor.IsInterruptWaiting() && !AtBreakpoint(m_system) &&
+         m_emu_running_state.IsSet())
+  {
+    if (std::chrono::steady_clock::now() > deadline)
+      break;
+    std::this_thread::yield();
+  }
+}
