--- a/Source/Core/VideoCommon/FramebufferManager.cpp
+++ b/Source/Core/VideoCommon/FramebufferManager.cpp
@@ -299,8 +299,68 @@ bool FramebufferManager::CreateEFBFramebuffer(int efb_scale)
   return true;
 }
 
+void FramebufferManager::ExchangeEFB(EFBSet& other)
+{
+  std::swap(m_efb_color_texture, other.color);
+  std::swap(m_efb_convert_color_texture, other.convert_color);
+  std::swap(m_efb_depth_texture, other.depth);
+  std::swap(m_efb_resolve_color_texture, other.resolve_color);
+  std::swap(m_efb_depth_resolve_texture, other.depth_resolve);
+  std::swap(m_efb_framebuffer, other.framebuffer);
+  std::swap(m_efb_convert_framebuffer, other.convert_framebuffer);
+  std::swap(m_efb_color_resolve_framebuffer, other.color_resolve_framebuffer);
+  std::swap(m_efb_depth_resolve_framebuffer, other.depth_resolve_framebuffer);
+  std::swap(m_prev_efb_format, other.prev_format);
+}
+
+bool FramebufferManager::CreateSpareEFB()
+{
+  if (m_spare_efb_created)
+    return true;
+  if (m_spare_efb_failed)
+    return false;
+  // Build a second set the same way as the first, then park it.
+  EFBSet game;
+  ExchangeEFB(game);
+  const bool created = CreateEFBFramebuffer(static_cast<int>(m_efb_scale));
+  m_prev_efb_format = game.prev_format;
+  ExchangeEFB(game);  // the game's back in place, the new set in `game`
+  if (!created)
+  {
+    // A half-made set is never swapped in (its null framebuffer was bound next)
+    WARN_LOG_FMT(VIDEO, "Can't create the spare EFB for frame interpolation");
+    m_spare_efb_failed = true;
+    return false;
+  }
+  m_spare_efb = std::move(game);
+  m_spare_efb_created = true;
+  return true;
+}
+
+bool FramebufferManager::SwapEFB()
+{
+  if (!CreateSpareEFB())
+    return false;
+  FlushEFBPokes();
+  // The EFB going out of use comes back later for another render pass with nothing reading it in
+  // between, so nothing would order that pass after this one's writes (Dolphin's own switches
+  // away from the EFB always read it first: an EFB copy). Desktop GPUs run the passes in order
+  // anyway; a tiled GPU loads the next pass's tiles from memory and got the previous pass's
+  // stores half done (the Retroid: bands of stale rows at the top of each tile, in the game's
+  // frames and the in-between ones). Ending the pass and changing the layout puts the barrier in.
+  m_efb_color_texture->FinishedRendering();
+  m_efb_depth_texture->FinishedRendering();
+  ExchangeEFB(m_spare_efb);
+  InvalidatePeekCache(true);
+  BindEFBFramebuffer();
+  return true;
+}
+
 void FramebufferManager::DestroyEFBFramebuffer()
 {
+  m_spare_efb = {};
+  m_spare_efb_created = false;
+  m_spare_efb_failed = false;
   m_efb_framebuffer.reset();
   m_efb_convert_framebuffer.reset();
   m_efb_color_texture.reset();
