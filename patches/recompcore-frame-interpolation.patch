+std::atomic<s64> s_cpu_wait_ns[2] = {};
+std::atomic<s64> s_gpu_work_ns{0};
+
+// Debug timeline (a file FrameInterpolation.timeline in the user directory): frames 600-610's
+// events with timestamps, to logcat / stderr.
+static std::atomic<bool> s_timeline_on{false};
+static Clock::time_point s_timeline_zero;
+static void Timeline(const char* what, double ms = 0.0);
+
+void CountCpuWait(int reason, std::chrono::steady_clock::duration time)
+{
+  if (s_timeline_on.load(std::memory_order_relaxed) && time > std::chrono::microseconds(300))
+    Timeline(reason ? "cpu idle-wait end" : "cpu token-wait end", DT_s(time).count() * 1e3);
+  s_cpu_wait_ns[reason & 1].fetch_add(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(time).count(), std::memory_order_relaxed);
+}
+
+void CountGpuWork(std::chrono::steady_clock::duration time)
+{
+  s_gpu_work_ns.fetch_add(std::chrono::duration_cast<std::chrono::nanoseconds>(time).count(),
+                          std::memory_order_relaxed);
+}
+
+static void Log(const char* format, ...);
+static void Timeline(const char* what, double ms)
+{
+  Log("[interp-timeline] %8.2f %s %.2f\n", DT_s(Clock::now() - s_timeline_zero).count() * 1e3,
+      what, ms);
+}
+
+// Statistics go to stderr, and on Android (no console) to logcat as well.
+static void Log(const char* format, ...)
+{
+  va_list args;
+  va_start(args, format);
+#ifdef ANDROID
+  va_list copy;
+  va_copy(copy, args);
+  __android_log_vprint(ANDROID_LOG_INFO, "FrameInterpolation", format, copy);
+  va_end(copy);
+#endif
+  std::vfprintf(stderr, format, args);
+  va_end(args);
+}
