+
+bool IsMatrixOrProjection(u32 address)
+{
+  return address < XFMEM_POSMATRICES_END ||
+         (address >= XFMEM_NORMALMATRICES && address < XFMEM_NORMALMATRICES_END) ||
+         (address >= XFMEM_POSTMATRICES && address < XFMEM_POSTMATRICES_END) ||
+         (address >= XFMEM_SETPROJECTION && address < XFMEM_SETPROJECTION + 6);
+}
+
+float ReadFloat(const u8* p)
+{
+  u32 word;
+  std::memcpy(&word, p, 4);
+  return std::bit_cast<float>(Common::swap32(word));
+}
+
+void WriteFloat(u8* p, float value)
+{
+  const u32 word = Common::swap32(std::bit_cast<u32>(value));
+  std::memcpy(p, &word, 4);
+}
+
+// Whether two loads of the same matrix are close enough to blend: a large jump means a camera cut
+// or a different object, which should snap rather than smear.
+bool Blendable(const Load& load, const u8* cur, const u8* prev)
+{
+  for (u32 i = 0; i < load.count; ++i)
+  {
+    const u32 address = load.address + i;
+    const float c = ReadFloat(cur + i * 4), p = ReadFloat(prev + i * 4);
+    if (!std::isfinite(c) || !std::isfinite(p))
+      return false;
+    const bool translation =
+        (address < XFMEM_POSMATRICES_END || (address >= XFMEM_POSTMATRICES &&
+                                             address < XFMEM_POSTMATRICES_END)) &&
+        (address & 3) == 3;
+    const float slack = translation ? 200.0f : 0.5f;
+    if (std::fabs(c - p) > 0.5f * std::max(std::fabs(c), std::fabs(p)) + slack)
+      return false;
+  }
+  return true;
+}
+
+// Whether a float vertex position jumps between frames: a coordinate moves more than half its value
+// and more than 50 units, or a tenth of the vertex's distance from the camera if that is more. The
+// positions are in view space, so turning the camera moves a coordinate near zero by a lot when the
+// vertex is far off to the side (a cliff beside the ship: z 99.6 -> 43.4 at x = -1790); without the
+// distance term, that snapped the cliff's texture groups while its other pieces moved halfway (cracks).
+bool VertexJumps(const u8* cur, const u8* prev, u32 count)
+{
+  float c[3] = {}, p[3] = {};
+  for (u32 k = 0; k < count; ++k)
+  {
+    c[k] = ReadFloat(cur + k * 4);
+    p[k] = ReadFloat(prev + k * 4);
+    if (!std::isfinite(c[k]) || !std::isfinite(p[k]))
+      return true;
+  }
+  const float length = std::sqrt(std::max(c[0] * c[0] + c[1] * c[1] + c[2] * c[2],
+                                          p[0] * p[0] + p[1] * p[1] + p[2] * p[2]));
+  const float slack = std::max(50.0f, 0.1f * length);
+  for (u32 k = 0; k < count; ++k)
+  {
+    if (std::fabs(c[k] - p[k]) > std::max(0.5f * std::max(std::fabs(c[k]), std::fabs(p[k])), slack))
+      return true;
+  }
+  return false;
+}
+
+// Pairs two lists of alike items, n_cur in this frame and n_prev in the previous one, allowing for
+// items that appear or go: when one of many alike items (cloud strips, say) is dropped, pairing the
+// n-th with the n-th would put every later one halfway to its neighbour. The lists are aligned
+// (dynamic programming in a band around the diagonal) by distance(i, j); pair(i, j) is called for
+// each pair. Returns how many items were left without a partner.
+template <typename Distance, typename PairFn>
+int Align(int n_cur, int n_prev, const Distance& distance, const PairFn& pair)
+{
+  if (n_cur == 1 && n_prev == 1)
+  {
+    pair(0, 0);
+    return 0;
+  }
+  const int band = std::abs(n_cur - n_prev) + 3;
+  const int width = 2 * band + 1;
+  // A kind whose count changes by hundreds (particles) would make the table huge: pair those in
+  // order.
+  if (static_cast<s64>(n_cur + 1) * width > 200000)
+  {
+    for (int i = 0; i < std::min(n_cur, n_prev); ++i)
+      pair(i, i);
+    return std::abs(n_cur - n_prev);
+  }
+  static std::vector<float> cost_table, typical;
+  static std::vector<u8> move_table;
+  // A gap costs a few times the typical motion of an item, so unpaired items only win over a
+  // pairing that is clearly wrong.
+  typical.clear();
+  for (int i = 0; i < n_cur; ++i)
+  {
+    float nearest = 1e30f;
+    for (int j = std::max(0, i - 1); j <= std::min(n_prev - 1, i + 1); ++j)
+      nearest = std::min(nearest, distance(i, j));
+    typical.push_back(nearest);
+  }
+  std::nth_element(typical.begin(), typical.begin() + typical.size() / 2, typical.end());
+  const float gap = std::max(4.0f * typical[typical.size() / 2], 1.0f);
+  // cost_table[i][d]: best cost with i current and j = i + d - band previous items used.
+  cost_table.assign(static_cast<size_t>(n_cur + 1) * width, 1e30f);
+  move_table.assign(static_cast<size_t>(n_cur + 1) * width, 0);
+  const auto at = [&](int i, int j) -> int {
+    const int d = j - i + band;
+    return (d < 0 || d >= width || j < 0 || j > n_prev) ? -1 : i * width + d;
+  };
+  cost_table[at(0, 0)] = 0.0f;
+  for (int i = 0; i <= n_cur; ++i)
+  {
+    for (int j = std::max(0, i - band); j <= std::min(n_prev, i + band); ++j)
+    {
+      const int here = at(i, j);
+      if (here < 0 || (i == 0 && j == 0))
+        continue;
+      float best = 1e30f;
+      u8 move = 0;
+      if (i > 0 && j > 0 && at(i - 1, j - 1) >= 0)
+      {
+        const float c = cost_table[at(i - 1, j - 1)] + distance(i - 1, j - 1);
+        if (c < best)
+          best = c, move = 1;  // pair
+      }
+      if (i > 0 && at(i - 1, j) >= 0)
+      {
+        const float c = cost_table[at(i - 1, j)] + gap;
+        if (c < best)
+          best = c, move = 2;  // a new item
+      }
+      if (j > 0 && at(i, j - 1) >= 0)
+      {
+        const float c = cost_table[at(i, j - 1)] + gap;
+        if (c < best)
+          best = c, move = 3;  // an item that went
+      }
+      cost_table[here] = best;
+      move_table[here] = move;
+    }
+  }
+  int i = n_cur, j = n_prev;
+  int unpaired = 0;
+  if (at(i, j) < 0)
+    return n_cur;  // outside the band: leave this kind unblended
+  // As many items as before: in order, unless the alignment is far better (alike cloud strips
+  // scrolling by, one leaving at one end as another comes in). Motion faster than the items'
+  // spacing makes a neighbour's old position look closer, and the alignment then paired items
+  // with neighbours for little gain (the battle-entry shatter's spinning strips got seams).
+  if (n_cur == n_prev)
+  {
+    float in_order = 0.0f;
+    for (int k = 0; k < n_cur; ++k)
+      in_order += distance(k, k);
+    if (!(cost_table[at(i, j)] < 0.5f * in_order))
+    {
+      for (int k = 0; k < n_cur; ++k)
+        pair(k, k);
+      return 0;
+    }
+  }
+  while (i > 0 || j > 0)
+  {
+    const u8 move = move_table[at(i, j)];
+    if (move == 1)
+    {
+      pair(i - 1, j - 1);
+      --i, --j;
+    }
+    else if (move == 2)
+    {
+      --i, ++unpaired;
+    }
+    else if (move == 3)
+    {
+      --j, ++unpaired;
+    }
+    else
+    {
+      break;
+    }
+  }
+  return unpaired;
+}
+
+// Writes the halfway matrices into a copy of the current stream. Returns false when too few loads
+// have a partner in the previous frame to be worth it (a scene change).
+bool BuildBlendedStream(std::vector<u8>* out)
+{
+  // This runs for every frame, over thousands of loads and draws: both frames' loads and draws are
+  // matched by merging their sorted orders, with buffers kept from frame to frame.
+  Sort(s_previous);
+  Sort(s_current);
+  s_trace_big_loads = 0;
+  s_trace_pos_moved = 0;
+
+  static const float t = [] {
+    const char* env = std::getenv("RECOMP_FRAME_INTERPOLATION_T");
+    return env ? static_cast<float>(std::atof(env)) : 0.5f;
+  }();
+  *out = s_current.stream;
+  size_t paired = 0;
+  s_stat_loads += s_current.loads.size();
+  const auto blend_load = [&](const Load& load, const Load& match) {
+    ++s_stat_found;
+    const u8* cur = s_current.stream.data() + load.data_offset;
+    const u8* prev = s_previous.stream.data() + match.data_offset;
+    if (!Blendable(load, cur, prev))
+      return;
+    if (Tracing())
+    {
+      float worst = 0.0f;
+      for (u32 i = 0; i < load.count; ++i)
+      {
+        if (load.address + i >= XFMEM_SETPROJECTION + 6)
+          continue;
+        const float c = ReadFloat(cur + i * 4), p = ReadFloat(prev + i * 4);
+        worst = std::max(worst,
+                         std::fabs(c - p) / std::max(std::max(std::fabs(c), std::fabs(p)), 1e-6f));
+      }
+      if (worst > 0.2f && s_trace_big_loads++ < 12)
+      {
+        Log( "[interp-trace]   load %03x+%u changes %.0f%%:", load.address,
+                     load.count, worst * 100.0f);
+        for (u32 i = 0; i < std::min<u32>(load.count, 12); ++i)
+          Log( " %g/%g", ReadFloat(prev + i * 4), ReadFloat(cur + i * 4));
+        Log( "\n");
+      }
+    }
+    ++paired;
+    ++s_stat_blended;
+    if (std::memcmp(cur, prev, load.count * 4) != 0)
+      ++s_stat_changed;
+    for (u32 i = 0; i < load.count; ++i)
+    {
+      // The projection type (the word after the six parameters) isn't a float.
+      if (load.address + i >= XFMEM_SETPROJECTION + 6)
+        continue;
+      const float c = ReadFloat(cur + i * 4), p = ReadFloat(prev + i * 4);
+      WriteFloat(out->data() + load.data_offset + i * 4, p + (c - p) * t);
+    }
+  };
+  // Loads of a kind (address, count and the next draw's key) are aligned like draws (Align): when
+  // the game culls one of many alike objects (cloud strips while turning), pairing them by
+  // occurrence put every later object's matrix halfway to its neighbour's (stray bands).
+  {
+    static std::vector<const Load*> cur_loads, prev_loads;
+    const auto kind = [](const Load& l) { return std::make_tuple(l.address, l.count, l.key); };
+    const std::vector<u32>& cur_lo = s_current.load_order;
+    const std::vector<u32>& prev_lo = s_previous.load_order;
+    size_t la = 0, lb = 0;
+    while (la < cur_lo.size() && lb < prev_lo.size())
+    {
+      const auto k = kind(s_current.loads[cur_lo[la]]);
+      const auto pk = kind(s_previous.loads[prev_lo[lb]]);
+      if (k != pk)
+      {
+        if (k < pk)
+          ++la;
+        else
+          ++lb;
+        continue;
+      }
+      cur_loads.clear();
+      prev_loads.clear();
+      for (; la < cur_lo.size() && kind(s_current.loads[cur_lo[la]]) == k; ++la)
+        cur_loads.push_back(&s_current.loads[cur_lo[la]]);
+      for (; lb < prev_lo.size() && kind(s_previous.loads[prev_lo[lb]]) == k; ++lb)
+        prev_loads.push_back(&s_previous.loads[prev_lo[lb]]);
+      // The projection type word isn't a float: compare the six parameters only.
+      const u32 address = std::get<0>(k);
+      u32 words = cur_loads[0]->count;
+      if (address <= XFMEM_SETPROJECTION + 6 && address + words > XFMEM_SETPROJECTION + 6)
+        words = XFMEM_SETPROJECTION + 6 - address;
+      const auto distance = [&](int i, int j) {
+        const u8* c = s_current.stream.data() + cur_loads[i]->data_offset;
+        const u8* p = s_previous.stream.data() + prev_loads[j]->data_offset;
+        float sum = 0.0f;
+        for (u32 w = 0; w < words; ++w)
+          sum += std::fabs(ReadFloat(c + w * 4) - ReadFloat(p + w * 4));
+        return std::isfinite(sum) ? sum : 1e30f;
+      };
+      const int n_cur = static_cast<int>(cur_loads.size());
+      const int n_prev = static_cast<int>(prev_loads.size());
+      const int unpaired = Align(n_cur, n_prev, distance,
+                                 [&](int i, int j) { blend_load(*cur_loads[i], *prev_loads[j]); });
+      if (Tracing() && (unpaired != 0 || n_cur != n_prev))
+      {
+        Log(
+                     "[interp-trace]   loads %03x+%u key %016llx: %d, previous %d, %d left unpaired\n",
+                     std::get<0>(k), std::get<1>(k), static_cast<unsigned long long>(std::get<2>(k)),
+                     n_cur, n_prev, unpaired);
+      }
+    }
+  }
+
+  // Draws with the same key are aligned (Align) by the distance between their first vertices; a
+  // draw left without a partner is drawn as it is.
+  // partner[i]: the previous frame's draw for s_current.prims[i].
+  static std::vector<const Prim*> partner;
+  partner.assign(s_current.prims.size(), nullptr);
+  const auto set_partner = [&](const Prim* cur, const Prim* prev) {
+    partner[static_cast<size_t>(cur - s_current.prims.data())] = prev;
+  };
+  static std::vector<const Prim*> cur_list, prev_list;
+  static std::vector<std::array<float, 3>> cur_first, prev_first;
+  const std::vector<u32>& cur_order = s_current.prim_order;
+  const std::vector<u32>& prev_order = s_previous.prim_order;
+  size_t a = 0, b = 0;
+  while (a < cur_order.size() && b < prev_order.size())
+  {
+    // The next key both frames draw.
+    const u64 key = s_current.prims[cur_order[a]].key;
+    const u64 prev_key = s_previous.prims[prev_order[b]].key;
+    if (key != prev_key)
+    {
+      if (key < prev_key)
+        ++a;
+      else
+        ++b;
+      continue;
+    }
+    cur_list.clear();
+    prev_list.clear();
+    for (; a < cur_order.size() && s_current.prims[cur_order[a]].key == key; ++a)
+      cur_list.push_back(&s_current.prims[cur_order[a]]);
+    for (; b < prev_order.size() && s_previous.prims[prev_order[b]].key == key; ++b)
+      prev_list.push_back(&s_previous.prims[prev_order[b]]);
+    const int n_cur = static_cast<int>(cur_list.size()), n_prev = static_cast<int>(prev_list.size());
+    if (cur_list[0]->pos_format != static_cast<u8>(ComponentFormat::Float) ||
+        (n_cur == 1 && n_prev == 1))
+    {
+      for (int i = 0; i < std::min(n_cur, n_prev); ++i)
+        set_partner(cur_list[i], prev_list[i]);
+      continue;
+    }
+    // First vertex of each draw, decoded once.
+    const auto first_vertices = [](const Frame& frame, const std::vector<const Prim*>& list,
+                                   std::vector<std::array<float, 3>>* firsts) {
+      firsts->resize(list.size());
+      for (size_t i = 0; i < list.size(); ++i)
+      {
+        const u8* p = frame.stream.data() + list[i]->data_offset + list[i]->pos_offset;
+        std::array<float, 3>& f = (*firsts)[i];
+        f = {0.0f, 0.0f, 0.0f};
+        for (u32 k = 0; k < list[i]->pos_count; ++k)
+          f[k] = ReadFloat(p + k * 4);
+      }
+    };
+    first_vertices(s_current, cur_list, &cur_first);
+    first_vertices(s_previous, prev_list, &prev_first);
+    const auto distance = [&](int i, int j) {
+      const float sum = std::fabs(cur_first[i][0] - prev_first[j][0]) +
+                        std::fabs(cur_first[i][1] - prev_first[j][1]) +
+                        std::fabs(cur_first[i][2] - prev_first[j][2]);
+      return std::isfinite(sum) ? sum : 1e30f;
+    };
+    const int unpaired = Align(n_cur, n_prev, distance,
+                               [&](int i, int j) { set_partner(cur_list[i], prev_list[j]); });
+    if (Tracing() && (unpaired != 0 || n_cur != n_prev))
+      Log( "[interp-trace]   key %016llx: %d draws, previous %d, %d left unpaired\n",
+                   static_cast<unsigned long long>(key), n_cur, n_prev, unpaired);
+  }
+  // Which paired draws jump (VertexJumps: a coordinate moves more than half its value and more than
+  // 50 units or a tenth of the vertex's distance; with the two added, a full-screen quad Skies moves from z = 100 to 0.001 after a menu passed, and
+  // halfway it covered the scene). When one draw jumps, every draw with the same texture snaps
+  // rather than smears: deciding per draw (or per vertex, or per key) tore objects made of many
+  // draws apart (the battle-entry shatter spins the copied screen away as a card of strips, edge
+  // strips of another size; some snapped while the others moved halfway).
+  static std::vector<u8> jumps;
+  jumps.assign(s_current.prims.size(), 0);
+  static std::vector<std::pair<u64, std::pair<u32, u32>>> group_counts;  // texture -> paired, jumping
+  group_counts.clear();
+  for (size_t index = 0; index < s_current.prims.size(); ++index)
+  {
+    if (!partner[index])
+      continue;
+    const Prim& prim = s_current.prims[index];
+    const Prim& old = *partner[index];
+    if (prim.pos_format != static_cast<u8>(ComponentFormat::Float) ||
+        old.num_vertices != prim.num_vertices || old.vertex_size != prim.vertex_size ||
+        old.pos_offset != prim.pos_offset || old.pos_format != prim.pos_format ||
+        old.pos_count != prim.pos_count)
+    {
+      continue;
+    }
+    bool jump = false;
+    for (u32 v = 0; v < prim.num_vertices && !jump; ++v)
+    {
+      const u32 at = v * prim.vertex_size + prim.pos_offset;
+      const u8* cur = s_current.stream.data() + prim.data_offset + at;
+      const u8* prev = s_previous.stream.data() + old.data_offset + at;
+      jump = VertexJumps(cur, prev, prim.pos_count);
+    }
+    jumps[index] = jump ? 1 : 0;
+    if (group_counts.empty() || group_counts.back().first != prim.texture)
+    {
+      auto it = std::find_if(group_counts.begin(), group_counts.end(),
+                             [&](const auto& g) { return g.first == prim.texture; });
+      if (it == group_counts.end())
+      {
+        group_counts.push_back({prim.texture, {0, 0}});
+      }
+      else
+      {
+        std::swap(*it, group_counts.back());
+      }
+    }
+    group_counts.back().second.first += 1;
+    group_counts.back().second.second += jump ? 1 : 0;
+  }
+  std::sort(group_counts.begin(), group_counts.end());
+  if (Tracing())
+  {
+    // Why draws are drawn as they are (not blended): no partner, or a jump that snaps their group.
+    u32 lone = 0, lone_verts = 0, traced = 0;
+    for (size_t index = 0; index < s_current.prims.size(); ++index)
+    {
+      const Prim& prim = s_current.prims[index];
+      if (partner[index] || prim.pos_format != static_cast<u8>(ComponentFormat::Float))
+        continue;
+      ++lone;
+      lone_verts += prim.num_vertices;
+      if (traced++ < 8)
+      {
+        const u8* p = s_current.stream.data() + prim.data_offset + prim.pos_offset;
+        Log( "[interp-trace]   lone draw %zu key %016llx tex %06x %u verts: %g,%g,%g\n",
+                     index, static_cast<unsigned long long>(prim.key), prim.texture,
+                     prim.num_vertices, ReadFloat(p), ReadFloat(p + 4),
+                     prim.pos_count > 2 ? ReadFloat(p + 8) : 0.0f);
+      }
+    }
+    if (lone != 0)
+      Log( "[interp-trace]   %u draws (%u vertices) without a partner\n", lone, lone_verts);
+    for (const auto& g : group_counts)
+    {
+      if (g.second.second == 0)
+        continue;
+      Log( "[interp-trace]   group tex %06llx snaps: %u of %u draws jump\n",
+                   static_cast<unsigned long long>(g.first), g.second.second, g.second.first);
+    }
+    u32 shown = 0;
+    for (size_t index = 0; index < s_current.prims.size() && shown < 6; ++index)
+    {
+      if (!jumps[index])
+        continue;
+      const Prim& prim = s_current.prims[index];
+      const Prim& old = *partner[index];
+      for (u32 v = 0; v < prim.num_vertices; ++v)
+      {
+        const u32 at = v * prim.vertex_size + prim.pos_offset;
+        const u8* cur = s_current.stream.data() + prim.data_offset + at;
+        const u8* prev = s_previous.stream.data() + old.data_offset + at;
+        if (!VertexJumps(cur, prev, prim.pos_count))
+          continue;
+        Log(
+                     "[interp-trace]   jump draw %zu tex %06x vertex %u/%u: %g,%g,%g -> %g,%g,%g\n",
+                     index, prim.texture, v, prim.num_vertices, ReadFloat(prev), ReadFloat(prev + 4),
+                     prim.pos_count > 2 ? ReadFloat(prev + 8) : 0.0f, ReadFloat(cur),
+                     ReadFloat(cur + 4), prim.pos_count > 2 ? ReadFloat(cur + 8) : 0.0f);
+        ++shown;
+        break;
+      }
+    }
+  }
+  const auto group_snaps = [&](u64 key) {
+    const auto it = std::lower_bound(group_counts.begin(), group_counts.end(),
+                                     std::make_pair(key, std::make_pair(0u, 0u)));
+    return it != group_counts.end() && it->first == key && it->second.second != 0;
+  };
+  for (size_t index = 0; index < s_current.prims.size(); ++index)
+  {
+    if (!partner[index])
+      continue;
+    const Prim& prim = s_current.prims[index];
+    const Prim& old = *partner[index];
+    if (old.num_vertices != prim.num_vertices || old.vertex_size != prim.vertex_size ||
+        old.pos_offset != prim.pos_offset || old.pos_format != prim.pos_format ||
+        old.pos_count != prim.pos_count)
+    {
+      continue;
+    }
+    if (jumps[index] || group_snaps(prim.texture))
+      continue;
+    ++paired;
+    ++s_stat_prims_blended;
+    for (u32 v = 0; v < prim.num_vertices; ++v)
+    {
+      const u32 at = v * prim.vertex_size + prim.pos_offset;
+      const u8* cur = s_current.stream.data() + prim.data_offset + at;
+      const u8* prev = s_previous.stream.data() + old.data_offset + at;
+      u8* dst = out->data() + prim.data_offset + at;
+      if (prim.pos_format == static_cast<u8>(ComponentFormat::Float))
+      {
+        float c[3], p[3];
+        for (u32 k = 0; k < prim.pos_count; ++k)
+        {
+          c[k] = ReadFloat(cur + k * 4);
+          p[k] = ReadFloat(prev + k * 4);
+        }
+        if (Tracing())
+        {
+          float worst = 0.0f;
+          for (u32 k = 0; k < prim.pos_count; ++k)
+            worst = std::max(worst, std::fabs(c[k] - p[k]));
+          s_trace_pos_moved += worst > 5.0f ? 1 : 0;
+          if (worst > 5.0f && s_trace_big_loads++ < 12)
+          {
+            Log( "[interp-trace]   draw key %016llx vertex %u: %g,%g,%g -> %g,%g,%g\n",
+                         static_cast<unsigned long long>(prim.key), v, p[0], p[1],
+                         prim.pos_count > 2 ? p[2] : 0.0f, c[0], c[1],
+                         prim.pos_count > 2 ? c[2] : 0.0f);
+          }
+        }
+        for (u32 k = 0; k < prim.pos_count; ++k)
+          WriteFloat(dst + k * 4, p[k] + (c[k] - p[k]) * t);
+      }
+      else if (prim.pos_format == static_cast<u8>(ComponentFormat::Short) ||
+               prim.pos_format == static_cast<u8>(ComponentFormat::UShort))
+      {
+        const bool is_signed = prim.pos_format == static_cast<u8>(ComponentFormat::Short);
+        for (u32 k = 0; k < prim.pos_count; ++k)
+        {
+          const u32 cu = (u32{cur[k * 2]} << 8) | cur[k * 2 + 1];
+          const u32 pu = (u32{prev[k * 2]} << 8) | prev[k * 2 + 1];
+          const float c = is_signed ? static_cast<s16>(cu) : static_cast<float>(cu);
+          const float pf = is_signed ? static_cast<s16>(pu) : static_cast<float>(pu);
+          const s32 value = static_cast<s32>(std::lround(pf + (c - pf) * t));
+          dst[k * 2] = static_cast<u8>(value >> 8);
+          dst[k * 2 + 1] = static_cast<u8>(value);
+        }
+      }
+      else
+      {
+        const bool is_signed = prim.pos_format == static_cast<u8>(ComponentFormat::Byte);
+        for (u32 k = 0; k < prim.pos_count; ++k)
+        {
+          const float c = is_signed ? static_cast<s8>(cur[k]) : static_cast<float>(cur[k]);
+          const float pf = is_signed ? static_cast<s8>(prev[k]) : static_cast<float>(prev[k]);
+          dst[k] = static_cast<u8>(static_cast<s32>(std::lround(pf + (c - pf) * t)));
+        }
+      }
+    }
+  }
+  const size_t total = s_current.loads.size() + s_current.prims.size();
+  if (Tracing())
+  {
+    Log(
+                 "[interp-trace]   blend: %zu of %zu loads+draws paired (%zu loads, %zu draws), "
+                 "%llu vertices moved > 5\n",
+                 paired, total, s_current.loads.size(), s_current.prims.size(),
+                 static_cast<unsigned long long>(s_trace_pos_moved));
+  }
+  return total != 0 && paired * 2 >= total;
+}
+
+// The GPU state the replay changes, saved with the same code as savestates.
+std::vector<u8> SaveState()
+{
+  auto& system = Core::System::GetInstance();
+  const auto do_state = [&](PointerWrap& p) {
+    p.Do(bpmem);
+    p.Do(g_main_cp_state);
+    p.Do(xfmem);
+    system.GetPixelShaderManager().DoState(p);
+    system.GetVertexShaderManager().DoState(p);
+    system.GetGeometryShaderManager().DoState(p);
+    system.GetXFStateManager().DoState(p);
+    TMEM::DoState(p);
+  };
+  u8* ptr = nullptr;
+  PointerWrap measure(&ptr, 0, PointerWrap::Mode::Measure);
+  do_state(measure);
+  std::vector<u8> buffer(reinterpret_cast<size_t>(ptr));
+  ptr = buffer.data();
+  PointerWrap write(&ptr, buffer.size(), PointerWrap::Mode::Write);
+  do_state(write);
+  return buffer;
+}
+
+void RestoreState(std::vector<u8>& buffer)
+{
+  auto& system = Core::System::GetInstance();
+  u8* ptr = buffer.data();
+  PointerWrap p(&ptr, buffer.size(), PointerWrap::Mode::Read);
+  p.Do(bpmem);
+  p.Do(g_main_cp_state);
+  p.Do(xfmem);
+  system.GetPixelShaderManager().DoState(p);
+  system.GetVertexShaderManager().DoState(p);
+  system.GetGeometryShaderManager().DoState(p);
+  system.GetXFStateManager().DoState(p);
+  TMEM::DoState(p);
+  CopyPreprocessCPStateFromMain();
+  BPReload();
+  VertexLoaderManager::MarkAllDirty();
+}
+
+Shown* FindShown(u64 frame)
+{
+  for (Shown& shown : s_shown)
+  {
+    if (shown.frame == frame)
+      return &shown;
+  }
+  return nullptr;
+}
