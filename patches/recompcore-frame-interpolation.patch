+// An XF load that sets matrices or the projection, and where its data sits in the stream.
+struct Load
+{
+  u32 data_offset;  // first data word in the recorded stream
+  u16 address;
+  u8 count;         // words
+  u64 key;          // the next draw's vertex format, count and texture, to tell objects apart
+  u32 occurrence;   // how many earlier loads in the frame had the same address, count and key
+};
+
+// A draw with its vertex positions in the stream. Ninja transforms vertices on the CPU, so the
+// positions (already in view space) carry both object and camera motion.
+struct Prim
+{
+  u32 data_offset;  // first vertex in the recorded stream
+  u16 num_vertices;
+  u16 vertex_size;
+  u8 pos_offset;    // within a vertex
+  u8 pos_format;    // ComponentFormat
+  u8 pos_count;     // 2 or 3
+  u64 key;
+  u32 occurrence;
+  u32 texture;      // texture unit 0's image address: draws of one object share it
+};
+
+// Vertex array data a draw reads by index, copied when it was drawn.
+struct ArrayCopy
+{
+  CPArray array;
+  u32 data_offset;  // in Frame::array_data
+  u32 lo;           // bytes from the array base to the first byte copied
+};
+
+// A cache entry held for the replay. EFB/XFB copies get the cache's content lock as well (as
+// Present does for the XFB it shows): without it the cache hands an invalidated pending copy's
+// texture back to its pool, or copies into the same entry again, while the replay still binds it
+// (green bands and garbage clouds on the Retroid). Other textures aren't locked: the cache never
+// changes their contents in place except by partial updates, which refuse locked entries.
+class HeldTexture
+{
+public:
+  explicit HeldTexture(RcTcacheEntry entry) : m_entry(std::move(entry))
+  {
+    if (m_entry && m_entry->IsCopy())
+    {
+      m_entry->AcquireContentLock();
+      m_locked = true;
+    }
+  }
+  HeldTexture(HeldTexture&& other) noexcept
+      : m_entry(std::move(other.m_entry)), m_locked(std::exchange(other.m_locked, false))
+  {
+  }
+  HeldTexture& operator=(HeldTexture&& other) noexcept
+  {
+    if (this != &other)
+    {
+      Release();
+      m_entry = std::move(other.m_entry);
+      m_locked = std::exchange(other.m_locked, false);
+    }
+    return *this;
+  }
+  HeldTexture(const HeldTexture&) = delete;
+  HeldTexture& operator=(const HeldTexture&) = delete;
+  ~HeldTexture() { Release(); }
+
+  const RcTcacheEntry& Get() const { return m_entry; }
+
+private:
+  void Release()
+  {
+    if (m_locked && m_entry)
+      m_entry->ReleaseContentLock();
+    m_locked = false;
+  }
+
+  RcTcacheEntry m_entry;
+  bool m_locked = false;
+};
+
+// A texture the frame's draws bound, and the cache entry they got: the replay runs later (a frame
+// later in dual core, in slices), when the game may have written other data over that memory.
+struct TextureUse
+{
+  u32 address;
+  u32 format;
+  u32 width, height;
+  HeldTexture entry;
+};
+
+struct Frame
+{
+  std::vector<u8> stream;
+  std::vector<Load> loads;
+  std::vector<Prim> prims;
+  // The vertex array data the draws read by index: the replay runs later (a frame later in dual
+  // core), when the game may have reused that memory. Draw k's copies are
+  // array_copies[arrays_begin[k]] up to array_copies[arrays_begin[k + 1]].
+  std::vector<u8> array_data;
+  std::vector<ArrayCopy> array_copies;
+  std::vector<u32> arrays_begin;
+  std::vector<TextureUse> textures;  // in the order the draws bound them
+  // Snapshots of entries the cache pieced together from EFB copies, by the entry they copy (held,
+  // so its address can't be reused for another entry meanwhile).
+  std::vector<std::pair<RcTcacheEntry, RcTcacheEntry>> snapshots;
+  // Loads by address, count, key and occurrence, and draws by key (then draw order), as indices:
+  // sorted once, the current frame's order serves again when it becomes the previous frame.
+  std::vector<u32> load_order, prim_order;
+  bool sorted = false;
+
+  void Clear()
+  {
+    stream.clear();
+    loads.clear();
+    prims.clear();
+    array_data.clear();
+    array_copies.clear();
+    arrays_begin.clear();
+    textures.clear();
+    snapshots.clear();
+    load_order.clear();
+    prim_order.clear();
+    sorted = false;
+  }
+};
+
+auto LoadTuple(const Load& load)
+{
+  return std::make_tuple(load.address, load.count, load.key, load.occurrence);
+}
+
+void Sort(Frame& frame)
+{
+  if (frame.sorted)
+    return;
+  frame.load_order.resize(frame.loads.size());
+  for (u32 i = 0; i < frame.load_order.size(); ++i)
+    frame.load_order[i] = i;
+  std::sort(frame.load_order.begin(), frame.load_order.end(), [&](u32 a, u32 b) {
+    return LoadTuple(frame.loads[a]) < LoadTuple(frame.loads[b]);
+  });
+  frame.prim_order.resize(frame.prims.size());
+  for (u32 i = 0; i < frame.prim_order.size(); ++i)
+    frame.prim_order[i] = i;
+  std::sort(frame.prim_order.begin(), frame.prim_order.end(), [&](u32 a, u32 b) {
+    const u64 ka = frame.prims[a].key, kb = frame.prims[b].key;
+    return ka != kb ? ka < kb : a < b;
+  });
+  frame.sorted = true;
+}
