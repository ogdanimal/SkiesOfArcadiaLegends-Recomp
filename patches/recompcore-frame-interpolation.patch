+// Interpolation only where it fits. In single-core mode the replay runs on the emulation thread,
+// so a frame whose game work plus replay doesn't fit its real-time budget would slow the game
+// down. Each frame measures the thread's work (wall time minus throttle sleep, without the
+// replay) and the replay's cost; the replay is skipped while the two together don't fit, and
+// switched back on once they have fit with room to spare for a while. Off with
+// RECOMP_FRAME_INTERPOLATION_ADAPTIVE=0 (always interpolate, to measure the full cost).
+bool Tracing();
+
+struct Budget
+{
+  bool have_last = false;
+  Clock::time_point last_time;
+  DT last_sleep{};
+  u64 last_ticks = 0;
+  double last_replay = 0.0;  // seconds the previous frame's replay took
+  double replay = 0.0;       // recent replay cost
+  double work = 0.0;         // recent game work per frame
+  double budget = 0.0;       // real time the last frame had
+  bool on = true;
+  u32 fitting = 0;  // frames in a row that would have fit while off
+};
+Budget s_budget;
+u64 s_stat_skipped = 0;
+u64 s_trace_indexed_prims = 0;
+u64 s_trace_big_loads = 0;  // loads traced in this blend
+u64 s_trace_pos_moved = 0;  // blended vertices that moved more than 5 units  // this frame's draws with an indexed attribute (trace)
+double s_stat_work = 0.0, s_stat_replay = 0.0, s_stat_budget = 0.0, s_stat_replay_reported = 0.0;
+u64 s_stat_budget_frames = 0;
+// Replay cost by part: pairing and blending ([0]), the replay's slices with their EFB and state
+// switches ([2]).
+double s_stat_parts[4] = {};
+
+bool Adaptive()
+{
+  static const bool on = [] {
+    const char* env = std::getenv("RECOMP_FRAME_INTERPOLATION_ADAPTIVE");
+    return !env || env[0] != '0';
+  }();
+  return on;
+}
+
+// Measures the frame that just ended and decides whether to replay it.
+bool ReplayFits()
+{
+  auto& system = Core::System::GetInstance();
+  // Dual core always replays; the timing below is the CPU thread's, not this (GPU) thread's to read
+  if (system.IsDualCoreMode())
+    return true;
+  Budget& b = s_budget;
+  const Clock::time_point now = Clock::now();
+  const DT sleep = system.GetPerfMetrics().GetTimeSleeping();
+  const u64 ticks = system.GetCoreTiming().GetTicks();
+  const bool had_last = b.have_last;
+  const Budget previous = b;
+  b.have_last = true;
+  b.last_time = now;
+  b.last_sleep = sleep;
+  b.last_ticks = ticks;
+  b.last_replay = 0.0;
+  if (!Adaptive())
+    return true;
+  const float speed = Config::Get(Config::MAIN_EMULATION_SPEED);
+  if (speed <= 0.0f || Core::GetIsThrottlerTempDisabled())
+    return true;  // no frame limit: any frame rate is full speed
+  if (!had_last || sleep < previous.last_sleep || ticks <= previous.last_ticks)
+    return b.on;  // first frame, or the metrics were reset (state load, pause)
+  const double wall = DT_s(now - previous.last_time).count();
+  const double slept = DT_s(sleep - previous.last_sleep).count();
+  const double work = std::max(wall - slept - previous.last_replay, 0.0);
+  const double budget =
+      static_cast<double>(ticks - previous.last_ticks) / system.GetSystemTimers().GetTicksPerSecond() /
+      speed;
+  if (budget > 0.25)
+    return b.on;  // a long gap (loading, a pause): says nothing about the scene
+  b.budget = budget;
+  // Averaged over about ten frames: the throttle catches up after a single slow frame, so only
+  // a scene that stays slow should turn interpolation off.
+  b.work = b.work == 0.0 ? work : b.work * 0.9 + work * 0.1;
+  const double need = b.work + b.replay;
+  if (b.on && need > 0.95 * budget)
+  {
+    b.on = false;
+    b.fitting = 0;
+  }
+  else if (!b.on)
+  {
+    // Back on only after a second that would have fit with room, so a scene at the edge doesn't
+    // switch every frame.
+    b.fitting = need < 0.88 * budget ? b.fitting + 1 : 0;
+    if (b.fitting >= 30)
+      b.on = true;
+  }
+  s_stat_work += work;
+  s_stat_budget += budget;
+  ++s_stat_budget_frames;
+  if (Tracing())
+  {
+    Log(
+                 "[interp-trace]   budget %.2f ms, work %.2f (recent %.2f), replay %.2f, %s\n",
+                 budget * 1e3, work * 1e3, b.work * 1e3, b.replay * 1e3, b.on ? "on" : "off");
+  }
+  return b.on;
+}
+
+void CountReplay(double seconds)
+{
+  s_budget.last_replay = seconds;
+  s_budget.replay = s_budget.replay == 0.0 ? seconds : s_budget.replay * 0.8 + seconds * 0.2;
+  s_stat_replay += seconds;
+}
