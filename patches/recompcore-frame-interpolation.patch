+
+void OnXF(u16 address, u8 count)
+{
+  if (!s_recording)
+    return;
+  // An XF write covers registers address..address+count-1.
+  bool relevant = false;
+  for (u32 i = 0; i < count && !relevant; ++i)
+    relevant = IsMatrixOrProjection(address + i);
+  if (!relevant)
+    return;
+  // OnXF comes before OnCommand appends the command: the data follows the 5-byte header.
+  s_unkeyed.push_back(s_current.loads.size());
+  s_current.loads.push_back(
+      Load{static_cast<u32>(s_current.stream.size() + 5), address, count, 0, 0});
+}
+
+void OnIndexedLoad(CPArray array, u32 index, u16 address, u8 size)
+{
+  if (!s_recording)
+    return;
+  ++s_stat_indexed_loads;
+  // The replay would read the matrix from RAM again, which by then holds the next frame's. Record
+  // it as an immediate XF load of the values read now instead, which can also be blended.
+  auto& memory = Core::System::GetInstance().GetMemory();
+  const u32 bytes = size * 4u;
+  const u8* data = memory.GetPointerForRange(
+      g_main_cp_state.array_bases[array] + g_main_cp_state.array_strides[array] * index, bytes);
+  if (!data)
+    return;  // record the indexed command as it is
+  const u32 header = Common::swap32((static_cast<u32>(size - 1) << 16) | address);
+  OnXF(address, size);  // registers the load at the current end of the stream
+  s_current.stream.push_back(static_cast<u8>(OpcodeDecoder::Opcode::GX_LOAD_XF_REG));
+  const u8* header_bytes = reinterpret_cast<const u8*>(&header);
+  s_current.stream.insert(s_current.stream.end(), header_bytes, header_bytes + 4);
+  s_current.stream.insert(s_current.stream.end(), data, data + bytes);  // already big-endian
+  s_skip_command = true;
+}
+
+// Copies the vertex array data this draw reads by index (see Frame::array_data).
+static void RecordArrays(u8 vat, u16 num_vertices, const u8* vertex_data, u32 size)
+{
+  Frame& frame = s_current;
+  if (frame.arrays_begin.empty())
+    frame.arrays_begin.push_back(0);
+  struct Indexed
+  {
+    CPArray array;
+    u32 offset;      // of the index within a vertex
+    u8 index_size;   // 1 or 2
+    u8 count;        // indices per vertex (3 for separately indexed normal, binormal, tangent)
+    u32 span;        // bytes one index reads
+  };
+  std::array<Indexed, 12> indexed;
+  size_t n = 0;
+  const TVtxDesc& desc = g_main_cp_state.vtx_desc;
+  const VAT& vtx = g_main_cp_state.vtx_attr[vat];
+  u32 offset = (desc.low.PosMatIdx ? 1 : 0);
+  for (u32 i = 0; i < 8; ++i)
+    offset += desc.low.TexMatIdx[i] ? 1 : 0;
+  const auto add = [&](CPArray array, VertexComponentFormat type, u32 bytes, u32 span, u8 count) {
+    if (IsIndexed(type))
+    {
+      indexed[n++] = Indexed{array, offset,
+                             static_cast<u8>(type == VertexComponentFormat::Index16 ? 2 : 1), count,
+                             span};
+    }
+    offset += bytes;
+  };
+  using VCF = VertexComponentFormat;
+  add(CPArray::Position, desc.low.Position,
+      VertexLoader_Position::GetSize(desc.low.Position, vtx.g0.PosFormat, vtx.g0.PosElements),
+      VertexLoader_Position::GetSize(VCF::Direct, vtx.g0.PosFormat, vtx.g0.PosElements), 1);
+  const bool index3 =
+      vtx.g0.NormalIndex3 && vtx.g0.NormalElements == NormalComponentCount::NTB;
+  add(CPArray::Normal, desc.low.Normal,
+      VertexLoader_Normal::GetSize(desc.low.Normal, vtx.g0.NormalFormat, vtx.g0.NormalElements,
+                                   vtx.g0.NormalIndex3),
+      VertexLoader_Normal::GetSize(VCF::Direct, vtx.g0.NormalFormat, NormalComponentCount::NTB,
+                                   false),
+      index3 ? 3 : 1);
+  for (u32 i = 0; i < 2; ++i)
+  {
+    if (desc.low.Color[i] == VCF::NotPresent)
+      continue;
+    add(CPArray::Color0 + static_cast<u8>(i), desc.low.Color[i],
+        VertexLoader_Color::GetSize(desc.low.Color[i], vtx.GetColorFormat(i)),
+        VertexLoader_Color::GetSize(VCF::Direct, vtx.GetColorFormat(i)), 1);
+  }
+  for (u32 i = 0; i < 8; ++i)
+  {
+    add(CPArray::TexCoord0 + static_cast<u8>(i), desc.high.TexCoord[i],
+        VertexLoader_TextCoord::GetSize(desc.high.TexCoord[i], vtx.GetTexFormat(i),
+                                        vtx.GetTexElements(i)),
+        VertexLoader_TextCoord::GetSize(VCF::Direct, vtx.GetTexFormat(i), vtx.GetTexElements(i)),
+        1);
+  }
+  // A layout that doesn't add up means a format read differently here: leave the draw alone.
+  if (num_vertices != 0 && offset * num_vertices == size)
+  {
+    auto& memory = Core::System::GetInstance().GetMemory();
+    for (size_t c = 0; c < n; ++c)
+    {
+      const Indexed& item = indexed[c];
+      const u32 all_ones = item.index_size == 1 ? 0xFFu : 0xFFFFu;
+      u32 lo_index = all_ones, hi_index = 0;
+      bool skip_index = false;
+      for (u32 v = 0; v < num_vertices; ++v)
+      {
+        const u8* p = vertex_data + v * offset + item.offset;
+        for (u32 k = 0; k < item.count; ++k)
+        {
+          const u32 index = item.index_size == 1 ? p[k] : (u32{p[2 * k]} << 8) | p[2 * k + 1];
+          skip_index = skip_index || index == all_ones;
+          lo_index = std::min(lo_index, index);
+          hi_index = std::max(hi_index, index);
+        }
+      }
+      // The loader reads a skipped position too, outside any range worth copying: leave that
+      // array in RAM for this draw.
+      if (skip_index && item.array == CPArray::Position)
+        continue;
+      const u32 stride = g_main_cp_state.array_strides[item.array];
+      const u32 lo = lo_index * stride;
+      const u32 bytes = (hi_index - lo_index) * stride + item.span;
+      if (bytes > 1024 * 1024)
+        continue;
+      const u8* data =
+          memory.GetPointerForRange(g_main_cp_state.array_bases[item.array] + lo, bytes);
+      if (!data)
+        continue;
+      frame.array_copies.push_back(
+          ArrayCopy{item.array, static_cast<u32>(frame.array_data.size()), lo});
+      frame.array_data.insert(frame.array_data.end(), data, data + bytes);
+    }
+  }
+  frame.arrays_begin.push_back(static_cast<u32>(frame.array_copies.size()));
+}
+
+void OnPrimitive(u8 vat, u16 num_vertices, const u8* vertex_data, u32 size)
+{
+  if (!s_recording)
+    return;
+  RecordArrays(vat, num_vertices, vertex_data, size);
+  {
+    const u32 mode = static_cast<u32>(g_main_cp_state.vtx_desc.low.Position.Value());
+    ++s_stat_prims[mode & 3];
+    s_stat_verts[mode & 3] += num_vertices;
+  }
+  const auto& desc = g_main_cp_state.vtx_desc.low;
+  if (Tracing())
+  {
+    bool indexed = IsIndexed(desc.Position) || IsIndexed(desc.Normal) || IsIndexed(desc.Color0) ||
+                   IsIndexed(desc.Color1);
+    for (u32 i = 0; i < 8; ++i)
+      indexed = indexed || IsIndexed(g_main_cp_state.vtx_desc.high.TexCoord[i]);
+    if (indexed)
+      ++s_trace_indexed_prims;
+  }
+  if (desc.Position == VertexComponentFormat::Direct && num_vertices != 0)
+  {
+    const auto& g0 = g_main_cp_state.vtx_attr[vat].g0;
+    u8 pos_offset = desc.PosMatIdx ? 1 : 0;
+    for (u32 i = 0; i < 8; ++i)
+      pos_offset += desc.TexMatIdx[i] ? 1 : 0;
+    // The primitive command is the opcode and a 16-bit vertex count, then the vertices.
+    s_current.prims.push_back(Prim{
+        static_cast<u32>(s_current.stream.size() + 3), num_vertices,
+        static_cast<u16>(size / num_vertices), pos_offset, static_cast<u8>(g0.PosFormat.Value()),
+        static_cast<u8>(g0.PosElements == CoordComponentCount::XYZ ? 3 : 2),
+        (u64{vat} << 56) ^ (u64{num_vertices} << 32) ^ (u64{size} << 8) ^
+            (u64{bpmem.tex.GetUnit(0).texImage3.image_base} << 20),
+        0, bpmem.tex.GetUnit(0).texImage3.image_base});
+  }
+  if (s_unkeyed.empty())
+    return;
+  // Not the vertex data itself: CPU-skinned models change it every frame.
+  const u64 key = (u64{vat} << 56) ^ (u64{num_vertices} << 32) ^ (u64{size} << 8) ^
+                  (u64{bpmem.tex.GetUnit(0).texImage3.image_base} << 20);
+  for (size_t index : s_unkeyed)
+    s_current.loads[index].key = key;
+  s_unkeyed.clear();
+}
+
+static void EndFrame(u32 dest_address);
+
+// A frame's recording beyond this (no XFB copy ending it: a game drawing without one, or a long
+// load) is dropped and recording waits for the next frame end.
+constexpr std::size_t MAX_RECORDED_BYTES = 64u << 20;
+
+void OnCommand(const u8* data, u32 size)
+{
+  if (s_skip_command)
+    s_skip_command = false;
+  else if (s_recording)
+    s_current.stream.insert(s_current.stream.end(), data, data + size);
+  if (s_recording && s_current.stream.size() + s_current.array_data.size() > MAX_RECORDED_BYTES)
+  {
+    s_current.Clear();  // an empty frame is never replayed (EndFrame)
+    s_recording = false;
+  }
+  if (s_end_pending)
+  {
+    s_end_pending = false;
+    EndFrame(s_end_address);
+  }
+}
+
+void OnXFBCopy(u32 dest_address)
+{
+  s_end_pending = true;
+  s_end_address = dest_address;
+}
+
+// The replay of one frame, drawn on the spare EFB in slices (dual core) or at once.
+namespace
+{
+struct Job
+{
+  bool active = false;
+  bool blended = false;
+  bool started = false;
+  u64 frame = 0;
+  u32 address = 0, width = 0, height = 0, stride = 0;
+  std::vector<u8> stream;  // the blended stream
+  size_t position = 0;
+  u32 prim = 0;           // draws replayed so far
+  size_t texture = 0;     // where the next texture lookup starts in the frame's textures
+  std::vector<u8> state;  // the replay's video state between slices
+  std::vector<u8> start_state;  // the video state the frame started with
+  Clock::time_point start;
+  double blend_seconds = 0.0, replay_seconds = 0.0;
+};
+Job s_job;
+// The replay's own EFB copies (texture only: the game's RAM must not see them) and its XFB copy.
+std::vector<std::pair<u32, RcTcacheEntry>> s_replay_copies;
+RcTcacheEntry s_replay_xfb;
+// The video state where the frame being recorded started (taken at the previous frame's end).
+std::vector<u8> s_frame_start_state;
+}  // namespace
+static Frame s_ready;  // the frame the job will draw (s_current records the next one meanwhile)
+
+// Dual core: the replay is drawn on the GPU thread when it has nothing else to do, in slices, on a
+// second EFB, so the game's commands always come first and the CPU never waits for it. Games that
+// sync on the GPU (Skies polls a draw-sync token, and waits for draw-done before the retrace)
+// would otherwise wait for the whole replay. The pictures are then presented one retrace later
+// (previous real, in-between, real) to leave the replay time. RECOMP_FRAME_INTERPOLATION_DEFER=0
+// replays at once and presents as in single core.
+static bool Deferred()
+{
+  static const bool allowed = [] {
+    const char* env = std::getenv("RECOMP_FRAME_INTERPOLATION_DEFER");
+    if (env)
+      return env[0] != '0';
+    // Android has no environment: a file FrameInterpolation.nodefer in the user directory.
+    return !File::Exists(File::GetUserPath(D_USER_IDX) + "FrameInterpolation.nodefer");
+  }();
+  return allowed && Core::System::GetInstance().IsDualCoreMode();
+}
+
+// Bytes of the replay stream per slice: small enough that commands arriving meanwhile wait little,
+// large enough that switching EFB and state between slices doesn't dominate.
+static size_t SliceBytes()
+{
+  static const size_t bytes = [] {
+    const char* env = std::getenv("RECOMP_FRAME_INTERPOLATION_SLICE");
+    if (env)
+      return static_cast<size_t>(std::strtoull(env, nullptr, 10));
+    // Android: a file FrameInterpolation.slice in the user directory holding the byte count.
+    std::string spec;
+    if (File::ReadFileToString(File::GetUserPath(D_USER_IDX) + "FrameInterpolation.slice", spec))
+      return static_cast<size_t>(std::strtoull(spec.c_str(), nullptr, 10));
+    return size_t{96 * 1024};
+  }();
+  return bytes;
+}
+
+static void DumpPictures(const Shown& shown)
+{
+  // Debug: RECOMP_FRAME_INTERPOLATION_DUMP=<dir> saves the real and in-between pictures of
+  // frames 300-305 there, to check that the in-between ones fall between their neighbours.
+  // RECOMP_FRAME_INTERPOLATION_DUMP_FRAME moves the first one, _DUMP_COUNT sets how many.
+  // Android has no environment to set: a file FrameInterpolation.dump in the user directory
+  // holding "first count" dumps to InterpDump/ there.
+  static std::string dump_dir;
+  static u64 dump_first = 300, dump_count = 6;
+  static const bool dump_on = [] {
+    if (const char* env = std::getenv("RECOMP_FRAME_INTERPOLATION_DUMP"))
+    {
+      dump_dir = env;
+      if (const char* first = std::getenv("RECOMP_FRAME_INTERPOLATION_DUMP_FRAME"))
+        dump_first = std::strtoull(first, nullptr, 10);
+      if (const char* count = std::getenv("RECOMP_FRAME_INTERPOLATION_DUMP_COUNT"))
+        dump_count = std::strtoull(count, nullptr, 10);
+      return true;
+    }
+    const std::string user = File::GetUserPath(D_USER_IDX);
+    std::string spec;
+    if (!File::ReadFileToString(user + "FrameInterpolation.dump", spec))
+      return false;
+    unsigned long long first = 300, count = 6;
+    std::sscanf(spec.c_str(), "%llu %llu", &first, &count);
+    dump_first = first;
+    dump_count = count;
+    dump_dir = user + "InterpDump";
+    File::CreateDir(dump_dir);
+    return true;
+  }();
+  if (!dump_on || shown.frame < dump_first || shown.frame >= dump_first + dump_count)
+    return;
+  const std::string base = dump_dir + "/f" + std::to_string(shown.frame);
+  if (shown.interp && shown.interp->texture)
+    shown.interp->texture->Save(base + "-interp.png", 0);
+  if (shown.real && shown.real->texture)
+    shown.real->texture->Save(base + "-real.png", 0);
+}
+
+// The job's frame becomes the previous one, which the next frame is blended with.
+static void RotateReady()
+{
+  std::swap(s_previous, s_ready);
+  s_ready.Clear();
+}
+
+static void EndJob(bool drawn)
+{
+  if (Shown* shown = FindShown(s_job.frame))
+  {
+    shown->interp_due = false;
+    if (drawn && s_replay_xfb)
+    {
+      shown->interp = std::move(s_replay_xfb);
+      DumpPictures(*shown);
+    }
+  }
+  s_replay_xfb.reset();
+  s_replay_copies.clear();
+  s_job.active = false;
+}
+
+// Runs the job's next step: the blend, or a slice of the replay (all of it when `whole`). Returns
+// whether the job still has work.
+static bool RunJob(bool whole)
+{
+  if (!s_job.active)
+    return false;
+  if (!s_job.blended)
+  {
+    const Clock::time_point blend_start = Clock::now();
+    std::swap(s_current, s_ready);
+    const bool ok = BuildBlendedStream(&s_job.stream);
+    std::swap(s_current, s_ready);
+    RotateReady();
+    s_job.blend_seconds = DT_s(Clock::now() - blend_start).count();
+    s_stat_parts[0] += s_job.blend_seconds;
+    if (!ok)
+    {
+      EndJob(false);
+      return false;
+    }
+    s_job.blended = true;
+    s_job.position = 0;
+    s_job.prim = 0;
+    s_job.texture = 0;
+    s_job.started = false;
+    s_job.replay_seconds = 0.0;
+    if (s_timeline_on)
+      Timeline("gpu replay blended", s_job.blend_seconds * 1e3);
+    if (!whole)
+      return true;
+  }
+
+  const Clock::time_point slice_start = Clock::now();
+  g_vertex_manager->Flush();
+  // The game's texture bindings go with its state: the replay binds its own, and a slice can fall
+  // between the game's bind of a texture and a draw that samples it. Invalidating TMEM there made
+  // the draw look the texture up again from RAM, which the game may have overwritten by then
+  // (on the console the texture is in TMEM): the cloud sea below the Valuan ladder drawn as a
+  // dark garbage texture for one game frame, now and then, on the Retroid.
+  std::vector<u8> game_state = SaveState();
+  std::array<RcTcacheEntry, 8> game_bound = g_texture_cache->GetBoundTextures();
+  if (!g_framebuffer_manager->SwapEFB())
+  {
+    // No memory for the replay's EFB (a high resolution with MSAA on a phone GPU): the real
+    // pictures only, until the setting is changed again (and a smaller EFB may then fit)
+    Shutdown();
+    detail::s_enabled = 0;
+    Log("[interp] frame interpolation off: the second EFB can't be created\n");
+    OSD::AddMessage("60 fps is off: not enough graphics memory at this resolution", 10000);
+    return false;
+  }
+  // The first slice starts from the state the frame started with, not the game's state now: the
+  // game writes only registers that changed, so the stream leaves out what an earlier frame set
+  // (a projection, blending), and after a menu or a fade "now" is a different scene.
+  RestoreState(s_job.started ? s_job.state : s_job.start_state);
+  s_job.started = true;
+  TMEM::InvalidateAll();
+
+  const u8* const data = s_job.stream.data();
+  const u8* const end = data + s_job.stream.size();
+  const u8* const begin = data + s_job.position;
+  const u8* slice_end = whole ? end : std::min(end, begin + SliceBytes());
+  s_replaying = true;
+  const u8* stop =
+      OpcodeDecoder::RunFifo<false>(DataReader(const_cast<u8*>(begin), const_cast<u8*>(slice_end)),
+                                    nullptr);
+  if (stop == begin && slice_end != end)
+  {
+    // One command larger than a slice: give it the rest.
+    stop = OpcodeDecoder::RunFifo<false>(
+        DataReader(const_cast<u8*>(begin), const_cast<u8*>(end)), nullptr);
+  }
+  g_vertex_manager->Flush();
+  s_replaying = false;
+  s_job.position = static_cast<size_t>(stop - data);
+  const bool finished = s_job.position >= s_job.stream.size() || stop == begin;
+
+  if (!finished)
+    s_job.state = SaveState();
+  // Debug (paint test, 2026-10-10): FrameInterpolation.paintefb in the user directory paints the
+  // replay's EFB magenta once its picture is copied out, so a game copy reading the wrong EFB shows.
+  static const bool paint_efb =
+      File::Exists(File::GetUserPath(D_USER_IDX) + "FrameInterpolation.paintefb");
+  if (finished && paint_efb)
+  {
+    g_framebuffer_manager->ClearEFB(
+        MathUtil::Rectangle<int>(0, 0, g_framebuffer_manager->GetEFBWidth(),
+                                 g_framebuffer_manager->GetEFBHeight()),
+        true, true, false, 0xFFFF00FF, 0, bpmem.zcontrol.pixel_format);
+  }
+  // The spare exists now, so the swap back can't fail
+  g_framebuffer_manager->SwapEFB();
+  RestoreState(game_state);
+  g_texture_cache->SetBoundTextures(std::move(game_bound));
+  s_job.replay_seconds += DT_s(Clock::now() - slice_start).count();
+
+  if (!finished)
+    return true;
+  s_stat_parts[2] += s_job.replay_seconds;
+  CountReplay(s_job.blend_seconds + s_job.replay_seconds);
+  ++s_interpolated;
+  if (Tracing())
+    Log( "[interp-trace]   replayed frame %llu\n",
+                 static_cast<unsigned long long>(s_job.frame));
+  if (s_timeline_on)
+    Timeline("gpu replay end", s_job.replay_seconds * 1e3);
+  EndJob(true);
+  return false;
+}
+
+static void FinishJob()
+{
+  if (s_job.active && s_timeline_on)
+    Timeline("gpu replay finished synchronously");
+  while (RunJob(true))
+  {
+  }
+}
+
+static void PrintStatistics()
+{
+  Log(
+               "[interp] primitives by position mode (none/direct/idx8/idx16): %llu/%llu/%llu/%llu, "
+               "vertices %llu/%llu/%llu/%llu, indexed XF loads %llu, draws blended %llu\n",
+               (unsigned long long)s_stat_prims[0], (unsigned long long)s_stat_prims[1],
+               (unsigned long long)s_stat_prims[2], (unsigned long long)s_stat_prims[3],
+               (unsigned long long)s_stat_verts[0], (unsigned long long)s_stat_verts[1],
+               (unsigned long long)s_stat_verts[2], (unsigned long long)s_stat_verts[3],
+               (unsigned long long)s_stat_indexed_loads,
+               (unsigned long long)s_stat_prims_blended);
+  Log(
+               "[interp] %llu of %llu frames interpolated; matrix loads %llu, matched %llu, "
+               "blended %llu (changed %llu); stream %zu bytes, %zu loads; shown %llu in-between, "
+               "%llu real\n",
+               static_cast<unsigned long long>(s_interpolated),
+               static_cast<unsigned long long>(s_frames),
+               static_cast<unsigned long long>(s_stat_loads),
+               static_cast<unsigned long long>(s_stat_found),
+               static_cast<unsigned long long>(s_stat_blended),
+               static_cast<unsigned long long>(s_stat_changed), s_current.stream.size(),
+               s_current.loads.size(), static_cast<unsigned long long>(s_stat_interp_shown),
+               static_cast<unsigned long long>(s_stat_real_shown));
+  if (s_stat_budget_frames != 0)
+  {
+    Log(
+                 "[interp] per frame: budget %.2f ms, game work %.2f ms, replay %.2f ms (when "
+                 "run); skipped to keep full speed: %llu\n",
+                 s_stat_budget / s_stat_budget_frames * 1e3, s_stat_work / s_stat_budget_frames * 1e3,
+                 s_interpolated ? s_stat_replay / s_interpolated * 1e3 : 0.0,
+                 static_cast<unsigned long long>(s_stat_skipped));
+  }
+  if (s_interpolated != 0)
+  {
+    Log(
+                 "[interp] replay parts: blend %.2f ms, replay slices %.2f ms\n",
+                 s_stat_parts[0] / s_interpolated * 1e3, s_stat_parts[2] / s_interpolated * 1e3);
+  }
+  // Wall time per game frame and how it was spent, since the last report.
+  static Clock::time_point last_report = Clock::now();
+  static u64 last_frames = 0;
+  const Clock::time_point now = Clock::now();
+  const double frames = static_cast<double>(s_frames - last_frames);
+  if (frames > 0)
+  {
+    const double per_frame_ms = 1e3 / frames;
+    Log("[interp] per frame (last %.0f): wall %.2f ms; CPU waits for the GPU %.2f ms at "
+        "draw-sync reads, %.2f ms idling; GPU thread: FIFO work %.2f ms, in-between %.2f ms\n",
+        frames, DT_s(now - last_report).count() * per_frame_ms,
+        s_cpu_wait_ns[0].exchange(0) * 1e-9 * per_frame_ms,
+        s_cpu_wait_ns[1].exchange(0) * 1e-9 * per_frame_ms,
+        s_gpu_work_ns.exchange(0) * 1e-9 * per_frame_ms,
+        (s_stat_replay - s_stat_replay_reported) * per_frame_ms);
+  }
+  s_stat_replay_reported = s_stat_replay;
+  last_report = now;
+  last_frames = s_frames;
+}
+
+static void EndFrame(u32 dest_address)
+{
+  // The previous replay has to be done before its frame's data are replaced.
+  FinishJob();
+
+  // Number the loads now that every key is known.
+  std::map<std::tuple<u16, u8, u64>, u32> seen;
+  for (Load& load : s_current.loads)
+    load.occurrence = seen[std::make_tuple(load.address, load.count, load.key)]++;
+  std::map<u64, u32> seen_prims;
+  for (Prim& prim : s_current.prims)
+    prim.occurrence = seen_prims[prim.key]++;
+  s_unkeyed.clear();
+  ++s_frames;
+  {
+    static const bool timeline_wanted =
+        File::Exists(File::GetUserPath(D_USER_IDX) + "FrameInterpolation.timeline");
+    if (timeline_wanted && s_frames == 600)
+    {
+      s_timeline_zero = Clock::now();
+      s_timeline_on = true;
+    }
+    if (s_frames == 611)
+      s_timeline_on = false;
+    if (s_timeline_on)
+      Timeline("gpu end frame (xfb copy)");
+  }
+  if (Tracing())
+  {
+    Log(
+                 "[interp-trace] end frame %llu xfb %08x, %llu draws with indexed attributes, "
+                 "%zu bytes of array data in %zu copies\n",
+                 static_cast<unsigned long long>(s_frames), dest_address,
+                 static_cast<unsigned long long>(s_trace_indexed_prims), s_current.array_data.size(),
+                 s_current.array_copies.size());
+    s_trace_indexed_prims = 0;
+  }
+
+  const bool fits = ReplayFits() && !s_test_noreplay;
+  if (!fits)
+    ++s_stat_skipped;
+
+  // Keep a copy of the real picture: the XFB cache entry is overwritten when the XFB is reused.
+  Shown shown;
+  shown.address = dest_address;
+  shown.frame = s_frames;
+  const u32 width = bpmem.copyTexSrcWH.x + 1;
+  const u32 stride = bpmem.copyDestStride << 5;
+  const float y_scale = bpmem.triggerEFBCopy.scale_invert ?
+                            256.0f / static_cast<float>(bpmem.dispcopyyscale) :
+                            static_cast<float>(bpmem.dispcopyyscale) / 256.0f;
+  const u32 height = static_cast<u32>(1.0f + bpmem.copyTexSrcWH.y * y_scale);
+  MathUtil::Rectangle<int> rect;
+  const RcTcacheEntry cached =
+      g_texture_cache->GetXFBTexture(dest_address, width, height, stride, &rect);
+  if (cached && cached->texture)
+  {
+    const TextureConfig& config = cached->texture->GetConfig();
+    std::unique_ptr<AbstractTexture> copy =
+        g_gfx->CreateTexture(config, "Frame interpolation real XFB");
+    if (copy)
+    {
+      copy->CopyRectangleFromTexture(cached->texture.get(), config.GetRect(), 0, 0,
+                                     config.GetRect(), 0, 0);
+      // The entry returns its texture to the cache's pool when it goes, and pooled render
+      // targets are expected to come with their framebuffer.
+      std::unique_ptr<AbstractFramebuffer> framebuffer;
+      if (config.IsRenderTarget())
+        framebuffer = g_gfx->CreateFramebuffer(copy.get(), nullptr);
+      shown.real = std::make_shared<TCacheEntry>(std::move(copy), std::move(framebuffer));
+    }
+  }
+  std::vector<u8> start_state = std::move(s_frame_start_state);
+  const bool replay = fits && shown.real && !s_previous.stream.empty() &&
+                      !s_current.stream.empty() && !start_state.empty();
+  // This XFB copy is done: the video state is where the next frame starts.
+  s_frame_start_state = SaveState();
+  if (Tracing() && !replay)
+  {
+    Log(
+                 "[interp-trace]   no replay: fits %d real %d previous %zu current %zu start %d\n",
+                 fits ? 1 : 0, shown.real ? 1 : 0, s_previous.stream.size(),
+                 s_current.stream.size(), start_state.empty() ? 0 : 1);
+  }
+  shown.interp_due = replay;
+  s_shown.push_back(std::move(shown));
+  while (s_shown.size() > 3)
+    s_shown.pop_front();
+
+  if (s_verbose && (s_frames % 300) == 0)
+    PrintStatistics();
+
+  // Record the next frame if it can be interpolated: two recorded frames are needed for a replay,
+  // so recording starts again two frames before the budget would switch interpolation back on.
+  s_recording = (s_budget.on || s_budget.fitting >= 28) && !s_test_norecord;
+
+  std::swap(s_ready, s_current);
+  s_current.Clear();
+  if (!replay)
+  {
+    RotateReady();
+    return;
+  }
+  s_job = {};
+  s_job.active = true;
+  s_job.frame = s_frames;
+  s_job.address = dest_address;
+  s_job.start_state = std::move(start_state);
+  s_job.start = Clock::now();
+  if (!Deferred())
+    FinishJob();
+}
+
+bool OnReplayPrimitive()
+{
+  // Debug: FrameInterpolation.skip in the user directory holding "lo hi" skips the replay's draws
+  // lo..hi-1 (counted from the frame's start), to find which draw makes a picture wrong.
+  static const std::pair<u32, u32> skip = [] {
+    std::string spec;
+    unsigned long long lo = 0, hi = 0;
+    if (File::ReadFileToString(File::GetUserPath(D_USER_IDX) + "FrameInterpolation.skip", spec))
+      std::sscanf(spec.c_str(), "%llu %llu", &lo, &hi);
+    return std::pair<u32, u32>(static_cast<u32>(lo), static_cast<u32>(hi));
+  }();
+  // The replayed frame is the previous one by now (RotateReady after the blend).
+  const Frame& frame = s_previous;
+  const u32 k = s_job.prim++;
+  const bool draw = !(k >= skip.first && k < skip.second);
+  if (k + 1 >= frame.arrays_begin.size())
+    return draw;
+  VertexLoaderManager::UpdateVertexArrayPointers();
+  u8* const data = const_cast<u8*>(frame.array_data.data());
+  for (u32 i = frame.arrays_begin[k]; i < frame.arrays_begin[k + 1]; ++i)
+  {
+    const ArrayCopy& copy = frame.array_copies[i];
+    // The base the loader indexes from can lie before the copy (lo > data_offset): computed as
+    // an integer, since that pointer would be outside the vector; the loader's reads stay inside
+    VertexLoaderManager::cached_arraybases[copy.array] = reinterpret_cast<u8*>(
+        reinterpret_cast<uintptr_t>(data) + copy.data_offset - copy.lo);
+  }
+  return draw;
+}
+
+bool OnGpuIdle()
+{
+  return RunJob(false);
+}
+
+void AddReplayCopy(u32 address, RcTcacheEntry entry, bool is_xfb_copy)
+{
+  if (Tracing())
+  {
+    Log("[interp-trace]   replay %s copy %08x %ux%u (job frame %llu) at draw %u\n",
+        is_xfb_copy ? "xfb" : "efb", address, entry ? entry->native_width : 0,
+        entry ? entry->native_height : 0, static_cast<unsigned long long>(s_job.frame),
+        s_job.prim);
+  }
+  if (is_xfb_copy)
+  {
+    s_replay_xfb = std::move(entry);
+    return;
+  }
+  for (auto& [copy_address, copy] : s_replay_copies)
+  {
+    if (copy_address == address)
+    {
+      copy = std::move(entry);
+      return;
+    }
+  }
+  s_replay_copies.emplace_back(address, std::move(entry));
+}
+
+// A copy of an entry's picture as it is now. For entries the cache builds from parts of EFB copies
+// (partial texture updates): it pastes newer copies into the same entry in place, so by the time
+// the replay binds it the picture can be another frame's, or the RAM under it (Skies samples strips
+// of a screen grab it copies into its XFB buffer at the bottom of a ladder: green bands).
+static RcTcacheEntry Snapshot(const RcTcacheEntry& entry)
+{
+  const TextureConfig& config = entry->texture->GetConfig();
+  std::unique_ptr<AbstractTexture> texture =
+      g_gfx->CreateTexture(config, "Frame interpolation texture snapshot");
+  if (!texture)
+    return entry;
+  for (u32 layer = 0; layer < config.layers; ++layer)
+  {
+    for (u32 level = 0; level < config.levels; ++level)
+    {
+      const MathUtil::Rectangle<int> rect = config.GetMipRect(level);
+      texture->CopyRectangleFromTexture(entry->texture.get(), rect, layer, level, rect, layer,
+                                        level);
+    }
+  }
+  // The entry returns its texture to the cache's pool when it goes, and pooled render targets
+  // are expected to come with their framebuffer.
+  std::unique_ptr<AbstractFramebuffer> framebuffer;
+  if (config.IsRenderTarget())
+    framebuffer = g_gfx->CreateFramebuffer(texture.get(), nullptr);
+  RcTcacheEntry copy = std::make_shared<TCacheEntry>(std::move(texture), std::move(framebuffer));
+  copy->SetGeneralParameters(entry->addr, entry->size_in_bytes, entry->format, false);
+  copy->SetDimensions(entry->native_width, entry->native_height, entry->native_levels);
+  copy->memory_stride = entry->memory_stride;
+  copy->has_arbitrary_mips = entry->has_arbitrary_mips;
+  copy->may_have_overlapping_textures = false;
+  return copy;
+}
+
+void OnTextureLoad(u32 address, TextureFormat format, u32 width, u32 height,
+                   RcTcacheEntry entry)
+{
+  if (!s_recording || s_replaying || !entry)
+    return;
+  if (!entry->IsCopy() && !entry->references.empty() && entry->texture)
+  {
+    auto& snapshots = s_current.snapshots;
+    const auto it = std::find_if(snapshots.begin(), snapshots.end(),
+                                 [&](const auto& s) { return s.first == entry; });
+    if (it != snapshots.end())
+    {
+      entry = it->second;
+    }
+    else
+    {
+      RcTcacheEntry copy = Snapshot(entry);
+      snapshots.emplace_back(entry, copy);
+      entry = std::move(copy);
+    }
+  }
+  // Keyed by the image the draw asked for, not the entry's address: the cache shares one entry
+  // between identical images at different addresses (Skies' text draws each glyph from its own
+  // slot of a ring, and equal glyphs got each other's slots: garbled menu text).
+  std::vector<TextureUse>& textures = s_current.textures;
+  if (!textures.empty() && textures.back().entry.Get() == entry &&
+      textures.back().address == address && textures.back().format == static_cast<u32>(format) &&
+      textures.back().width == width && textures.back().height == height)
+  {
+    return;
+  }
+  textures.push_back(
+      TextureUse{address, static_cast<u32>(format), width, height, HeldTexture(entry)});
+}
+
+RcTcacheEntry FindRecordedTexture(u32 address, TextureFormat format, u32 width, u32 height)
+{
+  // The replayed frame is the previous one by now (RotateReady after the blend). The replay binds
+  // textures in the order the frame did, so look from where the last match was, then from the start
+  // (the same image bound twice with different contents, say, gets its own entry each time).
+  const std::vector<TextureUse>& textures = s_previous.textures;
+  const auto matches = [&](const TextureUse& use) {
+    return use.address == address && use.format == static_cast<u32>(format) &&
+           use.width == width && use.height == height;
+  };
+  for (size_t i = s_job.texture; i < textures.size(); ++i)
+  {
+    if (matches(textures[i]))
+    {
+      s_job.texture = i + 1;
+      return textures[i].entry.Get();
+    }
+  }
+  for (size_t i = 0; i < std::min(s_job.texture, textures.size()); ++i)
+  {
+    if (matches(textures[i]))
+      return textures[i].entry.Get();
+  }
+  return {};
+}
+
+RcTcacheEntry FindReplayCopy(u32 address, TextureFormat format, u32 width, u32 height)
+{
+  for (const auto& [copy_address, copy] : s_replay_copies)
+  {
+    if (copy_address == address && copy->format.texfmt == format &&
+        copy->native_width == width && copy->native_height == height)
+    {
+      return copy;
+    }
+  }
+  return {};
+}
+
+void Shutdown()
+{
+  s_shown.clear();
+  s_job = {};
+  s_replay_copies.clear();
+  s_replay_xfb.reset();
+  s_frame_start_state.clear();
+  s_current = {};
+  s_previous = {};
+  s_ready = {};
+  s_unkeyed.clear();
+  s_end_pending = false;
+  s_skip_command = false;
+  s_budget = {};
+  s_recording = true;
+}
+
+RcTcacheEntry PictureForRetrace(u32 xfb_address, bool is_duplicate)
+{
+  // The newest frame in this XFB, and the one before it.
+  Shown* current = nullptr;
+  Shown* before = nullptr;
+  for (size_t i = s_shown.size(); i-- > 0;)
+  {
+    if (s_shown[i].address == xfb_address)
+    {
+      current = &s_shown[i];
+      before = i > 0 ? &s_shown[i - 1] : nullptr;
+      break;
+    }
+  }
+  if (!current)
+    return {};
+  ++current->retraces;
+  if (Tracing())
+    Log( "[interp-trace] retrace xfb %08x dup %d frame %llu retrace %u\n",
+                 xfb_address, is_duplicate ? 1 : 0,
+                 static_cast<unsigned long long>(current->frame), current->retraces);
+
+  RcTcacheEntry picture;
+  const char* what = "real";
+  if (Deferred())
+  {
+    // One retrace later: the previous real picture, then the in-between one, then this one.
+    if (current->retraces == 1)
+    {
+      picture = before && before->real ? before->real : current->real;
+      what = "previous real";
+    }
+    else if (current->retraces == 2)
+    {
+      if (current->interp_due && s_job.active && s_job.frame == current->frame)
+        FinishJob();
+      picture = current->interp ? current->interp : current->real;
+      what = current->interp ? "in-between" : "real (no in-between)";
+    }
+    else
+    {
+      picture = current->real;
+    }
+  }
+  else
+  {
+    if (current->retraces == 1 && current->interp)
+    {
+      picture = current->interp;
+      what = "in-between";
+    }
+    else
+    {
+      picture = current->real;
+    }
+  }
+  if (picture == current->interp && picture)
+    ++s_stat_interp_shown;
+  else
+    ++s_stat_real_shown;
+  if (s_timeline_on)
+    Timeline(what);
+  return picture;
+}
+}  // namespace FrameInterpolator
diff --git a/Source/Core/VideoCommon/FrameInterpolator.h b/Source/Core/VideoCommon/FrameInterpolator.h
new file mode 100644
index 0000000000..11b04469c6
--- /dev/null
+++ b/Source/Core/VideoCommon/FrameInterpolator.h
@@ -0,0 +1,118 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Frame interpolation for 30 fps games: draws an extra picture between two of the game's frames.
+//
+// While a frame is processed, the GX command stream (display lists expanded, indexed matrix loads
+// turned into immediate ones) is recorded, together with where each XF matrix load and each draw's
+// inline vertex positions sit in it. When the frame's XFB copy is done, the stream is replayed once
+// more with every matrix and position that has a counterpart in the previous frame replaced by the
+// average of the two, which renders the scene halfway between the frames. Positions matter as much
+// as matrices: games that transform vertices on the CPU (Sega's Ninja library, for one) send them
+// already in view space, with static matrices. Counterparts are found by XF address, in order of
+// appearance, or for draws by vertex format, count and texture, with the two frames' lists of alike
+// draws aligned by their first vertices so a draw that appears or goes (one of a hundred cloud
+// strips) doesn't pair every later one with its neighbour. A frame with too few counterparts (a
+// scene change) isn't interpolated, and a value that jumps too far snaps instead of being blended.
+//
+// The replay draws on a second EFB (FramebufferManager::SwapEFB) with its own video state, and its
+// EFB and XFB copies go to textures of its own (FindReplayCopy), never to RAM or the texture cache:
+// it doesn't disturb the game's frame in progress, and the game never sees its copies. The real
+// picture of each frame is copied aside when its XFB copy is done.
+//
+// Single core: the replay runs when the frame ends, and the in-between picture is presented on the
+// first retrace of the new XFB, the real one on the next (one retrace of latency). The replay then
+// costs the emulation thread a second pass of the frame's GPU work, so it's only made while it
+// fits: each frame measures the thread's work (wall time minus throttle sleep) and the replay's
+// cost against the frame's real-time budget, and a scene where they don't fit is shown at the
+// game's own rate, at full speed, until there is room again (RECOMP_FRAME_INTERPOLATION_ADAPTIVE=0
+// interpolates every frame regardless). Nothing is recorded meanwhile.
+//
+// Dual core: the GPU thread draws the replay in slices whenever its FIFO is empty, so the game's
+// commands always come first and the CPU never waits for an in-between picture; it is presented
+// one retrace later (previous real, in-between, real: two retraces of latency) to leave it the
+// time. If it isn't done when due, or when the next frame ends, the rest is drawn at once.
+//
+// Prototype: on with the environment variable RECOMP_FRAME_INTERPOLATION=1 (2 adds statistics), or,
+// when the variable isn't set, with a file named FrameInterpolation.on in the user directory.
+// Debugging: RECOMP_FRAME_INTERPOLATION_TRACE=1 logs each frame end, replay, retrace and unpaired
+// draws; RECOMP_FRAME_INTERPOLATION_DUMP=<dir> saves real and in-between pictures (frames from
+// _DUMP_FRAME, default 300, for _DUMP_COUNT, default 6); _DEFER=0 replays at once in dual core,
+// _SLICE sets the slice size in bytes. Files in the user directory (Android has no environment):
+// FrameInterpolation.stats (statistics, also to logcat), .timeline (frames 600-610's events),
+// .noreplay and .norecord (to measure the parts' costs).
+
+#pragma once
+
+#include <atomic>
+#include <chrono>
+
+#include "Common/CommonTypes.h"
+#include "VideoCommon/CPMemory.h"
+#include "VideoCommon/TextureCacheBase.h"
+
+namespace FrameInterpolator
+{
+namespace detail
+{
+// Written on the GPU thread, read on the CPU thread too (CoreTiming's idle, the GPU drain): atomic,
+// relaxed (a frame's disagreement is harmless; the reads are on every command)
+extern std::atomic<s8> s_enabled;  // -1 until the switch has been read
+extern std::atomic<bool> s_replaying;
+bool ReadEnabled();
+}  // namespace detail
+
+// Inline: they're checked for every command the GPU processes.
+inline bool IsEnabled()
+{
+  const s8 enabled = detail::s_enabled.load(std::memory_order_relaxed);
+  return enabled >= 0 ? enabled != 0 : detail::ReadEnabled();
+}
+inline bool IsReplaying()
+{
+  return detail::s_replaying.load(std::memory_order_relaxed);
+}
+
+// Statistics (RECOMP_FRAME_INTERPOLATION=2, or a file FrameInterpolation.stats in the user
+// directory): the CPU thread waiting for the GPU thread, and the GPU thread's busy time.
+void CountCpuWait(int reason, std::chrono::steady_clock::duration time);
+void CountGpuWork(std::chrono::steady_clock::duration time);
+
+// From the opcode decoder (not while replaying).
+void OnXF(u16 address, u8 count);
+void OnIndexedLoad(CPArray array, u32 index, u16 address, u8 size);
+void OnPrimitive(u8 vat, u16 num_vertices, const u8* vertex_data, u32 size);
+// While replaying, before a draw: points indexed vertex arrays at the data copied when the frame
+// was recorded.
+// Returns whether to draw it (the debug file FrameInterpolation.skip leaves a range out).
+bool OnReplayPrimitive();
+void OnCommand(const u8* data, u32 size);
+
+// From the BP handler once an XFB copy to dest_address (and its clear) is done. The frame ends, and
+// the replay runs, when that command reaches OnCommand, so the recording includes it.
+void OnXFBCopy(u32 dest_address);
+
+// Dual core: from the GPU thread when the FIFO is empty. Draws a slice of the pending replay (see
+// FrameInterpolator.cpp); returns whether more is left, to be called again.
+bool OnGpuIdle();
+
+// From the texture cache while replaying: the replay's EFB copies stay out of the game's RAM and
+// texture cache; the replay's own texture loads find them here.
+void AddReplayCopy(u32 address, RcTcacheEntry entry, bool is_xfb_copy);
+RcTcacheEntry FindReplayCopy(u32 address, TextureFormat format, u32 width, u32 height);
+// From the texture cache: a texture the game's frame bound (not while replaying), and, while
+// replaying, the entry the recorded frame got for the same image. EFB copies too: one made in an
+// earlier frame may have been replaced by the time the replay runs; the replay's own copies
+// (FindReplayCopy) come first.
+void OnTextureLoad(u32 address, TextureFormat format, u32 width, u32 height,
+                   RcTcacheEntry entry);
+RcTcacheEntry FindRecordedTexture(u32 address, TextureFormat format, u32 width, u32 height);
+
+// Releases the held pictures and forgets the recorded frames; from the video backend's shutdown,
+// before the texture cache goes, and after a savestate load.
+void Shutdown();
+
+// From the presenter, for each retrace that shows xfb_address: the picture to present instead of
+// the XFB cache's, if any.
+RcTcacheEntry PictureForRetrace(u32 xfb_address, bool is_duplicate);
+}  // namespace FrameInterpolator
